   // KocatanBlacksmith (KocatanBlacksmith)
   kocatanblacksmith_speech_001 = "~kIxla says, \"What do you have there?\""
   kocatanblacksmith_speech_002 = "~kIxla says, \"Come back any time.\""
   kocatanblacksmith_speech_003 = "~kIxla says, \"Leaving? See you around.\""
   kocatanblacksmith_speech_004 = \
      "~kIxla says, \"Kazot you and all of your kinkauilkinich chot frying "
      "pan armor, you call yourself a warrior? You call yourself a warrior? "
      "Get your sorry zosin mainland trash back through the zosin orc "
      "warrens where you zosin belong.\""
   kocatanblacksmith_speech_005 = "~kIxla says, \"Hello. Come on in.\""
   kocatanblacksmith_speech_006 = \
      "~kIxla says, \"What the kazot! How you been? Good to see you.\""
   kocatanblacksmith_speech_007 = \
      "~kIxla says, \"If it's not one zoszin thing it's another.\""
   kocatanblacksmith_speech_008 = "~kIxla blushes."
   kocatanblacksmith_speech_009 = \
      "~kIxla says, \"Guess what? That's where you are right now, you zoszin "
      "genius.\""
   kocatanblacksmith_speech_010 = \
      "~kIxla says, \"As in where is Ko'catan? Well let's see, something "
      "tells me that maybe you don't belong here if you don't know where you "
      "are. Listen Nah zotz chot, get it right. If you're going to stand "
      "around asking stupid zoszin questions, do it with somebody stupid "
      "enough to waste their time talking to you.\""
   kocatanblacksmith_speech_011 = \
      "~kIxla says, \"I've got his sword. His zoszin sword, I've got it. "
      "Great big thing too, charged with all kinds of energy that I don't "
      "understand.\""
   kocatanblacksmith_speech_012 = \
      "~kIxla says, \"Konima? He's the guy that came up with the zoszin plan "
      "to begin with. The Great Warlord. After him, all the others pale. "
      "They're just zoszin kotezleoc.\""
   kocatanblacksmith_speech_013 = \
      "~kIxla says, \"Kotezleoc is... how the zoszin do you say it? Like a "
      "person, after they're dead, and their body is like smoke or fog "
      "rather than being like a real body.\""
   kocatanblacksmith_speech_014 = \
      "~kIxla says, \"What the kazot do you think I sell? Umacha beans?\""
   kocatanblacksmith_speech_015 = "~kIxla says, \"Yeah, right.\""
   kocatanblacksmith_random_001 = \
      "~kIxla says, \"This anvil has been in my family for six generations. "
      "My grandfather's grandfather was the weaponsmith to Konima himself, "
      "and was next to him when he passed from this life. The wounds on "
      "Konima were so great, that in some places his armor was irreparable. "
      "My grandfather's grandfather made this anvil from the breastplate of "
      "Konima's great platemail. That's true, every zoszin word of it.\""
   kocatanblacksmith_random_002 = \
      "~kIxla says, \"This land that you come from, across and beneath the "
      "water. What the zoszin kazot kind of blacksmiths do you have there? "
      "Your tools and your weapons look so zoszin clumsy.\""
   kocatanblacksmith_random_003 = \
      "~kIxla says, \"I really don't give a kazot about the Avars or the "
      "Orcs. They got some guys like to fight, we got some guys that like to "
      "fight, the two groups of guys get together and fight. It's a minor "
      "zoszin sidelight, that's all. Big deal. That's not what life is "
      "about. But it keeps the zoszin business good.\""
   kocatanblacksmith_random_004 = \
      "~kIxla yells, \"~BChot!~B\" She's a little frustrated with her work "
      "right now."
   kocatanblacksmith_random_005 = \
      "~kYou don't see any evidence of wood or other fuel that would "
      "normally be needed in great abundance to feed a fire so remarkably "
      "hot."
   kocatanblacksmith_random_006 = \
      "~kIxla carefully smashes a metal plate with her hammer, sending "
      "sparks up around the room."
   kocatanblacksmith_random_007 = \
      "~kThe heart of the fire buzzes with the intensity of a magical storm."
   kocatanblacksmith_random_008 = \
      "~kIxla says, \"Watch yourself near the forge there. You stand too "
      "close and you'll burn the chot out of yourself.\""
   kocatanblacksmith_random_009 = \
      "~kIxla says, \"You need to be pretty zoszin careful with a nerudite "
      "sword. It's not like that clumsy zoszin iron you're probably used to "
      "swinging, nerudite is sharp and refined. But it's also brittle, so "
      "it's no good swinging it like a zoszin hammer.\""
   kocatanblacksmith_random_010 = \
      "~kThe heart of the forge glows with terribly intense heat, but seems "
      "to not substantially raise the temperature of the shop."
   kocatanblacksmith_random_011 = \
      "~kDeep in the very heart of the forge glows a terribly intense heat."
   kocatanblacksmith_random_012 = \
      "~kIxla says, \"Aw, kazot, I'm sorry. Did those sparks burn your "
      "clothes?\""
   kocatanblacksmith_random_013 = \
      "~kIxla says, \"What the kazot. Did you come in here to stand around "
      "watching me work or do we have business? I don't have all zoszin "
      "day.\""
   kocatanblacksmith_trigger_sell = "sell"
   kocatanblacksmith_trigger_goodbye = "goodbye"
   kocatanblacksmith_trigger_goodbye_2 = "goodbye"
   kocatanblacksmith_trigger_hello = "hello"
   kocatanblacksmith_trigger_help = "help"
   kocatanblacksmith_trigger_kazot = "kazot"
   kocatanblacksmith_trigger_ko_catan = "ko'catan"
   kocatanblacksmith_trigger_konima = "konima"
   kocatanblacksmith_trigger_kotezleoc = "kotezleoc"
   kocatanblacksmith_trigger_buy = "buy"
   kocatanblacksmith_trigger_zoszin = "zoszin"

   // KocatanBonePriestess (The Bone Priestess)
   kocatanbonepriestess_speech_001 = \
      "~kThe Bone Priestess says, \"Buy? TIC-TIC-TIC-TIC-TIC!!!\""
   kocatanbonepriestess_speech_002 = \
      "~kThe Bone Priestess squawks, \"CHITTY-UP!!\""
   kocatanbonepriestess_speech_003 = \
      "~kThe Bone Priestess replies, \"PER-CHICK-A-REEEEEEE!\""
   kocatanbonepriestess_speech_004 = \
      "~kThe Bone Priestess hisses, \"~IBRING ME THE HEAD OF THE ORC "
      "CHIEFTAIN!!!~I\""
   kocatanbonepriestess_speech_005 = \
      "~kThe Bone Priestess screams, \"ANK-ANK-ANK-ANK!\""
   kocatanbonepriestess_speech_006 = \
      "~kThe Bone Priestess says to you, \"WENK-WENK-WENK!!\""
   kocatanbonepriestess_speech_007 = \
      "~kThe Bone Priestess screams, \"~ITHE EYE OF RIIJA~I!\""
   kocatanbonepriestess_speech_008 = \
      "~kThe Bone Priestess screams, \"~IRIIJA! RIIJA!~I\""
   kocatanbonepriestess_random_001 = \
      "~kThe Bone Priestess squeals, \"Chobble-dee, chobble-dee, "
      "chobble-dee!\""
   kocatanbonepriestess_random_002 = \
      "~kThe Bone Priestess stutters, \"Garoooo-a-a-a-a.\""
   kocatanbonepriestess_random_003 = \
      "~kThe Bone Priestess buzzes, \"ZEE-CHUPITY-CHUPITY!\""
   kocatanbonepriestess_random_004 = \
      "~kThe Bone Priestess wildly chirps, \"Piky-tucky-tuck, pik-a-tuck, "
      "pik-a-tuck, Piky-tucky-tuck, pik-a-tuck, pik-a-tuck.\""
   kocatanbonepriestess_random_005 = \
      "~kThe Bone Priestess trills, \"Chu-wheee, cheer-ee-oh.\""
   kocatanbonepriestess_random_006 = \
      "~kThe Bone Priestess grates, \"Shaaaaaaaaak!\""
   kocatanbonepriestess_random_007 = \
      "~kThe Bone Priestess screams, \"CHUP-CHUP-ZEE! SKULLS! SKULLS!\""
   kocatanbonepriestess_random_008 = "~kThe Bone Priestess is clearly insane."
   kocatanbonepriestess_random_009 = "~kThe ground seems sticky around you."
   kocatanbonepriestess_random_010 = \
      "~kThere is something very scary about the way that the Bone Priestess "
      "is watching you."
   kocatanbonepriestess_random_011 = "~kThis place is unsettling."
   kocatanbonepriestess_random_012 = "~kThe Bone Priestess yaps at herself."
   kocatanbonepriestess_random_013 = \
      "~kThe Bone Priestess fidgets and watches you."
   kocatanbonepriestess_random_014 = \
      "~kThe Bone Priestess is staring at you without comprehension."
   kocatanbonepriestess_random_015 = \
      "~kThe Bone Priestess doesn't seem to see you at all."
   kocatanbonepriestess_random_016 = \
      "~kThe smell here is of rotting melons and it is overpowering."
   kocatanbonepriestess_random_017 = \
      "~kThe Bone Priestess thumps her hand on her chest and makes weird "
      "little circles with her head."
   kocatanbonepriestess_random_018 = \
      "~kThe Bone Priestess scratches, shakes her head, and makes a weird "
      "noise."
   kocatanbonepriestess_random_019 = \
      "~kThe Bone Priestess preens herself, dislodging a cloud of flaky "
      "crumbs from her feathers."
   kocatanbonepriestess_random_020 = \
      "~kThe Bone Priestess screams, \"ANK-ANK-ANK-ANK!\""
   kocatanbonepriestess_trigger_buy = "buy"
   kocatanbonepriestess_trigger_hello = "hello"
   kocatanbonepriestess_trigger_help = "help"
   kocatanbonepriestess_trigger_riija = "riija"
   kocatanbonepriestess_trigger_sell = "sell"
   kocatanbonepriestess_trigger_staff = "staff"
   kocatanbonepriestess_trigger_sword = "sword"

   // KocatanBowMaker (Hanla zax'Ta)
   kocatanbowmaker_speech_001 = \
      "~kHanla says, \"The feathers and wood determine the quality of an "
      "arrow, but ultimately it depends on how straight the shaft is "
      "carved.\""
   kocatanbowmaker_speech_002 = \
      "~kHanla says, \"The Avars are no worse or better than the warriors of "
      "Ko'catan. I don't pose enough of a threat to them, so they leave me "
      "alone.\""
   kocatanbowmaker_speech_003 = \
      "~kHanla says, \"You would be considered wise if you stayed a good "
      "distance from that man's hut. He is stark-staring mad.\""
   kocatanbowmaker_speech_004 = \
      "~kHanla says, \"Nature likes balance. If the hunter seeks to bring "
      "evil creatures down, that hunter shall tend towards good. Hunting "
      "good creatures will align her towards evil. A good hunter seeks to "
      "balance her kills.\""
   kocatanbowmaker_speech_005 = \
      "~kHanla says, \"Do not make a habit of coming here to sell your "
      "baubles to me. But since my supplies are running low, let me see what "
      "you have.\""
   kocatanbowmaker_speech_006 = \
      "~kHanla zax'Ta says, \"Good luck. You will need it.\""
   kocatanbowmaker_speech_007 = \
      "~kHanla zax'Ta says, \"Please close the door softly as you leave. I "
      "don't wish for my father to wake.\""
   kocatanbowmaker_speech_008 = \
      "~kHanla says, \"My father is my only friend. He has always been there "
      "for me. I do not know what I would do without him.\""
   kocatanbowmaker_speech_009 = \
      "~kHanla zax'Ta does not even look up from her work."
   kocatanbowmaker_speech_010 = "~kHanla zax'Ta says, \"I craft fine bows.\""
   kocatanbowmaker_speech_011 = \
      "~kHanla says, \"Stay away from the cliff. A true hunter does not hunt "
      "in the den of its prey.\""
   kocatanbowmaker_speech_012 = \
      "~kHanla says, \"The major hive is on a cliff north of here. Avoid "
      "it.\""
   kocatanbowmaker_speech_013 = \
      "~kHanla says, \"Ko'catan is civilized. Civilized like a pack of "
      "wolves.\""
   kocatanbowmaker_speech_014 = \
      "~kHanla says, \"~IKonima was a great warrior. He led our people to "
      "safety. He built our civilization.~I These are just stories that "
      "others tell to make themselves seem important.\""
   kocatanbowmaker_speech_015 = \
      "~kHanla says, \"Wulfgang the Trader and Bahal the mad also live out "
      "in the jungle.\""
   kocatanbowmaker_speech_016 = \
      "~kHanla says, \"The shadow god is just an old legend.\""
   kocatanbowmaker_speech_017 = \
      "~kHanla says, \"Normally, I would not part with my hand worked bows. "
      "Especially not to a stranger. But my father is sick and medication "
      "costs so much.\""
   kocatanbowmaker_speech_018 = \
      "~kHanla says, \"I do not wish to take on students. Perhaps old "
      "Kochtal can help you. He taught my father how to fire a bow.\""
   kocatanbowmaker_speech_019 = \
      "~kHanla says, \"I don't know what your people call them. Something "
      "like the beast of shadows.\""
   kocatanbowmaker_speech_020 = \
      "~kHanla says, \"Wulfgang is kind enough. He sometimes comes to "
      "re-supply us with essentials. His accent is similar to yours.\""
   kocatanbowmaker_random_001 = \
      "~kHanla zax'Ta says, \"This wood needs to be oiled properly. Bows "
      "need to be strong, yet yielding.\""
   kocatanbowmaker_random_002 = \
      "~kHanla says, \"My father is not the only one who has been outcast "
      "from Ko'catan. There have been others.\""
   kocatanbowmaker_random_003 = \
      "~kHanla says, \"It is essential to have a tightly strung bow, if you "
      "are hunting teotkriipa.\""
   kocatanbowmaker_random_004 = \
      "~kHanla says, \"Primarily, one must hunt for food or to hone one's "
      "ability. Though nature does have a sense of balance.\""
   kocatanbowmaker_random_005 = \
      "~kThe smell of cooking fish hangs heavily in the air."
   kocatanbowmaker_random_006 = \
      "~kHanla calls to the backroom, \"Yes, father. As soon as this person "
      "is gone, I will make you dinner.\""
   kocatanbowmaker_random_007 = \
      "~kHanla looks up towards the bedroom door. \"Do you need me, father? "
      "Your cough is getting worse.\""
   kocatanbowmaker_random_008 = \
      "~kHanla says, \"You won't be staying long, will you? I need to go out "
      "and get tomorrow's dinner and I don't want to leave you here alone "
      "with my father.\""
   kocatanbowmaker_random_009 = \
      "~kHanla says, \"I make different types of arrows.\""
   kocatanbowmaker_random_010 = \
      "~kA slight creaking can be heard from the back room."
   kocatanbowmaker_random_011 = \
      "~kHanla bends an arrow to test the strength of the shaft. When it "
      "doesn't break, she seems pleased."
   kocatanbowmaker_random_012 = \
      "~kHanla sings a soft song to herself as she works the wood."
   kocatanbowmaker_random_013 = \
      "~kHanla applies a light coating of oil to the bow in her hands."
   kocatanbowmaker_random_014 = "~kHanla says, \"Hail, %s.\""
   kocatanbowmaker_random_015 = \
      "~kHanla hands you a bow to examine. It is well made."
   kocatanbowmaker_random_016 = \
      "~kHanla says, \"It gets lonely out here without having other women to "
      "talk to.\""
   kocatanbowmaker_random_017 = \
      "~kFor a moment you think you can smell the stench of decay buried "
      "under the strong smell of cooking fish. Perhaps that was just in your "
      "imagination."
   kocatanbowmaker_random_018 = \
      "~kHanla says, \"I have had little problem with the Kyip-Kyip-Kreeet "
      "tribe. The Peet-Seeeeps are the arrogant ones.\""
   kocatanbowmaker_random_019 = \
      "~kHanla says, \"Beware of the old ruins. The war between the two "
      "major tribes rages most severely there.\""
   kocatanbowmaker_random_020 = \
      "~kHanla says, \"The huzotz can be an easy hunt, but beware do not "
      "think to take them in their hive. They are extremely territorial.\""
   kocatanbowmaker_random_021 = \
      "~kHanla grinds her teeth. She is obviously uncomfortable with your "
      "presence."
   kocatanbowmaker_trigger_arrow = "arrow"
   kocatanbowmaker_trigger_quality = "quality"
   kocatanbowmaker_trigger_avar = "avar"
   kocatanbowmaker_trigger_bahal = "bahal"
   kocatanbowmaker_trigger_balance = "balance"
   kocatanbowmaker_trigger_balance_2 = "balance"
   kocatanbowmaker_trigger_sell = "sell"
   kocatanbowmaker_trigger_bye = "bye"
   kocatanbowmaker_trigger_father = "father"
   kocatanbowmaker_trigger_hello = "hello"
   kocatanbowmaker_trigger_help = "help"
   kocatanbowmaker_trigger_hive = "hive"
   kocatanbowmaker_trigger_cliff = "cliff"
   kocatanbowmaker_trigger_huzotz = "huzotz"
   kocatanbowmaker_trigger_ko_catan = "ko'catan"
   kocatanbowmaker_trigger_konima = "konima"
   kocatanbowmaker_trigger_others = "others"
   kocatanbowmaker_trigger_riija = "riija"
   kocatanbowmaker_trigger_buy = "buy"
   kocatanbowmaker_trigger_teach = "teach"
   kocatanbowmaker_trigger_learn = "learn"
   kocatanbowmaker_trigger_learn_2 = "learn"
   kocatanbowmaker_trigger_teotkriipa = "teotkriipa"
   kocatanbowmaker_trigger_wulfgang = "wulfgang"

   // KocatanCaptainEvil (Xacal ko'Ixca)
   kocatancaptainevil_speech_001 = \
      "~kXacal says, \"Balo na'te Din? That's a strange thing for you to be "
      "asking about.\""
   kocatancaptainevil_speech_002 = \
      "~kXacal says, \"Bribe is such an ugly word. Let's just say that a "
      "~Igift~I of a thousand shillings buys a little cooperation.\""
   kocatancaptainevil_speech_003 = "~kXacal says, \"I ain't buying.\""
   kocatancaptainevil_speech_004 = \
      "~kXacal watches you with apparent amusement."
   kocatancaptainevil_speech_005 = \
      "~kXacal says, \"I am Xacal ko'Ixca, Captain of the Teot Guard and "
      "acting Tezcha Kici'ca in command of the Main Gate. Nothing passes "
      "this gate unless I say so.\""
   kocatancaptainevil_speech_006 = \
      "~kXacal says, \"Kazot you, skip the rigmarole.\""
   kocatancaptainevil_speech_007 = \
      "~kXacal says, \"Don't play games with me. This isn't the visitors "
      "bureau, and I ask the questions, not you.\""
   kocatancaptainevil_speech_008 = \
      "~kXacal says, \"A thousand shillings is a good reason to break the "
      "rules.\""
   kocatancaptainevil_speech_009 = \
      "~kXacal says, \"By proclamation of the A'ach tezcha, blah, blah, "
      "blah, the following items are restricted; you don't pass with "
      "restricted items unless I say so. Ready? Weapons; you can carry four "
      "weapons. Armor; you can get away with the armor you're wearing and a "
      "spare, that's it. Kangi stone; you don't have any kangi stone, "
      "zax'ix. Raw nerudite; no raw nerudite will pass through this gate "
      "under any circumstances. Got that? Alcohol; any alcohol will be "
      "confiscated by the captain on duty. Umacha beans; I don't care about "
      "umacha beans. Now, those are the rules, and we don't break the rules "
      "around here unless we have good reasons.\""
   kocatancaptainevil_speech_010 = \
      "~kXacal says, \"Anything is available, for the right price.\""
   kocatancaptainevil_speech_011 = \
      "~kXacal says, \"You're kidding me, right? At my gate? Keep it up, "
      "you're going to look pretty humorous eating brown corn with no front "
      "teeth, ix'chot.\""
   kocatancaptainevil_speech_012 = \
      "~kXacal says, \"Ah, I see. Tepal ix'Zonak sent you? Well, you're not "
      "in sanctuary now, so play by the rules or you may end up splashed on "
      "the floor here trying to breathe with your lungs ripped out.\""
   kocatancaptainevil_speech_013 = \
      "~kXacal recounts, \"By proclamation of the A'ach tezcha, the "
      "possession of certain items is forbidden.\""
   kocatancaptainevil_random_001 = \
      "~kXacal says, \"According to the Tezcha A'ach, we are currently in a "
      "heightened state of diplomatic awareness with the Avar. What does "
      "that mean? That means that although we are not at war, every night I "
      "send out a patrol of mean, quiet guys that come back in the morning "
      "washing blood and feathers off their armor and the generals pretend "
      "nothing happened. It means that anything that passes this gate only "
      "does so if I think there's a good reason. And if it's restricted, it "
      "better be a really good reason.\""
   kocatancaptainevil_random_002 = \
      "~kXacal says, \"So what brought you out to our quaint little island? "
      "Easy money, right? That's right, easy money. Well, you best watch "
      "your little entrepreneurial steps, or young Cital might find you "
      "floating face down in that little pool in front of Konima's tomb one "
      "morning.\""
   kocatancaptainevil_random_003 = \
      "~kXacal glances over his shoulder and shares a laugh with the guards."
   kocatancaptainevil_random_004 = \
      "~kXacal says, \"I am ordered to deny passage through this gate of any "
      "parties carrying restricted items. And that's exactly what I'm going "
      "to do.\""
   kocatancaptainevil_random_005 = \
      "~kXacal jokes, \"Be careful out there, Zax'ta.\" His men share a "
      "hearty laugh."
   kocatancaptainevil_random_006 = \
      "~kXacal says, \"Young Cital commands the gate during the day, and I'm "
      "here at night, every night. We do things a little differently, the "
      "two of us.\""
   kocatancaptainevil_random_007 = "~kXacal says, \"Don't get cute.\""
   kocatancaptainevil_random_008 = \
      "~kXacal says, \"Look alive there. If you've got business with the "
      "gate, then let's deal. Otherwise, I don't give a chot what you're up "
      "to, beat it, and fast. I have little patience for foreigners.\""
   kocatancaptainevil_random_009 = \
      "~kXacal's veteran guards watch you contemptuously."
   kocatancaptainevil_random_010 = \
      "~kXacal says, \"You're going out there to play around a bit, huh? It "
      "gets a bit rough out there, you better be ready to play rough.\""
   kocatancaptainevil_random_011 = \
      "~kXacal says, \"You cannot show mercy out in the jungle, for none "
      "will be shown to you, zax'ix. If your enemy flees, it will only be "
      "because they are close to death. Hit them with your range weapons, or "
      "they will be back to attack when their strength returns. That is the "
      "law of the jungle.\""
   kocatancaptainevil_random_012 = \
      "~kXacal says, \"Have you heard of the koutom in the tunnels? He is "
      "faster than evil itself, I have seen him. Only the most seasoned "
      "warrior survives sword-to-sword with that clever moch.\""
   kocatancaptainevil_trigger_balo_na_te_din = "balo na'te din"
   kocatancaptainevil_trigger_bribe = "bribe"
   kocatancaptainevil_trigger_sell = "sell"
   kocatancaptainevil_trigger_hello = "hello"
   kocatancaptainevil_trigger_help = "help"
   kocatancaptainevil_trigger_ko_catan = "ko'catan"
   kocatancaptainevil_trigger_konima = "konima"
   kocatancaptainevil_trigger_reason = "reason"
   kocatancaptainevil_trigger_gift = "gift"
   kocatancaptainevil_trigger_gift_2 = "gift"
   kocatancaptainevil_trigger_restrictions = "restrictions"
   kocatancaptainevil_trigger_buy = "buy"
   kocatancaptainevil_trigger_sing = "sing"
   kocatancaptainevil_trigger_tepal = "tepal"
   kocatancaptainevil_trigger_weapons = "weapons"

   // KocatanCaptainGood (Cital ko'Manca)
   kocatancaptaingood_speech_001 = \
      "~kCital says, \"I hope that you are not attempting to bribe me. "
      "Offering graft to a ranking officer in the Kici'ca is an offense "
      "punishable by imprisonment and subsequent death.\""
   kocatancaptaingood_speech_002 = \
      "~kCital says, \"We are not here to sell anything. At this gate "
      "nothing is negotiable, and any attempt to bribe a Ko'catani Officer "
      "could lead to your imprisonment. Followed by interrogation, and "
      "death.\""
   kocatancaptaingood_speech_003 = "~kCital says, \"Good afternoon, %s.\""
   kocatancaptaingood_speech_004 = \
      "~kCital says, \"I am Cital ko'Manca, Captain of the Kin Guard and "
      "acting Tezcha Kici'ca in command of the Main Gate.\""
   kocatancaptaingood_speech_005 = \
      "~kCital says, \"The homeland that I have sworn to defend. Have you "
      "heard our national anthem?\""
   kocatancaptaingood_speech_006 = \
      "~kCital says, \"Koutom is our word for the chieftain of the orcs.\""
   kocatancaptaingood_speech_007 = \
      "~kCital quotes, \"By proclamation of the A'ach tezcha, the following "
      "items are restricted; parties may not pass through this gate with "
      "restricted items in their possession. Weapons; parties are limited to "
      "four weapons only for their personal defense outside the gate. Armor; "
      "parties are limited to two suits of armor for their safety outside "
      "the gate. A ~Isuit~I of armor is composed of one of each of the "
      "following items- one pair of gauntlets, one shield, one helmet, and "
      "one breastplate. Kangi stone; no Kangi stone will pass through this "
      "gate under any circumstances. Raw nerudite; no raw nerudite will pass "
      "through this gate under any circumstances. Alcohol; no alcoholic "
      "beverages will pass through this gate under any circumstances. Umacha "
      "beans; no umacha beans will pass through this gate under any "
      "circumstances. Is that clear enough?\""
   kocatancaptaingood_speech_008 = \
      "~kCital recounts, \"By proclamation of the A'ach tezcha, the "
      "possession of certain items is forbidden.\""
   kocatancaptaingood_speech_009 = \
      "~kCital says, \"This is not a market %s.\""
   kocatancaptaingood_speech_010 = \
      "~kCital sings, \"Ko'catan, Ko'catan, yo lal ona tan, tez'ca, tez'ca, "
      "hu lal ona tan, yo'ca, yo'ca, tez lal ona tan, Ko'catan, Ko'catan!\""
   kocatancaptaingood_random_001 = "~kCital ko'Manca is all business."
   kocatancaptaingood_random_002 = \
      "~kCital says, \"I am ordered to deny passage through this gate of any "
      "parties carrying restricted items.\""
   kocatancaptaingood_random_003 = \
      "~kCital says, \"A word of advice. The jungle is fraught with dangers "
      "that you cannot even imagine. When I venture out of this gate, it is "
      "with at least twenty veteran soldiers. I suggest that you be very "
      "careful out there.\""
   kocatancaptaingood_random_004 = \
      "~kCital says, \"I sincerely hope that you have enjoyed your stay in "
      "Ko'catan.\""
   kocatancaptaingood_random_005 = \
      "~kCital says, \"What you do outside of these gates is your business, "
      "but what you bring out there is mine. I take my business very "
      "seriously. That is my duty.\""
   kocatancaptaingood_random_006 = \
      "~kCital says, \"We are currently in a heightened state of diplomatic "
      "awareness with the Avar. That means that although we are not at war, "
      "the flow of goods from this gate is restricted.\""
   kocatancaptaingood_random_007 = \
      "~kCital glances over his shoulder and the guards snap to attention."
   kocatancaptaingood_random_008 = "~kCital eyes you steadily."
   kocatancaptaingood_random_009 = \
      "~kCital says to his men, \"Vapil adiki zax'lal. A mozo ona zax.\""
   kocatancaptaingood_random_010 = \
      "~kCital's elite guards watch your every movement."
   kocatancaptaingood_random_011 = \
      "~kCital says, \"A piece of advice to the unwary. If you notice that "
      "the area is darkening, watch for the teotkriipa, or shadowbeast. They "
      "are fast and dangerous.\""
   kocatancaptaingood_random_012 = \
      "~kCital says, \"I will also warn you that good soldiers survive in "
      "the jungle by defending their allies. That works on both sides, for "
      "you, and your enemies.\""
   kocatancaptaingood_random_013 = \
      "~kCital says, \"Beware the avar'ca, even though we are supposedly on "
      "neutral standing with them. They are territorial, and will not "
      "hesitate to attack if they see you as a threat.\""
   kocatancaptaingood_random_014 = \
      "~kCital says, \"Survival usually depends on knowing your enemy. The "
      "primitive avar'ca military doctrine usually dictates that they deploy "
      "their ranged weapons away from you, the target, while their infantry "
      "moves to engage. The best way to combat this is to send part of your "
      "force to flank them, and annihilate the archers and spell casters.\""
   kocatancaptaingood_trigger_bribe = "bribe"
   kocatancaptaingood_trigger_buy = "buy"
   kocatancaptaingood_trigger_hello = "hello"
   kocatancaptaingood_trigger_help = "help"
   kocatancaptaingood_trigger_ko_catan = "ko'catan"
   kocatancaptaingood_trigger_koutom = "koutom"
   kocatancaptaingood_trigger_restricted_items = "restricted items"
   kocatancaptaingood_trigger_weapons = "weapons"
   kocatancaptaingood_trigger_sell = "sell"
   kocatancaptaingood_trigger_sing = "sing"

   // KocatanInnkeeper (KocatanInnkeeper)
   kocataninnkeeper_speech_001 = \
      "~kMoxal says, \"Unfortunately, our culture has had a lot of "
      "misunderstandings with the Avars. Once matters are cleared up, they "
      "are going to be a great culture to take from, I mean, trade with.\""
   kocataninnkeeper_speech_002 = \
      "~kMoxal says, \"I'm always interested in a good deal.\""
   kocataninnkeeper_speech_003 = \
      "~kMoxal says, \"So long, %s! May all of your journeys be profitable.\""
   kocataninnkeeper_speech_004 = \
      "~kMoxal ix'Hanak greets you with, \"Hello, %s! You're just in time. "
      "Any later and you would have missed out on some great deals.\""
   kocataninnkeeper_speech_005 = "~kMoxal says, \"Hail, %s!\""
   kocataninnkeeper_speech_006 = "~kMoxal says, \"I am here to serve you.\""
   kocataninnkeeper_speech_007 = \
      "~kMoxal says, \"This is the greatest society mankind has ever known. "
      "But maybe someday I'll leave Ko'catan to see what the old cities have "
      "to offer.\""
   kocataninnkeeper_speech_008 = \
      "~kMoxal says, \"Konima was the greatest hero and entrepreneur this "
      "society has ever known. I wish I was around to get in on his "
      "expedition in its start up.\""
   kocataninnkeeper_speech_009 = \
      "~kMoxal says, \"Riija is a fine upstanding god. He doesn't deserve "
      "the bad reputation some people give him.\""
   kocataninnkeeper_speech_010 = \
      "~kMoxal says, \"I have food here, but I'm sure I can help you better "
      "spend your hard earned money.\""
   kocataninnkeeper_speech_011 = \
      "~kThe room goes silent as %s mentions stunted dwarf."
   kocataninnkeeper_speech_012 = \
      "~kMoxal says, \"I'm afraid I'm not allowed to teach anything yet.\""
   kocataninnkeeper_random_001 = \
      "~kMoxal says, \"You know... never mind, I shouldn't say... well, all "
      "right, since we're friends. I know of a group of prospectors who have "
      "located an emerald mine. The claim hasn't been made official yet, so "
      "there is still time to invest in the mining operation. If you give me "
      "12,000 shillings, we can quadruple it in two weeks time.\""
   kocataninnkeeper_random_002 = \
      "~kMoxal says, \"I'm thinking of opening a second inn on the mainland. "
      "Just imagine, the authentic feel of Ko'catan right in the middle of "
      "Cor Noth. Tell you what, since I like you, I'll let you invest 25,000 "
      "shillings. With it you would own one quarter of the inn and its "
      "profits.\""
   kocataninnkeeper_random_003 = \
      "~kMoxal says, \"Have you bet on the warriors Tourney yet? I have "
      "inside knowledge that the champion is going to lose. If you want in, "
      "the odds pay 67 to 1. Guaranteed win. Give me 500 shillings and I'll "
      "place the bet for you.\""
   kocataninnkeeper_random_004 = \
      "~kMoxal says, \"Come here. Do you want to make big money? I'm "
      "involved in a group where the profits are enormous. Here's how it "
      "works, as a new member you pay me 1,000 shillings. Now the next "
      "twenty new members pay you 1,000 shillings each. You will be rich in "
      "no time.\""
   kocataninnkeeper_random_005 = \
      "~kMoxal says, \"Last chance to enter the raffle for the nerudite bow! "
      "Only 500 shillings to enter. Winner announced tomorrow.\""
   kocataninnkeeper_random_006 = \
      "~kMoxal says, \"How much money do you have on you? I have a bit of "
      "property I need to unload today. It's a small villa on the other side "
      "of the island. The area is a bit dangerous, but it's good property "
      "and I'm willing to part with it for only 100,000 shillings.\""
   kocataninnkeeper_random_007 = \
      "~kMoxal says, \"I have secret knowledge that there will soon be a "
      "shortage of brew. I've stockpiled a couple of barrels away. If you "
      "want, I'll hold them here until the shortage begins, but you can be "
      "the owner of them for only 900 shillings. Think about it, you'll be "
      "able to charge any price you want for a cup of brew.\""
   kocataninnkeeper_random_008 = \
      "~kMoxal says, \"This wasn't really an inn before people from your "
      "land started coming here. Long ago it was built to house the Avar "
      "ambassadors. Well, after the treaties fell apart, this mainly got "
      "used by soldiers who, well, let's just say, didn't feel like sleeping "
      "in their barracks.\""
   kocataninnkeeper_random_009 = \
      "~kMoxal says, \"This is a wonderful place to stay the night. Don't "
      "let the noise from downstairs bother you. It usually quiets down "
      "around midnight.\""
   kocataninnkeeper_random_010 = \
      "~kYou hear shouting and laughter coming from the tavern beneath here."
   kocataninnkeeper_random_011 = \
      "~kA loud crash from downstairs startles you. Presumably used to such "
      "sounds, Moxal pays no attention to it."
   kocataninnkeeper_random_012 = \
      "~kMoxal says, \"If you are out in the jungle, you might want to ask "
      "Wulfgang about his inventory.\""
   kocataninnkeeper_random_013 = "~kMoxal cheerfully smiles at you."
   kocataninnkeeper_random_014 = \
      "~kMoxal happily sings an old folk song to himself."
   kocataninnkeeper_random_015 = \
      "~kMoxal smiles and says, \"Today is a great day, don't you think?\""
   kocataninnkeeper_random_016 = \
      "~kMoxal counts a large stack of coins, giggling to himself."
   kocataninnkeeper_random_017 = \
      "~kMoxal says, \"So how long have you been in the settlement? You must "
      "love it here. I know I do.\""
   kocataninnkeeper_random_018 = \
      "~kMoxal says, \"Business has really started booming since your people "
      "started coming here. In fact, I only need a few more masters to "
      "sponsor me and I'll move up a rank.\""
   kocataninnkeeper_random_019 = \
      "~kMoxal says to himself, \"Where am I going to get 450,000 shillings? "
      "I am such a dead man. Riija help me, I'm such a dead man.\""
   kocataninnkeeper_random_020 = \
      "~kMoxal sweats profusely and says, \"Xacal ko'Ixca didn't send you "
      "did he? If he did, let him know I ~Ihave~I his money. Well, I mean I "
      "will have his money tomorrow.\""
   kocataninnkeeper_random_021 = \
      "~kMoxal paces back and forth nervously as if awaiting some disaster."
   kocataninnkeeper_random_022 = \
      "~kMoxal says to himself, \"What am I going to do?! There is no way I "
      "can come up with that much money.\""
   kocataninnkeeper_random_023 = \
      "~kMoxal wipes tears from his eyes while muttering something about "
      "losing a lot of money."
   kocataninnkeeper_trigger_avar = "avar"
   kocataninnkeeper_trigger_sell = "sell"
   kocataninnkeeper_trigger_bye = "bye"
   kocataninnkeeper_trigger_hello = "hello"
   kocataninnkeeper_trigger_help = "help"
   kocataninnkeeper_trigger_ko_catan = "ko'catan"
   kocataninnkeeper_trigger_konima = "konima"
   kocataninnkeeper_trigger_riija = "riija"
   kocataninnkeeper_trigger_buy = "buy"
   kocataninnkeeper_trigger_stunted_dwarf = "stunted dwarf"
   kocataninnkeeper_trigger_teach = "teach"
   kocataninnkeeper_trigger_teach_2 = "teach"

   // KocatanLanguageMaster (Quetzal)
   kocatanlanguagemaster_speech_001 = \
      "~kQuetzal says, \"Yokinich would be a giant insect, a giant ant. Add "
      "the word red, and you have kawilkinich, for the mutant red ant.\""
   kocatanlanguagemaster_speech_002 = \
      "~kQuetzal says, \"The bird people are smart enough to form a "
      "semi-coherent language, but that hardly makes them civilized.\""
   kocatanlanguagemaster_speech_003 = \
      "~kQuetzal says, \"I have a few things here I could sell you.\""
   kocatanlanguagemaster_speech_004 = \
      "~kQuetzal says, \"How about dissecting insects. The basic insect is "
      "called a kinich. A little insect, such as a baby spider, would be an "
      "imixkinich.\""
   kocatanlanguagemaster_speech_005 = \
      "~kQuetzal says, \"Greetings, %s, that's an interesting name you have. "
      "What are its origins?\""
   kocatanlanguagemaster_speech_006 = \
      "~kQuetzal says, \"I'm easily the most intelligent person in this "
      "settlement. I know all about Language Structure, History, and "
      "Philosophy. I can even teach simpletons to speak Ko'catanese "
      "fluently.\""
   kocatanlanguagemaster_speech_007 = \
      "~kQuetzal says, \"Kauil means poisonous, so a scorpion is a "
      "kinkauilkinich and a giant spider is a teotkauilkinich. Ants are "
      "similar.\""
   kocatanlanguagemaster_speech_008 = \
      "~kQuetzal snidely remarks, \"Ko'catan literally means 'master "
      "warriors fortification.' It just screams how primitive our society "
      "is. It may as well be called 'dumb bullies' hideout.'\""
   kocatanlanguagemaster_speech_009 = \
      "~kQuetzal says, \"Yeah, Konima was a great warrior who fought the "
      "orcs, but he hardly founded this society. Our language and culture "
      "came out of a lost group of ruffians thirsting for civilization in a "
      "most inhospitable region.\""
   kocatanlanguagemaster_speech_010 = \
      "~kQuetzal says, \"Exactly right, Konima was a great warrior who "
      "fought the orcs.\""
   kocatanlanguagemaster_speech_011 = \
      "~kQuetzal says, \"Do you have any books or scrolls?\""
   kocatanlanguagemaster_speech_012 = \
      "~kQuetzal says, \"Stay here and listen to me. I'll help you learn our "
      "language.\""
   kocatanlanguagemaster_random_001 = \
      "~kQuetzal says, \"Most foreigners can't grasp the simple rules of "
      "pronunciation. For example, take the letter 'X.' A true member of "
      "Ko'catan starts the letter at the back of the throat as if about to "
      "spit. The sound ends up like 'sh' in your word 'wish.'\""
   kocatanlanguagemaster_random_002 = \
      "~kQuetzal says, \"Let me teach you how to properly pronounce our "
      "'O's. Tense your tongue and round your lips in a tight circle. 'O's "
      "are always long and stressed in a word. Such that our 'Ot' sounds "
      "like your 'coat.'\""
   kocatanlanguagemaster_random_003 = \
      "~kQuetzal says, \"Always stress the first syllable in any Ko'catan "
      "word. In addition, put an equal amount of stress on any syllable that "
      "immediately follows an apostrophe. Ko'catan is KO - CAtan.\""
   kocatanlanguagemaster_random_004 = \
      "~kQuetzal says, \"I'm the only one in town who has the skill "
      "necessary to teach language. By all accounts, I should be Quetzal "
      "ko'Atezya.\""
   kocatanlanguagemaster_random_005 = \
      "~kQuetzal says, \"You are pronouncing our 'E' wrong. Make it softer "
      "and bring it to the front of your mouth. We say, 'get,' not 'git,' "
      "'geet' or 'gat.'\""
   kocatanlanguagemaster_random_006 = \
      "~kQuetzal says, \"Our 'A's are almost always soft and long as in "
      "'balm.' Relax your tongue more and widen your lips. That's it.\""
   kocatanlanguagemaster_random_007 = \
      "~kQuetzal says, \"I don't understand most of your people's names. "
      "They don't seem to have very much structure.\""
   kocatanlanguagemaster_random_008 = \
      "~kQuetzal says, \"I also know a bit of Avar speak, but not enough to "
      "properly teach it. If you really want to talk with those creatures, "
      "you should seek Franz zax'Ak.\""
   kocatanlanguagemaster_random_009 = \
      "~kQuetzal says, \"Much of our language is created by a logical "
      "sequence of sounds and meanings. Shall I dissect some words for you?\""
   kocatanlanguagemaster_random_010 = \
      "~kQuetzal says, \"Many of our words have three syllables, like "
      "puucmecmoch. That's a monster that is both plant and animal, by the "
      "way.\""
   kocatanlanguagemaster_random_011 = \
      "~kQuetzal says, \"Kohuzotz live out on the island. Bahal knows more "
      "about them than anyone. Ask him.\""
   kocatanlanguagemaster_trigger_ant = "ant"
   kocatanlanguagemaster_trigger_ant_2 = "ant"
   kocatanlanguagemaster_trigger_avar = "avar"
   kocatanlanguagemaster_trigger_buy = "buy"
   kocatanlanguagemaster_trigger_dissect = "dissect"
   kocatanlanguagemaster_trigger_dissect_2 = "dissect"
   kocatanlanguagemaster_trigger_hello = "hello"
   kocatanlanguagemaster_trigger_help = "help"
   kocatanlanguagemaster_trigger_kinich = "kinich"
   kocatanlanguagemaster_trigger_ko_catan = "ko'catan"
   kocatanlanguagemaster_trigger_konima = "konima"
   kocatanlanguagemaster_trigger_sell = "sell"
   kocatanlanguagemaster_trigger_teach = "teach"
   kocatanlanguagemaster_trigger_teach_2 = "teach"
   kocatanlanguagemaster_trigger_teach_3 = "teach"

   // KocatanMadScientist (Bahal zax'Ot)
   kocatanmadscientist_speech_001 = "~kBahal says, \"Keep your toys.\""
   kocatanmadscientist_speech_002 = \
      "~kBahal says, \"Come back and tell me if you start to feel... odd. I "
      "ask for no reason in particular.\""
   kocatanmadscientist_speech_003 = \
      "~kBahal says, \"Listen closely... ~IMurder~I is the key. Slaughter "
      "opponents of the opposite extreme and your karma will reach the level "
      "you desire.\""
   kocatanmadscientist_speech_004 = \
      "~kBahal says, \"The girl should cook and clean for me, instead of her "
      "father. Why he... \" Bahal stops and then smiles to himself, \"No, I "
      "don't think I will tell you.\""
   kocatanmadscientist_speech_005 = \
      "~kBahal says, \"Good, you are here. Step a little closer. Closer.\""
   kocatanmadscientist_speech_006 = \
      "~kBahal says, \"Hmm, how can I best use you?\""
   kocatanmadscientist_speech_007 = \
      "~kBahal says, \"Help you?! Perhaps we can help each other. Go stand "
      "by the back table and close your eyes.\""
   kocatanmadscientist_speech_008 = \
      "~kBahal says, \"Why should I help ~Iyou~I?\""
   kocatanmadscientist_speech_009 = \
      "~kBahal says, \"Oh, I have plans for Ko'catan.\""
   kocatanmadscientist_speech_010 = \
      "~kBahal says, \"Kohuzotz. Those little dragon critters. Delicious yet "
      "more valuable in other ways.\""
   kocatanmadscientist_speech_011 = \
      "~kBahal says, \"If only those ignorant barbarians knew the true, dark "
      "secrets of their fallen martyr.\""
   kocatanmadscientist_speech_012 = \
      "~kBahal says, \"It took me months to capture a live kriipa. They hide "
      "in the most unusual places.\""
   kocatanmadscientist_speech_013 = \
      "~kBahal says, \"I could teach you so very much. But what is the use, "
      "you would surely go insane. Like the others.\""
   kocatanmadscientist_speech_014 = \
      "~kBahal says, \"You think I have no brain matter?! Keep your long "
      "nose on your face and not in mine.\""
   kocatanmadscientist_speech_015 = \
      "~kBahal says, \"You seek the shadow god? You will not find what you "
      "expect.\""
   kocatanmadscientist_speech_016 = \
      "~kBahal cackles, \"I will say only this, Konima slaughtered more "
      "women than orcs.\""
   kocatanmadscientist_speech_017 = \
      "~kBahal says, \"I'll not slip my tongue and give you reason to incite "
      "another witch hunt after me.\""
   kocatanmadscientist_speech_018 = \
      "~kBahal says, \"You would not want what I have.\""
   kocatanmadscientist_speech_019 = \
      "~kBahal says, \"I could teach you so very much. But what is the use, "
      "you would surely go insane. Like the others.\""
   kocatanmadscientist_speech_020 = \
      "~kBahal says, \"I created them to take care of the problem with the "
      "utom. They are marvellous hunters. Nearly intangible due to the "
      "nether element, yet with the ferocity of a kriipa.\""
   kocatanmadscientist_speech_021 = \
      "~kBahal says, \"Those ugly man-like creatures in the caves that "
      "border Ko'catan.\""
   kocatanmadscientist_speech_022 = \
      "~kBahal says, \"You would not understand.\""
   kocatanmadscientist_speech_023 = "~kBahal says, \"Wulfgang has his uses.\""
   kocatanmadscientist_speech_024 = \
      "~kBahal smirks and writes something down on a small pad and tucks it "
      "back in his apron."
   kocatanmadscientist_random_001 = \
      "~kBahal says, \"I can never seem to get enough Kohuzotz.\""
   kocatanmadscientist_random_002 = \
      "~kBahal says, \"Shall I enlighten you on how to reach the very "
      "extremes of Good and Evil?\""
   kocatanmadscientist_random_003 = \
      "~kBahal says, \"Stick around for a while, I have something I want to "
      "try out on you. It will hurt a little. Well, actually quite a lot.\""
   kocatanmadscientist_random_004 = \
      "~kBahal says, \"How much do you weigh and what exactly have you eaten "
      "today?\""
   kocatanmadscientist_random_005 = \
      "~kBahal carefully measures the cover of an unbound book. He walks up "
      "to you, pokes at your flesh, and then frowns while saying, \"Too "
      "soft.\""
   kocatanmadscientist_random_006 = \
      "~kBahal cleans a small carcass of what you can only assume was a "
      "bird. He discards all but the innards."
   kocatanmadscientist_random_007 = \
      "~kBahal says, \"Where exactly do you come from and when were you "
      "born?\""
   kocatanmadscientist_random_008 = \
      "~kBahal says, \"I need a single drop of salted water. Can you spare a "
      "tear? I can help you to produce one.\""
   kocatanmadscientist_random_009 = \
      "~kBahal pricks you with a long needle, takes a few drops of blood and "
      "adds it to a dark potion."
   kocatanmadscientist_random_010 = \
      "~kBahal says, \"Move a little to your left.\" He then adjusts some "
      "contraption in your direction."
   kocatanmadscientist_random_011 = \
      "~kBahal says, \"Have you seen the Teotkriipa? I am very proud of that "
      "experiment.\""
   kocatanmadscientist_random_012 = \
      "~kBahal says, \"How many people have you killed in your life? You "
      "look like you could be a murderer.\""
   kocatanmadscientist_random_013 = \
      "~kBahal says, \"I need to clean up from my experiment, then I'll be "
      "with you.\""
   kocatanmadscientist_random_014 = \
      "~kBahal quickly eats what looks like a small bug."
   kocatanmadscientist_random_015 = \
      "~kBahal says, \"Do you feel strange?\" Oddly enough, you temporarily "
      "lose your sense of balance."
   kocatanmadscientist_random_016 = \
      "~kBahal points a short twig at you. For a moment, you can't feel your "
      "tongue in your mouth. The feeling passes as he puts away the stick."
   kocatanmadscientist_random_017 = \
      "~kYour vision starts to blur a little. You smell a faint trace of "
      "something similar to vinegar."
   kocatanmadscientist_random_018 = \
      "~kYou suddenly feel your skin tighten on your flesh. Bahal chuckles "
      "to himself as he replaces something small into a dark, wooden box."
   kocatanmadscientist_random_019 = \
      "~kBahal offers you something small in his hand. Before he can give it "
      "to you, he screams, \"~BOw! It bit me!~B\" He then hurriedly rummages "
      "through some boxes and then gulps down a vial of pink fluid."
   kocatanmadscientist_random_020 = "~kBahal says, \"Go away now.\""
   kocatanmadscientist_random_021 = \
      "~kBahal stares at you. You have the uncomfortable feeling that he is "
      "peering into your soul."
   kocatanmadscientist_random_022 = \
      "~kBahal glares at you, \"I am done with you! Leave!\""
   kocatanmadscientist_random_023 = \
      "~kBahal screams, \"~BGet out! You are contaminating my work!~B\""
   kocatanmadscientist_random_024 = \
      "~kBahal gets an insane look in his eyes and begins chasing you around "
      "the hut with a butcher knife. After a few minutes, he shakes his head "
      "and ignores you."
   kocatanmadscientist_random_025 = \
      "~kBahal uncorks a small vial. Within moments, you begin to feel "
      "nauseous. Your body seems to tell you it may be a good idea to get "
      "some fresh air soon."
   kocatanmadscientist_trigger_sell = "sell"
   kocatanmadscientist_trigger_bye = "bye"
   kocatanmadscientist_trigger_enlighten = "enlighten"
   kocatanmadscientist_trigger_enlighten_2 = "enlighten"
   kocatanmadscientist_trigger_hanla = "hanla"
   kocatanmadscientist_trigger_hello = "hello"
   kocatanmadscientist_trigger_help = "help"
   kocatanmadscientist_trigger_ko_catan = "ko'catan"
   kocatanmadscientist_trigger_kohuzotz = "kohuzotz"
   kocatanmadscientist_trigger_dragonfly = "dragonfly"
   kocatanmadscientist_trigger_konima = "konima"
   kocatanmadscientist_trigger_kriipa = "kriipa"
   kocatanmadscientist_trigger_learn = "learn"
   kocatanmadscientist_trigger_plans = "plans"
   kocatanmadscientist_trigger_riija = "riija"
   kocatanmadscientist_trigger_secret = "secret"
   kocatanmadscientist_trigger_secret_2 = "secret"
