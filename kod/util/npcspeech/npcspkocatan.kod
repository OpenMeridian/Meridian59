         [[kocatanbonepriestess_trigger_hello],0,
            [LIBACT_QUOTE_RSC,kocatanbonepriestess_speech_002],2],
         [[kocatanbonepriestess_trigger_help],0,
            [LIBACT_QUOTE_RSC,kocatanbonepriestess_speech_003],3],
         [[kocatanbonepriestess_trigger_riija],LIBRES_MOOD_GOOD,
            [LIBACT_QUOTE_RSC,kocatanbonepriestess_speech_004],4],
         [[kocatanbonepriestess_trigger_riija],LIBRES_MOOD_NOT_GOOD,
