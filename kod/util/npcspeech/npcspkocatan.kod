NpcSpeechKocatan is NpcSpeech
// NPC talk of Ko'catan:
// answers to trigger words and random lines.
// Each line is a resource (EN here, DE in the .lkod); Library adds the
// lists in CreateSpeechLibrary and CreateRandomLibrary.

constants:

   include blakston.khd

resources:

   include npcspkocatan.lkod

   // KocatanApothecary (Zala ix'Mecya)
   kocatanapothecary_speech_001 = \
      "~kZala says, \"That's what we call war. I call it a big waste.\""
   kocatanapothecary_speech_002 = "~kZala says, \"They make me laugh!\""
   kocatanapothecary_speech_003 = "~kZala says, \"Hmmmm...\""
   kocatanapothecary_speech_004 = \
      "~kZala says, \"Are you trying to get me in trouble?\""
   kocatanapothecary_speech_005 = \
      "~kZala says, \"Let's see what you got. I might be interested.\""
   kocatanapothecary_speech_006 = \
      "~kZala says, \"Hey, stop back in sometime, okay?\""
   kocatanapothecary_speech_007 = \
      "~kZala ix'Mecya takes a puff from her pipe and says, \"Hey, welcome "
      "to my shop. Can I get you something?\""
   kocatanapothecary_speech_008 = "~kZala says, \"Hello, %s.\""
   kocatanapothecary_speech_009 = \
      "~kZala ix'Mecya says, \"I run this magic shop. If you are in need of "
      "herbs or reagents for your mystic rituals, I'm the woman to talk to.\""
   kocatanapothecary_speech_010 = "~kZala says, \"I don't get it.\""
   kocatanapothecary_speech_011 = \
      "~kZala says, \"The Huf Huf Moch? Oh, that's the ko'catanese name for "
      "The Barking Monster. Same thing. It's a big bar that the military "
      "keeps, just down the hill.\""
   kocatanapothecary_speech_012 = \
      "~kZala says, \"You should know what the ixleoc is, because it's from "
      "your land. It's that walking dead person thing.\""
   kocatanapothecary_speech_013 = \
      "~kZala says, \"Well that's where you are, man.\""
   kocatanapothecary_speech_014 = \
      "~kZala says, \"That's the guy in charge, you know, called that after "
      "the original guy in charge. It bums me out that they won't even "
      "consider giving a woman that job. Plenty of women around here that "
      "would do it just as well or better than some old a'ach guy.\""
   kocatanapothecary_speech_015 = \
      "~kZala says, \"That's our word for wine. You can get some excellent "
      "pekonch here, but watch out for the cheap stuff.\""
   kocatanapothecary_speech_016 = \
      "~kZala says, \"I've got these clay pots, but they're not for sale. I "
      "use them to store magical reagents.\""
   kocatanapothecary_speech_017 = \
      "~kZala says, \"Sure, I got some stuff to sell.\""
   kocatanapothecary_speech_018 = \
      "~kZala says, \"Don't start. It's a nasty habit.\""
   kocatanapothecary_random_001 = \
      "~kZala sorts through a pile of green herbs. She carelessly tosses the "
      "dead brown ones to the floor."
   kocatanapothecary_random_002 = \
      "~kZala says, \"I hope there are not too many spices in this brew.\""
   kocatanapothecary_random_003 = \
      "~kZala seems to forget you are here and begins to meditate."
   kocatanapothecary_random_004 = \
      "~kZala says, \"My mind remains focused, even in haze. I see the fog "
      "that clouds the transcendent planes.\""
   kocatanapothecary_random_005 = \
      "~kZala says, \"The eggs are fresh today, of course.\""
   kocatanapothecary_random_006 = \
      "~kZala munches on achalot nuts and packs her pipe."
   kocatanapothecary_random_007 = \
      "~kZala hums softly as she works on tying herbs into small bunches."
   kocatanapothecary_random_008 = \
      "~kThere is a thick fertile smell that permeates the shop from the "
      "incense Zala burns."
   kocatanapothecary_random_009 = \
      "~kZala absently says, \"Mastering the art of mind fog.\""
   kocatanapothecary_random_010 = \
      "~kZala says, \"If I were you, I'd stay away from that pekonch that "
      "they serve at the Huf Huf Moch. I never drink it anymore. It'll rot "
      "you from the inside out.\""
   kocatanapothecary_random_011 = \
      "~kZala says, \"If you like feathers, you should see the ones Hanla "
      "uses. Ask to see her arrows if you're out there.\""
   kocatanapothecary_random_012 = \
      "~kZala says, \"Whoa, I forgot you were here. Did I help you yet?\""
   kocatanapothecary_random_013 = \
      "~kZala says, \"You're not from Ko'catan, I can see that now. Can I "
      "ask why you traveled all this way?\""
   kocatanapothecary_random_014 = \
      "~kZala says, \"Riija magic is pretty interesting. I don't know if "
      "you've messed around with it much, but it's best to be careful how "
      "much time you spend at it. People go crazy from Riija, you'll see "
      "them around.\""
   kocatanapothecary_random_015 = "~kZala says, \"That's a fantastic shirt.\""
   kocatanapothecary_random_016 = \
      "~kZala says, \"What's up with the weather? It's been so hard to come "
      "to work lately.\""
   kocatanapothecary_random_017 = \
      "~kZala looks around and says, \"Whoa, check it out.\""
   kocatanapothecary_random_018 = \
      "~kZala coughs loudly, expelling a large cloud of smoke."
   kocatanapothecary_random_019 = \
      "~kZala says, \"The way I see it, the strength of a spell is generally "
      "going to depend on just a couple of factors... and that's pretty much "
      "the duration, your trance time, and the cost in mana. Oh, and did I "
      "say effect powers? Well, the effect powers too.\""
   kocatanapothecary_random_020 = \
      "~kZala says, \"You know, it's not like you can just use any old "
      "reagents to make a spell. They've got to be flawless, or it just "
      "won't work. That especially includes the claws of kriipa, and "
      "dragonfly eyeballs.\""
   kocatanapothecary_random_021 = \
      "~kZala says, \"I feel like a ixleoc. Brain dead, like that.\""
   kocatanapothecary_random_022 = \
      "~kZala says, \"I don't get it. In your Land Across and Beneath the "
      "Water, you have the teotkauilkinich, and you have the little "
      "imixkinich. So hey, man, are they the same thing? Do they both come "
      "from the kokinich mother? Do they hunt from the same web?\""
   kocatanapothecary_random_023 = \
      "~kZala says, \"Kick back if you want; I'm just hanging out.\""
   kocatanapothecary_random_024 = \
      "~kZala says, \"Come by again sometime if you like, you can always "
      "find me here.\""
   kocatanapothecary_trigger_a_ach = "a'ach"
   kocatanapothecary_trigger_army = "army"
   kocatanapothecary_trigger_bong = "bong"
   kocatanapothecary_trigger_bud = "bud"
   kocatanapothecary_trigger_sell = "sell"
   kocatanapothecary_trigger_goodbye = "goodbye"
   kocatanapothecary_trigger_hello = "hello"
   kocatanapothecary_trigger_help = "help"
   kocatanapothecary_trigger_huf_huf_moch = "huf huf moch"
   kocatanapothecary_trigger_ixleoc = "ixleoc"
   kocatanapothecary_trigger_ko_catan = "ko'catan"
   kocatanapothecary_trigger_konima = "konima"
   kocatanapothecary_trigger_pekonch = "pekonch"
   kocatanapothecary_trigger_pot = "pot"
   kocatanapothecary_trigger_pot_2 = "pot"
   kocatanapothecary_trigger_buy = "buy"
   kocatanapothecary_trigger_smoke = "smoke"

   // KocatanBanker (Huital ko'Nosak)
   kocatanbanker_speech_001 = \
      "~kHuital says, \"This island may not have enough room for three "
      "warlike tribes to peacefully coexist. We must be prepared for the "
      "inevitable war for dominance.\""
   kocatanbanker_speech_002 = "~kHuital says, \"~IAgain?!~I\""
   kocatanbanker_speech_003 = \
      "~kHuital says, \"You will find the Neglected Arsenal on the west side "
      "of Ko'catan. Pacal ix'Anoak may wish to buy your wares.\""
   kocatanbanker_speech_004 = \
      "~kHuital says, \"Good day to you. Your valuables will be safe with "
      "us.\""
   kocatanbanker_speech_005 = \
      "~kHuital ko'Nosak says, \"Welcome traveler. How can I or my brother, "
      "Itzal, help you today?\""
   kocatanbanker_speech_006 = \
      "~kHuital says, \"My brother Itzal can safely store a number of your "
      "items. I manage the bank. I have provided signs to explain how to use "
      "our establishment.\""
   kocatanbanker_speech_007 = \
      "~kHuital says, \"We are fortunate to be part of such an advanced "
      "society here. You must be impressed.\" Itzal rolls his eyes and "
      "grunts."
   kocatanbanker_speech_008 = \
      "~kHuital says, \"Hail to Konima. May his legend live on.\""
   kocatanbanker_speech_009 = \
      "~kHuital says, \"Beware of the power of Riija. Many say it is mere "
      "trickery, but in diabolical hands, great wrongs can be done.\""
   kocatanbanker_speech_010 = \
      "~kHuital says, \"You are mistaken, we are not merchants.\""
   kocatanbanker_speech_011 = \
      "~kHuital says, \"I have already taken on my fill of apprentices for "
      "this season.\""
   kocatanbanker_random_001 = \
      "~kHuital says, \"We have not yet set up an official trade route with "
      "the old world. Money and items you store here can not be accessed in "
      "your home land.\""
   kocatanbanker_random_002 = \
      "~kHuital rinses his hands off in the pool of water before beginning "
      "the next transaction."
   kocatanbanker_random_003 = \
      "~kHuital says, \"I am not yet certain of the ramifications of the "
      "influx of old world traders. I'm keeping a close eye on the moneys in "
      "my bank though. I do not want to see Ko'catan enter an age of "
      "inflation.\""
   kocatanbanker_random_004 = \
      "~kHuital says, \"We had little need of a monetary system before the "
      "foreigners arrived. Most people bartered and worked for their needs.\""
   kocatanbanker_random_005 = \
      "~kHuital says, \"Where do you accumulate all of this wealth?\""
   kocatanbanker_random_006 = \
      "~kHuital says, \"Honestly Itzal, you need to work on your posture.\""
   kocatanbanker_random_007 = \
      "~kHuital says, \"~BItzal!~B ~IWake up, we have customers here.~I\""
   kocatanbanker_random_008 = \
      "~kHuital says, \"You are a bit overdressed for our hot climate.\""
   kocatanbanker_random_009 = \
      "~kHuital waves his hand at the water pedestal and says, \"Please, it "
      "is our custom to wash our hands before doing business to represent a "
      "clean deal.\""
   kocatanbanker_random_010 = \
      "~kHuital says, \"Itzal, you desperately need to organize your vault. "
      "The customers have been more than patient waiting for you to find "
      "their valuables.\""
   kocatanbanker_random_011 = \
      "~kHuital says, \"You may want to leave your money and many of your "
      "items here before you go off into the jungle. It can be fairly "
      "dangerous this time of year.\""
   kocatanbanker_random_012 = \
      "~kHuital smiles at you and says, \"It is refreshing to see your "
      "people in our land.\""
   kocatanbanker_random_013 = "~kHuital says, \"It is good to see you, %s.\""
   kocatanbanker_random_014 = \
      "~kHuital smiles, seeming content with the day's events."
   kocatanbanker_random_015 = \
      "~kHuital frowns while looking over a tablet. He says, \"I'm worried "
      "that these shillings you import could disrupt our economy.\""
   kocatanbanker_random_016 = \
      "~kHuital says to you, \"Where did your people learn social graces? "
      "Rather, when ~Iwill~I they?!\""
   kocatanbanker_trigger_avar = "avar"
   kocatanbanker_trigger_broke = "broke"
   kocatanbanker_trigger_sell = "sell"
   kocatanbanker_trigger_bye = "bye"
   kocatanbanker_trigger_hello = "hello"
   kocatanbanker_trigger_help = "help"
   kocatanbanker_trigger_ko_catan = "ko'catan"
   kocatanbanker_trigger_konima = "konima"
   kocatanbanker_trigger_riija = "riija"
   kocatanbanker_trigger_buy = "buy"
   kocatanbanker_trigger_teach = "teach"
   kocatanbanker_trigger_teach_2 = "teach"

   // KocatanBartender (Oxal ix'Tokak)
   kocatanbartender_speech_001 = \
      "~kOxal says, \"The A'ach tezcha is our Military Directorate, like a "
      "governing body that looks over every aspect of life in Ko'catan.\""
   kocatanbartender_speech_002 = \
      "~kOxal says, \"They are a worthy and honorable foe, although their "
      "ultimate aim is our demise.\""
   kocatanbartender_speech_003 = \
      "~kOxal says, \"It is said that there were two tribes of those bird "
      "men. That is talk for diplomats, cha'ya, and old merchants past "
      "closing time. That is not talk for Ix'ca. To Ix'ca there is only one "
      "kind of avar, and that is avar'ot.\""
   kocatanbartender_speech_004 = "~kOxal ix'Tokak glares at you savagely."
   kocatanbartender_speech_005 = \
      "~kOxal says, \"Balo na'te Din was the battle where I was wounded, a "
      "very fierce battle over the course of three days. Many died at Balo "
      "na'te Din.\""
   kocatanbartender_speech_006 = \
      "~kOxal says, \"I am not permitted to talk about that with you. Don't "
      "ask.\""
   kocatanbartender_speech_007 = \
      "~kOxal says, \"Show me what you have to offer.\""
   kocatanbartender_speech_008 = "~kOxal says, \"Hail, Zax'ca.\""
   kocatanbartender_speech_009 = \
      "~kOxal ix'Tokak looks you over with a disapproving glare and says, "
      "\"What do you want?\""
   kocatanbartender_speech_010 = \
      "~kOxal ix'Tokak says, \"I am here to serve as a bartender. That is "
      "all. Do you want a drink or not?\""
   kocatanbartender_speech_011 = \
      "~kOxal says, \"Hu a'ach is an old saying in the Ko'catani which means "
      "'savage war'. Hu is something fierce, or uncontrolled, and a'ach "
      "means war, or literally 'smashing forces'.\""
   kocatanbartender_speech_012 = \
      "~kOxal says, \"I am not certain what the precise translation of that "
      "would be, exactly.\""
   kocatanbartender_speech_013 = \
      "~kOxal says, \"Kici'ca.. . that means Legion.\""
   kocatanbartender_speech_014 = \
      "~kOxal says, \"In your language this is the Barking Monster. It is "
      "the name of this hall.\""
   kocatanbartender_speech_015 = \
      "~kOxal says, \"Ko'catan is the name of this settlement. It means "
      "something like Great City.\""
   kocatanbartender_speech_016 = \
      "~kOxal says, \"Konima is the Great Warlord that led our people to "
      "this place in the face of a long battle against the Utom. Since that "
      "time, each Warlord that has followed has assumed the title of Konima. "
      "Our current leader is the fierce Katalin waz Konima, or Sixth "
      "Warlord.\""
   kocatanbartender_speech_017 = "~kOxal says, \"Drink to Konima!\""
   kocatanbartender_speech_018 = \
      "~kOxal says, \"How dare you befoul that name with your lazy tongue. "
      "You must leave immediately.\""
   kocatanbartender_speech_019 = \
      "~kOxal says, \"Pekonch is wine. A good warrior will draw much "
      "strength from its consumption.\""
   kocatanbartender_speech_020 = \
      "~kOxal says, \"That means... uh, something like ugly cow.\""
   kocatanbartender_speech_021 = \
      "~kOxal looks at you as though he was looking at something pathetic."
   kocatanbartender_speech_022 = \
      "~kOxal says, \"I sell pekonch, atz pekonch, and if you want to order "
      "get in line.\""
   kocatanbartender_speech_023 = \
      "~kOxal says, \"I might have something you are interested in.\""
   kocatanbartender_speech_024 = \
      "~kThe room goes silent as %s mentions stunted dwarf."
   kocatanbartender_speech_025 = "~kOxal says, \"Zala is puuc nahyijoa.\""
   kocatanbartender_speech_026 = \
      "~kOxal says, \"Zala ix'Mecya has a shop on up towards the wall. She "
      "sells herbs and things for making magic. I don't trust anyone who "
      "makes their living from wizardry and nonsense hocus pocus.\""
   kocatanbartender_speech_027 = \
      "~kOxal says, \"Zax'ca means literally 'foreign warrior'. It is not "
      "meant to be impolite.\""
   kocatanbartender_random_001 = \
      "~kOxal says, \"Try a cup of our pekonch. It is what we call "
      "'atz'pekonch', or in your language 'mythical wine.' It is the highest "
      "standard of pekonch, produced specifically for the Lal a'ach.\""
   kocatanbartender_random_002 = \
      "~kOxal says, \"If I were in charge of the Kici'ca, we'd be taking the "
      "fight to the Avar! Hu a'ach!\""
   kocatanbartender_random_003 = \
      "~kOxal says, \"Be fair warned, death awaits those who go into the "
      "jungle unprepared. It might take your arm and leave you a half "
      "soldier, as it has with me.\""
   kocatanbartender_random_004 = \
      "~kOxal says, \"I left the Kici'ca when my arm was separated from me.\""
   kocatanbartender_random_005 = \
      "~kOxal says, \"I wish sometimes that things had turned out "
      "differently, but there isn't much room for mistakes in the life of an "
      "Iz'ca. I have been cursed with bad luck.\""
   kocatanbartender_random_006 = \
      "~kOxal says, \"In this society, the only excuse that you have for not "
      "being a warrior is to be a dead warrior. Perhaps I would have been "
      "more fortunate if I had had my head chopped off by that Avar hatchet "
      "rather than my arm. I am but half a warrior.\""
   kocatanbartender_random_007 = \
      "~kOxal says, \"I've got plenty to say about the way things are run "
      "around here, but talking about change in Ko'catan will get you "
      "trouble.\""
   kocatanbartender_random_008 = \
      "~kOxal says, \"I still have the instincts and discipline of a "
      "tez'ca.\""
   kocatanbartender_random_009 = \
      "~kOxal says, \"In my dreams now, sometimes late at night I can still "
      "feel my hand, the one that the Avar'ot destroyed so many years ago. "
      "It is a strange feeling, liberating even though I know all the time "
      "that it is gone. But enough about that, we could both be imprisoned "
      "for talking about this.\""
   kocatanbartender_random_010 = \
      "~kOxal says, \"It isn't easy to be a half-soldier in our society, I "
      "have to work twice as hard to fulfill my duty. Without duty a soldier "
      "is worthless, and a worthless soldier... well, the jungle is full of "
      "shallow holes we dug to put worthless soldiers in.\""
   kocatanbartender_random_011 = \
      "~kOxal says, \"Feel comfortable in the Huf Huf Moch, warrior. It is "
      "your right, earned through blood and honor.\""
   kocatanbartender_random_012 = \
      "~kOxal says, \"Welcome to the Huf Huf Moch, Zax'ta. It is an honor of "
      "my duties to preside here, and if I can to serve you.\""
   kocatanbartender_random_013 = \
      "~kOxal says, \"If you come from the family that I came from, there "
      "isn't much choice in it at all. You will end up soldiering, and you "
      "just better hope your luck holds up.\""
   kocatanbartender_random_014 = \
      "~kOxal says, \"After I was wounded at Balo na'te Din the War "
      "Directorate assigned me to working here at the Huf Huf Moch, on "
      "account of my record with the Katalin waz Lal'ca. It is a great honor "
      "for a wounded veteran to be assigned here, so close to the Army after "
      "he has become useless to war.\""
   kocatanbartender_random_015 = \
      "~kOxal says, \"Have you heard of Xacal ko'Ixca? He is the commanding "
      "officer of my combat unit, Katalin waz Lal'ca. Although I am no "
      "longer on the active roster for my unit, I hold Captain ko'Ixca in "
      "the highest regard and honor. Drink to Captain ko'Ixca!!\""
   kocatanbartender_random_016 = \
      "~kOxal says, \"I understand that in the land across and beneath the "
      "water you have many cities as large as Ko'catan and enemies abound, "
      "and yet there is no zax'Kicica... that you have no army! How can that "
      "be?\""
   kocatanbartender_random_017 = \
      "~kOxal says, \"The mural up there tells the story from the time of "
      "the Waz Waz Konima, our Second Warlord, and The Two-Front War. It was "
      "a dark hour when we nearly lost all to the combined Avar'ot Kici'ca, "
      "one hundred and fifty-six years before this year. The valor of our "
      "atz Kici'ca was tremendous, and we were saved!\""
   kocatanbartender_random_018 = \
      "~kOxal says, \"When I was with Katalin waz Lal'ca years ago as a "
      "Iz'ca before Balo na'te Din, we were on patrol when we came across a "
      "remote and fortified trading post far from here in the jungle. A "
      "fantastic place to behold. My unit had secretly surrounded the fort "
      "and we were preparing to storm it when a message came from Captain "
      "ko'Ixca that we were to let the fort be. I heard later that it was a "
      "Zax'at that runs this place, one of yours.\""
   kocatanbartender_random_019 = \
      "~kOxal says, \"Be careful of the exzor ferns out in the jungle. "
      "They'll cut right through your trousers and your boots.\""
   kocatanbartender_random_020 = \
      "~kOxal says, \"This settlement would have been annihilated long ago "
      "if it were not for our strong emphasis on military and fortification. "
      "The rules from the A'ach tezcha may not give us the ideal life here, "
      "but we are alive at least.\""
   kocatanbartender_random_021 = \
      "~kOxal says, \"The pekonch from our casks builds the strength "
      "necessary to victory in war and battle.\""
   kocatanbartender_random_022 = \
      "~kOxal says, \"Welcome, Zax'ta. I am Oxal ix'Tokak, honored by the "
      "A'ach tezcha to serve here. What is your bidding?\""
   kocatanbartender_random_023 = "~kOxal says, \"Can I help you, Zax'ta?\""
   kocatanbartender_random_024 = \
      "~kOxal deftly cleans up behind the bar, working at a fluid pace."
   kocatanbartender_random_025 = \
      "~kOxal says, \"I have a duty here, to run Huf Huf Moch as efficiently "
      "as any unit in the Kici'ca fulfills its duties. I take my orders very "
      "seriously.\""
   kocatanbartender_random_026 = \
      "~kOxal says, \"If not for the bad luck of losing my arm at Balo na'te "
      "Din, I would have been a ranking officer by now.\""
   kocatanbartender_random_027 = \
      "~kOxal carefully wipes a glass with a colorfully printed towel."
   kocatanbartender_random_028 = \
      "~kOxal says, \"It has taken us years to eradicate the napyijoa from "
      "Ko'catan, but I understand that even the sewers have no trace of the "
      "vermin. That is how efficient is our A'ach tezcha.\""
   kocatanbartender_random_029 = \
      "~kOxal says, \"My opinion is that the Ix'ca spend far too much time "
      "in here during the day. If I were the ranking officer or the Captain "
      "of the Day Guard I would keep all the soldiers so busy that they "
      "wouldn't have time to drink wine.\""
   kocatanbartender_random_030 = \
      "~kOxal says, \"If this military isn't vigilant, those Avar'ot would "
      "mount an attack and ravage Ko'catan. We are that close to extinction "
      "here.\""
   kocatanbartender_random_031 = \
      "~kOxal says, \"This hall has been here for almost two hundred years. "
      "It was set up by the Kici'ca, and it is here even now mostly for the "
      "Kici'ca. You are here as a guest of the Ko'catani Kici'ca. \""
   kocatanbartender_random_032 = \
      "~kOxal says, \"I have seen a stranger in here from the Land Across "
      "and Under the Water, with a curious half sword. What a weapon! "
      "Perfect for one as myself!\""
   kocatanbartender_random_033 = \
      "~kOxal says, \"If you encounter the avar'ca in the jungle, be most "
      "careful. They will attack in waves, with the wounded falling back to "
      "heal and rally, and then rejoining the fray.\""
   kocatanbartender_random_034 = \
      "~kOxal says, \"The stronger a warrior's arms and armor, the better "
      "their ability to resist a magical attack. We learned this early on in "
      "the a'ach kici'ca, and it will serve you as well. Always take care of "
      "your equipment.\""
   kocatanbartender_random_035 = \
      "~kOxal says, \"I have heard that in your Land Across and Beneath the "
      "Water, you have spirited trees! These tezmecya must make your jungles "
      "very difficult to maneuver indeed.\""
   kocatanbartender_random_036 = \
      "~kOxal says, \"You aren't one of those spell casting imbeciles, are "
      "you? I cannot trust ritual witches, like Zala and her lot.\""
   kocatanbartender_random_037 = \
      "~kOxal says, \"Are you going to buy a drink or just stand there with "
      "your mouth open?\""
   kocatanbartender_random_038 = \
      "~kOxal says, \"Impetuous Zax'ot, laggardly Zax'met, disgusting "
      "Zax'chot, you have the gall to visit the homeland of another and "
      "desecrate all that is honorable there with your presence? I will "
      "waste no more time on you.\""
   kocatanbartender_random_039 = \
      "~kOxal says, \"Hey you! You there, from the land of the Nap'ca, whose "
      "idiot are you anyway? You who bubbles from the nearest sewer, take "
      "yourself away from Honorable warriors, Atz yo'Chot.\""
   kocatanbartender_random_040 = "~kOxal watches you suspiciously."
   kocatanbartender_random_041 = \
      "~kOxal says, \"I believe that you are dangerous, and it is my duty to "
      "report your presence to the War Directorate, to the A'ach Tez'cha. "
      "That is not a warning, but a statement of fact.\""
   kocatanbartender_random_042 = \
      "~kOxal says, \"This place, the Huf Huf Moch, was set up by the War "
      "Directorate to serve warriors and soldiers that have honored "
      "themselves and the descendants of Konima. Since you are not by any "
      "consideration an honorable warrior, you should remove yourself from "
      "here.\""
   kocatanbartender_random_043 = \
      "~kOxal says, \"Don't get tough with me, kinich. I will smash you with "
      "the arm that still functions.\""
   kocatanbartender_random_044 = \
      "~kOxal says, \"You will be very sorry if you create trouble in this "
      "place. Very, very sorry.\""
   kocatanbartender_random_045 = \
      "~kOxal somehow manages to act professional as he ignores you entirely."
   kocatanbartender_trigger_a_ach_tezcha = "a'ach tezcha"
   kocatanbartender_trigger_avar = "avar"
   kocatanbartender_trigger_balo_na_te_din = "balo na'te din"
   kocatanbartender_trigger_sell = "sell"
   kocatanbartender_trigger_hello = "hello"
   kocatanbartender_trigger_help = "help"
   kocatanbartender_trigger_hu_a_ach = "hu a'ach"
   kocatanbartender_trigger_huf_huf_moch = "huf huf moch"
   kocatanbartender_trigger_ko_catan = "ko'catan"
   kocatanbartender_trigger_konima = "konima"
   kocatanbartender_trigger_pekonch = "pekonch"
   kocatanbartender_trigger_puuc_nahyijoa = "puuc nahyijoa"
   kocatanbartender_trigger_buy = "buy"
