            [LIBACT_QUOTE_RSC,kocatanbartender_speech_024,[LIBPLUG_NAME]],24],
         [[kocatanbartender_trigger_zala],LIBRES_MOOD_NOT_GOOD,
            [LIBACT_QUOTE_RSC,kocatanbartender_speech_025],25],
         [[kocatanbartender_trigger_zala],LIBRES_MOOD_NOT_BAD,
            [LIBACT_QUOTE_RSC,kocatanbartender_speech_026],26],
         [[kocatanbartender_trigger_zax_ca],LIBRES_MOOD_NOT_BAD,
            [LIBACT_QUOTE_RSC,kocatanbartender_speech_027],27]
      ]],lLib);

      lLib = Cons([&KocatanBlacksmith,[
         [[kocatanblacksmith_trigger_sell],0,
            [LIBACT_QUOTE_RSC,kocatanblacksmith_speech_001],1],
         [[kocatanblacksmith_trigger_goodbye,
            kocatanblacksmith_trigger_goodbye_2],LIBRES_MOOD_GOOD,
            [LIBACT_QUOTE_RSC,kocatanblacksmith_speech_002],2],
         [[kocatanblacksmith_trigger_goodbye,
            kocatanblacksmith_trigger_goodbye_2],LIBRES_MOOD_NEUTRAL,
            [LIBACT_QUOTE_RSC,kocatanblacksmith_speech_003],3],
         [[kocatanblacksmith_trigger_goodbye,
            kocatanblacksmith_trigger_goodbye_2],LIBRES_MOOD_BAD,
            [LIBACT_QUOTE_RSC,kocatanblacksmith_speech_004],4],
         [[kocatanblacksmith_trigger_hello],0,
            [LIBACT_QUOTE_RSC,kocatanblacksmith_speech_005],5],
         [[kocatanblacksmith_trigger_hello],LIBRES_MOOD_GOOD,
            [LIBACT_QUOTE_RSC,kocatanblacksmith_speech_006],6],
