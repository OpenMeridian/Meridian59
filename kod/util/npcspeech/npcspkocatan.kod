   kocatanmadscientist_trigger_yes_2 = "yes"

   // KocatanShopkeeper (KocatanShopkeeper)
   kocatanshopkeeper_speech_001 = "~kPacal says, \"I love business!\""
   kocatanshopkeeper_speech_002 = \
      "~kPacal says, \"I'll buy all sorts of things.\""
   kocatanshopkeeper_speech_003 = "~kPacal says, \"Goodbye now.\""
   kocatanshopkeeper_speech_004 = "~kPacal says, \"Hi. Come on in.\""
   kocatanshopkeeper_speech_005 = "~kPacal says, \"I am here to serve you.\""
   kocatanshopkeeper_speech_006 = \
      "~kPacal says, \"Ko'catan is the city that Konima founded here where "
      "he came to die. The city has grown considerably, but we still call it "
      "by the same name.\""
   kocatanshopkeeper_speech_007 = \
      "~kPacal says, \"That is the military leader here. A very powerful "
      "man. He takes his title straight from the original warlord who led "
      "our people here.\""
   kocatanshopkeeper_speech_008 = \
      "~kPacal says, \"Everything here is for sale.\""
   kocatanshopkeeper_random_001 = \
      "~kPacal says, \"Sometimes it's best to ask me if you're looking for a "
      "particular item. My filing system is... unique, and I'm afraid a bit "
      "confusing.\""
   kocatanshopkeeper_random_002 = \
      "~kPacal says, \"This building served as the arsenal for the kici'ca "
      "for many years, for at that time it was strategically placed near the "
      "entrance to the Utom warrens. With time though, those were sealed up "
      "and now we seldom dwell upon the threat that lives down there.\""
   kocatanshopkeeper_random_003 = \
      "~kPacal says, \"It is quite remarkable that you were able to make it "
      "here at all from the land across and beneath the water.\""
   kocatanshopkeeper_random_004 = \
      "~kPacal says, \"I was in the kici'ca, but not as a soldier. I served "
      "my duty as a quartermaster.\""
   kocatanshopkeeper_random_005 = \
      "~kPacal says, \"I suppose you might say I'm as much a collector as I "
      "am a merchant. That is how I am known here in any case, which is why "
      "the last sound on my name, Pacal ix'Anoak is the 'ak' sound. That "
      "means I am a merchant.\""
   kocatanshopkeeper_random_006 = \
      "~kPacal says, \"This building, being an old military building, has "
      "some singular features in its design.\""
   kocatanshopkeeper_random_007 = \
      "~kPacal says, \"Just let me know if there's anything I can help you "
      "find.\""
   kocatanshopkeeper_random_008 = "~kThe old armory is very cool inside."
   kocatanshopkeeper_random_009 = \
      "~kPacal says, \"The prices are ~Inot~I negotiable.\""
   kocatanshopkeeper_random_010 = "~kPacal says, \"Hmmm... \""
   kocatanshopkeeper_random_011 = \
      "~kPacal says, \"I love my stuff. You might be surprised at some of "
      "the items that I have.\""
   kocatanshopkeeper_random_012 = "~kPacal says, \"Watch your step!\""
   kocatanshopkeeper_random_013 = \
      "~kPacal says, \"I have heard that in your land you wrap the dead in "
      "rags, and then they rise to become napleoc and plague the land! Could "
      "this be true? Are you that stupid, zax'nap?\""
   kocatanshopkeeper_random_014 = \
      "~kPacal says, \"Tezotz make your sewers much more perilous to travel "
      "than our own, I think... in this city, sewer travel may not be the "
      "most ~Iglamorous~I way to get around, but it can be expedient if the "
      "occasion necessitates.\""
   kocatanshopkeeper_trigger_business = "business"
   kocatanshopkeeper_trigger_sell = "sell"
   kocatanshopkeeper_trigger_goodbye = "goodbye"
   kocatanshopkeeper_trigger_goodbye_2 = "goodbye"
   kocatanshopkeeper_trigger_hello = "hello"
   kocatanshopkeeper_trigger_help = "help"
   kocatanshopkeeper_trigger_ko_catan = "ko'catan"
   kocatanshopkeeper_trigger_konima = "konima"
   kocatanshopkeeper_trigger_buy = "buy"

   // KocatanTailor (Tepal ix'Zonak)
   kocatantailor_speech_001 = \
      "~kTepal says, \"I hear the Avar have a peculiar interest in precious "
      "stones.\""
   kocatantailor_speech_002 = \
      "~kTepal says, \"Well, um, what do you have I guess?\""
   kocatantailor_speech_003 = \
      "~kTepal says, \"Goodbye, until the next time we meet.\""
   kocatantailor_speech_004 = "~kTepal says, \"Uh, hello %s.\""
   kocatantailor_speech_005 = \
      "~kTepal says, \"You're in the Tailor's Shop. Ko'catan. What, um, what "
      "do you need?\""
   kocatantailor_speech_006 = \
      "~kTepal says, \"Ko'catan is the name of this city. In our language "
      "this is, um, this is how it works. Tan is the word for fortress. So "
      "we are here in, um, in a tan. But what tan? Ko is the word for "
      "greatest, or master, ca is the modifier for warrior. So Ko'ca is "
      "master warrior, and Ko'catan is the master warrior's fortress. You "
      "see?\""
   kocatantailor_speech_007 = "~kTepal says, \"Are you here to do business?\""
   kocatantailor_speech_008 = \
      "~kTepal says, \"Konima is the father of corruption and force. He "
      "started all of this.\""
   kocatantailor_speech_009 = \
      "~kTepal says, \"What do you, um, what do you want to know?\""
   kocatantailor_speech_010 = \
      "~kTepal says, \"There is a real market for precious stones. Someone "
      "willing to take a couple chances could make a good deal of money. I "
      "happen to know a little about it.\""
   kocatantailor_speech_011 = \
      "~kTepal says, \"The true follower of Riija will know that the spell "
      "strength depends upon the moon phase. The higher the moon, the more "
      "powerful will be His spells.\""
   kocatantailor_speech_012 = \
      "~kTepal says, \"I, um, sell mostly clothing. Is that what you mean?\""
   kocatantailor_speech_013 = \
      "~kTepal says, \"Wulfgang and I share a common interest in precious "
      "stones.\""
   kocatantailor_random_001 = \
      "~kTepal says, \"Can I help you find something, um, something in "
      "particular?\""
   kocatantailor_random_002 = \
      "~kTepal says, \"I have some beautiful cloth to work with just now. "
      "Our cloth makers are making the most of all the new dyes and "
      "materials that are trickling in from the mainland.\""
   kocatantailor_random_003 = \
      "~kTepal says, \"I think my robes are becoming a popular item back on "
      "the land across and beneath the water, where you come from. People "
      "are buying them to take, um, take back home with them. Business has "
      "never been better.\""
   kocatantailor_random_004 = \
      "~kTepal says, \"You look like about size katalin. Maybe a size "
      "katalin waz, but more on the katalin side of katalin waz.\""
   kocatantailor_random_005 = "~kTepal watches you pleasantly. Sizing you up."
   kocatantailor_random_006 = \
      "~kYou feel a cool draft from the back of the shop."
   kocatantailor_random_007 = \
      "~kTepal twitches a bit. He seems... uncomfortable."
   kocatantailor_random_008 = "~kTepal fidgets nervously."
   kocatantailor_trigger_avar = "avar"
   kocatantailor_trigger_sell = "sell"
   kocatantailor_trigger_goodbye = "goodbye"
   kocatantailor_trigger_goodbye_2 = "goodbye"
   kocatantailor_trigger_hello = "hello"
   kocatantailor_trigger_help = "help"
   kocatantailor_trigger_ko_catan = "ko'catan"
   kocatantailor_trigger_konima = "konima"
   kocatantailor_trigger_precious_stones = "precious stones"
   kocatantailor_trigger_precious_stones_2 = "precious stones"
   kocatantailor_trigger_precious_stones_3 = "precious stones"
   kocatantailor_trigger_riija = "riija"
   kocatantailor_trigger_buy = "buy"
   kocatantailor_trigger_wulfgang = "wulfgang"

   // kocatanTradeMaster (kocatanTradeMaster)
   kocatantrademaster_speech_001 = \
      "~kWulfgang says, \"A'ach kici'ca is the Ko'catani name for their "
      "army, or war legion, whatever.\""
   kocatantrademaster_speech_002 = \
      "~kWulfgang says, \"What, you haven't seen them yet?\""
   kocatantrademaster_speech_003 = \
      "~kWulfgang says, \"You have heard of this battle, have you? I was a "
      "scout there, for the a'ach kici'ca. You cannot imagine, unless you "
      "were there, zax'ta. Three days of slaughter, and at the end we left "
      "with half the men we went in with. All for a square of jungle that "
      "you couldn't even plant a decent crop of brown corn on.\""
   kocatantrademaster_speech_004 = \
      "~kWulfgang says, \"What do you have to offer?\""
   kocatantrademaster_speech_005 = \
      "~kWulfgang says, \"You ask for entroot berries?  Take them, it's just "
      "a bitter reminder of what I have left behind.\""
   kocatantrademaster_speech_006 = \
      "~kWulfgang says, \"I have been working on making a game that is quite "
      "popular here in Ko'catan.\""
   kocatantrademaster_speech_007 = \
      "~kWulfgang says, \"Hail, traveler! What news is from abroad?\""
   kocatantrademaster_speech_008 = "~kWulfgang says, \"Greetings, stranger.\""
   kocatantrademaster_speech_009 = "~kWulfgang says, \"Get lost.\""
   kocatantrademaster_speech_010 = \
      "~kWulfgang says, \"What? I don't think I can help you. You got "
      "yourself here, didn't you?\""
   kocatantrademaster_speech_011 = \
      "~kWulfgang says, \"I'm not looking for anything now.\""
   kocatantrademaster_speech_012 = \
      "~kWulfgang says, \"The Meridian language is ugly compared to the "
      "language of Ko'catan. In Meridian we say ant, they say ~Iyokinich~I. "
      "We say mutant ant, ugh, and they say ~Ikawilkinich~I. Beautiful, "
      "isn't it? Odd that such a blunt, war-like people would have such a "
      "beautiful way with words.\""
   kocatantrademaster_speech_013 = \
      "~kWulfgang says, \"Marion was home to me for twenty years, and my "
      "heart of hearts is back there as we speak. But I will never return.\""
   kocatantrademaster_speech_014 = "~kWulfgang says, \"Marion who?\""
   kocatantrademaster_speech_015 = \
      "~kWulfgang says, \"The Avars have a source of mana power.  If you "
      "want it, you should offer gifts of food to their gods.\""
   kocatantrademaster_speech_016 = \
      "~kWulfgang says, \"Are you here to murder Avars to take their power, "
      "too?\""
   kocatantrademaster_speech_017 = \
      "~kWulfgang says, \"Any 'precious stones' that you can carry from "
      "Tepal to here would be very much worth your while, I can assure you.\""
   kocatantrademaster_speech_018 = \
      "~kWulfgang says, \"I was once a follower of Qor, but that was many "
      "moons ago. I now make a living trading to the natives.\""
   kocatantrademaster_speech_019 = \
      "~kWulfgang says, \"I do not speak of that time in my life.  Let me "
      "say that the trickster god has shown me the true path.\""
   kocatantrademaster_speech_020 = \
      "~kWulfgang says, \"I played lock for Marion, for many years. I'm "
      "trying to get a team started with the Avar now.\""
   kocatantrademaster_speech_021 = \
      "~kWulfgang says, \"It all depends on what you're looking for.\""
   kocatantrademaster_speech_022 = \
      "~kWulfgang says, \"Tepal? So you've come from sanctuary then? What do "
      "you have for me, zax'ta?\""
   kocatantrademaster_speech_023 = \
      "~kWulfgang says, \"Tos was where I went into hiding when the Kraanan "
      "fanatics came for my life. I couldn't stay in Marion, it was too "
      "dangerous. Tos is a cold city when you are in trouble, I'll never "
      "forget that.\""
   kocatantrademaster_speech_024 = \
      "~kWulfgang says, \"I don't know what you're talking about.\""
   kocatantrademaster_speech_025 = \
      "~kWulfgang says, \"You want fairy wings?  You can have them, I have "
      "no use for that anymore.\""
   kocatantrademaster_random_001 = \
      "~kWulfgang says, \"The next time you are back in Marion, say hello to "
      "Tova for me, would you?\""
   kocatantrademaster_random_002 = \
      "~kWulfgang says, \"I know Meridian. I should, I lived there for "
      "twenty-five years before I was exiled to this place.\""
   kocatantrademaster_random_003 = \
      "~kWulfgang says, \"If you are able to get raw neurodite from the city "
      "to me, I will pay you well. I have many ~Icustomers~I for neurodite. "
      "It is a profitable trade for everyone with these embargoes in "
      "effect.\""
   kocatantrademaster_random_004 = \
      "~kWulfgang says, \"The new followers of Riija that will make their "
      "way back to the mainland must be very careful, for Riija has many "
      "enemies among the other gods. It is believed that Duke Akardius "
      "follows Riija.\""
   kocatantrademaster_random_005 = \
      "~kWulfgang says, \"I am the last of my people, the Riija followers "
      "from the underground sect on the mainland. Where you come from, and "
      "whence I came some years ago.\""
   kocatantrademaster_random_006 = \
      "~kWulfgang says, \"The followers of Riija were an underground "
      "movement in all of the parts of Meridian that survived despite great "
      "hardship for many, many years. Eventually the followers of Kraanan "
      "declared a secret war upon us, a war of annihilation. When the time "
      "came that I was the only survivor, I fled and came to this place. I "
      "have been here since.\""
   kocatantrademaster_random_007 = \
      "~kWulfgang says, \"When the followers of Kraanan came with blades for "
      "my people, it was with the blessing of Zarcos IV, the King then. When "
      "his son Zarcos V took over, he put a stop to it and although we lived "
      "as outlaws, the few that survived the previous years didn't have to "
      "live in fear of the butchers of Kraanan. But when Zarcos V abdicated, "
      "Duke Kalior renewed enthusiasm for the destruction of Riija followers "
      "entirely from the mainland. I am the only survivor now. My magic has "
      "kept me alive.\""
   kocatantrademaster_random_008 = \
      "~kWulfgang says, \"You didn't happen to bring any neurodite with you, "
      "did you?\""
   kocatantrademaster_random_009 = \
      "~kWulfgang says, \"You'll never guess how I finally got here from the "
      "mainland. I meditated for three days and fasted for three days and "
      "then I made a big wish and I blinked. That's right I blinked! The "
      "spell, blink, I blinked from the fountain in Tos and I got nauseous "
      "and when I came to I was in the jungle here!! Sometimes the most "
      "unassuming weapon in your arsenal can save you where the battering "
      "ram will fail.\""
   kocatantrademaster_random_010 = \
      "~kWulfgang says, \"Drink to the good life, my friends. Drink to those "
      "that cannot be here with us to drink.\""
   kocatantrademaster_random_011 = \
      "~kWulfgang says, \"The next time you're in the Limping Toad, have a "
      "drink for me.\""
   kocatantrademaster_random_012 = \
      "~kWulfgang says, \"You will soon learn to watch the canopy above when "
      "you are traveling the jungle. Death waits above where the Kriipa "
      "lives.\""
   kocatantrademaster_random_013 = \
      "~kWulfgang says, \"I've got a few rooms downstairs that I board "
      "travelers in. Right now they are full, there are some... "
      "~Isemi-permanent~I guests staying over. We don't see them at the "
      "breakfast table much.\""
   kocatantrademaster_random_014 = "~kWulfgang says, \"Drink to Meridian!\""
   kocatantrademaster_random_015 = \
      "~kWulfgang says, \"This island is bountiful.\""
   kocatantrademaster_random_016 = \
      "~kWulfgang says, \"Travelers from afar, eh? Well, you make yourself "
      "at home.\""
   kocatantrademaster_random_017 = \
      "~kWulfgang says, \"I do a modest business between the Avar and the "
      "few travelers that come through here. That and the so-called Kici'ca, "
      "the Ko'catani Legion. You just never know who is going to want what.\""
   kocatantrademaster_random_018 = \
      "~kWulfgang says, \"The Legions of Ko'catan fight the Avar. The Avar "
      "ambush the Legions. The Avar fight the Avar. The Legions fight the "
      "Avar fighting the Avar. The Avar fight the Avar fighting the Legions. "
      "And in the middle of it all is Wulfgang, sitting in my trading post "
      "getting drunk and rolling in money. I live by my wits alone.\""
   kocatantrademaster_random_019 = \
      "~kWulfgang says, \"The Avar are as reasonable a civilization as there "
      "ever was. If you know their ways. But to know their ways, you need to "
      "speak Avar. And I speak Avar.\""
   kocatantrademaster_random_020 = \
      "~kWulfgang says, \"The Ko'catani Legions are a crafty and spirited "
      "army. But they cannot hold the island. The Avar are very good at "
      "choosing their battleground, and at simply fading away when they "
      "would rather not fight.\""
   kocatantrademaster_random_021 = \
      "~kWulfgang says, \"There has been a relative peace between the "
      "Ko'catani and the Avar for about five years. Understand that it means "
      "that they are not fighting ~Ievery~I day. But there is tension, and "
      "many trade restrictions.\""
   kocatantrademaster_random_022 = \
      "~kWulfgang says, \"To the Avar race, magic isn't a study or a "
      "devotion as we know it. The magical Avar, the Avar'ya as the "
      "Konimians call them, are born with one eye right in the middle of "
      "their head. They are the only Avar that have the ability to learn "
      "magic.\""
   kocatantrademaster_random_023 = \
      "~kWulfgang says, \"The Avar are an interesting race, but not what you "
      "would call consistent. It has taken me a number of years to learn "
      "their language, and I'm not sure I'll ever have their confidence. But "
      "they are a lot smarter than those people in the settlement, I'll tell "
      "you that.\""
   kocatantrademaster_random_024 = "~kWulfgang says, \"Who's here to deal?\""
   kocatantrademaster_random_025 = \
      "~kWulfgang says, \"Take shelter from the storm here, traveler. I work "
      "hard enough to keep this place safe; enjoy the leisure before you go "
      "back out there into the jungle.\""
   kocatantrademaster_random_026 = \
      "~kWulfgang has a voice like someone pulling down a barn."
   kocatantrademaster_random_027 = "~kWulfgang chuckles to himself."
   kocatantrademaster_random_028 = \
      "~kWulfgang says, \"There is food in the kitchen, and I have both ale "
      "and Atz'pekonch, the finest Kocatani wine. And I mean this stuff is "
      "the best, I got it through military connections.\""
   kocatantrademaster_random_029 = \
      "~kWulfgang says, \"Take a place by the fire and tell of your "
      "travels.\""
   kocatantrademaster_random_030 = \
      "~kWulfgang seems to be listening intently to the jungle outside."
   kocatantrademaster_random_031 = "~kWulfgang coughs."
   kocatantrademaster_random_032 = \
      "~kThere is the smell of smoked meat and sweet spilled wine about this "
      "place."
   kocatantrademaster_random_033 = "~kWulfgang glances up at you."
   kocatantrademaster_random_034 = \
      "~kWulfgang says, \"What news, awkward one?\""
   kocatantrademaster_random_035 = \
      "~kWulfgang says, \"Kalior is dead?...Good.\""
   kocatantrademaster_random_036 = \
      "~kWulfgang says, \"Kateriina is not queen yet? Ha ha ha! That is "
      "funny!\""
   kocatantrademaster_random_037 = \
      "~kWulfgang says, \"It wasn't easy getting here from the mainland and "
      "getting myself established. I'm talking about setting up shop between "
      "the various Avar tribes and those lunatic dimwits you probably "
      "noticed on the other side of the island, holed up behind a huge wall. "
      "Nearly got myself killed fifty times trying. And now all of you show "
      "up here, like a bunch of Barloque tourists. I'd get out of here, but "
      "I don't know where else to go.\""
   kocatantrademaster_random_038 = \
      "~kWulfgang says, \"The next time you guys fight your silly way "
      "through the Orc warrens, why don't you bring Ran er'Hoth with you? At "
      "least then we'd have some decent conversation in here!\""
   kocatantrademaster_random_039 = \
      "~kWulfgang says, \"Looks to me like the quality of adventurers has "
      "slipped a bit since last time I was in Meridian. You're a pathetic "
      "lot. Ha, ha, ha, ha!\""
   kocatantrademaster_random_040 = \
      "~kWulfgang says, \"Say, is that a short sword you've got with you? "
      "Well equipped for our little jungles, I see!\""
   kocatantrademaster_random_041 = \
      "~kWulfgang doesn't take his eyes off you. He seems in a menacing mood."
   kocatantrademaster_random_042 = \
      "~kWulfgang says, \"I think you'd be safer back in Tos. You need to "
      "start heading in that direction.\""
   kocatantrademaster_random_043 = \
      "~kWulfgang says, \"Go on. Get out of here, I'm through with you.\""
   kocatantrademaster_trigger_a_ach_kici_ca = "a'ach kici'ca"
   kocatantrademaster_trigger_avar = "avar"
   kocatantrademaster_trigger_balo_na_te_din = "balo na'te din"
   kocatantrademaster_trigger_sell = "sell"
   kocatantrademaster_trigger_entroot = "entroot"
   kocatantrademaster_trigger_entroot_2 = "entroot"
   kocatantrademaster_trigger_game = "game"
   kocatantrademaster_trigger_hello = "hello"
   kocatantrademaster_trigger_help = "help"
   kocatantrademaster_trigger_inventory = "inventory"
   kocatantrademaster_trigger_inventory_2 = "inventory"
   kocatantrademaster_trigger_language = "language"
   kocatantrademaster_trigger_marion = "marion"
   kocatantrademaster_trigger_node = "node"
   kocatantrademaster_trigger_precious_stones = "precious stones"
   kocatantrademaster_trigger_qor = "qor"
   kocatantrademaster_trigger_rugby = "rugby"
   kocatantrademaster_trigger_buy = "buy"
   kocatantrademaster_trigger_tepal = "tepal"
   kocatantrademaster_trigger_tos = "tos"
   kocatantrademaster_trigger_wings = "wings"

   // KocatanVaultman (Itzal cha'Nosak)
   kocatanvaultman_random_001 = \
      "~kItzal stares blankly at the wall and belches repeatedly."
   kocatanvaultman_random_002 = "~kItzal scratches his backside."
   kocatanvaultman_random_003 = \
      "~kItzal says, \"You don't want me to go ~Iback~k down that vault to "
      "retrieve something, do you?!\""
   kocatanvaultman_random_004 = \
      "~kItzal says, \"Hey Huital, can I take a break? My legs are tired.\""
   kocatanvaultman_random_005 = \
      "~kItzal's eyes flutter closed and his mouth hangs open. In a few "
      "seconds, he begins snoring."
   kocatanvaultman_random_006 = \
      "~kItzal says, \"Huital, I need some extra money. I accidentally broke "
      "one of the customer's flasks.\""
   kocatanvaultman_random_007 = \
      "~kItzal places his hands in the water and splashes his face. Huital "
      "gives him a scathing glare."
   kocatanvaultman_random_008 = "~kItzal swats at a buzzing fly."
   kocatanvaultman_random_009 = \
      "~kYou are suddenly confronted by a very unpleasant odor. Itzal smiles "
      "to himself."
   kocatanvaultman_random_010 = \
      "~kItzal says, \"Excuse me. Shouldn't have eaten at the Monster "
      "today.\""
   kocatanvaultman_random_011 = \
      "~kItzal says, \"I think I lost some of Ixla's armor pieces. I hope "
      "she doesn't hurt me for it.\""
   kocatanvaultman_random_012 = \
      "~kItzal says, \"Thank you for coming in our Vaults, good %s.\", then "
      "whispers to Huital, \"Was that all right?\""
   kocatanvaultman_random_013 = \
      "~kItzal says, \"I'm tired, Huit. Let me go home early tonight.\""
   kocatanvaultman_random_014 = "~kItzal sighs and says, \"Not you again.\""

   // KocatanWeaponsMaster (Kochtal ko'Tulca)
   kocatanweaponsmaster_speech_001 = \
      "~kKochtal says, \"The Avar are very precise and sturdy opponents. "
      "Tread lightly through their homelands or bring an army with you.\""
   kocatanweaponsmaster_speech_002 = \
      "~kKochtal says, \"Ko'catan provides for all of my needs.\""
   kocatanweaponsmaster_speech_003 = \
      "~kKochtal says, \"Our society is built on respect for those who rank "
      "above you. As foreigners, you rank under an ix and therefore must "
      "respect all in our society.\""
   kocatanweaponsmaster_speech_004 = \
      "~kKochtal ko'Tulca says, \"Hello? Who's there?\""
   kocatanweaponsmaster_speech_005 = \
      "~kKochtal ko'Tulca says, \"I am the foremost weapons master in "
      "Ko'catan. Those who show proper warrior respect, I teach.\""
   kocatanweaponsmaster_speech_006 = \
      "~kKochtal says, \"Ko'catan is a great and orderly fortification. She "
      "offers protection and purpose to her inhabitants.\""
   kocatanweaponsmaster_speech_007 = \
      "~kKochtal says, \"Konima was the perfect warrior. Not just a killing "
      "machine, but also a compassionate and unselfish strategist. Our "
      "society is founded on his brave ideals.\""
   kocatanweaponsmaster_speech_008 = \
      "~kKochtal says, \"Every person is judged on their worth to our "
      "warrior society. People here know the boundaries of their vocations.\""
   kocatanweaponsmaster_speech_009 = \
      "~kKochtal says, \"I may be able to train you in the ways of archery.\""
   kocatanweaponsmaster_speech_010 = \
      "~kKochtal says, \"I do not know your word for the half men who our "
      "mighty Konima beat back all those centuries ago.\""
   kocatanweaponsmaster_random_001 = \
      "~kKochtal says, \"In Ko'catan, our people must earn their names. One "
      "does not choose to ascend to cha or ko. Others will decide that for "
      "them.\""
   kocatanweaponsmaster_random_002 = \
      "~kKochtal says, \"Our culture has many established customs and mores. "
      "We do not hesitate to outcast those who can not adhere to them.\""
   kocatanweaponsmaster_random_003 = \
      "~kKochtal says, \"Every person has a purpose and a defined rank here. "
      "We allow you in our walls. Do not presume to disrupt the order of "
      "Ko'catan.\""
   kocatanweaponsmaster_random_004 = \
      "~kKochtal says, \"There is no art of war. War is the antithesis of "
      "art. Those who find beauty in war have never been in a battle.\""
   kocatanweaponsmaster_random_005 = \
      "~kKochtal says, \"Skill at weaponry makes a soldier competent. To be "
      "truly formidable, the warrior must also have patience, forethought "
      "and allies.\""
   kocatanweaponsmaster_random_006 = \
      "~kKochtal says, \"You must have compassion. A cold hearted warrior is "
      "less effective than one who cares, for they have nothing worthwhile "
      "to lose.\""
   kocatanweaponsmaster_random_007 = \
      "~kKochtal says, \"Our society has survived for over 200 years based "
      "on one principle--'structure'. With no structure, there is only "
      "chaos.\""
   kocatanweaponsmaster_random_008 = \
      "~kKochtal says, \"Many years ago I lost my eyes defending the outer "
      "walls. I am of little use as a warrior now. That is why I must "
      "teach.\""
   kocatanweaponsmaster_random_009 = \
      "~kKochtal sniffs the air and says, \"The warriors have returned from "
      "a hunt.\""
   kocatanweaponsmaster_random_010 = \
      "~kKochtal cranes his neck as if listening intently. You hear nothing. "
      "After a moment he smiles and says, \"She won't find him at the "
      "tavern.\""
   kocatanweaponsmaster_random_011 = \
      "~kKochtal begins a slow routine of stretching and bending."
   kocatanweaponsmaster_random_012 = \
      "~kKochtal gropes around for his weapons. After a moment, his hands "
      "find an old, rusted short sword. He whispers, \"There you are, old "
      "friend.\""
   kocatanweaponsmaster_random_013 = \
      "~kKochtal says, \"Those avars can be fairly crafty. There is one that "
      "surrounds itself with death. It knows about Riija.\""
   kocatanweaponsmaster_random_014 = \
      "~kKochtal says, \"I sense you are respected in your land. That is "
      "good, friend.\""
   kocatanweaponsmaster_random_015 = \
      "~kKochtal says, \"I have heard praise of you from another traveler. "
      "Be proud.\""
   kocatanweaponsmaster_random_016 = \
      "~kKochtal feels your face and your shoulders. Smiling, he says, \"I "
      "will remember you.\""
   kocatanweaponsmaster_random_017 = \
      "~kKochtal says, \"You have already proved yourself strong since you "
      "have traversed the utom caves.\""
   kocatanweaponsmaster_random_018 = \
      "~kKochtal says, \"As I hear, your land has little structure. The "
      "Kingdom is divided and the towns in conflict. Ko'catan does not need "
      "such influence.\""
   kocatanweaponsmaster_random_019 = \
      "~kKochtal says, \"You offend our settlement. You would be wise to "
      "leave.\""
   kocatanweaponsmaster_random_020 = \
      "~kKochtal says, \"Ko'catan does not desire your people here.\""
   kocatanweaponsmaster_random_021 = \
      "~kKochtal says, \"Long ago, your people and our people were one. Now "
      "we are different. Our societies no longer belong together.\""
   kocatanweaponsmaster_trigger_avar = "avar"
   kocatanweaponsmaster_trigger_buy = "buy"
   kocatanweaponsmaster_trigger_sell = "sell"
   kocatanweaponsmaster_trigger_customs = "customs"
   kocatanweaponsmaster_trigger_society = "society"
   kocatanweaponsmaster_trigger_hello = "hello"
   kocatanweaponsmaster_trigger_help = "help"
   kocatanweaponsmaster_trigger_ko_catan = "ko'catan"
   kocatanweaponsmaster_trigger_konima = "konima"
   kocatanweaponsmaster_trigger_mores = "mores"
   kocatanweaponsmaster_trigger_mores_2 = "mores"
   kocatanweaponsmaster_trigger_teach = "teach"
   kocatanweaponsmaster_trigger_learn = "learn"
   kocatanweaponsmaster_trigger_learn_2 = "learn"
   kocatanweaponsmaster_trigger_utom = "utom"

