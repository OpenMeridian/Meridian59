riijamonk_trigger_when = de "wann"
riijamonk_trigger_yes = de "ja"

// ShalillePriestess
shalillepriestess_speech_001 = de \
   "~kPriesterin Xiana sagt, \"Diese Dinge sollten nicht einmal angefasst "
   "werden. Ihre Macht zu verderben wirkt fast augenblicklich und ist nicht "
   "wieder umkehrbar. Überlasse ihre Zerstörung den höheren Gewalten.\""
shalillepriestess_speech_002 = de \
   "~kPriesterin Xiana sagt, \"~bUnser... ergebenster Anhänger wohnt in "
   "Barloque. Vielleicht hast Du ja schon von dem Herrn Meidei gehört.~k\""
shalillepriestess_speech_003 = de \
   "~kPriesterin Xiana sagt, \"Es waren Leute ohne die Führung von "
   "Shal'ille.\""
shalillepriestess_speech_004 = de \
   "~kPriesterin Xiana sagt, \"~bDie heilige Shal'ille versorgt mich mit "
   "allem, was ich benötige.~k\""
shalillepriestess_speech_005 = de \
   "~kPriesterin Xiana sagt, \"~bFriede sei mit Dir, %s.~k\""
shalillepriestess_speech_006 = de \
   "~kPriesterin Xiana sagt, \"~bIch war noch nicht in Cor Noth. Ist es "
   "schön dort?~k\""
shalillepriestess_speech_007 = de \
   "~kPriesterin Xiana sagt, \"~bIch verstehe die Rolle nicht, die der Rat "
   "jetzt am Hof spielt.~k\""
shalillepriestess_speech_008 = de \
   "~kPriesterin Xiana sagt, \"~bAlle sechs Jahre begehen wir die Feiertage "
   "unserer Herrin Shal'ille. Es ist eine Zeit des Friedens und des Gebens. "
   "Fast jeder hat etwas, das er anderen geben kann, die weniger haben oder "
   "neu im Land sind.~k\""
shalillepriestess_speech_009 = de \
   "~kPriesterin Xiana sagt, \"~bIch habe gehört, dass er gestorben ist. Wie "
   "traurig.~k\""
shalillepriestess_speech_010 = de \
   "~kPriesterin Xiana sagt, \"~bFaren wurde vom Zorn über die Taten Qors "
   "geblendet. Hoffentlich lässt er unsere Herrin eines Tages seine Augen "
   "heilen.~k\""
shalillepriestess_speech_011 = de \
   "~kPriesterin Xiana sagt, \"~bSei gegrüßt, %s. Was führt Dich zum Tempel "
   "von Shal'ille?~k\""
shalillepriestess_speech_012 = de \
   "~kPriesterin Xiana sagt, \"~bIch lehre die Magie von Shal'ille, der "
   "Göttin des Friedens.~k\""
shalillepriestess_speech_013 = de \
   "~kPriesterin Xiana sagt, \"~bAlle sechs Jahre begehen wir die Feiertage "
   "unserer Herrin Shal'ille. Es ist eine Zeit des Friedens und des Gebens. "
   "Fast jeder hat etwas, das er anderen geben kann, die weniger haben oder "
   "neu im Land sind.~k\""
shalillepriestess_speech_014 = de \
   "~kPriesterin Xiana sagt, \"Leute zu töten ist falsch, egal was es für "
   "rechtfertigende Gründe geben mag. Es muss eine Lösung unserer Probleme "
   "ohne Blutvergießen geben.\""
shalillepriestess_speech_015 = de \
   "~kPriesterin Xiana sagt, \"Was ist der Unterschied zwischen einer "
   "Giftschlange und einer Boa constrictor? Bleib allem fern, was mit den "
   "Jägern zu tun hat.\""
shalillepriestess_speech_016 = de \
   "~kPriesterin Xiana sagt, \"~bIch trauere um die arme Jala. Sie war die "
   "Schwester unserer Herrin und die schönste Dichterin und Künstlerin im "
   "ganzen Land. Unsere Herrin vermisst den süßen Klang von Jalas "
   "Liedern.~k\""
shalillepriestess_speech_017 = de \
   "~kPriesterin Xiana sagt, \"~bIch weiß nur wenig über die Städte.~k\""
shalillepriestess_speech_018 = de \
   "~kPriesterin Xiana sagt, \"~bKraanan ist der Ehemann und Herr meiner "
   "Herrin Shal'ille. Er ist der erste der Sechs. Gepriesen sei Kraanan die "
   "Faust.~k\""
shalillepriestess_speech_019 = de \
   "~kPriesterin Xiana sagt, \"~bIch lehre die Magie von Shal'ille, der "
   "Göttin des Friedens.~k\""
shalillepriestess_speech_020 = de \
   "~kPriesterin Xiana sagt, \"~bVor langer Zeit, während der Kriege "
   "zwischen Barloque und Tos, kam eine Legion von Soldaten aus Tos durch "
   "Marion und wollte die Stadt als Basis für ihre Truppen verwenden, bis "
   "sie den großen Ozean überqueren und Barloque überraschend von Norden her "
   "einnehmen konnten. Die Priesterin und alle Dorfbewohner beteten zu "
   "Shal'ille, dass sie ihre schützenden Arme um das Dorf legen möge, damit "
   "es unter den Unbillen des Krieges nicht zu leiden hätte. Die Gebete "
   "wurden erhört, und bis heute wacht Shal'ille über sie.~k\""
shalillepriestess_speech_021 = de \
   "~kPriesterin Xiana sagt, \"~bMeidei ist sicherlich ein Enthusiast, aber "
   "ich glaube, er übertreibt. Unsere Göttin verlangt keine Anbetung, wie er "
   "meint.~k\""
shalillepriestess_speech_022 = de \
   "~kPriesterin Xiana sagt, \"~bDurch die Augen Shal'illes sehe ich, wie "
   "einsam ihre Existenz ist, obwohl ich weder ihre Worte noch ihre Taten "
   "deuten kann.~k\""
shalillepriestess_speech_023 = de \
   "~kPriesterin Xiana sagt, \"~bNimm meine Hände, wir werden zu Shal'ille "
   "beten, damit sie uns Stärke gibt, um das zu tun, was notwendig ist, was "
   "richtig ist.~k\""
shalillepriestess_speech_024 = de \
   "~kPriesterin Xiana sagt, \"~bIhre Lügen haben einige Unruhe "
   "hervorgerufen? Lass Dich nicht durch ihre gottlosen Wege "
   "beeinflussen.~k\""
shalillepriestess_speech_025 = de \
   "~kPriesterin Xiana sagt, \"~bUnglücklicherweise haben wir alle Tenuvals "
   "Warnungen als paranoides Gefasel abgetan. Nun, da Miriana ihre wahren "
   "Absichten gezeigt hat, wissen wir, dass Tenuval nicht paranoid genug "
   "war.~k\""
shalillepriestess_speech_026 = de \
   "~kPriesterin Xiana sagt, \"~bSprich nicht ihren verfluchten Namen in "
   "diesem Tempel des Friedens und des guten Willens.~k\""
shalillepriestess_speech_027 = de \
   "~kPriesterin Xiana sagt, \"~bHerrin Shal'ille sieht die Notwendigkeit "
   "ihres Ablebens, und obwohl sie Tränen über die Gewalttätigkeit dieser "
   "Tat vergießen muss, weiß sie, dass dies der einzige Weg ist, uns von "
   "Mirianas Wahnsinn zu befreien.~k\""
shalillepriestess_speech_028 = de \
   "~kPriesterin Xiana sagt, \"Diese Kreaturen kennen keine Gnade oder "
   "Menschlichkeit. Sie existieren, um Leben zu zerstören. Sie sind völlig "
   "blind, was die Wege Shal'illes betrifft.\""
shalillepriestess_speech_029 = de \
   "~kPriesterin Xiana sagt, \"~bDie Quellen haben sich offensichtlich "
   "selbst gegen ihre Angriffe verteidigt, sonst würden sie nicht mehr "
   "existieren.~k\""
shalillepriestess_speech_030 = de \
   "~kPriesterin Xiana sagt, \"~bDie schlimmsten Konsequenzen ergeben sich "
   "aus den Handlungen, die zufällig erscheinen.~k\""
shalillepriestess_speech_031 = de \
   "~kPriesterin Xiana sagt, \"~bSie muss aufgehalten werden. Die Quellen "
   "scheinen in Ordnung zu sein, aber man kann nie wissen, wann Miriana "
   "genug hat. Wir können nicht das Risiko eingehen, sie weitermachen zu "
   "lassen.~k\""
shalillepriestess_speech_032 = de \
   "~kPriesterin Xiana senkt den Kopf und sagt, \"~bLass uns zusammen beten. "
   "Herrin Shal'ille, erhöre unsere Gebete um Frieden und Wohlstand für alle "
   "guten Leute auf dieser Welt.~k\""
shalillepriestess_speech_033 = de \
   "~kPriesterin Xiana sagt, \"~bWie geht es Kati? Manchmal besucht sie "
   "mich, wenn sie sich ihren königlichen Pflichten entziehen kann.~k\""
shalillepriestess_speech_034 = de \
   "~kPriesterin Xiana sagt, \"~bAch, Qor ist die Gefallene. Sie bräuchte "
   "nur die Vergebung unserer Herrin Shal'ille zu suchen, und ich bin "
   "sicher, sie würde sie empfangen.~k\""
shalillepriestess_speech_035 = de \
   "~kPriesterin Xiana sagt, \"~bIch weiß nicht, was aus Riija wurde. "
   "Wahrscheinlich spielt er irgendwo den Ahnungslosen Streiche.~k\""
shalillepriestess_speech_036 = de \
   "~kPriesterin Xiana sagt, \"~bErlösung ist nicht käuflich. Shal'ille "
   "schenkt sie aus freien Stücken.~k\""
shalillepriestess_speech_037 = de \
   "~kPriesterin Xiana sagt, \"~bUnsere Herrin Shal'ille ist die Göttin von "
   "allem, das gut und friedlich ist. Sie wohnt im murmelnden Bach, im "
   "ruhigen Wind und im sanften Regen. Gepriesen sei ihr Name.~k\""
shalillepriestess_speech_038 = de \
   "~kPriesterin Xiana sagt, \"~bIch fürchte, Shal'ille benötigt zurzeit "
   "keine Schüler.~k\""
shalillepriestess_speech_039 = de \
   "~kPriesterin Xiana sagt, \"Jedes Mal, wenn ich an seine Tragödie denke, "
   "bete ich für seine Seele.\""
shalillepriestess_speech_040 = de \
   "~kPriesterin Xiana sagt, \"~bHerr Kraanan hat viele Anhänger in Tos, "
   "daher muss es eine großartige Stadt sein.~k\""
shalillepriestess_speech_041 = de \
   "~kPriesterin Xiana sagt, \"Ohne Vertrauen in die Harmonie aller Dinge "
   "neigen wir eher dazu, uns dem zuzuwenden, was die leichte Lösung "
   "verspricht. Venya'cyr nahm den leichten Pfad zu ihren Wünschen, und es "
   "kostete sie ihre unsterbliche Seele.\""
shalillepriestess_speech_042 = de \
   "~kPriesterin Xiana sagt, \"Wenn er nicht überlebt hätte, wäre die "
   "Geschichte sicher ganz anders verlaufen.\""
shalillepriestess_random_001 = de \
   "~kPriesterin Xiana sagt, \"~bDie Waldschrate von Faronath sind "
   "friedliche Wesen. Sie dienen Shal'ille.~k\""
shalillepriestess_random_002 = de \
   "~kPriesterin Xiana sagt, \"~bDie kleine Miriana verbreitet Lügen über "
   "unsere Herrin. Sie sollte besser gemieden werden.~k\""
shalillepriestess_random_003 = de \
   "~kPriesterin Xiana sagt, \"~bMaleval ist ein Monster. Er verbreitet "
   "nichts als Lügen.~k\""
shalillepriestess_random_004 = de \
   "~kPriesterin Xiana sagt, \"~bEs gibt kaum Gründe, gute Kreaturen zu "
   "fürchten, solange Du selbst gut bist.~k\""
shalillepriestess_random_005 = de \
   "~kPriesterin Xiana sagt, \"~bMonster zu töten ist wesentlich akzeptabler "
   "als Menschen zu töten. Mord ist der schnellste Weg, um in Ungnade zu "
   "fallen.~k\""
shalillepriestess_random_006 = de \
   "~kPriesterin Xiana sagt, \"~bViele bemerken nicht, dass das Töten nicht "
   "ohne Folgen bleibt. Oft manifestiert sich ein schrecklicher Geist, der "
   "das unschuldige Opfer rächen will.~k\""
shalillepriestess_random_007 = de \
   "~kPriesterin Xiana sagt, \"~bJene, die guter Natur sind, werden mit "
   "einem Geschenk belohnt, sollten sie ein Opfer der Unterwelt werden.~k\""
shalillepriestess_random_008 = de \
   "~kPriesterin Xiana sagt, \"~bDas Meistern der Lehren von Shal'ille ist "
   "einfacher, wenn Dein Geist von den Einflüssen anderer Götter befreit "
   "ist. Ein Trank des Vergessens kann dabei helfen, hat aber oft böse "
   "Nebenwirkungen.~k\""
shalillepriestess_random_009 = de \
   "~kPriesterin Xiana sagt, \"~bIn Tos gibt es eine Arena, die dem Ehemann "
   "unserer Herrin geweiht ist. Dort gibt es nur Schaukämpfe, Du brauchst "
   "also keine Angst vor dem Tod zu haben.~k\""
shalillepriestess_random_010 = de \
   "~kPriesterin Xiana sagt, \"~bDie Gottestage von Shal'ille sind wahrlich "
   "fröhliche und friedliche Feiertage im ganzen Land.~k\""
shalillepriestess_random_011 = de \
   "~kPriesterin Xiana sagt, \"~bIn der nördlichen Ecke des Tempels befindet "
   "sich der Teich der Heiterkeit. Bade in seinen Wassern und finde den "
   "Frieden in Dir. Nimm Dir ein paar Augenblicke, um den Ärger des Tages "
   "loszulassen und zu erkennen, dass Du nur zur Entspannung auf dieser Welt "
   "bist. Kein Problem hier ist es wert, sich wirklich darüber "
   "aufzuregen.~k\""
shalillepriestess_random_012 = de \
   "~kPriesterin Xiana sagt, \"~bIn der südlichen Ecke des Tempels findest "
   "Du das Becken der Vergebung. Knie davor nieder und vergib dem Menschen, "
   "den Du am wenigsten magst, denn er will Dir nicht wirklich Schmerz "
   "zufügen; er sieht die Dinge nur von einem anderen Standpunkt aus. Trage "
   "nicht die Last eines nutzlosen Grolls, sonst bist Du allein es, der "
   "leidet.~k\""
shalillepriestess_random_013 = de \
   "~kPriesterin Xiana sagt, \"~bManche werfen mir vor, dass ich mich den "
   "Wünschen Kraanans beuge. Männer verfügen über große körperliche Kraft "
   "und müssen respektiert werden, aber die Macht von Frieden und "
   "Wiedergeburt liegt in der Seele der Frauen.~k\""
shalillepriestess_random_014 = de \
   "~kPriesterin Xiana sagt, \"~bGepriesen sei Shal'ille, die Ruhige!~k\""
shalillepriestess_random_015 = de \
   "~kPriesterin Xiana sagt, \"~bUnsere Herrin schenkt Dir ein sanftes "
   "Lächeln.~k\""
shalillepriestess_random_016 = de \
   "~kPriesterin Xiana sagt, \"~bMöge Shal'ille Deinen Feldern sanften Regen "
   "schenken.~k\""
shalillepriestess_random_017 = de \
   "~kPriesterin Xiana sagt, \"~bMögest Du Frieden in der Betrachtung "
   "unserer Herrin finden.~k\""
shalillepriestess_random_018 = de \
   "~kPriesterin Xiana sagt, \"~bJene, die sich als die Würdigsten erweisen, "
   "werden von unserer Herrin mit zusätzlicher Hilfe bei ihren Zaubern "
   "gesegnet.~k\""
shalillepriestess_random_019 = de \
   "~kPriesterin Xiana sagt, \"~bDer Legende nach opferten sich die Götter "
   "im Heiligen Land der Trolle, als der Nexus vor Hunderten von Jahren "
   "zusammenbrach.~k\""
shalillepriestess_random_020 = de \
   "~kPriesterin Xiana sagt, \"~bDie Toten sollten geehrt werden. Blumen an "
   "einer Gedenkstätte niederzulegen dient eher dem spirituellen Wohl der "
   "Lebenden als dem der Verstorbenen.~k\""
shalillepriestess_random_021 = de \
   "~kPriesterin Xiana sagt, \"~bIch bin entsetzt über die "
   "gotteslästerlichen Dinge, die Miriana über Shal'ille und Faren "
   "verbreitet. Das Mädchen sollte ausgepeitscht werden. Oh, vergib mir, "
   "Shal'ille, dass ich solche abscheulichen Sachen sage.~k\""
shalillepriestess_trigger_amulet = de "amulett"
shalillepriestess_trigger_sell = de "verkauf"
shalillepriestess_trigger_bye = de "ciao"
shalillepriestess_trigger_council = de "ratsmitglied"
shalillepriestess_trigger_days = de "gottestage"
shalillepriestess_trigger_duke = de "herzog"
shalillepriestess_trigger_hello = de "hallo"
shalillepriestess_trigger_help = de "hilfe"
shalillepriestess_trigger_holiday = de "ferien"
shalillepriestess_trigger_holiday_2 = de "feiertag"
shalillepriestess_trigger_hunter = de "jäger"
shalillepriestess_trigger_hunter_sword = de "jagdschwert"
shalillepriestess_trigger_learn = de "lernen"
shalillepriestess_trigger_necromancer = de "nekro"
shalillepriestess_trigger_node = de "quelle"
shalillepriestess_trigger_prayer = de "beten"
shalillepriestess_trigger_prayer_2 = de "gebet"
shalillepriestess_trigger_princess = de "prinzessin"
shalillepriestess_trigger_buy = de "kaufen"
shalillepriestess_trigger_shal_ille = de "sha-lill"
shalillepriestess_trigger_sha_lill = de "shal'ille"
