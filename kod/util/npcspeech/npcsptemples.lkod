// RiijaMonk
riijamonk_speech_001 = de \
   "~kDer Mönch von Riija sagt, \"Stell Dir vor zu essen und niemals satt zu "
   "werden.\""
riijamonk_speech_002 = de \
   "~kDer Mönch von Riija sagt, \"Wenn das Fundament Deines Hauses nur aus "
   "Luft besteht, wird es sicherlich zusammenstürzen.\""
riijamonk_speech_003 = de \
   "~kDer Mönch von Riija sagt, \"~I~bIch wäre ~I~B~knur~B~I~g daran "
   "interessiert, ~I~kDeine Seele~I~g zu kaufen~n~k.\""
riijamonk_speech_004 = de \
   "~kDer Mönch von Riija sagt, \"~gDas Schicksal ~B~rwird~B ~bDich "
   "~I~kzurück~I ~rbringen.`n~k\""
riijamonk_speech_005 = de "~kDer Mönch von Riija sagt, \"Du bist weise.\""
riijamonk_speech_006 = de \
   "~kDer Mönch von Riija sagt, \"~I~gDas stärkste Gefühl ist ~I~rANGST.~I~g "
   "Hass ist überhaupt kein Gefühl. ~bHass ist nur die ANGST davor, was "
   "andere sind ~roder genauer gesagt, was wir nicht sind, %s~n~k.\""
riijamonk_speech_007 = de \
   "~kDer Mönch von Riija intoniert, \"~I~rDu ~I~B~bbist ~I~gunter "
   "`n~kvielen ~b~IGefahren~I ~B~ggereist, ~B~rum ~I~bmich ~kzu "
   "treffen.~n~k\""
riijamonk_speech_008 = de \
   "~kDer Mönch von Riija sagt, \"~BDu ~I~bbist~n~g jenseits des "
   "~B~rPunktes,~g~B an dem man ~kHilfe braucht ~I~boder verdient~n~k.\""
riijamonk_speech_009 = de \
   "~kDer Mönch von Riija sagt, \"Es gab eine Zeit, in der der Prinz und die "
   "Prinzessin glücklich zusammen lebten.\""
riijamonk_speech_010 = de \
   "~kDer Mönch von Riija sagt, \"Was sagtest Du, das Hungerschwert?\""
riijamonk_speech_011 = de \
   "~kDer Mönch von Riija sagt, \"~BKonima~B~I~r war ein ~bNarr,~g als er "
   "sein ~bVolk ~I~B~rauf diese Insel~B~I~b brachte~n~k.\""
riijamonk_speech_012 = de \
   "~kDer Mönch von Riija sagt, \"~I~bDas stärkste Gefühl ist ~I~rANGST. "
   "~I~bLiebe ist überhaupt kein Gefühl, %s. ~rLiebe ist nur ANGST vor "
   "Einsamkeit~n~k.\""
riijamonk_speech_013 = de \
   "~kDer Mönch von Riija kichert, \"~b~bSind ihre ~B ~I~gWorte Worte der "
   "~I~bWahrheit oder ~B~kWorte der ~B~I~rLügen. ~I~gWer sind wir, ~B~rum "
   "das zu ~B~kbeurteilen.\""
riijamonk_speech_014 = de \
   "~kDer Mönch von Riija hält sich die Hände vor die Ohren und brüllt, "
   "\"~B~gICH ~bKANN ~rDICH ~B~I~bNICHT HÖREN~k!~I ~rLA~gLA~bLA~kLA.\""
riijamonk_speech_015 = de \
   "~kDer Mönch von Riija scheint mit den Schultern zu zucken, \"~BWahrheit, "
   "~I~rLügen~I, ~g....der ~beinzige ~I~gUnterschied liegt ~I~B~rin der "
   "Wahrnehmung.~B~k\""
riijamonk_speech_016 = de \
   "~kDer Mönch von Riija sagt, \"Ich habe einen Parasiten, der in mir lebt. "
   "Um den Parasiten zu töten, muss ich mich selbst umbringen.\""
riijamonk_speech_017 = de \
   "~kDer Mönch von Riija sagt, \"Jene, die ~I~rdenken, ~gsie ~kwären normal "
   "~bin ~reiner ~bWelt ~bwie ~runserer, ~rsind ~b~I~Bwahnsinnig~n~k.\""
riijamonk_speech_018 = de \
   "~kDer Mönch von Riija ruft, \"~B~bKomm herein, ~B~I~kes ist offen... "
   "~I~rOhhh, Du, ~I~gvielleicht ~Bdoch ~B~bnicht.~n~k\""
riijamonk_speech_019 = de \
   "~kDer Mönch von Riija sagt, \"~I~bWenn Du ~I~B~kMiriana ~B~rund ihre "
   "~gKreaturen ~B~rbesiegen willst, ~B~Imusst Du ~I~gviel lernen!~n~k\""
riijamonk_speech_020 = de \
   "~kDer Mönch von Riija predigt, \"~B~rRiija der Wanderer, ~bist der Gott "
   "~k~Ides Bewusstseins. ~BUnd nichts ist wichtiger ~I~gals das "
   "BEWUSSTSEIN.~n~k\""
riijamonk_speech_021 = de \
   "~kDer Mönch von Riija sagt, \"~IIch ~rverkaufe ~I~BWahrheit~n~k.\""
riijamonk_speech_022 = de \
   "~kDer Mönch von Riija sagt, \"~BIch kann Dir ~rdie Augen~k für ~rso~k "
   "vieles öffnen~n~k.\""
riijamonk_speech_023 = de \
   "~kDer Mönch von Riija sagt, \"Wenn der Prinz vor dem König stirbt, ist "
   "das wahrlich ein Tag zum Weinen.\""
riijamonk_speech_024 = de "~kDer Mönch von Riija sagt, \"Sie war ein Mann.\""
riijamonk_speech_025 = de \
   "~kDer Mönch von Riija sagt, \"~B~gFrüher, als Du denkst~n~k.\""
riijamonk_speech_026 = de \
   "~kDer Mönch von Riija sagt, \"~BJemand, ~gder ~rwirklich ~kwahnsinnig "
   "~gist, ~bhätte ~kdoch ~rkeine ~gKenntnis ~gvon ~bseinem ~rWahnsinn~n~k.\""
riijamonk_speech_027 = de \
   "~kDer Mönch von Riija sagt, \"Der echte Zarrus starb in Brax.\""
riijamonk_random_001 = de \
   "~kDer Mönch von Riija gluckst, \"~BRIIJA ~I~bist ~gMacht.~n~k\""
riijamonk_random_002 = de \
   "~kDer Mönch von Riija verfolgt jede Deiner Bewegungen."
riijamonk_random_003 = de \
   "~kDer Mönch von Riija sagt, \"~BWahnsinn ist ein falsch benutztes "
   "~bAttribut. ~I~kBist Du wahnsinnig? ~I~n~rSag \"~Bja~I\" und Du bist es "
   "nicht. `n~g Sag \"~Bnein~B\" und Du musst es sein~n~k.\""
riijamonk_random_004 = de \
   "~kDer Mönch von Riija sagt, \"~rManche ~Iwerden Dir sagen~I, dass Sehen "
   "Glauben ist. ~bSie sind ~B~kblind~n~k.\""
riijamonk_random_005 = de \
   "~kDer Mönch von Riija sagt, \"~B~bAm Himmel ~B~rgibt es manchmal einen "
   "~B~gF~bI`n~BSC~kH,~B~r er fliegt ~Ihöher als der ~bRegenbogen ~gund kann "
   "mit keinem Gift getötet werden. ~I~kWenn Du seine Schuppen berühren "
   "könntest, ~bwürdest Du ~Iwissen, was hinter der Nacht liegt. "
   "~I~B~rDoch~B~g der Fisch kann nicht gefangen werden, weil er nicht "
   "~Bexistiert~n~k.\""
riijamonk_random_006 = de \
   "~kDer Mönch von Riija sagt, \"~rDie Farbe der Tränen ist nicht ~brot~r, "
   "sollte es aber sein~n~k.\""
riijamonk_random_007 = de \
   "~kDer Mönch von Riija sagt, \"Wenn Du ins ~B~rFeuer~B~k schaust, siehst "
   "Du kein ~B~rFeuer~B~k. ~B~rFeuer~B~k ist niemals an einem genauen Punkt. "
   "Du nimmst nur wahr, wo das ~B~rFeuer~B~k gewesen ist~n~k.\""
riijamonk_random_008 = de \
   "~kDer Mönch von Riija sagt, \"~B~bTief ~rin ~gder ~bLeber ~kder "
   "~rMenschen ~ggibt es ~beinen~r Beutel. ~kDort ~bdrinnen ~gwerden ~rdie "
   "~kÄngste ~baufbewahrt~n~k.\""
riijamonk_random_009 = de \
   "~kDer Mönch von Riija sagt, \"~g~IDu kannst Hitze nicht schmecken. "
   "~bAber ich kann es~n~k.\""
riijamonk_random_010 = de \
   "~kDer Mönch von Riija sagt, \"~IWenn Dich ~bein Schwert ~rberührt, "
   "~gkönntest Du sterben, ~bdoch ~kwenn Dich ~rniemals ein ~ganderer Mensch "
   "~rberührt, ~bstirbst Du bestimmt~n~k.\""
riijamonk_random_011 = de \
   "~kDer Mönch von Riija sagt, \"~IIch weiß, warum Du hier bist.~I Wenn "
   "diese Person Dir mehr Aufmerksamkeit geschenkt hätte, ~bwärst Du dort. "
   "~rStattdessen bist Du bei mir. ~B~kHA HA HA HA HA HA HA HA~n~k!\""
riijamonk_random_012 = de \
   "~kDer Mönch von Riija sagt, \"~B~gDu weißt, wenn jemand ~rDich~g hasst. "
   "~kDas ist REALITÄT. ~gAber Du weißt nie, ob jemand ~bDich~g liebt. Immer "
   "ist genug Raum für Zweifel. ~I~bOh, sie werden Dir sagen, dass sie Dich "
   "aus ~n~b~Bganzem~B~I Herzen lieben. ~n~B~kDas ist "
   "~rPH~gA~kN~bT~rA~gS~bIE~n~k.\""
riijamonk_random_013 = de \
   "~kDer Mönch von Riija sagt, \"Ich weiß, was Du denkst. ~bDu fragst Dich "
   "oft, ob Du allein hier bist. ~I Du fragst Dich, ob jede Person, der Du "
   "begegnest, nur ein Hirngespinst Deiner Einbildung ist. ~gDort "
   "hingestellt, um Dich irgendwie zu prüfen. ~I~rDu fragst Dich, ob "
   "irgendwer sonst wirklich eine ~I~B~gS~be~ke~gle~r hat oder außerhalb "
   "Deines Gesichtsfeldes existiert. `n~kDu hast recht. ~IAußer, dass Du "
   "auch nicht existierst~n~k.\""
riijamonk_random_014 = de \
   "~kDer Mönch von Riija sagt, \"~B~g'Warum?'~B~k Du hast dem Leben zu oft "
   "diese Frage gestellt, wenn Du eigentlich hättest fragen sollen: "
   "~B~r'Wann?' ~n~k\""
riijamonk_random_015 = de \
   "~kDer Mönch von Riija sagt, \"~B~gSag ~bmir, ~rmein ~gGast, ~I~rwelches "
   "ist das stärkste ~kGefühl~n~k?\""
riijamonk_trigger_amulet = de "amulett"
riijamonk_trigger_sell = de "verkauf"
riijamonk_trigger_bye = de "tschüss"
riijamonk_trigger_fear = de "angst"
riijamonk_trigger_hate = de "hass"
