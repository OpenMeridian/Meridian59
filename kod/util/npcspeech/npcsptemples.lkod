qorpriestess_trigger_help = de "hilfe"
qorpriestess_trigger_holiday = de "feiertag"
qorpriestess_trigger_holiday_2 = de "ferien"
qorpriestess_trigger_hunter_sword = de "jagdschwert"
qorpriestess_trigger_learn = de "lernen"
qorpriestess_trigger_node = de "quelle"
qorpriestess_trigger_princess = de "prinzessin"
qorpriestess_trigger_pupil = de "schüler"
