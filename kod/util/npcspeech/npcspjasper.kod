   jasperblacksmith_trigger_zhieu_b_hob = "zhieu b'hob"
   jasperblacksmith_trigger_bob = "bob"

   // JasperElder (Afiera D'xor)
   jasperelder_speech_001 = \
      "~kAfiera D'xor says, \"A gentle creature if avoided completely.\""
   jasperelder_speech_002 = \
      "~kAfiera D'xor says, \"Goodbye. Come back another time.\""
   jasperelder_speech_003 = \
      "~kAfiera D'xor says, \"I lead a simple life here, with my people and "
      "my art.\""
   jasperelder_speech_004 = \
      "~kAfiera D'xor says, \"A beautiful city, though I haven't been there "
      "for some years.\""
   jasperelder_speech_005 = \
      "~kAfiera D'xor says, \"I have no use for the place.\""
   jasperelder_speech_006 = \
      "~kAfiera D'xor says, \"We have much to learn from the mistakes of the "
      "past.  Brax was a terrible mistake, but what have we learned?\""
   jasperelder_speech_007 = \
      "~kAfiera D'xor says, \"You must come back and see me soon.\""
   jasperelder_speech_008 = "~kAfiera D'xor says, \"Yes, goodbye.\""
   jasperelder_speech_009 = \
      "~kAfiera D'xor seems to have forgotten that you are here at all."
   jasperelder_speech_010 = "~kAfiera D'xor says, \"Simple creatures.\""
   jasperelder_speech_011 = \
      "~kAfiera D'xor says, \"Take some responsibility and go find out for "
      "yourself.\""
   jasperelder_speech_012 = \
      "~kAfiera D'xor says, \"Lovely place, if I remember correctly.\""
   jasperelder_speech_013 = \
      "~kAfiera D'xor says, \"As far as a construct of this civilization "
      "goes, it's not a bad one.\""
   jasperelder_speech_014 = \
      "~kAfiera D'xor says, \"Is that where you've come from?\""
   jasperelder_speech_015 = \
      "~kAfiera D'xor says, \"A bunch of pretty smart people. But so are "
      "goat thieves, bartenders, and street urchins.\""
   jasperelder_speech_016 = \
      "~kAfiera D'xor says, \"In truth there is but one pool of magic, which "
      "is drawn upon from every side, simple. Once you understand that, it "
      "is not overly difficult to disrupt those connections by simply "
      "disrupting that pool. Splash around a bit... \""
   jasperelder_speech_017 = \
      "~kAfiera D'xor says, \"Come back another time and we shall talk. I "
      "cannot help you now.\""
   jasperelder_speech_018 = \
      "~kAfiera D'xor says, \"Those who wish to follow such a pretender both "
      "strengthen his resolve to pursue the crown and validate his claim to "
      "it.\""
   jasperelder_speech_019 = \
      "~kAfiera D'xor says, \"Politicians come and then pass as the seasons "
      "pass. Who is the Duke but a man among his fellow citizens?\""
   jasperelder_speech_020 = \
      "~kAfiera D'xor says, \"He makes a fine politician, but would he truly "
      "make a good king?\""
   jasperelder_speech_021 = \
      "~kAfiera D'xor says, \"Faren is the closest deity to the source of "
      "all power, and he is on the rise. I know this. Beneath all lies "
      "chaos, and beneath chaos, Faren. That is all that I will say.\""
   jasperelder_speech_022 = \
      "~kAfiera D'xor says, \"I have spent a large portion of my life "
      "studying the ways of this world, of the natural orders, and have "
      "learned some small and overall meaningless tricks to help me survive. "
      "Many attribute the mastery of these tricks to Faren, and Faren magic, "
      "but I know better, do you understand? There is but one magic. Only "
      "one, from which all sources are drawn.\""
   jasperelder_speech_023 = \
      "~kAfiera D'xor says, \"You must leave now. Our conversation is over "
      "for today.\""
   jasperelder_speech_024 = "~kAfiera D'xor says, \"Come in, %s.\""
   jasperelder_speech_025 = \
      "~kAfiera D'xor says, \"Yes? Who is it? Step closer so that I might "
      "see you.\""
   jasperelder_speech_026 = \
      "~kAfiera D'xor doesn't seem to have noticed that you are even here."
   jasperelder_speech_027 = \
      "~kAfiera D'xor says, \"They are a little better than the "
      "necromancers, if you ask me.\""
   jasperelder_speech_028 = \
      "~kAfiera D'xor says, \"That is a tool of death. Let us hope the "
      "hunters have at least a little morality left.\""
   jasperelder_speech_029 = \
      "~kAfiera D'xor says, \"Jala's true secret has yet to unfold. I have "
      "spent my life in thought and meditation over the fate of the Jala, "
      "and the fates of art and of music... I can tell you with confidence "
      "that Jala is not dead. I cannot pretend to know where she is, for she "
      "is the most mysterious and elusive of our deities... but I can tell "
      "you that she has shown me that she will return when the time is "
      "right.\""
   jasperelder_speech_030 = \
      "~kAfiera D'xor says, \"If you are going to study the ways of the "
      "earth along the path of a god, then you must look carefully at all of "
      "the gods, for all are equally necessary to complete the design. Do "
      "not forget Jala, whom many say is dead. How can art be dead? Music? "
      "Do not believe half of this talk. Look around, tell me what's true.\""
   jasperelder_speech_031 = \
      "~kAfiera D'xor says, \"I am tired now. Please go.\""
   jasperelder_speech_032 = "~kAfiera D'xor says, \"Here you have it.\""
   jasperelder_speech_033 = \
      "~kAfiera D'xor says, \"Look around for yourself.\""
   jasperelder_speech_034 = \
      "~kAfiera D'xor says, \"Well, what do you think? Go out there and look "
      "around, you are capable of coming to your own conclusions.\""
   jasperelder_speech_035 = \
      "~kAfiera D'xor says, \"A good man at heart, if a little too "
      "determined, but he would make a sound ruler, if he can just get past "
      "his need for vengeance that is.\""
   jasperelder_speech_036 = \
      "~kAfiera D'xor says, \"Have you two been introduced?\""
   jasperelder_speech_037 = \
      "~kAfiera D'xor says, \"He's probably in the bar talking grand "
      "strategy, go find him and ask.\""
   jasperelder_speech_038 = \
      "~kAfiera D'xor says, \"There may come a point when we must face the "
      "Lich in battle. Now is the time to find out as much as we can about "
      "our enemy.\""
   jasperelder_speech_039 = \
      "~kAfiera D'xor says, \"Conjuring an attack of lightning is a power "
      "that I learned from the many years that I spent among the tree folk. "
      "I am not averse to passing it on to those with a capacity to "
      "understand, and to utilize the power for what it is.\""
   jasperelder_speech_040 = \
      "~kAfiera D'xor says, \"I don't have time for this now.\""
   jasperelder_speech_041 = \
      "~kAfiera D'xor says, \"I have not been to Marion in a very long "
      "time.\""
   jasperelder_speech_042 = \
      "~kAfiera D'xor says, \"Tell me, what is it like these days, Marion?\""
   jasperelder_speech_043 = \
      "~kAfiera D'xor seems to be thinking of something else."
   jasperelder_speech_044 = \
      "~kAfiera D'xor says, \"The pendant is a center of power for the "
      "necromancer. It could also be a point of vulnerability. Understand "
      "that, and there may be a way to destroy them. Make no mistake, for "
      "they want the same.\""
   jasperelder_speech_045 = \
      "~kAfiera D'xor says, \"Destroy them at any cost.\""
   jasperelder_speech_046 = \
      "~kAfiera D'xor says, \"An ancient and venerable civilization, "
      "completely misunderstood by our limited end/means sensibilities. But "
      "they have also perpetuated these myths. I fear we shall never find "
      "the truth, which is not that the orcs are bad and we are good, or "
      "right, but that we are scared to death that our world will become "
      "something new tomorrow. Even though it must.\""
   jasperelder_speech_047 = "~kAfiera D'xor says, \"Leave me now.\""
   jasperelder_speech_048 = "~kAfiera D'xor says, \"Ho hum.\""
   jasperelder_speech_049 = \
      "~kAfiera D'xor says, \"Yes, I spoke with her once, a very long time "
      "ago. I don't doubt that she has honorable intentions, but I don't "
      "think that she has the will for the undertaking of leadership.\""
   jasperelder_speech_050 = \
      "~kAfiera D'xor says, \"Take your questions to her then.\""
   jasperelder_speech_051 = \
      "~kAfiera D'xor says, \"Forgive me, but I have no time for a pupil "
      "right now. You must leave.\""
   jasperelder_speech_052 = \
      "~kAfiera D'xor says, \"Rats are in conflict with us humans "
      "essentially because we are both scavengers, competing for the same "
      "limited piles of garbage and waste.\""
   jasperelder_speech_053 = "~kAfiera D'xor says, \"Rat?\""
   jasperelder_speech_054 = \
      "~kAfiera D'xor says, \"The spiders have their own purpose. Can you "
      "really blame them for the appearance of hostility when to them you "
      "look like a walking meat pie? They are great hunters.\""
   jasperelder_speech_055 = \
      "~kAfiera D'xor says, \"I cannot talk any more now. Please leave me.\""
   jasperelder_speech_056 = \
      "~kAfiera D'xor says, \"I wish the poor man had achieved his goal all "
      "those years ago.  Then we would not have to deal with these "
      "tribulations today.\""
   jasperelder_speech_057 = "~kAfiera D'xor says, \"Yes, Tos.\""
   jasperelder_speech_058 = \
      "~kAfiera D'xor says, \"Tos? I'm afraid I don't know very much about "
      "the city itself.\""
   jasperelder_speech_059 = \
      "~kAfiera D'xor says, \"The very center of nonsense in this place.\""
   jasperelder_speech_060 = \
      "~kAfiera D'xor says, \"The tree folk have been upon this land for "
      "many millennia, and have discovered ways to maintain peace and to "
      "pass existence by their own terms.\""
   jasperelder_speech_061 = \
      "~kAfiera D'xor says, \"I will not speak with you any further today, I "
      "must return to my work.\""
   jasperelder_speech_062 = \
      "~kAfiera D'xor says, \"Do you know anyone who has ever spoken with a "
      "troll? It isn't likely. Not that they are what we would really "
      "consider to be interesting conversationalists, sitting here, the two "
      "of us. They aren't, by our standards, particularly quick, or keen. "
      "The point is that we don't even try, even those that purport to "
      "identify with Shal'ille and the ways of healing are all too ready to "
      "fight rather than trying to understand. We don't want to hear their "
      "answers, so we don't even bother to speak to them at all.\""
   jasperelder_speech_063 = \
      "~kAfiera D'xor says, \"I don't have anything to say to you at all.\""
   jasperelder_speech_064 = "~kAfiera D'xor says, \"What of her?\""
   jasperelder_speech_065 = \
      "~kAfiera D'xor says, \"I believe that the yeti is both guardian and "
      "messenger. But what message? They are solitary creatures.\""
   jasperelder_speech_066 = \
      "~kAfiera D'xor says, \"Yeti? Forgive me, but my concentration is "
      "elsewhere. You must leave now.\""
   jasperelder_random_001 = \
      "~kAfiera D'xor says, \"Those councilors are trying to reopen the "
      "ancient Nexus with the tokens. I'm not so sure that's a good idea. "
      "Who knows what will happen when those tokens are brought together? "
      "They ought to be ready to call the attention of the gods when that "
      "happens.\""
   jasperelder_random_002 = \
      "~kAfiera D'xor says, \"Old Alzahakar is a wise man. A great magician, "
      "and a learned man of many, many books. Perhaps he can help you find a "
      "way into your own secret reserves. There is potential that resides "
      "within, which even now is waiting for the winter surrounding you to "
      "retreat.\""
   jasperelder_random_003 = \
      "~kAfiera D'xor says, \"Jala is not dead unless she is forgotten "
      "completely. She is not dead as long as we keep her alive.\""
   jasperelder_random_004 = "~kAfiera D'xor says, \"Enjoy yourself.\""
   jasperelder_random_005 = \
      "~kAfiera D'xor says, \"Be who you want to be. This, all of this, is "
      "just a game. Just a game. It's as important as you want it to be.\""
   jasperelder_random_006 = \
      "~kAfiera D'xor says, \"Find your place and go there. Take your time, "
      "and think about what is happening in your life. It is really quite "
      "simple.\""
   jasperelder_random_007 = \
      "~kAfiera D'xor says, \"Do you smell something funny?\""
   jasperelder_random_008 = \
      "~kAfiera D'xor says, \"The treefolk have an old saying for those that "
      "speak the tongue. They say 'Today is the forest fire, and tomorrow "
      "the ashes.' They lived only in nightmares, and visions. So there will "
      "be a time when all of this passes too, and our dreams now will then "
      "replace this dream, and on, and on.\""
   jasperelder_random_009 = \
      "~kAfiera D'xor says, \"Be wary in choosing your enemies when the "
      "chances to pick them for yourself are afforded. If the choice is "
      "never there, then make sure whatever enemies you have don't forget "
      "you until they are dead.\""
   jasperelder_random_010 = \
      "~kAfiera D'xor says, \"I have never had any money, nor any interest "
      "in the stuff. There are too many I know that follow money above all "
      "else, convinced that just to have a little more will truly save them, "
      "once and for all... \""
   jasperelder_random_011 = \
      "~kAfiera D'xor says, \"It is often better to avoid trouble as it "
      "approaches. Step around it, let it pass. That is the wisdom of an old "
      "man, but one who continues to live and to get older.\""
   jasperelder_random_012 = \
      "~kAfiera D'xor says, \"You could devote your life to studying the "
      "tokens. Many have. You could also devote your life to chasing your "
      "own tail, so to speak. It is a mistake to believe that we can "
      "understand something just through learned observation, without "
      "delving into the pattern behind it, the grand pattern. Imagination. "
      "Meaning.\""
   jasperelder_random_013 = \
      "~kAfiera D'xor says, \"It isn't as though we have a choice about art, "
      "or music. It is just as much a part of our existence as speaking and "
      "listening are.\""
   jasperelder_random_014 = \
      "~kAfiera D'xor says, \"You have come a long way to be here, I can see "
      "that.\""
   jasperelder_random_015 = \
      "~kAfiera D'xor says, \"You can go wherever you wish by fighting your "
      "way in, or if you are clever enough you can get to the same places by "
      "avoiding violence and stepping around trouble. There are innumerable "
      "ways to achieve exactly what you want in this world, my friend.\""
   jasperelder_random_016 = \
      "~kAfiera D'xor says, \"Don't sweat over the little things... "
      "inconveniences, petty slights. There is real tragedy and heartache "
      "enough to go around.\""
   jasperelder_random_017 = \
      "~kAfiera D'xor says, \"Do you know that the orc have a culture that "
      "predates our own by a thousand years? I have seen some of the "
      "artistic achievements of their people, and count myself fortunate for "
      "the insight. For all the outward signs of hostility and apparent "
      "ignorance to our own realities, the orc tribes have a cultural "
      "sophistication that we seem incapable of comprehending.\""
   jasperelder_random_018 = \
      "~kAfiera D'xor says, \"Blessed be Shal'ille, who is gentle and "
      "compassionate.\""
   jasperelder_random_019 = \
      "~kAfiera D'xor says, \"All hail Jala, our lady of art, of song, and "
      "of truth.\""
   jasperelder_random_020 = \
      "~kAfiera D'xor says, \"Honor Faren, who finds a pattern in the chaos "
      "of this world.\""
   jasperelder_random_021 = \
      "~kAfiera D'xor says, \"Welcome Riija, who honors us with remembrance "
      "and vision.\""
   jasperelder_random_022 = \
      "~kAfiera D'xor says, \"Behold Mighty Kraanan, admirable in his "
      "strength and his furious action.\""
   jasperelder_random_023 = \
      "~kAfiera D'xor says, \"Praise to Qor, who seeks undoing.\""
   jasperelder_random_024 = "~kAfiera D'xor says, \"Who are you?\""
   jasperelder_random_025 = "~kAfiera D'xor says, \"What do you seek?\""
   jasperelder_random_026 = \
      "~kAfiera D'xor says, \"History does not repeat itself, historians "
      "tend to repeat each other.\""
   jasperelder_random_027 = \
      "~kAfiera D'xor says, \"The music of the earth is a source of magic in "
      "and of itself.\""
   jasperelder_random_028 = \
      "~kAfiera D'xor says, \"There are secrets beyond the ocean, beyond the "
      "mountains, beyond our settlement towns and cities certainly. Secrets "
      "that uncover themselves in time, and time.\""
   jasperelder_random_029 = \
      "~kAfiera D'xor says, \"You came here to see an old man, and now you "
      "have seen me. Why don't you make yourself comfortable there while I "
      "work. I will tell you what I can.\""
   jasperelder_random_030 = \
      "~kAfiera D'xor says, \"The so-called tokens are relics from a bygone "
      "era, from an intelligence that passed over this land so many "
      "generations before we came here to dream that nothing remains of them "
      "but souvenirs, trinkets beyond our imaginations.\""
   jasperelder_random_031 = \
      "~kAfiera D'xor says, \"Did you know that the trolls have a heritage "
      "all of their own, a history that is both rich and exclusive of ours "
      "as our history is exclusive of them?\""
   jasperelder_random_032 = \
      "~kAfiera D'xor says, \"There are no easy answers.\""
   jasperelder_random_033 = \
      "~kAfiera D'xor says, \"Life is in the process of happening all around "
      "you, right? What are you waiting for?\""
   jasperelder_random_034 = \
      "~kAfiera D'xor says, \"Stay. Rest. We shall talk by and by.\""
   jasperelder_random_035 = \
      "~kAfiera D'xor says, \"Look around and you'll find your own way. You "
      "have time, if you wish to.\""
   jasperelder_random_036 = \
      "~kAfiera D'xor says, \"The dead rise in Tos because we will it so, "
      "you see, most of our perceived enemies are thus... inventions, "
      "fancies of the collective imagination.\""
   jasperelder_random_037 = \
      "~kAfiera D'xor says, \"They say that the King has been gone from his "
      "throne these many years, and that many calamities have befallen the "
      "land because of this. What nonsense! This world follows its own "
      "indescribable path, and nothing may alter that. Kings and Queens are "
      "the personification of our vanity, no more.\""
   jasperelder_random_038 = \
      "~kAfiera D'xor says, \"It is not enough to create, we must create "
      "with risks. From great conflicts come the most powerful surges of "
      "creativity, and people aren't happy unless they're miserable. Do you "
      "follow me?\""
   jasperelder_random_039 = \
      "~kAfiera D'xor says, \"There is no right and wrong among the gods. "
      "All are equal, all are necessary. Honor their purpose, all.\""
   jasperelder_random_040 = \
      "~kAfiera D'xor says, \"The Living Tree, being a magical creature, "
      "sets its own rules for survival in many cases. A truce spell can take "
      "no hold upon them.\""
   jasperelder_random_041 = \
      "~kAfiera D'xor says, \"Maleval the Sorcerer has progressed his magic "
      "beyond the scope of what has yet been imagined. He is playing with "
      "the proverbial fire! He has told me that he can teach his sporeburst "
      "spell to a student of Qor who is ready to take that step toward "
      "Faren!\""
   jasperelder_random_042 = \
      "~kAfiera D'xor says, \"I have heard talk that a single Yrx'l Tree has "
      "been identified upon Konima's Island. Having seen the branches and "
      "leaves myself, I suspect that that is indeed what it is, although I "
      "know the tree only from legend.\""
   jasperelder_random_043 = \
      "~kAfiera D'xor says, \"I believe that our conversation is over for "
      "now. Come and see me another time.\""
   jasperelder_random_044 = \
      "~kAfiera D'xor says, \"People are basically stupid.\""
   jasperelder_random_045 = \
      "~kAfiera D'xor says, \"Go out there and fight for your living, if "
      "that's what you must do. It's easier than thinking, right?\""
   jasperelder_random_046 = \
      "~kAfiera D'xor says, \"Please leave me now. I must return to my "
      "carving.\""
   jasperelder_random_047 = \
      "~kAfiera D'xor says, \"I have nothing else to share with you now.\""
   jasperelder_random_048 = \
      "~kAfiera D'xor says, \"I must get back to my work now.\""
   jasperelder_random_049 = "~kAfiera D'xor says, \"What do you understand?\""
   jasperelder_random_050 = \
      "~kAfiera D'xor says, \"You can see yourself out.\""
