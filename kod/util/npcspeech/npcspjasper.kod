   // JasperBlacksmith (Quintor)
   jasperblacksmith_speech_001 = "~kQuintor says, \"Get out of my shop.\""
   jasperblacksmith_speech_002 = \
      "~kQuintor says, \"You'd best talk to Afiera D'xor if that's who you "
      "want to talk about.\""
   jasperblacksmith_speech_003 = \
      "~kQuintor says, \"It's a great thing to have if you're gathering "
      "firewood, but to carry as a weapon? The graveyards in these hills are "
      "crowded with axe-carrying fools from the flatlands that went up "
      "against the orc scimitar.\""
   jasperblacksmith_speech_004 = "~kQuintor says, \"Get out of my shop.\""
   jasperblacksmith_speech_005 = \
      "~kQuintor says, \"The fancy manners and dress of Barloque are a long "
      "way from Jasper, I assure you.\""
   jasperblacksmith_speech_006 = \
      "~kQuintor says, \"I've never been to the city of Barloque, so I'd be "
      "the wrong person to ask.\""
   jasperblacksmith_speech_007 = \
      "~kQuintor says, \"This is Jasper. If you want to know about Barloque, "
      "beggar, head north until you get to the coast, then go east until you "
      "reach a sewer surrounded by walls. You can't miss it.\""
   jasperblacksmith_speech_008 = \
      "~kQuintor says, \"Come back and see me when you're in these parts.\""
   jasperblacksmith_speech_009 = "~kQuintor says, \"Be gone.\""
   jasperblacksmith_speech_010 = \
      "~kQuintor says, \"They've got their heads stuck firmly in the ground "
      "in Cor Noth, to be sure. ~IUniversity~I. You would learn more in a "
      "week in these mountains than a lifetime at their so called "
      "~Iuniversity~I.\""
   jasperblacksmith_speech_011 = \
      "~kQuintor says, \"Although I have been to the city of Cor Noth, I was "
      "there as a visitor only. I know little of those people and their "
      "ways.\""
   jasperblacksmith_speech_012 = \
      "~kQuintor says, \"Cor Noth? Well, I'd say it'd be a fine place for "
      "~Ione~I such as you.\""
   jasperblacksmith_speech_013 = \
      "~kQuintor says, \"I would rather not discuss politics.\""
   jasperblacksmith_speech_014 = \
      "~kQuintor says, \"I am too busy to try and keep up with politics.\""
   jasperblacksmith_speech_015 = \
      "~kQuintor says, \"So what about them then? I don't have anything to "
      "say to you!\""
   jasperblacksmith_speech_016 = "~kQuintor says, \"A toy.\""
   jasperblacksmith_speech_017 = \
      "~kQuintor says, \"This Duke Akardius is as much a fool as Kalior. "
      "Meridian needs an honorable warrior, such as Jonas, to take the "
      "throne.\""
   jasperblacksmith_speech_018 = \
      "~kQuintor says, \"I don't know much about him.\""
   jasperblacksmith_speech_019 = \
      "~kQuintor says, \"I think you should take your political opinions out "
      "of my shop, NOW!\""
   jasperblacksmith_speech_020 = \
      "~kQuintor says, \"This man, Frular of Barloque, is alive without a "
      "soul or ancestors of merit. His business is to buy property and "
      "buildings all across the land in order to rent them for profit. "
      "BUT... this man Frular of Barloque especially wishes to acquire "
      "buildings that are sacred to their communities, and then defile them "
      "with his business dealings. He bought Wryn's Keep here in Jasper, "
      "which is the traditional fortress of the mountain warlord, and a "
      "Shal'ille temple in Cor Noth that I know of. Someday I will show him "
      "how wrong this is.\""
   jasperblacksmith_speech_021 = \
      "~kQuintor says, \"I wouldn't make a hammer to act as a weapon, and I "
      "don't know a respectable warrior that would fight with one either. A "
      "hammer, really. I know a few farmers that would try to fight with a "
      "hammer, but not a warrior. And I've known a few of the best.\""
   jasperblacksmith_speech_022 = "~kQuintor says, \"Yes, can I help you?\""
   jasperblacksmith_speech_023 = "~kQuintor says, \"Good %s, stranger.\""
   jasperblacksmith_speech_024 = \
      "~kQuintor says, \"What do you want, beggar?\""
   jasperblacksmith_speech_025 = \
      "~kQuintor says, \"I'll say this, it was a different place before the "
      "mines failed and all those outsiders left town, and before Jonas "
      "showed up with his so called ~Ifaction~I. But the people of Jasper "
      "have always been here, and always will. You could spend your life in "
      "Jasper and still not find out much about it, stranger. Sometimes it's "
      "better to let sleeping dogs lie.\""
   jasperblacksmith_speech_026 = \
      "~kQuintor says, \"Take it at face value, stranger. Just a sleepy "
      "mountain community where life is pretty simple.\""
   jasperblacksmith_speech_027 = \
      "~kQuintor says, \"Not your cup of tea, eh? Just as well you figured "
      "it out the easy way.\""
   jasperblacksmith_speech_028 = \
      "~kQuintor says, \"A mace is a child's weapon, better suited to "
      "crushing grapes than to actually fighting.\""
   jasperblacksmith_speech_029 = \
      "~kQuintor says, \"The people of Marion are complacent and stubborn. "
      "That's probably because all they have to contend with down on the "
      "flatlands are baby spiders and giant rats. No trolls, no orcs. Life "
      "must be pretty easy.\""
   jasperblacksmith_speech_030 = \
      "~kQuintor says, \"Marion? Not much to say about it, it's just north "
      "where the land flattens out.\""
   jasperblacksmith_speech_031 = \
      "~kQuintor says, \"I don't care about Marion, its problems, or your "
      "opinions on any of it. I think you were just leaving.\""
   jasperblacksmith_speech_032 = \
      "~kQuintor says, \"What reason do you have to go mining, stranger?\""
   jasperblacksmith_speech_033 = \
      "~kQuintor says, \"Many think of them as a backwards race, but that is "
      "the ignorance of those that have not dealt with them firsthand. In "
      "these mountains, if you happen to run into an orc it will most likely "
      "be a lone warrior, but even alone orcs are formidable fighters and "
      "you must watch yourself. No one knows where their central fortress is "
      "or what happens there, but you can be sure that they are waiting for "
      "the time to come out in force, for they are capable of organizing and "
      "fielding large armies. When that day comes, we will all know it.\""
   jasperblacksmith_speech_034 = \
      "~kQuintor says, \"The orcs are fearsome creatures that live up in "
      "these mountains. I have heard that there is also another breed that "
      "stays almost entirely underground, but that they are related in both "
      "blood and spirit.\""
   jasperblacksmith_speech_035 = \
      "~kQuintor says, \"I am a blacksmith, not some soldier. Go about your "
      "business and leave me alone.\""
   jasperblacksmith_speech_036 = \
      "~kQuintor says, \"If you have business with Pietro, I suggest that "
      "you take it up with him.\""
   jasperblacksmith_speech_037 = "~kQuintor says, \"Get out of my shop.\""
   jasperblacksmith_speech_038 = \
      "~kQuintor says, \"I'd rather discuss something else, if it's all the "
      "same to you.\""
   jasperblacksmith_speech_039 = \
      "~kQuintor says, \"I haven't got an opinion about her at all.\""
   jasperblacksmith_speech_040 = \
      "~kQuintor bellows, \"The affairs of the Princess have absolutely no "
      "bearing in these parts, so if you have an opinion why don't you keep "
      "it to yourself!\""
   jasperblacksmith_speech_041 = \
      "~kQuintor says, \"I don't need no pupil right now. You best be on "
      "your way, stranger.\""
   jasperblacksmith_speech_042 = \
      "~kQuintor says, \"The scimitar is the sword of the orc hordes, a "
      "large, curve-bladed weapon that is a fearsome weapon in the hands of "
      "those who have the skill. I have learned a few things wielding such a "
      "blade. Occasionally I will take a pupil under my wing and teach them "
      "some basic points.\""
   jasperblacksmith_speech_043 = \
      "~kQuintor says, \"The scimitar is an orc blade, very advanced in its "
      "design. It puts to rest any ideas that those unfamiliar with the orcs "
      "often have about the orcs being a backwards race.\""
   jasperblacksmith_speech_044 = \
      "~kQuintor says, \"I don't know anything about the scimitar.\""
   jasperblacksmith_speech_045 = \
      "~kQuintor says, \"I have something that you must see.\""
   jasperblacksmith_speech_046 = \
      "~kQuintor says, \"I might have something you'd be interested in.\""
   jasperblacksmith_speech_047 = \
      "~kQuintor says, \"I don't have anything you'd be interested in!\""
   jasperblacksmith_speech_048 = \
      "~kQuintor says, \"The sword is a warrior's weapon, and I have made my "
      "share.\""
   jasperblacksmith_speech_049 = \
      "~kQuintor says, \"I might be able to teach you a few things about the "
      "scimitar. It is a unique weapon in its balance and weight, and "
      "requires dedication if you wish to master its subtlety. Perhaps I can "
      "help you begin your studies.\""
   jasperblacksmith_speech_050 = \
      "~kQuintor says, \"It's true that I will occasionally take a pupil.\""
   jasperblacksmith_speech_051 = \
      "~kQuintor angrily says, \"I'm not taking pupils!\""
   jasperblacksmith_speech_052 = \
      "~kQuintor says, \"I don't care for the Tos people. They are blind "
      "followers, unable to fully think for themselves.\""
   jasperblacksmith_speech_053 = \
      "~kQuintor says, \"Tos is at the center of all of the idleness that "
      "plagues this land. You probably know more about it than I do.\""
   jasperblacksmith_speech_054 = \
      "~kQuintor says, \"I've got nothing to say about Tos, so if you're "
      "that curious perhaps you should go and see for ~Iyourself~I.\""
   jasperblacksmith_speech_055 = \
      "~kQuintor says testily, \"Well, I don't know anything about any no "
      "Troll Whiskey.\""
   jasperblacksmith_speech_056 = "~kQuintor says, \"Get out of my shop.\""
   jasperblacksmith_speech_057 = "~kQuintor says, \"Get out of my shop.\""
   jasperblacksmith_speech_058 = \
      "~kQuintor says, \"You would do well to avoid rumor-mongering and "
      "state your business.\""
   jasperblacksmith_speech_059 = \
      "~kQuintor says, \"My wife left these parts years ago, when the mines "
      "dried up. I... well, I haven't seen her for some time now.\""
   jasperblacksmith_speech_060 = \
      "~kQuintor says, \"That's my business, and none of your affair.\""
   jasperblacksmith_speech_061 = \
      "~kQuintor says, \"Are you asking me about my business? Who have you "
      "been talking to? I think that you should leave here.\""
   jasperblacksmith_speech_062 = \
      "~kQuintor says, \"I don't know what you're after, but Yevitan's "
      "business is his own, as mine is my own and your business best kept to "
      "yourself.\""
   jasperblacksmith_speech_063 = "~kQuintor says, \"Get out of my shop.\""
   jasperblacksmith_speech_064 = \
      "~kQuintor says, \"This is a blacksmith's shop, not a gossip parlor. "
      "You will learn to mind your own business in this town.\""
   jasperblacksmith_random_001 = \
      "~kQuintor says, \"Have you been to Tos, stranger? In Tos there is a "
      "grand arena, where Meridian's greatest warriors often test their "
      "skills against each other in a trial by combat.\""
   jasperblacksmith_random_002 = \
      "~kQuintor says, \"If you'll take my advice, don't believe half of "
      "what you hear in this town. And watch your step, if you think that "
      "the creatures in these hills are treacherous you don't know the half "
      "of it until you've gotten yourself on the wrong side of the people of "
      "Jasper.\""
   jasperblacksmith_random_003 = \
      "~kQuintor says, \"My reputation as a weaponsmith speaks for itself. "
      "Ask around, the finest sword steel in the land comes out of this "
      "forge.\""
   jasperblacksmith_random_004 = \
      "~kQuintor says, \"There is a different wisdom to the people in these "
      "hills than the other peoples of Meridian. You would never get their "
      "trust to find it out, but the people of the Cragged Mountains know "
      "how to survive. Afiera D'xor is a wise man. Go and see him, "
      "stranger.\""
   jasperblacksmith_random_005 = \
      "~kQuintor says, \"I heard from a traveler recently that a new Queen "
      "Spider is active in the Twisted Woods. An adventurer I knew once went "
      "after her eggs, on account of the price of those things. She never "
      "made it out, though, and the story ends there.\""
   jasperblacksmith_random_006 = \
      "~kQuintor says, \"Someday soon I believe the Wryn's Keep will be "
      "returned to its rightful owners, the people of Jasper. Someday very "
      "soon that cretin Frular will get his... \""
   jasperblacksmith_random_007 = \
      "~kQuintor says, \"If you want to improve your weapon skills, seek out "
      "opponents that are worthy of a good fight. You won't get anywhere "
      "fighting opponents that are beneath you.\""
   jasperblacksmith_random_008 = \
      "~kQuintor says, \"Can I show you anything in particular?\""
   jasperblacksmith_random_009 = \
      "~kQuintor says, \"The people of Jasper were once completely "
      "independent of the rest of Meridian, with our own laws, and "
      "government. In the time of my great grandfather we were a separate "
      "state, with an appointed Warlord called a Wryn. You can still see the "
      "warlord's fortress, The Wryn's Keep, at the edge of town, although "
      "now it is rented to outsiders by some businessman in ~IBarloque~I.\""
   jasperblacksmith_random_010 = \
      "~kQuintor says, \"I am in the business of selling metalware. Is there "
      "something specific you are wondering about?\""
   jasperblacksmith_random_011 = \
      "~kQuintor says, \"You must be new to these parts.\""
   jasperblacksmith_random_012 = \
      "~kQuintor says, \"You look a little lightly armed to be traveling in "
      "these mountains, stranger. Even the idiots in this town know that "
      "these hills are perilous, and you won't get any second chances.\""
   jasperblacksmith_random_013 = "~kQuintor says, \"What do you need?\""
   jasperblacksmith_random_014 = \
      "~kQuintor says, \"Are you here about some specific business, "
      "stranger?\""
   jasperblacksmith_random_015 = \
      "~kQuintor says, \"Mending a weapon with magic reduces the lifespan of "
      "that weapon. Put off mends as long as possible.\""
   jasperblacksmith_random_016 = \
      "~kQuintor says, \"Better spellcasters will damage your weapons less "
      "when they mend them, but mending is very hard on a weapon's overall "
      "life.\""
   jasperblacksmith_random_017 = \
      "~kQuintor says, \"Some creatures, like the scorpion, get a taste for "
      "your blood in the fight. They will not rest until you either run and "
      "hide or until one of you is dead.\""
   jasperblacksmith_random_018 = \
      "~kQuintor hisses, \"Are you stupid? I am asking you to leave.\""
   jasperblacksmith_random_019 = \
      "~kQuintor says, \"I am too busy to waste another moment on you. Get "
      "you gone.\""
   jasperblacksmith_random_020 = \
      "~kQuintor says, \"You waste my time, beggar. Be on your way.\""
   jasperblacksmith_trigger_afiera = "afiera"
   jasperblacksmith_trigger_afiera_d_xor = "afiera d'xor"
   jasperblacksmith_trigger_afiera_xor = "afiera xor"
   jasperblacksmith_trigger_axe = "axe"
   jasperblacksmith_trigger_b_hob = "b'hob"
   jasperblacksmith_trigger_barloque = "barloque"
   jasperblacksmith_trigger_bye = "bye"
   jasperblacksmith_trigger_cor_noth = "cor noth"
   jasperblacksmith_trigger_council = "council"
   jasperblacksmith_trigger_dagger = "dagger"
   jasperblacksmith_trigger_duke = "duke"
   jasperblacksmith_trigger_frular = "frular"
   jasperblacksmith_trigger_hammer = "hammer"
   jasperblacksmith_trigger_hello = "hello"
   jasperblacksmith_trigger_jasper = "jasper"
   jasperblacksmith_trigger_mace = "mace"
   jasperblacksmith_trigger_marion = "marion"
   jasperblacksmith_trigger_mining = "mining"
   jasperblacksmith_trigger_orc = "orc"
   jasperblacksmith_trigger_pietro = "pietro"
   jasperblacksmith_trigger_princess = "princess"
   jasperblacksmith_trigger_pupil = "pupil"
   jasperblacksmith_trigger_scimitar = "scimitar"
   jasperblacksmith_trigger_buy = "buy"
   jasperblacksmith_trigger_sell = "sell"
   jasperblacksmith_trigger_sword = "sword"
   jasperblacksmith_trigger_teach = "teach"
   jasperblacksmith_trigger_learn = "learn"
   jasperblacksmith_trigger_learn_2 = "learn"
