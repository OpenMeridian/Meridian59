   jasperbanker_trigger_duke = "duke"
   jasperbanker_trigger_frular = "frular"
   jasperbanker_trigger_gerah_springers = "gerah springers"
   jasperbanker_trigger_hello = "hello"
   jasperbanker_trigger_herbutte = "herbutte"
   jasperbanker_trigger_herbut = "herbut"
   jasperbanker_trigger_jasper = "jasper"
   jasperbanker_trigger_joguer = "joguer"
   jasperbanker_trigger_koldor = "koldor"
   jasperbanker_trigger_jonas = "jonas"
   jasperbanker_trigger_justicar = "justicar"
   jasperbanker_trigger_justicar_2 = "justicar"
