   jasperblacksmith_trigger_whiskey = "whiskey"
   jasperblacksmith_trigger_widow = "widow"
   jasperblacksmith_trigger_widow_qesino = "widow qesino"
   jasperblacksmith_trigger_witwe_qesino = "witwe qesino"
