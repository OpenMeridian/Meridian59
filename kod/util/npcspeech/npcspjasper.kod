   // JasperBartender (Pietro)
   jasperbartender_speech_001 = \
      "~kPietro says, \"Crazy old coot. ~IYou'll~I schtay away from him, if "
      "~Iyou~I know whaz good for ~Iyou~I!! I'll schay nothing more on the "
      "subject, not a freggin' WORD.\""
   jasperbartender_speech_002 = \
      "~kPietro says, \"I don't know who you're talking about.\""
   jasperbartender_speech_003 = \
      "~kPietro says, \"Whaz the matter with you you can't keep your nose in "
      "your own bizniz!?! ~Iwho~I ARE you, anywayz?\""
   jasperbartender_speech_004 = \
      "~kPietro says, \"~Ibarloque~I is the BOTTOM of the river, you know "
      "what I mean?? Well, let'z juscht schay you ~Idon't~I, although "
      "~II'm~I not so schure ~Iabout that~I. I'm ~Inot~I so schure about "
      "that ~Iat all~I. But listen anywayz. The ~Iold people~I in thiz town "
      "talk about a ~Ischyschtem of schewerz~I that run under the WHOLE of "
      "Meridian, not juscht under Barloque where the ~Iratz~I come from... "
      "that schewerz ~Iconnect~I TOZ, JASPER, COR NOTH ~Iand Barloque~I, and "
      "that schyschtem empties at ~IBARLOQUE~I. That means that Barloque, "
      "the ~IRoyal Capitol~I of this land, is the end of the line for ~Iall "
      "that~I SEWAGE, is one ~IBIG~I schewer... \""
   jasperbartender_speech_005 = "~kPietro says, \"I don't travel much.\""
   jasperbartender_speech_006 = \
      "~kPietro says, \"Pox on you, pox on Barloque, pox on your anchestorz, "
      "pox on your freggin' bizniz!! Git out!!!\""
   jasperbartender_speech_007 = \
      "~kPietro says, \"Broom? What freggin' ~Ibroom~I?\""
   jasperbartender_speech_008 = \
      "~kPietro says, \"What, do I schtudder? Barz CLOZED, now ~Igit~I, hic, "
      "~IGIT~I out!\""
   jasperbartender_speech_009 = \
      "~kPietro says, \"I'd just as soon ~Ispit~I on you as ~Ischerve~I you "
      "a DRINK, donkey.\""
   jasperbartender_speech_010 = "~kPietro glances up to watch you leave."
   jasperbartender_speech_011 = "~kPietro says, \"Humpf.\""
   jasperbartender_speech_012 = \
      "~kPietro says, \"Thazz right, get on out. Go on. OUT!!!\""
   jasperbartender_speech_013 = \
      "~kPietro says, \"Cor Noth is where the ~Ianarchistz~I are, plotterz "
      "and ~Ischabotage expertz~I. Thaz RIGHT. Humpf. Good for them, I "
      "schay, who ~Ifreggin'~I carez. Burn the rest of Meridian, and Jasper "
      "will schtill be here. ~ILet~I them do whatever they want, burn the "
      "whole freggin' stewpot down to the freggin' flat prairie it squatz "
      "on.\""
   jasperbartender_speech_014 = \
      "~kPietro says, \"It's supposed to be pretty nice there.\""
   jasperbartender_speech_015 = \
      "~kPietro says, \"I ~Isuppoze~I thaz where YOU'RE from, dog, an I "
      "suppoze ~Ithiz town~I juz izn't up to your freggin' ~Istandardz~I, "
      "either.\""
   jasperbartender_speech_016 = \
      "~kPietro says, \"Conzil? They have tokens, and it ~Iiz sched~I that "
      "the tokenz can MOVE, ~Iall by theschelvz~I!!  I wonderz whatz in them "
      "there tokens that mashkes them able to move like that.\""
   jasperbartender_speech_017 = \
      "~kPietro says, \"Keep your freggin' politics to yourself, stranger. "
      "~INo one~I here is interested in what you have to say about the "
      "council.\""
   jasperbartender_speech_018 = \
      "~kPietro says, \"Lizzen. Take your POLITICZ, and ~ISCHTICK~I them in "
      "your ~Igob~I.\""
   jasperbartender_speech_019 = "~kPietro says, \"Get LOST, ~Ijack azz~I.\""
   jasperbartender_speech_020 = \
      "~kPietro says, \"That freggin' Duke ~Ihatez~I Jasper, and he hatez "
      "the peoplez from Jasper, too. And you know WHY? Thaz right, it'z "
      "~Ibecausche~I he can't ~ICONTROL~I us, or this town, or any of it. "
      "~IPOX~I on him. Pox on hiz armiez too, let him just march hiz armiez "
      "into theze hillz and schow us differently. WE got a few thingz we "
      "will schow HIM. Thaz ~Iright~I. There'll be freggin' bodiez all over "
      "~Ithiz~I freggin' mountain.\""
   jasperbartender_speech_021 = "~kPietro says, \"I don't follow politics.\""
   jasperbartender_speech_022 = \
      "~kPietro says, \"Itz none of your freggin' bizniz what I think, "
      "puke.\""
   jasperbartender_speech_023 = \
      "~kPietro mutters, \"Good for nothin', those idiotz, when life treatz "
      "them badly they alwayz have to go blame fate for it and not "
      "themschelvez.\""
   jasperbartender_speech_024 = "~kPietro abruptly says, \"Yes, WHAT?!?\""
   jasperbartender_speech_025 = "~kPietro says, \"What do you want?\""
   jasperbartender_speech_026 = \
      "~kPietro spits, landing close to Jonas' boot, and turns away."
   jasperbartender_speech_027 = \
      "~kPietro says, \"I have only seen that man once or twice. He is "
      "wandering around.... Know what I mean? He tries to sell that garbage "
      "of his.\""
   jasperbartender_speech_028 = \
      "~kPietro says, \"Thiz town'z got more ~Isecretz~I than a Barloque "
      "harlot. And thaz ~Iall~I I'm going to schay on the matter. That is "
      "freggin' it. Not ANOTHER ~Iword~I. No. Not a ~IWORD~I.\""
   jasperbartender_speech_029 = \
      "~kPietro says, \"You're obviously a stranger to these parts, so let "
      "me give you a little advice. Mind your own freggin' business in this "
      "town, same as everyone else.\""
   jasperbartender_speech_030 = \
      "~kPietro says, \"Therez nothing for you in thiz town.\""
   jasperbartender_speech_031 = \
      "~kPietro says, \"We ~Ihatez~I thoze people.\""
   jasperbartender_speech_032 = \
      "~kPietro says, \"I don't know. Go see for yourself.\""
   jasperbartender_speech_033 = "~kPietro says, \"Barz clozed. ~IGIT~I out.\""
   jasperbartender_speech_034 = \
      "~kPietro says, \"Rumor haz it that sche's not talking about a god, "
      "but about herschelf.\""
   jasperbartender_speech_035 = \
      "~kPietro says, \"Sche's juscht a little girl, and everybody knowz "
      "kidz don't know nuthin' about nuthin'.\""
   jasperbartender_speech_036 = \
      "~kPietro says, \"~IHic~I Izn't sche that little danschin' girl who "
      "thinkz the magic nodez are callin' her?\""
   jasperbartender_speech_037 = \
      "~kPietro says, \"Out ~Ihic~I out of my bar and ~Ihic~I, mind your own "
      "freggin' bizniz.\""
   jasperbartender_speech_038 = \
      "~kPietro says, \"What I've heard iz: ...sche doesn't drain the nodez "
      "completely, sche only ever takez a little bit, and it takez a while "
      "for that to regenerate.\""
   jasperbartender_speech_039 = \
      "~kPietro says, \"Everybody's getting all worked up and it's juscht a "
      "kid. What harm can a kid do, anywayz?\""
   jasperbartender_speech_040 = \
      "~kPietro says, \"~IHic~I, schtupid, good-for-nuthin' kidz. Alwayz "
      "schhhmelly diaperz, can't leave 'em alone to do nuthin'.\""
   jasperbartender_speech_041 = \
      "~kPietro says, \"The Princezz? Well, ~Inice~I and ~Itidy~I how she "
      "got her father to DISAPPEAR, ischn't it? I know, they ~Ischay~I that "
      "the King loscht hiz ~Imind~I, and I believe you me he ~Idid~I. But "
      "peoplez mindz can also be manipu... they can be manipulative... "
      "peoples minds can also be ~Imanipulated~I by magic and witchcraft, "
      "and after all who does the princezz schurround herschelf with but "
      "people of ~Imagic~I, sorcerers and mages. I'm not saying it wuz the "
      "princezz herschelf, but her faction HAZ done ~IVERY WELL~I for itself "
      "with the old man out of their way. If you aschk me, which ~Iyou "
      "did~I, it'z that Alzahakar that done it to the King like that. He "
      "knowz more about Riija than anyone realizez... \""
   jasperbartender_speech_042 = \
      "~kPietro says, \"She doesn't come here much, if you hadn't noticed.\""
   jasperbartender_speech_043 = \
      "~kPietro says, \"What are you, a ~Ispy~I? Are you a ~ISPY~I? Git out "
      "of my bar, you freggin' Princess ~Ischpy~I you!\""
   jasperbartender_speech_044 = \
      "~kPietro says, \"Dizappeared on hiz way to Toz. Vanished into thin "
      "air, becuz thaz what we have up here in the mountainz, thin air. If "
      "you ask me though, and you did, his friggin' widow and her friggin' "
      "blacksmith boyfriend killed him, left hiz body up there in the "
      "freggin' mountainz, murdered him and took all the money he wuz headed "
      "to Toz with. Becauze he had a bundle with him, and that dizappeared "
      "too. HA!\""
   jasperbartender_speech_045 = "~kPietro says, \"He left town.\""
   jasperbartender_speech_046 = \
      "~kPietro looks at you for a long moment, shaking his head."
   jasperbartender_speech_047 = \
      "~kPietro says, \"He'z doing better than ever before, better than "
      "anyone elze in thiz town if you know what I mean. But I guez you "
      "don't, or you wouldn't be azking. Okay, let me schpell it out for "
      "you. He should be doing freggin' fine, since he freggin' murdered old "
      "man Qesino and moved in with hiz freggin' wife! Don't you think you'd "
      "be doing pretty freggin' well if you freggin' murdered old man Qesino "
      "and moved in with hiz freggin' wife!?!\""
   jasperbartender_speech_048 = \
      "~kPietro says, \"He's the blacksmith in these parts. He's just across "
      "the way, and if you've got business with him you should discuss it "
      "with him.\""
   jasperbartender_speech_049 = \
      "~kPietro says, \"I don't want to freggin' know, and if you know whaz "
      "good for you, neither do you. But if you want the real schtory on "
      "Quintor, find his freggin' ex-wife! HA! You can bet sche'z with that "
      "miner sche ran off with, if you can find her, that iz. Bring a shovel "
      "when you go looking, becauze you'll have to dig up half this mountain "
      "to find them both. Might have to usche your imagination too, 'cause "
      "the piecez might not fit together scho good... that's what I mean by "
      "if you know what'z good for you... \""
   jasperbartender_speech_050 = \
      "~kPietro says, \"Plenty of SCHEECRETS in these mountains. You ~Iwatch "
      "your step~I, or you could become ~Ione~I of them.\""
   jasperbartender_speech_051 = \
      "~kThe room goes silent as %s mentions stunted dwarf."
   jasperbartender_speech_052 = \
      "~kPietro says, \"Toz is really ~Ithe schite of ancient EVIL~I. They "
      "schay that at night ~Ithe dead get up and rize~I in Toz, that they "
      "~Iwalk the earth~I. The city itschelf is built upon ~Ithe ancient "
      "schtronghold of Qor~I. Thatz RIGHT!! ~IANCIENT EVIL~I!! And "
      "~Ischomeday schoon~I that evil will make itschelf known to Meridian, "
      "and thiz land will not be the schame!! The bodies of those "
      "flatlanderz will be schtacked in big moundz, ~Ischacrificez~I to the "
      "~IEVIL QOR~I and to their own ~Iignorance~I. ~IHumpf~I. HUMPH!\""
   jasperbartender_speech_053 = "~kPietro says, \"Never been there.\""
   jasperbartender_speech_054 = \
      "~kPietro says, \"Get out of here. NOBODY in theez partz iz, ~Ihic~I, "
      "iz ~Iinterested~I in the wayz of that stink-hole Toz, or ~Inobody~I "
      "from there neither.\""
   jasperbartender_speech_055 = \
      "~kPietro says, \"Troll Whiskey iz illegal, or didn't you know? I "
      "don't know nothing about Troll Whiskey, all I sell here is beer. "
      "Beer, thaz it. Period.\""
   jasperbartender_speech_056 = \
      "~kPietro says, \"Oh, yes, the bereaving widow. She'z so freggin' "
      "broken up about her husband'z dizappearance, that she freggin' "
      "shacked up with the blacksmith!! Thick as thieves, thaz right, thick "
      "as freggin' thieves. But you didn't hear that from me... \""
   jasperbartender_speech_057 = \
      "~kPietro says, \"She runs the inn, just down the street.\""
   jasperbartender_speech_058 = \
      "~kPietro says, \"You ask too many questions, stranger, schticking "
      "your noze around where you got no biznez. Why don't you leave Jasper "
      "while you still got a noze on your freggin' face.\""
   jasperbartender_speech_059 = \
      "~kPietro says, \"That old man haz got hiz own planz, that I know. Did "
      "you know that in hiz younger, ~Ihic~I, hiz younger dayz he was the "
      "~IFinancial Minischter~I to ~Ithe King~I? Thaz RIGHT. ~Ipowerful~I "
      "man. They threw him out, too, when the, hic, when the King loscht hiz "
      "mind. Wanted to ~IKILL~I him, he'z a powerful man ~Iand~I from Jasper "
      "to boot. ~Ibut~I... he escaped, and they wouldn't dare to come for "
      "him here. I ~Ibet you~I that schomeday ~Ischoon~I he goes right back "
      "down there and takez back what he'z due. And GOOD FOR HIM!!\""
   jasperbartender_speech_060 = \
      "~kPietro says, \"Yes, the banker. Royal Bank of Jasper.\""
   jasperbartender_speech_061 = \
      "~kPietro says, \"Therez ~Inobody~I in thesche partz by that name, "
      "~ISTRANGER~I.\""
   jasperbartender_speech_062 = \
      "~kPietro says, \"Schtupid... idiot... schtupid idiot. And "
      "~Igreedy~I... \""
   jasperbartender_random_001 = \
      "~kPietro says, \"Drink! Eat! Rest up here while you can, you'll "
      "~Ineed~I your schtrength for fighting monschters and BAD people in "
      "her..out there! ~Ihic~I!\""
   jasperbartender_random_002 = \
      "~kPietro says, \"I have HEARD, ~Ihic~I, that a great warrior "
      "reschides in Cor Noth, a maschter warrior don't shou know. He wuz the "
      "~Icaptain of the Royal Guardz~I, okay? He is schupposed to know all "
      "that there iz to know about battling monschsters, and demonz, and "
      "schuch... \""
   jasperbartender_random_003 = \
      "~kPietro says, \"Barloque iz the royal capitol of all the land "
      "outschide Jasper, and a place overwhelming with wealth. Aschk Yevitan "
      "about it, he usched to LIVE there.\""
   jasperbartender_random_004 = \
      "~kPietro says, \"Schtay away from the trollz in thesche hillz, they "
      "are deadly. DEADLY. The orcz too, becauze they will schometimez form "
      "~IWAR PARTIES~I and ~Iraid~I the human townz! Yes! ~Ivery~I "
      "dangerouz!\""
   jasperbartender_random_005 = \
      "~kPietro says, \"I could ~Itell~I you a few thinzz about thiz town "
      "that would ~Imake~I your hairz schtand on their enz. Thazz RIGHT. On "
      "their freggin' enz.\""
   jasperbartender_random_006 = \
      "~kPietro says, \"Schtart aschking questions around here, and you "
      "don't ever know what you might turn up. Probably ~Iwouldn't~I WANT to "
      "know, neither.\""
   jasperbartender_random_007 = \
      "~kPietro says, \"You ~Iwatch~I your step around here, stranger. "
      "Schomeone will freggin' hit you over the freggin' HEAD and take your "
      "money. Even ~Ihappenz to localz~I, you can believe me there, scho "
      "don't go thinking you're ANYTHING FRIGGIN' SCHPECIAL... \""
   jasperbartender_random_008 = \
      "~kPietro says, \"Even ~IJasper's~I got it'z schare of IDIOTZ. No "
      "namez ~Imentioned~I, but that Zhieu B'hob is a freggin' horschez "
      "rump. Dumb az a cedar freggin' post.\""
   jasperbartender_random_009 = \
      "~kPietro says, \"Yevitan, now he'z a wize old bugger. He'z got planz, "
      "BIG planz, but he wazn't schaying nothing till that Jonz, Jonarc, "
      "whatz hiz face came round. Schmart guy.\""
   jasperbartender_random_010 = \
      "~kPietro says, \"Pick your path out of Jasper carefully, stranger. "
      "The road to the east is infested with an army of trolls and orcs, "
      "enough to challenge any army the freggin' flatlands could raise.\""
   jasperbartender_random_011 = \
      "~kPietro says, \"People in these parts aren't like the rest of "
      "Meridian folks. It's a breed apart up here, and you'd best be mindful "
      "of the differences.  Especially now with Jonas and his gang, they "
      "don't like no one talking bad bout them.\""
   jasperbartender_random_012 = \
      "~kPietro says, \"We didn't used to get so many strangers up here in "
      "the mountains.  Wish that damned Jonas and his guppies never thought "
      "to come here.\""
   jasperbartender_random_013 = "~kPietro is waiting to take your order."
   jasperbartender_random_014 = \
      "~kPietro says, \"There is a bank here in Jasper, just around the "
      "corner. It is left over from the days that the freggin' mines "
      "prospered.\""
   jasperbartender_random_015 = \
      "~kPietro says, \"Hey, you gonna buy a beer, or what? This isn't a "
      "freggin' flophouse!!!\""
   jasperbartender_random_016 = \
      "~kPietro says, \"If you're here to drink and eat, then drink and eat. "
      "I don't have time for your damned conversation.\""
   jasperbartender_random_017 = \
      "~kPietro says, \"You're better off by not asking too many questions "
      "in these parts. We like our privacy.\""
   jasperbartender_random_018 = \
      "~kPietro says, \"Money freggin' talks in this land, so you better "
      "figure out how to freggin' get it.\""
   jasperbartender_random_019 = \
      "~kPietro says, \"You might be surprised at what you can find out by "
      "just listening.\""
   jasperbartender_random_020 = \
      "~kPietro says, \"I don't care where you sleep, but you're not "
      "sleeping here.\""
   jasperbartender_random_021 = \
      "~kPietro grumbles, \"It used to be nice and quiet round these here "
      "parts.  Haven't been this many loafers round since the mines dried "
      "up.\""
   jasperbartender_random_022 = \
      "~kPietro says, \"We like things the way they are in these parts.\""
   jasperbartender_random_023 = \
      "~kPietro says, \"You don't want to freggin' start no trouble here.\""
   jasperbartender_random_024 = "~kPietro says, \"~IHic~I.\""
   jasperbartender_random_025 = "~kPietro says, \"What do you need?\""
   jasperbartender_random_026 = \
      "~kPietro says, \"~IHit~I the freggin' ROAD.\""
   jasperbartender_random_027 = \
      "~kPietro says, \"Did you need something? No? No? Well then, you "
      "freggin' get going.\""
   jasperbartender_random_028 = \
      "~kPietro says, \"If I wuz you, dungface, I'd walk out of here while "
      "you still can.\""
   jasperbartender_random_029 = \
      "~kPietro says, \"Hit the brickz, you freggin' road trash. Pietroz iz "
      "C-L-O-S-E-D.\""
   jasperbartender_random_030 = "~kPietro screams, \"WHAT!?!\""
   jasperbartender_random_031 = \
      "~kPietro yells, \"OUT! Everyone freggin' OUT!\""
   jasperbartender_random_032 = \
      "~kPietro grumbles, \"Stinkin rebelz, ~IHic~I, freggin' good for "
      "nothin loutz, ~IHic~I, come inz an take o'er myz bar.  Thez don't "
      "even askz me if'n I'm willin.\""
   jasperbartender_random_033 = \
      "~kPietro shouts, \"The bar iz closed. Get out.\""
   jasperbartender_trigger_afiera_d_xor = "afiera d'xor"
   jasperbartender_trigger_afiera_xor = "afiera xor"
