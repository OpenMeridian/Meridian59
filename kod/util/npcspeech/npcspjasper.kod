   jaspermerchant_trigger_whiskey = "whiskey"
   jaspermerchant_trigger_widow = "widow"
   jaspermerchant_trigger_qesino = "qesino"
   jaspermerchant_trigger_wool = "wool"
   jaspermerchant_trigger_wryn_s_keep = "wryn's keep"
