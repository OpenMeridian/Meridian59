jasperblacksmith_trigger_mining = de "schürfen"
jasperblacksmith_trigger_orc = de "ork"
jasperblacksmith_trigger_princess = de "prinzessin"
jasperblacksmith_trigger_pupil = de "schüler"
jasperblacksmith_trigger_scimitar = de "säbel"
jasperblacksmith_trigger_buy = de "kaufen"
jasperblacksmith_trigger_sell = de "verkauf"
jasperblacksmith_trigger_sword = de "schwert"
jasperblacksmith_trigger_teach = de "lernen"
jasperblacksmith_trigger_learn = de "lehre"
jasperblacksmith_trigger_learn_2 = de "beibringen"
jasperblacksmith_trigger_widow = de "witwe"
jasperblacksmith_trigger_widow_qesino = de "witwe qesino"
