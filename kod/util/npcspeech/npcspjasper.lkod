jaspermerchant_trigger_bye_2 = de "wiedersehen"
jaspermerchant_trigger_council = de "ratsmitglied"
jaspermerchant_trigger_duke = de "herzog"
jaspermerchant_trigger_goat = de "ziege"
jaspermerchant_trigger_hello = de "hallo"
jaspermerchant_trigger_princess = de "prinzessin"
jaspermerchant_trigger_widow = de "witwe"
jaspermerchant_trigger_wool = de "wolle"
jaspermerchant_trigger_wryn_s_keep = de "würms-feste"
jaspermerchant_trigger_wryn_s_keep_2 = de "würmsfeste"
jaspermerchant_trigger_wryn_s_keep_4 = de "feste"
jaspermerchant_trigger_yes = de "ja"
