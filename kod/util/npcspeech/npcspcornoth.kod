   cornothsergeant_trigger_dragonfly = "dragonfly"
   cornothsergeant_trigger_duke = "duke"
   cornothsergeant_trigger_hello = "hello"
   cornothsergeant_trigger_jasper = "jasper"
   cornothsergeant_trigger_jonas = "jonas"
