NpcSpeechWanderer is NpcSpeech
// NPC talk of wandering NPCs, the Lich and all towns:
// answers to trigger words and random lines.
// Each line is a resource (EN here, DE in the .lkod); Library adds the
// lists in CreateSpeechLibrary and CreateRandomLibrary.

constants:

   include blakston.khd

resources:

   include npcspwanderer.lkod

   // DarkWizard (Maleval)
   darkwizard_speech_001 = \
      "~kMaleval says, \"A toy for children who wish they could live forever "
      "and lose their souls in doing so. A most remarkable experience.\""
   darkwizard_speech_002 = \
      "~kMaleval says, \"Why don't you ask the priestesses about them. I "
      "would be interested to hear their response.\""
   darkwizard_speech_003 = \
      "~kMaleval says, \"Please, do not demean your intellect by believing "
      "that the only powers in our world are those of some glorified "
      "heroes.\""
   darkwizard_speech_004 = \
      "~kMaleval says, \"I remember the people of Brax as very "
      "industrious... perhaps too narrow in their vision... or perhaps "
      "merely very unlucky.\""
   darkwizard_speech_005 = \
      "~kMaleval says, \"I have means of getting all that I desire. Keep "
      "your precious little items.\""
   darkwizard_speech_006 = \
      "~kMaleval says, \"Crafting a spell requires concentration, practice "
      "and special reagents.\""
   darkwizard_speech_007 = \
      "~kMaleval says, \"If there was no Faren would the winds cease to "
      "blow? The winds have been blowing for longer than people have "
      "believed in the thunder god.\""
   darkwizard_speech_008 = \
      "~kMaleval glares at you, then flashes a dark smile, \"Greetings.\""
   darkwizard_speech_009 = \
      "~kMaleval says, \"I can help you better understand magic and how you "
      "learn it.\""
   darkwizard_speech_010 = \
      "~kMaleval says, \"They will be no match for the dark forces they "
      "hunt. Their swords will be their downfall.\""
   darkwizard_speech_011 = \
      "~kMaleval says, \"Please consider that the hunters and the "
      "necromancers serve the same function. Their methods and ideologies "
      "may differ, but make no mistake, both feed on souls.\""
   darkwizard_speech_012 = \
      "~kMaleval says, \"How is it that a god can die? Legend says by a "
      "dagger. Ha, what poppycock indeed.\""
   darkwizard_speech_013 = \
      "~kMaleval says, \"Kraanan is merely an excuse to get drunk and fight "
      "and feel good about doing so.\""
   darkwizard_speech_014 = \
      "~kMaleval says, \"The lich was the first incarnation of the Ancient "
      "one in this realm. It is a child of darkness that will bring others "
      "into this land. It is a herald of doom for this world. The Ancient "
      "one has awakened.\""
   darkwizard_speech_015 = \
      "~kMaleval says, \"They are the proof that things are not as pure as "
      "the priestesses would have you believe. Of course they are forces of "
      "incredible power in our world.\""
   darkwizard_speech_016 = \
      "~kMaleval smiles, \"There is no goddess of evil. Just evil people who "
      "cannot take ownership of their own guilt.\""
   darkwizard_speech_017 = \
      "~kMaleval says, \"Reagents are items that store a concentrated amount "
      "of energy that you can channel through a spell. Some are very "
      "difficult to acquire. Others can be found easily. Then there is "
      "Solagh.\""
   darkwizard_speech_018 = \
      "~kMaleval says, \"Ah, the ultimate illusion. Riija does not exist! "
      "How simple it is to play tricks on the human mind.\""
   darkwizard_speech_019 = "~kMaleval says, \"I am not a peddler, cretin.\""
   darkwizard_speech_020 = \
      "~kMaleval says, \"If she is so powerful, then why does she let good "
      "people die?! Are you telling me a goddess does not have the power to "
      "protect her children?!\""
   darkwizard_speech_021 = \
      "~kMaleval says, \"Solagh. Ha. The apothecaries of the land are wise "
      "to guard their secret else they will lose the monopoly on this "
      "substance.\""
   darkwizard_speech_022 = \
      "~kMaleval says, \"Long ago the Ancient one created instruments "
      "through which he could manipulate his surroundings. He did this to "
      "prepare for his rebirth. The urn is one such instrument.\""
   darkwizard_speech_023 = \
      "~kMaleval says, \"She was a child when she encountered one of the "
      "most powerful forces in the universe. When the Ancient one opened his "
      "eyes and saw her, her soul became a toy.\""
   darkwizard_speech_024 = \
      "~kMaleval says, \"You must give the man credit for escaping the "
      "destruction of his homeland. He was a shameless survivor.\""
   darkwizard_random_001 = "~kMaleval practices bizarre incantations."
   darkwizard_random_002 = \
      "~kMaleval says, \"There is no power in religion. None whatsoever.\""
   darkwizard_random_003 = \
      "~kMaleval says, \"Two sorcerers may employ the same spell, but it "
      "will be vastly different depending on their own skill.\""
   darkwizard_random_004 = \
      "~kMaleval says, \"Spells do not come from the gods. They come from "
      "within. Anyone can employ the mystic arts if they have the "
      "inclination to learn the proper components.\""
   darkwizard_random_005 = \
      "~kMaleval says, \"The wild girl Miriana is so young and innocent, yet "
      "her untamed mind speaks volumes of truth.\""
   darkwizard_random_006 = \
      "~kMaleval says, \"There are times and places where magic grows "
      "stronger.\""
   darkwizard_random_007 = \
      "~kMaleval says, \"The gods are merely a convenient way to describe "
      "that which cannot be explained by simple minds.\""
   darkwizard_random_008 = \
      "~kMaleval grumbles, \"I am in no mood to be trifled with.\""
   darkwizard_random_009 = \
      "~kMaleval smiles, \"I sense an awakening. Someone has learned a new "
      "spell.\""
   darkwizard_random_010 = "~kMaleval says, \"Which god do you believe in?\""
   darkwizard_random_011 = \
      "~kMaleval says, \"You need to expand your horizons. However, "
      "expanding your horizon will mean limiting someone else's.\""
   darkwizard_random_012 = \
      "~kMaleval waves his hands as if caressing a floating animal. You "
      "sense magic in the air."
   darkwizard_random_013 = \
      "~kMaleval winks an eye at you. You feel as though he has looked into "
      "your very soul. He shakes his head and grunts."
   darkwizard_random_014 = \
      "~kMaleval waves a hand and says some ancient word. The room suddenly "
      "smells better."
   darkwizard_random_015 = \
      "~kMaleval begins coughing violently. He wiggles his fingers slightly "
      "and the coughing subsides."
   darkwizard_random_016 = \
      "~kMaleval says, \"My liege, I have done the research that you have "
      "requested. She is not in touch with the needs of her followers. It "
      "may be the key.\""
   darkwizard_random_017 = \
      "~kMaleval says, \"I require reimbursement for my efforts, Akardius. "
      "Much of my time was lost doing your work.\""
   darkwizard_random_018 = \
      "~kMaleval says, \"I have scried the counselors meeting, my liege. For "
      "the appropriate price, I can tell you their minds with regards to the "
      "Princess.\""
   darkwizard_random_019 = \
      "~kMaleval says, \"My magic tells me of a new agent of the Bourgeois "
      "Castle. When you ascend to the throne, I wish not to be forgotten, my "
      "liege.\""
   darkwizard_random_020 = \
      "~kDuke Akardius says, \"Good, Maleval. You will be paid as promised "
      "for your information.\""
   darkwizard_random_021 = \
      "~kDuke Akardius says, \"Remember that we have renegotiated the price, "
      "Maleval, so you would do well to hold your tongue.\""
   darkwizard_random_022 = \
      "~kDuke Akardius says, \"Maleval, I will remember your station when I "
      "become King. You will get what you deserve.\""
   darkwizard_random_023 = "~kMaleval bows to Duke Akardius."
   darkwizard_random_024 = \
      "~kThe Duke nods to Maleval, \"That will be all for now, wizard.\""
   darkwizard_random_025 = \
      "~kMaleval whispers something softly and the Duke grins."
   darkwizard_random_026 = \
      "~kMaleval says to the Duke, \"Will there be anything else, my liege?\""
   darkwizard_random_027 = "~kThe Duke says to Maleval, \"You may leave.\""
   darkwizard_random_028 = \
      "~kMaleval says, \"I do not wish to be disturbed.\""
   darkwizard_random_029 = \
      "~kMaleval says, \"Justice is blind, would you not agree?\""
   darkwizard_random_030 = \
      "~kMaleval's ring glows for a moment. The dark wizard laughs to "
      "himself."
   darkwizard_random_031 = \
      "~kMaleval says, \"I grow hungry.\" He then waves his hand and smiles "
      "contently, \"That's better.\""
   darkwizard_random_032 = \
      "~kMaleval says, \"That old wizard Alzahakar believes that the Tokens "
      "have great power. Reunite the tokens. Ha! He and his followers are on "
      "a fool's errand.\""
   darkwizard_random_033 = \
      "~kMaleval begins to make some guttural sounds. All of the dust near "
      "him vanishes."
   darkwizard_random_034 = \
      "~kMaleval speaks an ancient three word incantation. The last word "
      "sounds something like \"necktie.\""
   darkwizard_random_035 = \
      "~kMaleval bows to Zuxana, \"My lady, I have information for you.\""
   darkwizard_random_036 = "~kMaleval says to the priestess, \"As you wish.\""
   darkwizard_random_037 = \
      "~kPriestess Zuxana says, \"~I~rAh, Maleval, what news do you have for "
      "me?~I~k\""
   darkwizard_random_038 = \
      "~kPriestess Zuxana says, \"~I~rWe shall finish our discussion later, "
      "Maleval.~I~k\""
   darkwizard_random_039 = \
      "~kMaleval and Priestess Zuxana begin to laugh together."
   darkwizard_random_040 = \
      "~kMaleval says to Priestess Zuxana, \"I have ~Ispoken~I with the "
      "Duke.\""
   darkwizard_random_041 = \
      "~kPriestess Zuxana says to the dark wizard, \"~I~rIs all going as I "
      "planned?~I~k\""
   darkwizard_random_042 = \
      "~kMaleval grins, \"Zuxana, the one that you spoke of before, is now "
      "dead.\""
   darkwizard_random_043 = \
      "~kSensing that you are listening, Maleval abruptly ends his "
      "conversation with the Priestess."
   darkwizard_trigger_amulet = "amulet"
   darkwizard_trigger_ancient_one = "ancient one"
   darkwizard_trigger_ancient_ones = "ancient ones"
   darkwizard_trigger_brax = "brax"
   darkwizard_trigger_sell = "sell"
   darkwizard_trigger_components = "components"
   darkwizard_trigger_components_2 = "components"
   darkwizard_trigger_faren = "faren"
   darkwizard_trigger_hello = "hello"
   darkwizard_trigger_help = "help"
   darkwizard_trigger_hunter = "hunter"
   darkwizard_trigger_hunter_sword = "hunter sword"
   darkwizard_trigger_jala = "jala"
   darkwizard_trigger_kraanan = "kraanan"
   darkwizard_trigger_lich = "lich"
   darkwizard_trigger_necromancer = "necromancer"
   darkwizard_trigger_qor = "qor"
   darkwizard_trigger_reagents = "reagents"
   darkwizard_trigger_riija = "riija"
   darkwizard_trigger_buy = "buy"
   darkwizard_trigger_shal_ille = "shal'ille"
   darkwizard_trigger_sha_lill = "sha-lill"
   darkwizard_trigger_solagh = "solagh"
   darkwizard_trigger_urn = "urn"
   darkwizard_trigger_venya_cyr = "venya'cyr"
   darkwizard_trigger_zarrus = "zarrus"

   // Heretic (Miriana)
   heretic_speech_001 = \
      "~kMiriana says, \"Oh, pretty, pretty pendant! Ouch! Hey, leave my "
      "soul alone! I only wanted... I only wanted... I only wanted to be "
      "pretty too.\""
   heretic_speech_002 = \
      "~kMiriana looks at you sadly. \"This innocent little magic node never "
      "did anything to anyone. It will not hurt anyone and it never has.\""
   heretic_speech_003 = \
      "~kMiriana says, \"Cows go to heaven, Goats go to the Underworld.\""
   heretic_speech_004 = "~kMiriana says, \"I don't like towns.\""
   heretic_speech_005 = \
      "~kMiriana says, \"Brax, Brax, Brax, you will never get the facts.\""
   heretic_speech_006 = "~kMiriana says, \"I don't have hardly any money.\""
   heretic_speech_007 = "~kMiriana says, \"I don't like towns.\""
   heretic_speech_008 = \
      "~kMiriana says, \"Not all things seem as they are, if you want to "
      "learn something about the truth, then perhaps you should try to talk "
      "seriously with Madelia.\""
   heretic_speech_009 = \
      "~kMiriana shrieks shrilly, \"Bad, bad, bad people. All because of "
      "him. They know, they know what they are doing, do you?\""
   heretic_speech_010 = \
      "~kMiriana sighs, \"How can you take ~Ime~I for a necromancer?\""
   heretic_speech_011 = \
      "~kMiriana jumps up and down clapping her hands and says, \"Very glad "
      "to meet you!\""
   heretic_speech_012 = \
      "~kMiriana says, \"Hello, do you want to play with me? I can fetch all "
      "my friends and then we'll play tag! Tag, you're it!\""
   heretic_speech_013 = "~kMiriana says, \"I know some magic. I really do.\""
   heretic_speech_014 = \
      "~kMiriana smiles, \"She uses pretty yarn to weave her wares, such "
      "pretty yarn. I hope she makes me something just as pretty.\""
   heretic_speech_015 = \
      "~kMiriana approaches you menacingly, \"What do you want? Are you "
      "trying to steal my powers? Oh, surely not, silly me.\""
   heretic_speech_016 = \
      "~kMiriana says, \"What do they do with their prey, these hunters? Do "
      "they eat their prey? Do they make coats from their skin? Do they hang "
      "their stuffed heads in a room? I just wonder.\""
   heretic_speech_017 = \
      "~kMiriana says, \"Those swords are more dangerous than their "
      "victims.\""
   heretic_speech_018 = \
      "~kMiriana says, \"She's not dead and never was. Parrin can prove it!\""
   heretic_speech_019 = "~kMiriana says, \"I don't like towns.\""
   heretic_speech_020 = \
      "~kMiriana says, \"The lich is a hungry mouth that feeds the mother. "
      "The mother sleeps while the children feed her. Ha! Imagine that. "
      "Shhhh.\""
   heretic_speech_021 = \
      "~kMiriana says, \"She believes me, she knows, but I don't know how "
      "she knows. She knows, ask her and she will tell you.\""
   heretic_speech_022 = "~kMiriana says, \"I don't like towns.\""
   heretic_speech_023 = \
      "~kMiriana says, \"I have seen them. They reminded me of cows. I tried "
      "to make one some soup, and he started screaming.\""
   heretic_speech_024 = \
      "~kMiriana says, \"You want to stop me? Then see that you get the "
      "answer from your trusted advisor, the councilor.\""
   heretic_speech_025 = \
      "~kMiriana says, \"Would you like to know what the power is good for? "
      "Is that what you are asking, little bird?\""
   heretic_speech_026 = \
      "~kMiriana's eyes light up brightly, \"You want the power back? You "
      "really want to try to wrest it from me? Poor little birds, running "
      "around with their little nodes.\""
   heretic_speech_027 = \
      "~kMiriana whispers, \"Old mean wizard Maleval does believe in the "
      "gods. Well, one of them anyway.\""
   heretic_speech_028 = \
      "~kMiriana says, \"There's a dress maker in the Castle who owns "
      "slaves.\""
   heretic_speech_029 = \
      "~kMiriana whispers, \"Faren and Shal'ille are one and the same.\""
   heretic_speech_030 = \
      "~kMiriana whispers, \"There's a monster behind you.\""
   heretic_speech_031 = \
      "~kMiriana says, \"Nevermind. I don't want to tell you.\""
   heretic_speech_032 = \
      "~kMiriana says, \"If I like you, and I'm not saying I do, I'll teach "
      "you some magic.\""
   heretic_speech_033 = \
      "~kMiriana says, \"He is still around somewhere. I saw him. Where did "
      "I see him? I can not remember.\""
   heretic_speech_034 = "~kMiriana says, \"I don't like towns.\""
   heretic_speech_035 = \
      "~kMiriana says, \"The dreams of children. The dreams of children can "
      "be very dangerous. I wonder if she knows about my dreams.\""
   heretic_speech_036 = \
      "~kMiriana giggles, \"Her death was her undoing, in more ways than "
      "one.\""
   heretic_speech_037 = \
      "~kMiriana looks thoughtful, \"Cut the thread, snip snap. Measure the "
      "thread, cut the thread, snip snap. I wonder if she ever gets tired of "
      "it?\""
   heretic_speech_038 = \
      "~kMiriana giggles, \"Not me, silly little bird, I don't look like "
      "Hester Gilk... do I?\""
   heretic_random_001 = "~kMiriana laughs to herself as she dances."
   heretic_random_002 = \
      "~kMiriana sings, \"~IShal'ille and Faren, Shal'ille and Faren, both "
      "are women, both are barren.~I\""
   heretic_random_003 = \
      "~kMiriana says, \"The gods are Gods. Not man nor mortal, nor were "
      "they ever.\""
   heretic_random_004 = \
      "~kMiriana says, \"Yes? I hear you, but I don't understand. Please "
      "help me understand, no don't go away, don't leave me alone.\""
   heretic_random_005 = \
      "~kMiriana giggles, \"They shall see, yes they will. We will prove "
      "them all wrong won't we?\""
   heretic_random_006 = \
      "~kMiriana looks at you shyly, \"Do you ever scare yourself, and have "
      "to run away inside your head?\""
   heretic_random_007 = \
      "~kMiriana whispers to you, \"Do you ever hear voices? Do the voices "
      "call to you? Do you answer the voices?\""
   heretic_random_008 = \
      "~kMiriana sings, \"~ILady Faren and Lord Shal'ille, together in love, "
      "apart not real.~I\""
   heretic_random_009 = \
      "~kMiriana says, \"Kraanan is old and gray and mean.\""
   heretic_random_010 = \
      "~kMiriana says, \"Qor was never a woman. He was a man. And he didn't "
      "kill Jala, he seduced her.\""
   heretic_random_011 = \
      "~kMiriana says, \"Riija makes me think of goats. I don't know why.\""
   heretic_random_012 = \
      "~kMiriana whispers, \"I have a secret. Come closer.\""
   heretic_random_013 = \
      "~kMiriana sings, \"~IThe gods made the land and sky, the priests "
      "wondered how and why, but to look smart they had to lie, and what a "
      "lie, oh my, oh my.~I\""
   heretic_random_014 = \
      "~kMiriana whistles a song that you can't quite place."
   heretic_random_015 = \
      "~kMiriana sobs while she dances, \"Oh why won't they believe me?! I "
      "speak only the truth.\""
   heretic_random_016 = \
      "~kMiriana sings, \"~IOh, at a time not night, not day, when the "
      "stones stand up and dance and play, with wicked grins of the hardest "
      "gray, gods take revenge on those who slay.~I\""
   heretic_random_017 = \
      "~kMiriana giggles scornfully. \"You can't hear their calling, can "
      "you? I feel sorry for you.\""
   heretic_random_018 = \
      "~kMiriana dances about playfully. A magical field appears, a force "
      "seems to flow out of her. The force flows back, and the field "
      "disappears again."
   heretic_random_019 = \
      "~kMiriana says, \"Resurrection is important, just wait and you will "
      "see.\""
   heretic_random_020 = \
      "~kMiriana whispers, \"Did you hear the call too? It is sort of "
      "whirling and hissing.\""
   heretic_random_021 = \
      "~kMiriana dances around in circles and suddenly falls down. \"The "
      "voice won't leave me alone. It is all so unclear, but it won't go "
      "away. Make it go away.\""
   heretic_random_022 = \
      "~kMiriana hops up and down, her eyes flashing, \"Have you seen the "
      "big monster? It goes boom and bang and has that funny thing in its "
      "middle. Look out, there's one behind you!\""
   heretic_random_023 = \
      "~kMiriana suddenly flinches, \"The gods are not pleased. Oh no, they "
      "are not happy about all this at all.\""
   heretic_random_024 = \
      "~kMiriana plucks at her dress. You wonder whether she wants to make a "
      "new one out of the threads."
   heretic_random_025 = \
      "~kMiriana suddenly screams, \"Have, have, have, that is all you care "
      "about. But now I want to have something too!\""
   heretic_random_026 = \
      "~kMiriana sings softly, \"~IHave you heard the true story of the "
      "gods, have you heard of the downfall of the One?~I\""
   heretic_random_027 = \
      "~kMiriana says, \"I wonder whether the gods feel guilty about their "
      "lies?\""
   heretic_random_028 = \
      "~kMiriana stares into the sun, \"Sometimes the light that guides us "
      "is too strong and you are swallowed up by it.\""
   heretic_random_029 = \
      "~kMiriana says, \"You know, Hester Gilk could help you, she helped me "
      "once too... or was that someone else? Hmmm...\""
   heretic_random_030 = \
      "~kMiriana looks around fearfully, then disappears among the trees."
   heretic_random_031 = \
      "~kMiriana screams, \"No, no, NO! Mean, mean, MEAN! No, no, I DON'T "
      "WANT TO!!!\""
   heretic_random_032 = \
      "~kMiriana's eyes shine brightly through her tears, \"Did you see it "
      "collapse? I saw it. It was so empty, so pointless and sad. I don't "
      "like being sad, it makes me cry.\""
   heretic_random_033 = \
      "~kMiriana whispers into the wind, \"Just a few days, just a few days "
      "and they will see the truth and you will be free and roam the land, "
      "yes, you will.\""
   heretic_random_034 = \
      "~kMiriana dances gleefully, \"It was me! Me, do you hear me? I stole "
      "the power and now it is mine.\""
   heretic_random_035 = \
      "~kMiriana shrieks, \"Go away! I won't cut the thread, don't make me. "
      "GO AWAY!!\""
   heretic_random_036 = \
      "~kMiriana abruptly sits down and gasps, \"Spinning, spinning, "
      "spinning, I do it day in, day out. Sometimes it makes me all muddled. "
      "It would be no different for you.\""
   heretic_random_037 = \
      "~kMiriana dances in a circle, \"Time, time, soon it is time. Then "
      "they will all see. No one will doubt me anymore.\""
   heretic_random_038 = \
      "~kMiriana looks down at her feet, \"Was I bad? I didn't want to be "
      "bad. I only did what I ~Bhad~B to do, you understand that, don't "
      "you?\""
   heretic_random_039 = \
      "~kMiriana suddenly takes a threatening step toward you and you know "
      "that getting any closer to her would be sheer suicide."
   heretic_random_040 = \
      "~kMiriana growls wildly, then claps a hand over her mouth, \"Oh my "
      "god, ~Iwhere~I did that come from? Was that you? Did ~Iyou~I give me "
      "that?\""
   heretic_random_041 = \
      "~kMiriana innocently taps you, \"Excuse me, but did you want to kill "
      "the giant monster that is leaning over you?\""
   heretic_random_042 = \
      "~kMiriana exclaims softly, \"You do believe me, don't you? It was not "
      "supposed to be like this. You little birds can still stop it, but "
      "first you must search for the truth. Do you think you can do that, "
      "little bird? Can you hear the truth?\""
   heretic_random_043 = "~kMiriana says, \"Have you heard about Jala?\""
   heretic_trigger_amulet = "amulet"
   heretic_trigger_attack = "attack"
   heretic_trigger_aythya = "aythya"
