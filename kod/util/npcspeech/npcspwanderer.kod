   // JealousGeneral (Jonas D'Accor)
   jealousgeneral_speech_001 = \
      "~kJonas says, \"Some say that Konima is still fighting a fierce "
      "battle inside those caves. Others say that Shal'ille still weeps for "
      "the lost warriors. But whatever the truth may be, he saved mankind "
      "from the vile orcs.\""
   jealousgeneral_speech_002 = \
      "~kJonas says, \"Konima was the greatest hero mankind has ever seen. "
      "His troop led a shameful attack on the orc caves beyond the western "
      "deep woods. Sixty warriors went into the caves and none came back "
      "out.\""
   jealousgeneral_random_001 = \
      "~kJonas says, \"I have been researching the old legends of Konima. "
      "You know the stories of the great Konima, don't you?\""
   jealousgeneral_trigger_caves = "caves"
   jealousgeneral_trigger_konima = "konima"

   // Lich (Queen Venya'cyr)
   lich_speech_001 = \
      "~kQueen Venya'cyr gets a strange glow in her eyes, \"Would you like "
      "to join them?\""
   lich_speech_002 = \
      "~kQueen Venya'cyr says, \"Do you fear that the children's words are "
      "true? If not, perhaps you should.\""
   lich_speech_003 = \
      "~kQueen Venya'cyr says, \"The child has guidance. If one cannot bear "
      "the elemental force of that guidance, one should not investigate it.\""
   lich_speech_004 = \
      "~kQueen Venya'cyr says, \"Our time has come! Those who do not accept "
      "the truth shall be destroyed.\""
   lich_speech_005 = \
      "~kQueen Venya'cyr says, \"Which side are you on? Is it time to live "
      "or time to ~rdie~k?\""
   lich_speech_006 = \
      "~kQueen Venya'cyr gets a bloodthirsty look, \"Such a delicious "
      "situation. Blood, death and chaos. I only wonder why the child didn't "
      "do it sooner.\""
   lich_speech_007 = \
      "~kQueen Venya'cyr says, \"Why should the loss of someone upset you "
      "so? Join the ranks of my necromancers and you will no longer be "
      "troubled by such shallow opinions. We should stop the course of our "
      "enemies' lives.\""
   lich_speech_008 = \
      "~kQueen Venya'cyr says, \"Would you like me to suck the life force "
      "out of you, just as Miriana sucked the power out of the magical "
      "nodes?\""
   lich_random_001 = \
      "~kQueen Venya'cyr smiles bloodthirstily, \"So much death and pain, I "
      "expect great opportunities.\""
   lich_trigger_fate = "fate"
   lich_trigger_miriana = "miriana"
   lich_trigger_nodes = "nodes"

   // Minstrel (Parrin Aragone)
   minstrel_speech_001 = "~kParrin says, \"I will gladly take donations.\""
   minstrel_speech_002 = "~kParrin says, \"That place makes me a sad panda.\""
   minstrel_speech_003 = \
      "~kParrin sings, \"~IThe Duke is grand if you're a pompous jerk, I'm "
      "sure you'll find he's grand, and he'll like you too, you can be sure, "
      "when your money's in his hand! Because we know the Duke, he's a "
      "selfish puke, he's got shillings in his head. We've seen the Duke, "
      "that crazy kook, but we'd rather see him dead.~I Now that one is a "
      "classic!\""
   minstrel_speech_004 = "~kParrin says, \"Wait a minute, is this a trick?\""
   minstrel_speech_005 = \
      "~kParrin Aragone sings, \"~IAnd a merry, merry, mer~Bry~B~I... hail "
      "to you!\""
   minstrel_speech_006 = "~kParrin says, \"What can I do for thee?\""
   minstrel_speech_007 = \
      "~kParrin says, \"You like my instrument? It is a fine one, isn't it?\""
   minstrel_speech_008 = \
      "~kParrin says, \"Jala bards should find themselves an instrument that "
      "they love.\""
   minstrel_speech_009 = \
      "~kParrin says, \"Ah, you are interested in learning the ways of the "
      "minstrel. Wonderful! I may be able to teach you what I have learned "
      "of Jala, such as the spell of truth.\""
   minstrel_speech_010 = \
      "~kParrin says, \"It is not for me to judge, only to capture deeds in "
      "songs and verses! Still, I must admit that I am delighted at how long "
      "this escapade has lasted.\""
   minstrel_speech_011 = \
      "~kParrin says, \"I am now working on a 15-part ballad about her "
      "escapades.\""
   minstrel_speech_012 = \
      "~kParrin sings, \"~I~rShe used paths that no one wanted to walk, she "
      "used nodes that no one could crack. Through the day, through the "
      "night, Miriana will spoil it, Miriana will ruin it.~n~k\""
   minstrel_speech_013 = \
      "~kParrin says, \"Incompetent fool, can't you see that I am working "
      "right now? Shhhhh, yes, go, shhh, go away!\""
   minstrel_speech_014 = \
      "~kParrin says, \"Were you caught up in an attack? Tell me about it, "
      "feelings, sounds, taste, smell... everything you can remember. That "
      "should make an excellent ballad.\""
   minstrel_speech_015 = \
      "~kParrin says, \"Describe these creatures that Miriana summoned. What "
      "exactly did they look like? How big were they? Did they have an "
      "otherworldly aura? Oh, I must write this down, oh yes, this is good.\""
   minstrel_speech_016 = \
      "~kParrin says, \"Can't you read the sign on the door that says: No "
      "entry? Ohh, my goodness, there is no door here, how strange, I could "
      "swear there was a door here.\""
   minstrel_speech_017 = \
      "~kParrin sings, \"~IOh the Princess, the product of incest, for the "
      "Royal genepool's scope is small! Oh, the Princess, but what of the "
      "inquest, who lived to see your uncle fall? And what will you do now "
      "maiden, since the poor old King does run and hide? And what will you "
      "do now maiden, as the kingdom slowly rots and dies?~I\""
   minstrel_speech_018 = \
      "~kParrin says, \"I heard someone use it a few times. Catchy, isn't "
      "it?\""
   minstrel_speech_019 = \
      "~kParrin says, \"I can offer nothing but my art... music and poetry, "
      "friend.\""
   minstrel_speech_020 = \
      "~kParrin says, \"It is a powerful song for seeing beyond illusions.\""
   minstrel_random_001 = "~kParrin Aragone gingerly plucks at his lyre."
   minstrel_random_002 = "~kParrin Aragone struggles to tune his lyre."
   minstrel_random_003 = \
      "~kParrin sings a truly beautiful a cappella hymn in a haunting "
      "language that is foreign to your ear. It sounds something like this. "
      "\"~IHa na oka-chi, ha na hey, jan-do apas-i, apas-i wa apas-i wa, ha "
      "na hey... \""
   minstrel_random_004 = \
      "~kParrin says, \"I know a couple of ~Ichoice~I songs about Akardius, "
      "but I have to be careful about where and when I sing them.\""
   minstrel_random_005 = \
      "~kParrin says, \"We both know that satire is sacred, and that no one "
      "should hold themselves above humorous comment. Nevertheless, there "
      "are some thin-skinned people around here that might get downright "
      "uptight over the latest song I wrote about the Princess.\""
   minstrel_random_006 = \
      "~kParrin says, \"I... well, I LOVE the world!! I do!! I just LOVE "
      "you, big old world!!!\""
   minstrel_random_007 = "~kParrin screams, \"Yeeeeee, haw!!\""
   minstrel_random_008 = \
      "~kParrin sings, \"~IJala, Jala, beloved Jala, I can't find a word "
      "that rhymes with Jala! Jala, Jala, glorious Jala, I could sing all "
      "day if your name was Fay! I'd sing let's stay and pray and we'll be "
      "okay, and your glorious song would be a glorious ray, I'd sing well "
      "what the hay forget the pay and every day would be Jala day~I!\""
   minstrel_random_009 = \
      "~kParrin warbles, \"~IWay up in Barloque, one day the sewers did "
      "choke, and spit rats out all over like loogies! Now they skitter "
      "around, in the forests and towns, and kill the occasional newbie! Oh, "
      "the Barloque Rats, the Barloque Rats, where are the Marion Cats? Oh, "
      "the Barloque Rats, the Barloque Rats, where are the Marion Cats?~I\""
   minstrel_random_010 = \
      "~kParrin twitters, \"~ILong ago, in days of yore, the year was "
      "three-fifteen, Tos and Barloque went to war, to settle the difference "
      "between! Was it over land, or the right to rule, or who won the big "
      "chess game? No one remembers why they started the war, but they're "
      "still fighting it just the same! Just the same, just the same, just "
      "the same, just the same, they're still fighting it just the same! "
      "Just the same, just the same, just the same, just the same, though "
      "the reasons don't pertain!~I\""
   minstrel_random_011 = \
      "~kParrin suddenly bursts into song, \"~IWogga wogga wogga wheeee, "
      "wogga wogga wogga wogga! Wheeee wogga wheeeeeee wogga "
      "woggawoggawogga! Wheeeeeeeeeeee!~I\""
   minstrel_random_012 = "~kParrin looks around hopefully."
   minstrel_random_013 = "~kParrin says, \"Ah, the life of a celebrity.\""
   minstrel_random_014 = \
      "~kParrin says, \"Naturally, I have an artistic temperament. I am... "
      "prone to creative rages, and fits of fancy.\""
   minstrel_random_015 = \
      "~kParrin obviously doesn't have much sense of rhythm."
   minstrel_random_016 = \
      "~kParrin croons, \"~IOh, have you heard the story of the lonely Yeti, "
      "who lives off in his icy cave, his hair is all nappy like white "
      "confetti, and he waits to send weaklings to their grave! Oh, the "
      "yeti, the yeti, the lonesome yeti, guards that node with a monstrous "
      "pride, oh, the yeti, the yeti, the lonesome yeti, lays in wait for a "
      "hairy bride!~I\""
   minstrel_random_017 = \
      "~kParrin trills, \"~IIf I were an Orc, I wouldn't get to eat the "
      "Feast Hall pork, yes if I were an Orc, the Duke wouldn't let me in! "
      "And if I were a Troll, I wouldn't have Skivlat to keep my bankroll, "
      "yes if I were a Troll, the Duke wouldn't let me in! Because the Duke "
      "doesn't like monsters at his parties, in his bank or wandering Tos, "
      "yes the Duke won't have them over for drinks, and everyone knows that "
      "the Duke's the boss~I!\""
   minstrel_random_018 = \
      "~kParrin says, \"You've got a face for show business!\""
   minstrel_random_019 = \
      "~kParrin says, \"I want everyone to hold their applause until I "
      "finish the song, please.\""
   minstrel_random_020 = "~kParrin says, \"And for my next number... \""
   minstrel_random_021 = \
      "~kParrin sings, \"~IWell the Tos Arena's five leagues long, doo dah, "
      "doo dah... ~I\""
   minstrel_random_022 = \
      "~kParrin tries his best to do a primitive tap dance. It's kind of "
      "pathetic."
   minstrel_random_023 = \
      "~kParrin Aragone hums a few bars of something or other, trying to "
      "remember the words."
   minstrel_random_024 = "~kParrin Aragone whistles a sea shanty."
   minstrel_random_025 = "~kParrin Aragone dances a little jig."
   minstrel_random_026 = \
      "~kParrin sings, \"~IThe PKer's took my baby away, and she is here no "
      "more, I'm a-going up to the Barloque Sewers, to even up the score. "
      "I'm hunting PKer's today, I'm hunting PKer's today, I'm going to find "
      "that red named so-and-so and I'm going to make him pay.~I\""
   minstrel_random_027 = \
      "~kParrin croons, \"~IThe song of the fungus beast is wooo, wooo, "
      "wooo! The song of the fungus beast is wooo, wooo, wooo! Everyone "
      "knows that the fungus beast sings, and when it sings it sings about "
      "you. Because we all have to live with the fungus beast, and the "
      "fungus beast lives with you and me! Yes we all have to live with the "
      "fungus beast, and the fungus beast, and the fungus beast just wants "
      "to be free!~I\""
   minstrel_random_028 = \
      "~kParrin sings, \"~IThrough the forest, through the forest, looking "
      "for the Spider Queen! Underground and all around, when I find her "
      "I'll stab her in the spleen! She's got treasure, ooooh, yeah! "
      "Treasure treasure ooooh, yeah! Whooo, we'll be rich, we'll be so "
      "rich, we'll retire and hang out at Fams! We'll eat and get fat, "
      "that's where it's at, we'll be rich and fat and that's where it's "
      "at!~I\""
   minstrel_random_029 = \
      "~kParrin sings, \"~IOoh la la, ooh la lay, I'm going out near Marion, "
      "and looking for the fey! Ooh la la, ooh la lee, they say that some "
      "are evil, but I'll just wait and see! Well have you seen the little "
      "fey, so beautiful to me? With their gossamer wings to hover on, how "
      "could they be bad? Ooh, how could they be mean?~I\""
   minstrel_random_030 = "~kParrin says, \"I want to be alone now.\""
   minstrel_random_031 = \
      "~kParrin slumps into a state of artistic ennui and makes sure that "
      "everyone knows it."
   minstrel_random_032 = "~kParrin broods and looks miserable."
   minstrel_random_033 = \
      "~kParrin says, \"Look, you think it'd be easy being a musician? "
      "Pouring out my soul to you people day after day, night after night, "
      "struggling with every artistic fiber in my being to reach you, to get "
      "inside you and tenderly pluck some chord or some memory? WELL, IT'S "
      "NOT!!! I don't know if I can take this anymore! You're bumming me "
      "out.\""
   minstrel_random_034 = "~kParrin visibly sulks."
   minstrel_random_035 = \
      "~kParrin says, \"I am a tortured soul! Cannot you people see that?\""
   minstrel_random_036 = \
      "~kParrin sighs heavily and does his best petulant sneer."
   minstrel_random_037 = \
      "~kParrin sings, \"~IQ is a mighty creator of lands, more than half of "
      "these were made by his mighty mighty hands, and when Zjiria says Yay, "
      "he says a mighty Nay, and saves us from her wackiest of plans.~I\""
   minstrel_random_038 = \
      "~kParrin sings, \"~IArantis is the guardian of this great land, he "
      "watches over it with his mighty hand. Gronkh came with crazy plans, "
      "but drew only a weary yawn from him. He put him in his place at once, "
      "and so saved us from silly ideas~I.\""
   minstrel_trigger_sell = "sell"
   minstrel_trigger_crypt = "crypt"
   minstrel_trigger_crypt_2 = "crypt"
   minstrel_trigger_duke = "duke"
   minstrel_trigger_freebird = "freebird"
   minstrel_trigger_freebird_2 = "freebird"
   minstrel_trigger_hello = "hello"
   minstrel_trigger_help = "help"
   minstrel_trigger_instrument = "instrument"
   minstrel_trigger_jala = "jala"
   minstrel_trigger_learn = "learn"
   minstrel_trigger_miriana = "miriana"
   minstrel_trigger_node = "node"
   minstrel_trigger_node_2 = "node"
   minstrel_trigger_princess = "princess"
   minstrel_trigger_sad_panda = "sad panda"
   minstrel_trigger_sad_panda_2 = "sad panda"
   minstrel_trigger_buy = "buy"
   minstrel_trigger_truth = "truth"
   minstrel_trigger_illusions = "illusions"

   // Towns (Towns)
   towns_speech_001 = \
      "~kThe room falls silent as %s speaks of a stunted dwarf."
   towns_trigger_stunted_dwarf = "stunted dwarf"
   towns_trigger_stunted_dwarf_2 = "stunted dwarf"
   towns_trigger_stunted_dwarf_3 = "stunted dwarf"

