   marionbartender_trigger_zig = "zig"

   // MarionBlacksmith (Colhorr)
   marionblacksmith_speech_001 = \
      "~kColhorr says, \"Broke? What's broke? Let's have a look, maybe I can "
      "fix it.\""
   marionblacksmith_speech_002 = \
      "~kColhorr says, \"Ah, well... it's a fair city, grand actually. Aye "
      "it's a grand city, certainly grand, grand grand grand capital of "
      "Meridian.\""
   marionblacksmith_speech_003 = \
      "~kColhorr says, \"Yes, well, good bye now.\""
   marionblacksmith_speech_004 = "~kColhorr mumbles something to himself."
   marionblacksmith_speech_005 = \
      "~kColhorr says, \"Centipede? Well, I know that they look awful, but "
      "in fairness now they are quite harmless if you let them be.\""
   marionblacksmith_speech_006 = \
      "~kColhorr says, \"What? East Tos? East Tos, uh... aye, well, Tos is "
      "east of here, through Ileria, that's a valley. To the east. Just "
      "east, actually. But aye, it's east. East. And the bank's there, "
      "sure.\""
   marionblacksmith_speech_007 = \
      "~kColhorr says, \"Council? Uh, that doesn't ring any bells.\""
   marionblacksmith_speech_008 = \
      "~kColhorr shivers and says, \"That crypt scares me silly.\""
   marionblacksmith_speech_009 = \
      "~kColhorr says, \"In Marion? No, no, there's no Duke in Marion. But "
      "there is a Lady, and what a kind soul she is, indeed. A real Lady. "
      "She lives to help the unfortunate, Marion's own saint.\""
   marionblacksmith_speech_010 = \
      "~kColhorr says, \"Yes? Oh, hello there, hello... \""
   marionblacksmith_speech_011 = "~kColhorr says, \"Yes?\""
   marionblacksmith_speech_012 = \
      "~kColhorr says, \"Huh? I thought I told you you're not welcome here.\""
   marionblacksmith_speech_013 = \
      "~kColhorr says, \"What do you need help with? This is a simple place, "
      "not too difficult to figure out, so I can't see where you'd need help "
      "with that. Aye, there's plenty I could teach you, you bet, but you "
      "certainly don't need my help to get around Marion.\""
   marionblacksmith_speech_014 = \
      "~kColhorr says, \"Of course it's hot! You think I don't know it's hot "
      "in here? I KNOW it's hot in here. You don't need to tell me it's hot "
      "in here, after thirty-five years at this forge, I know exactly how "
      "hot it is in here. Humpf. Hot.\""
   marionblacksmith_speech_015 = \
      "~kColhorr says, \"Jasper? No, no you must be lost, %s. You're in "
      "MARION... that's right, MARION, M-A-R-I-O-N.\""
   marionblacksmith_speech_016 = \
      "~kColhorr says, \"Aye, indeed this is Marion. That's exactly where "
      "you are. What can I do for you %s?\""
   marionblacksmith_speech_017 = \
      "~kColhorr says, \"What? Mimes? Where? And how many?\""
   marionblacksmith_speech_018 = \
      "~kColhorr says, \"What? Mimes? Where? And how many?\""
   marionblacksmith_speech_019 = \
      "~kColhorr says, \"Goodness, you're better off staying away from the "
      "orcs altogether. Foul creatures, sworn enemies of all people. Why I "
      "remember a day when armies were raised to hunt them down and smash "
      "them completely. Aye, I've seen some of the weapons that those orcs "
      "make. Oh boy. Impressive. Scimitars with a blade as long as your "
      "arm.\""
   marionblacksmith_speech_020 = \
      "~kColhorr says, \"Shirtless? Well, I know it's not proper, but I put "
      "on my shirt whenever I go out of my shop! It's the heat from my "
      "forge, you see... well, you will notice it's quite hot in here. Hot. "
      "Yes, quite hot indeed.\""
   marionblacksmith_speech_021 = \
      "~kColhorr says, \"Ran er'Hoth? He... well, I suppose that you're "
      "going to hear this elsewhere, so I might as well put it kindly. He is "
      "a little touched. Aye, he is.\""
   marionblacksmith_speech_022 = \
      "~kColhorr shouts, \"Ran er'Hoth? Well now, it isn't kind to speak ill "
      "of the cretins and half-wits of the world, so I'll just hold my "
      "tongue.\""
   marionblacksmith_speech_023 = \
      "~kColhorr screams, \"That man is an idiot, and you don't have to be "
      "sauced on Troll Whiskey to see that. He has spent the last ten years "
      "ridiculing the people of Marion, and now has the nerve to return and "
      "expect charity from us. Well, he gets nothing from me. Nothing. Now "
      "be on your way.\""
   marionblacksmith_speech_024 = \
      "~kColhorr says, \"I was a pretty good tight-head prop in my day. I "
      "still play every fall in the annual Marion versus Barloque test "
      "match, not because I'm fit but because I'm mean as a raccoon. I'll "
      "rip the faces off those rich guys half my age.\""
   marionblacksmith_speech_025 = \
      "~kColhorr says, \"Well, let's see... I make a couple of different "
      "weapons, and those are for sale. Otherwise, I am busy fixing things "
      "up for the farmers around Marion.\""
   marionblacksmith_speech_026 = \
      "~kColhorr says, \"I might have a thing or two here you'd be "
      "interested in looking at.\""
   marionblacksmith_speech_027 = \
      "~kColhorr says, \"Teach? Well, now... I know a few things, that's the "
      "truth. I know a bit about the old ways, for my people came out of the "
      "Cragged Mountains in my great-grandfather's time and brought the ways "
      "of Kraanan with them. They made their weapons from the ethers, just "
      "like that. Aye, there's some there I could show you too, but you need "
      "some understanding of his ways to use his magics.\""
   marionblacksmith_speech_028 = \
      "~kColhorr says, \"I love that guy. He played hooker on the Marion "
      "rugby team for a couple years, tough as a hammer.\""
   marionblacksmith_speech_029 = \
      "~kColhorr says, \"Oh, Tos. Aye, well in Tos there is an arena where "
      "the warriors fight with great weapons. Great weapons, iron and steel, "
      "whatnot.\""
   marionblacksmith_speech_030 = "~kColhorr says, \"Aye, nasty stuff.\""
   marionblacksmith_random_001 = \
      "~k~IThe heat in this shop is almost unbearable.~I"
   marionblacksmith_random_002 = \
      "~k~IThe blacksmith's shop is swelteringly hot.~I"
   marionblacksmith_random_003 = \
      "~kColhorr says, \"If you've got old weapons you're looking to get rid "
      "of, might be I'm interested. Sure, can't keep too much scrap iron "
      "around.\""
   marionblacksmith_random_004 = \
      "~kColhorr says, \"Did you try our local tavern? That Tova now, he is "
      "a kick in the pants. Aye, a real hoot %s.\""
   marionblacksmith_random_005 = \
      "~kColhorr says, \"These are quiet parts. Good people, hard working "
      "people, er, with one exception.\""
   marionblacksmith_random_006 = \
      "~kColhorr says, \"You probably noticed that ramshackle hut across the "
      "way, near the stables. Well, it does stick out, seeing as the rest of "
      "the town is tidy, and proud. Aye, that's the hut of Ran er'Hoth, %s. "
      "I could tell you stories... \""
   marionblacksmith_random_007 = \
      "~kColhorr says, \"You look like you appreciate the craftsmanship that "
      "goes into a well made weapon, and I'll tell you what, so do I. Yes I "
      "do. I have quite a collection too, but I keep that somewhere safe.\""
   marionblacksmith_random_008 = \
      "~kColhorr screams, \"Did you say something about knitting needles?\""
   marionblacksmith_random_009 = "~kColhorr says, \"Huh?\""
   marionblacksmith_random_010 = \
      "~kColhorr says, \"Oh, did you say something?\""
   marionblacksmith_random_011 = "~k~IColhorr is sweating profusely.~I"
   marionblacksmith_random_012 = "~kColhorr says, \"What's this?\""
   marionblacksmith_random_013 = \
      "~kColhorr shouts, \"Yes, well speak up please.\""
   marionblacksmith_random_014 = "~kColhorr scratches absently."
   marionblacksmith_random_015 = \
      "~kColhorr says, \"What have you got there?\""
   marionblacksmith_random_016 = \
      "~kColhorr screams, \"AS FAR AS KARMA IS CONCERNED, I THINK THAT YOU "
      "TEND TO GO THE OPPOSITE WAY OF WHAT YOU'RE KILLING.\""
   marionblacksmith_random_017 = \
      "~kColhorr says, \"I hear more than they think, that's for sure.\""
   marionblacksmith_random_018 = "~kColhorr yells, \"WHAT WAS THAT?\""
   marionblacksmith_random_019 = "~kColhorr glares at you."
   marionblacksmith_random_020 = \
      "~kColhorr says, \"The shop is closed, all done for the day. Go on "
      "your way now.\""
   marionblacksmith_trigger_barloque = "barloque"
   marionblacksmith_trigger_broke = "broke"
