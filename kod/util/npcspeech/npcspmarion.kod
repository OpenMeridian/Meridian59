   marionbartender_trigger_sell = "sell"
   marionbartender_trigger_buy = "buy"
   marionbartender_trigger_shal_ille = "shal'ille"
   marionbartender_trigger_sha_lill = "sha-lill"
   marionbartender_trigger_stunted_dwarf = "stunted dwarf"
   marionbartender_trigger_tos = "tos"
   marionbartender_trigger_treefolk = "treefolk"
   marionbartender_trigger_whiskey = "whiskey"
   marionbartender_trigger_wryn_s = "wryn's"
   marionbartender_trigger_wryn_s_2 = "wryn's"
   marionbartender_trigger_wryn_s_3 = "wryn's"
