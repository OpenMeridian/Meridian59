   // MarionInnkeeper (MarionInnkeeper)
   marioninnkeeper_speech_001 = "~kMorrigan says, \"So long!\""
   marioninnkeeper_speech_002 = "~kMorrigan clears his throat."
   marioninnkeeper_speech_003 = "~kMorrigan scowls."
   marioninnkeeper_speech_004 = \
      "~kMorrigan says, \"Oh yes, that's the game Meidei runs in his tavern, "
      "isn't it? Oh, it isn't, hmm, well then I don't know what you're "
      "talking about.\""
   marioninnkeeper_speech_005 = "~kMorrigan says, \"Hello, welcome back!\""
   marioninnkeeper_speech_006 = "~kMorrigan says, \"Er, hello!\""
   marioninnkeeper_speech_007 = "~kMorrigan says, \"Come on in!\""
   marioninnkeeper_speech_008 = "~kMorrigan says, \"Good Evening!\""
   marioninnkeeper_speech_009 = "~kMorrigan says, \"Hello!\""
   marioninnkeeper_speech_010 = "~kMorrigan says, \"Good day!\""
   marioninnkeeper_speech_011 = "~kMorrigan looks down glumly."
   marioninnkeeper_speech_012 = \
      "~kMorrigan busies himself with some thing under the counter."
   marioninnkeeper_speech_013 = \
      "~kMorrigan says, \"I am not sure what that fellow is up to. I think "
      "he buys and sells goods. I have seen him near the West Merchant way "
      "just south of here. Doesn't stay in one place too long though.\""
   marioninnkeeper_speech_014 = \
      "~kMorrigan says, \"The rabid cur has finally been put to sleep.\""
   marioninnkeeper_speech_015 = \
      "~kMorrigan says, \"His fate has been decided by a higher power. He "
      "shall harass Meridian no longer.\""
   marioninnkeeper_speech_016 = \
      "~kMorrigan says, \"The King is my liege, and I await the chance to "
      "serve his will.\""
   marioninnkeeper_speech_017 = \
      "~kMorrigan says, \"I wonder how she came to be all alone in the "
      "woods, I mean, it's a bit strange, isn't it, what parents would let "
      "their child dance all alone in a forest? Would you let your child "
      "dance all alone in a forest?\""
   marioninnkeeper_speech_018 = \
      "~kMorrigan nods so vigorously that you fear his head might fall off, "
      "\"Ran er'Hoth swears she is older than old, but then how come she "
      "still looks like a little girl and acts like a little girl... Well, "
      "sometimes she acts like one, but how can anyone stay like that "
      "forever? Haven't you ever noticed? Strange, whatever could the reason "
      "be?\""
   marioninnkeeper_speech_019 = \
      "~kMorrigan says, \"Evil witch... well, that's what I've heard people "
      "say about her lately.\""
   marioninnkeeper_speech_020 = \
      "~kMorrigan turns bright red in the face, as if he might explode any "
      "moment, \"EXCUSE ME!!!\""
   marioninnkeeper_speech_021 = "~kMorrigan says, \"True, Tova, true.\""
   marioninnkeeper_speech_022 = "~kMorrigan says, \"Yes, Tova.\""
   marioninnkeeper_speech_023 = "~kMorrigan says, \"Aye, Tova!!\""
   marioninnkeeper_speech_024 = \
      "~kMorrigan says, \"Mushrooms? I buy mushrooms!\""
   marioninnkeeper_speech_025 = \
      "~kMorrigan says, \"Nope. Nothing needs to go out right now.\""
   marioninnkeeper_speech_026 = \
      "~kMorrigan says, \"It's quite extraordinary what Miriana did there. "
      "Not that I approve, because I don't, but the way she drained the "
      "magic nodes. I mean, who even knew such a thing was possible, I "
      "certainly didn't, and Tova says he didn't know either, and Tova knows "
      "everything. Did you know it was possible? Truly extraordinary, "
      "~bPOP~k, all gone, just like that...\""
   marioninnkeeper_speech_027 = \
      "~kMorrigan says, \"Oh, I'm sorry. Were you also connected to one of "
      "the magic nodes that Miriana seized, or one she tried to? Did it "
      "hurt? Did your head feel like jelly? Did you see stars, as if someone "
      "had hit you on the back of your head? Did you try to protect the "
      "magic node? NO, oh no, please don't hit me, I'm sorry!\""
   marioninnkeeper_speech_028 = \
      "~kMorrigan rubs his hands and looks rather irritable for a moment, "
      "\"Ppp-oooooooower... all that power... so much power. Oh, pardon me, "
      "I didn't see you standing there. Can I help you? Do you need a room?\""
   marioninnkeeper_speech_029 = \
      "~kMorrigan says, \"We have pants for sale, right over here! Good "
      "Marion canvas, too, the best that money can buy!\""
   marioninnkeeper_speech_030 = \
      "~kMorrigan sneers, \"That traitorous Kalior! Even in death he attacks "
      "the throne. This time with that impudent whelp of a nephew!\""
   marioninnkeeper_speech_031 = \
      "~kMorrigan says, \"That's right, and I play in the backfield, wing. "
      "We've got a pretty good team here, don't we Tova?\""
   marioninnkeeper_random_001 = \
      "~k~ISomewhere outside the bar, a rooster crows.~I"
   marioninnkeeper_random_002 = \
      "~kMorrigan says, \"Ha ha, oh Tova, you kill me!\""
   marioninnkeeper_random_003 = \
      "~kMorrigan says, \"Ha haha, hahahahah, hahahahah, ha ha ha!!\""
   marioninnkeeper_random_004 = \
      "~kMorrigan says, \"Ha ha ha ha, hahaha, ha hee hee!!\""
   marioninnkeeper_random_005 = "~kMorrigan laughs out loud!"
   marioninnkeeper_random_006 = "~kMorrigan says, \"Ha, ha, ha, ha, ha!!!!\""
   marioninnkeeper_random_007 = \
      "~kMorrigan says, \"Hee, hee, Tova, hee hee heeheehee!!!\""
   marioninnkeeper_random_008 = \
      "~kMorrigan says, \"Ha ha, ha ha, ha ha, ha ha, ha ha, ha ha, ha ha!\""
   marioninnkeeper_random_009 = \
      "~kMorrigan says, \"Tee hee, tee heeheehee, tee hee!!\""
   marioninnkeeper_random_010 = \
      "~kMorrigan bursts into hysterical laughter, which subsides in a bout "
      "of coughing."
   marioninnkeeper_random_011 = \
