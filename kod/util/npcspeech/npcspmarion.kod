NpcSpeechMarion is NpcSpeech
// NPC talk of Marion:
// answers to trigger words and random lines.
// Each line is a resource (EN here, DE in the .lkod); Library adds the
// lists in CreateSpeechLibrary and CreateRandomLibrary.

constants:

   include blakston.khd

resources:

   include npcspmarion.lkod

   // MarionBartender (Tova)
   marionbartender_speech_001 = \
      "~kTova says, \"Barloque is in the north, and claims itself the Royal "
      "City of Meridian. But I try not to knock the rich. I never got a job "
      "from a poor person, don't you know!\""
   marionbartender_speech_002 = \
      "~kTova says without looking at you, \"What, are you still here?\""
   marionbartender_speech_003 = \
      "~kTova says, \"I have heard that ~Ihis Majesty the King~I is ~Iin the "
      "sanctuary~I, under the care of ~ILady Aftyn~I!! They say that soon he "
      "will be fit again to rule, %s!! Oh, blessed saints, oh glorious "
      "day!!\""
   marionbartender_speech_004 = "~kTova says, \"May you fare well, %s.\""
   marionbartender_speech_005 = "~kTova says, \"Don't bother coming back.\""
   marionbartender_speech_006 = \
      "~kTova says, \"Cor Noth now, is just a step behind the rest of us. "
      "You see, they've got their heads in the clouds and their feet are not "
      "on the ground. Aye, but it's a fine place, and do they love to talk "
      "%s! Did you hear the one about how years ago, Tos and Barloque went "
      "to war? Well, Tos and Barloque had some silly dispute, and their "
      "pride to boot, and neither city would move an inch to meet the other. "
      "Finally, without any hope of negotiations they figured the only "
      "resort was to start a war between themselves. The next day, Cor Noth "
      "surrendered! Ha, ha, ha, ha!!\""
   marionbartender_speech_007 = \
      "~kTova says without looking at you, \"What, are you still here?\""
   marionbartender_speech_008 = \
      "~kTova says, \"Yes, well the council... you will hear a lot of talk "
      "about the council, but not in Marion. We stay out of the politics and "
      "intrigue here, %s.\""
   marionbartender_speech_009 = \
      "~kTova says, \"Watch yourself! I hear those that prey on others hunt "
      "there.\""
   marionbartender_speech_010 = \
      "~kTova says, \"Who was the fool that opened that sacred resting "
      "place? Probably some fool looking for treasure.\""
   marionbartender_speech_011 = \
      "~kTova says, \"I hear Akardius has taken well to his uncle's duties. "
      "How convenient.\""
   marionbartender_speech_012 = "~kTova says, \"I guess he got his...\""
   marionbartender_speech_013 = \
      "~kTova says, \"No offense intended, but my religion is right here in "
      "my mug, %s. How about I pour you a pint of salvation?\""
   marionbartender_speech_014 = \
      "~kTova says, \"Ah fate, aye, fate plays a big part in every life, "
      "from birth on.\""
   marionbartender_speech_015 = \
      "~kTova says, \"Aye, the wee things are a sight to see all right! "
      "Myself and Morrigan went up north there to get a look for ourselves, "
      "didn't we Morrigan? Unpredictable though, I'm not ashamed to say we "
      "turned and ran when the little buggers turned nasty on us! You should "
      "have seen us coming out of those woods!\""
   marionbartender_speech_016 = \
      "~kTova shouts, \"Come in, my friend. What took you so long to get "
      "here?\""
   marionbartender_speech_017 = \
      "~kTova says, \"Ah, good evening %s. Look who's here, Morrigan!\""
   marionbartender_speech_018 = \
      "~kTova says, \"Aye, come in, come in, let's get you something to warm "
      "up your bones now.\""
   marionbartender_speech_019 = \
      "~kTova says, \"It's a fine evening %s, sure it is.\""
   marionbartender_speech_020 = \
      "~kTova says, \"And a good day to you, %s! Can I get you something to "
      "drink, or perhaps a bite of food?\""
   marionbartender_speech_021 = \
      "~kTova says, \"Good day there. What will you have, %s?\""
   marionbartender_speech_022 = "~kTova says, \"Ah, hello there %s.\""
   marionbartender_speech_023 = \
      "~kTova sneers, \"What are they flushing out of the sewers of Barloque "
      "now, Morrigan? Look what the cat dragged in.\""
   marionbartender_speech_024 = \
      "~kTova says, \"And who are you? Get out, we don't have what you "
      "need.\""
   marionbartender_speech_025 = \
      "~kTova says, \"No offense intended, but my religion is right here in "
      "my mug, %s. How about I pour you a pint of salvation?\""
   marionbartender_speech_026 = \
      "~kTova says, \"Oh, yes, it's to the south of here and up high in the "
      "mountains. The people up there are their own sort, fierce and "
      "independent %s. Not the type you want to pick a fight with.\""
   marionbartender_speech_027 = \
      "~kTova says without looking at you, \"What, are you still here?\""
   marionbartender_speech_028 = \
      "~kTova says, \"Hush now Morrigan, you know better than that. It's "
      "best not to speak so with all these people here.\""
   marionbartender_speech_029 = \
      "~kTova says, \"No offense intended, but my religion is right here in "
      "my mug, %s. How about I pour you a pint of salvation?\""
   marionbartender_speech_030 = \
      "~kTova says, \"They say that she is of nobility, from Barloque, and "
      "that her husband left her a fortune after he passed on %s. Aye, they "
      "also say that the fortune is right here in Marion with her, at the "
      "asylum.\""
   marionbartender_speech_031 = \
      "~kTova says, \"She is a saint. An absolute saint. Bless her heart.\""
   marionbartender_speech_032 = \
      "~kTova says, \"Marion? Well, you're looking at it my friend, unless "
      "you need a shovel mended or the counsel of an ancient madman.\""
   marionbartender_speech_033 = \
      "~kTova says, \"If you want to see a color paler than white, just look "
      "at her skin! HAHA.\""
   marionbartender_speech_034 = \
      "~kTova says, \"I didn't tell you this, but she has a tiny god that "
      "she keeps in her pockets.\""
   marionbartender_speech_035 = \
      "~kTova says, \"Joking aside, I'd rather someone did something about "
      "that girl. It just sends a chill down my spine when I think what she "
      "could do with all that power.\""
   marionbartender_speech_036 = \
      "~kTova says, \"I don't know about you, but that girl-child gives me "
      "goosebumps. There's just something not right about her.\""
   marionbartender_speech_037 = \
      "~kTova says, \"She is a danger, plain and simple, there's no other "
      "way to put it, no matter what the others say.\""
   marionbartender_speech_038 = \
      "~kTova says, \"What is as full as it can be, but not as full as it "
      "could be? Your mana after you've tangled with Miriana! Hah, haha...\""
   marionbartender_speech_039 = \
      "~kTova says, \"What is paler than pale? Your face after you've seen "
      "one of Miriana's creatures. HAH!\""
   marionbartender_speech_040 = \
      "~kTova looks you over, \"Have you tangled with Miriana or one of her "
      "creatures once or twice? You look like death warmed over.\""
   marionbartender_speech_041 = \
      "~kTova says, \"No offense intended, but my religion is right here in "
      "my mug, %s. How about I pour you a pint of salvation?\""
   marionbartender_speech_042 = \
      "~kTova says, \"All in good time, my friend. When the king calls upon "
      "us, Marion will answer in kind.\""
   marionbartender_speech_043 = \
      "~kTova says, \"No offense intended, but my religion is right here in "
      "my mug, %s. How about I pour you a pint of salvation?\""
   marionbartender_speech_044 = \
      "~kTova says, \"I still play, front row, loose-head prop for Marion. I "
      "love a good ruck more than anything, especially if one of the Tos "
      "centers is at the bottom. If it's on the field, it's grass is what I "
      "say. Ha, ha ha ha ha ha!\""
   marionbartender_speech_045 = \
      "~kTova says, \"I have heard that ~Ihis Majesty the King~I is ~Iin the "
      "sanctuary~I, under the care of ~ILady Aftyn~I!! They say that soon he "
      "will be fit again to rule, %s!! Oh, blessed saints, oh glorious "
      "day!!\""
   marionbartender_speech_046 = \
      "~kTova says, \"This is a tavern, my friend. It's not too "
      "complicated.\""
   marionbartender_speech_047 = \
      "~kTova says, \"You'd be better asking the Good Lady Aftyn about "
      "Shal'ille. She is versed in the ways, and such a kind soul.\""
   marionbartender_speech_048 = \
      "~kThe room goes silent as %s mentions stunted dwarf."
   marionbartender_speech_049 = \
      "~kTova says, \"By the Holy Martyrs, it's a miserable place. Aye, take "
      "my advice on this, %s. I spent a fair piece of my youth there, and "
      "I'll never go back. The people of Tos are so lazy, they can't even "
      "exercise their discretion!\""
   marionbartender_speech_050 = \
      "~kTova says, \"Tos is a town with little cheer, and let me warn you "
      "about the public house there, %s. The innkeeper Paddock is a "
      "muddy-headed liar, as likely to swindle you down as offer you a beer. "
      "He's the type of man who never exaggerates his accomplishments, but "
      "he tries his best. You know, the type of man that would belittle his "
      "inferiors, if he could find any. Ha, ha, ha, ha!!!\""
   marionbartender_speech_051 = \
      "~kTova says, \"A pox on that town. Why don't you take your business "
      "elsewhere, stranger, because you're not welcome here. Out with you!\""
   marionbartender_speech_052 = \
      "~kTova says without looking at you, \"What, are you still here?\""
   marionbartender_speech_053 = \
      "~kTova says, \"Yes, there are treefolk in these parts, a kind and "
      "legendary creature that keep very much among themselves. The elders "
      "of Marion speak of their wisdom and intelligence, but they keep "
      "entirely to themselves now. It is said that something terrible "
      "happened to them in the past, isolating them to this day.\""
   marionbartender_speech_054 = \
      "~kTova says, \"Troll Whiskey? You have some? Hey Morrigan, get the "
      "good glasses down from the shelf and dust them off!\""
   marionbartender_speech_055 = \
      "~kTova says, \"You ask the people in Jasper how they feel about The "
      "Wryn's Keep, that thief Frular of Barloque renting it out like a "
      "common grange hall... why that's their ancestral capitol, and in the "
      "heart of everyone from Jasper!\""
   marionbartender_speech_056 = \
      "~kTova says, \"Aye, it's an old fortress outside of Jasper, and the "
      "traditional capital of the mountain kingdom of old. It is said that a "
      "half-hundred good fighters could hold the Cragged Mountains against "
      "an army if they hold The Wryn's Keep.\""
   marionbartender_speech_057 = \
      "~kTova says, \"Wulfgang? You must mean the same Wulfgang that I know. "
      "I'll drink to that devil.\""
   marionbartender_speech_058 = \
      "~kTova amiably says, \"Now I don't know what you might be talking "
      "about there.\""
   marionbartender_speech_059 = \
      "~kTova hisses, \"Those black-hearted thugs, sneaking around and "
      "spying on innocent folk... they should be hunted down like wild dogs "
      "and put on the gallows with their black-hearted master, the Duke.\""
   marionbartender_speech_060 = \
      "~kTova says, \"Some things are better left unsaid, and I'll tell you "
      "this on your way out of me bar, that black name is one of them.\""
   marionbartender_random_001 = \
      "~kTova says, \"Aye, the hotel rooms in Barloque may look small, but "
      "it's only because the rats are so big. It must be the rich diet, "
      "don't you think, Morrigan?\""
   marionbartender_random_002 = \
      "~kTova says, \"Lady Aftyn now, is a newcomer to this town. She is a "
      "real Lady, and I won't tolerate any bad talk of her in here. She "
      "helps those that are in need... the sick, wretched, the injured, and "
      "the impoverished.\""
   marionbartender_random_003 = \
      "~kTova says, \"Paddock is the type of guy who started out in life at "
      "the bottom... and then sank.\""
   marionbartender_random_004 = \
      "~kTova recites, \"Fams is the tavern in Tos Where the paths of all "
      "Meridian cross, but when you go there you'll wonder just who made the "
      "blunder and made the village idiot the boss!\""
   marionbartender_random_005 = \
      "~kTova says, \"Ah, there's nothing wrong with Paddock that "
      "reincarnation won't fix.\""
   marionbartender_random_006 = \
      "~kTova says, \"That Paddock never did a thing in his life, and even "
      "that he hasn't done well.\""
   marionbartender_random_007 = \
      "~kTova says, \"A fella I know told Paddock he should just try to be "
      "himself. Isn't that terrible advice? Ha, ha, ha, ha!!\""
   marionbartender_random_008 = \
      "~kTova says, \"Ah sure, everybody loves Paddock, and so does he.\""
   marionbartender_random_009 = \
      "~kTova says, \"I heard Paddock was trying to hire a dwarf to help him "
      "behind the bar... he thinks it will make the drinks look bigger!\""
   marionbartender_random_010 = \
      "~kTova says, \"Did you hear about the man from Marion, an honest "
      "farmer now, who was stabbed thirty-five times in his own home? Aye, "
      "he was only learning to eat with a fork!\""
   marionbartender_random_011 = \
      "~kTova has a mug, and takes a sip occasionally."
   marionbartender_random_012 = \
      "~kTova says, \"So this adventurer walks into the tavern, he wants to "
      "know where he can find a troll. I says, well, depends on where you "
      "left him! Ha, ha, ha, ha!!\""
   marionbartender_random_013 = \
      "~kTova says, \"No, but in fairness now, if you want to improve your "
      "skills at combat, you'd do best to pick a fight that you'll have ~I "
      "some ~I trouble finishing.\""
   marionbartender_random_014 = \
      "~kTova says, \"When you're feeling a little worn out, you can be sure "
      "you'll be welcome at The Limping Toad, %s. I think you'll find an inn "
      "or a tavern is the place to rest up.\""
   marionbartender_random_015 = \
      "~kTova says, \"If you're new to the business of fighting monsters, "
      "then you'd best stick to battling those beasties that are within your "
      "abilities. Aye, many young adventure types hunt the rats, and the "
      "baby spiders.\""
   marionbartender_random_016 = \
      "~kTova says, \"Marion may be a slow kind of place, but we remember "
      "what's important and keep our houses in order. It always pays to be "
      "respectful to those you meet, and you will learn important lessons "
      "that will help to guide you.\""
   marionbartender_random_017 = \
      "~kTova says, \"I've heard that the temples serving the four gods are "
      "remote, but that they are accessible to the devoted. In truth the "
      "temple of Shal'ille is close to this town, and many a pilgrim stops "
      "in my little tavern for a little... fortification... on their way to "
      "see the priestess.\""
   marionbartender_random_018 = \
      "~kTova says, \"Gather up interesting things along the trail, you can "
      "never tell what may draw a shilling or two in town, %s. Morrigan "
      "there may even be interested, for he peddles all sorts of nonsense "
      "back there in his nook. Isn't that right, Morrigan?\""
   marionbartender_random_019 = \
      "~kTova says, \"If it's the fighting you're curious about now, why "
      "then go see Rook up in Cor Noth. He was a great officer in the King's "
      "Army, %s, and a hero to many of us. He makes his living now by "
      "training those that live and die by the sword.\""
   marionbartender_random_020 = \
      "~kTova says, \"Watch for the living trees in these parts, for they "
      "are a wonder indeed. But do not harm them... it is bad luck and "
      "misfortune upon those that do.\""
   marionbartender_random_021 = \
      "~kTova says, \"Watch your step in the mountains. The paths up there "
      "are treacherous, and overrun with every kind of evil beast %s.\""
   marionbartender_random_022 = \
      "~kTova says, \"Colhorr, now, in fairness... he's a competent "
      "blacksmith, %s, and may have a few items that would draw your eye. "
      "Aye, but he's deaf as a post from hitting that anvil longer than you "
      "and I have been in breeches, so speak clearly when you talk to him.\""
   marionbartender_random_023 = \
      "~kTova says, \"This is a great life in Marion, %s, I learn more than "
      "you might suspect from serving the locals and the passers through. "
      "Aye, and sometimes enjoy a pint or two myself.\""
   marionbartender_random_024 = \
      "~kTova says, \"You know the recipe for making chicken soup in Jasper? "
      "Well now first thing, you steal two chickens...\""
   marionbartender_random_025 = \
      "~kTova says, \"On the other hand, you have different fingers. Ha, ha, "
      "ha, ha!! Different fingers!! Get it Morrigan? Ha, ha, ha, ha, ha!!\""
   marionbartender_random_026 = \
      "~kTova says, \"Good %s, did you know the people of Marion invented "
      "the wheelbarrow? Aye, well, then they gave the design to the good "
      "folk of Jasper, to teach them to walk upright...\""
   marionbartender_random_027 = \
      "~kTova says, \"A farmer from Marion is lying in bed next to his wife. "
      "He tells her 'Dear wife, I've got terrible insomnia.' 'Well,' she "
      "says 'If you go to sleep, it won't bother you.' Ha, ha, ha, ha!!\""
   marionbartender_random_028 = \
      "~kTova says, \"I knew this fella from Jasper who never had a shilling "
      "to his name... so he changed his name!\""
   marionbartender_random_029 = \
      "~kTova says, \"Aye, I know another fella from Tos, who is so lazy he "
      "can sleep twenty-four hours a day. The only trouble is, he sleeps "
      "thirty hours a day.\""
   marionbartender_random_030 = \
      "~kTova says, \"And this woman I know from Tos, known her all my life, "
      "I swear to the blessed saints. She is ~Iso~I lazy she could become a "
      "landmark! By the gods, there's nothing else of interest to see in "
      "that wretched place! Ha, ha, ha, ha, ha!!\""
   marionbartender_random_031 = \
      "~kTova says, \"Good %s, I heard about a fella from Tos who was so "
      "lazy, that he died at twenty-five and no one figured it out until he "
      "was fifty!\""
   marionbartender_random_032 = \
      "~kTova says, \"I've got this brother-in-law, can't keep a shilling to "
      "his name. He borrows so much money from me, at night my wife goes "
      "through HIS pockets!\""
   marionbartender_random_033 = \
      "~kTova says, \"Good %s, did you hear about the Lady in Barloque, men "
      "always wanted her hand in marriage. The problem is that they had to "
      "take the rest of her too! Ha, ha, ha, ha!!\""
   marionbartender_random_034 = \
      "~kTova says, \"I know an old man here in Marion, a bit simple like "
      "many of the others in these parts. But you've got to give him this... "
      "he'll never be too old to learn a few new ways to be stupid!\""
   marionbartender_random_035 = \
      "~kTova says, \"This fella passed through the tavern a while back, and "
      "Morrigan told me afterward that he was an outlaw. Said he's a wanted "
      "man in Barloque. So I asked Morrigan, now why do you think they would "
      "want any more thieves in Barloque? Ha, ha, ha, ha!!\""
   marionbartender_random_036 = \
      "~kTova says, \"Before we were married, my wife would always complain, "
      "'You're only after one thing.' Aye, now I've forgotten what it was. "
      "Ha, ha, ha, ha!!\""
   marionbartender_random_037 = \
      "~kTova says, \"Two Ladies from Barloque are talking. One Lady says "
      "'How do you keep your youth?' The other Lady says, 'Well, I lock him "
      "in the closet!' Ha, ha, ha, ha!\""
   marionbartender_random_038 = \
      "~kTova says, \"I got one for you. What's the difference between a "
      "woman from Cor Noth and an Orc? About forty pounds and a scimitar!\""
   marionbartender_random_039 = \
      "~kTova says, \"A man hereabouts went to the healer, only to find out "
      "he had but six months left to live. The healer now, she suggested "
      "that he sell his house in Marion, and move to Cor Noth. So the man "
      "says 'Will that help me live longer?' 'No,' the healer says, 'but it "
      "will certainly seem longer!'\""
   marionbartender_random_040 = "~kTova winks at Morrigan good-naturedly."
   marionbartender_random_041 = \
      "~kTova says, \"I hear the Princess said that civilization in Barloque "
      "will last ten thousand years. She forgot to tell us when it's going "
      "to begin. Ha, ha, ha, ha!\""
   marionbartender_random_042 = \
      "~kTova says, \"So this farmer walks into the tavern here, and asks me "
      "what time it is. I tell him it's four-fifteen. He narrows his eyes "
      "looking at me and says 'I must be going crazy, Tova. All day long "
      "I've been getting different answers!' Ha, ha, ha, ha!\""
   marionbartender_random_043 = \
      "~kTova says, \"I got another one. What's the difference between a "
      "woman from Cor Noth and a cow? Cows don't wear headscarves! Ha ha "
      "ha!\""
   marionbartender_random_044 = \
      "~kTova says, \"Nodes? I don't node nothing about nodes. How about "
      "you, Morrigan? Do you node about nodes? Ha, ha, ha, ha!!\""
   marionbartender_random_045 = \
      "~kTova says, \"Did you folks see Ran er'Hoth on the way into town? "
      "Crazy as a march hare, that man, aye but that's a different story "
      "now. Many of the people passing through Marion stop in on him, ha, "
      "ha, and seek his wisdom!\""
   marionbartender_random_046 = \
      "~kTova says, \"I spent some time in Tos, and I'll tell you now, it's "
      "a place that hides from its own evil intentions. Ignorant, lazy "
      "people. Why, even the dead are restless, and rise from the ground to "
      "haunt the graveyard! Aye, it's true!\""
   marionbartender_random_047 = \
      "~kTova says, \"Keep the noise down over there, or you'll find "
      "yourselves on the street!\""
   marionbartender_random_048 = \
      "~kTova grumbles, and busies himself cleaning glasses."
   marionbartender_trigger_barloque = "barloque"
   marionbartender_trigger_blessed = "blessed"
   marionbartender_trigger_bye = "bye"
