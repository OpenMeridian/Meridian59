   marionbartender_trigger_fey = "fey"
   marionbartender_trigger_hello = "hello"
   marionbartender_trigger_jala = "jala"
   marionbartender_trigger_jasper = "jasper"
   marionbartender_trigger_kalior = "kalior"
   marionbartender_trigger_kraanan = "kraanan"
