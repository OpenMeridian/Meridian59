   barloquetailor_trigger_venya_cyr = "venya'cyr"

   // BarloqueVaultman (Obert Cair'bre)
   barloquevaultman_speech_001 = \
      "~kObert says, \"Thou wilt never find a more noble city than this here "
      "Barloque.\""
   barloquevaultman_speech_002 = \
      "~kObert says, \"I've no need to buy a thing from thee. 'Tis space and "
      "what could be stored in it that I deal.\""
   barloquevaultman_speech_003 = \
      "~kObert says, \"Your servant always, my %s, fare thee well.\""
   barloquevaultman_speech_004 = \
      "~kObert says, \"I humbly thank you. Good day to thee, my %s.\""
   barloquevaultman_speech_005 = \
      "~kObert says, \"Hath thou seen the mockery Cor Noth makes of fine "
      "Barloque's clepsydra with their, dare I say, clock. 'Tis an insult to "
      "our intelligent brain, says I.\""
   barloquevaultman_speech_006 = \
      "~kObert says, \"I wonder what the council of five will do now? "
      "Perhaps Meidei knows.\""
   barloquevaultman_speech_007 = \
      "~kObert says, \"Surely Kalior hath made one enemy too many. This time "
      "his dealings hath surely earned him his trip to the grave.\""
   barloquevaultman_speech_008 = \
      "~kObert Cair'bre says, \"Good morrow, my %s. To what do I owe the "
      "honor of thy presence?\""
   barloquevaultman_speech_009 = \
      "~kObert Cair'bre says, \"Hail and well met, my %s. How fare thee?\""
   barloquevaultman_speech_010 = \
      "~kObert Cair'bre says, \"I am at thy service, good noble. For a fee "
      "that thou will find none too exorbitant, I will store a number of "
      "goods for thee. 'Twill be safe from harm or theft, I assure thee.\""
   barloquevaultman_speech_011 = \
      "~kObert says, \"In all its beauty, Jasper has surely taken a turn for "
      "the worse. I can barely believe the reports that the rebel talk is "
      "originating there.\""
   barloquevaultman_speech_012 = \
      "~kObert says, \"Many a year has it been since I have had presumption "
      "to visit thither Marion. What hear thou of her farmers? They must be "
      "well, for their summer crop was bountiful and sweet.\""
   barloquevaultman_speech_013 = \
      "~kObert says, \"Hail her grace! The Princess grows beautifully into "
      "her rule. I pray Akardius' false claims to the throne do not slow her "
      "ascent.\""
   barloquevaultman_speech_014 = \
      "~kObert says, \"'Tis not my business to sell the goods housed within "
      "mine warehouses, for the true owners would like it not.\""
   barloquevaultman_speech_015 = \
      "~kObert says, \"Thou would not to leave tokens here for I have born "
      "witness that they move by their own desire. Thou could better profit "
      "thyself by offering those willful tokens to the council.\""
   barloquevaultman_speech_016 = \
      "~kObert says, \"A plague on Tos! In times long past, we took up arms "
      "against her. Our weapons now sit idle in their sheaths, but the stain "
      "of their insults disappears not.\""
   barloquevaultman_random_001 = \
      "~kObert says, \"Dost thou hear, hither sewers of Barloque and thither "
      "sewers of Jasper meet one another in a most disagreeable fashion. "
      "'Tis said much danger lies betwixt the two.\""
   barloquevaultman_random_002 = \
      "~kObert says, \"'Tis said that one man, who be both a rascal and a "
      "cur, dwelleth in our sewers. I ask thee, what business hath any man "
      "below the cobblestone of this fair city?\""
   barloquevaultman_random_003 = \
      "~kObert says, \"I do beseech thee, take thyself to the Bourgeois "
      "Castle and pledge thy allegiance to the Princess.\""
   barloquevaultman_random_004 = \
      "~kObert says, \"Alas, poor Pritchett doth try badly to masque as a "
      "native of Barloque. Mayhap, someone need teach the knave how to speak "
      "properly. His tongue doth create words which make sense not.\""
   barloquevaultman_random_005 = \
      "~kObert says, \"If thou hast need of a bank to store thy shillings, I "
      "would suggest a journey to the First Royal Bank of Jasper.\""
   barloquevaultman_random_006 = \
      "~kObert says, \"Methinks, thou may find the most interesting items "
      "stashed within the cupboards of the shop keepers. They may part with "
      "said items, if favors are done in exchange.\""
   barloquevaultman_random_007 = \
      "~kObert says, \"'Tis true enough, I do own the lot of these "
      "warehouses. Alas, save one. The guildhall on the west side. A rowdy "
      "bunch are they and not likely to give up their space to me or any one "
      "besides me for that matter.\""
   barloquevaultman_random_008 = \
      "~kObert says, \"How now! What's the matter?\""
   barloquevaultman_random_009 = \
      "~kObert says, \"How now! From where, pray tell, dost thou find all of "
      "these baubles which thou bringest for me to store?\""
   barloquevaultman_random_010 = \
      "~kObert says, \"'Tis good indeed, that I possess near all of "
      "Barloque's warehouses, for they quickly fill with all that noble folk "
      "like thyself wish to store.\""
   barloquevaultman_random_011 = \
      "~kWith a grunt, Obert moves a crate to the back door."
   barloquevaultman_random_012 = \
      "~kObert packs up a crate of goods and marks it with a number."
   barloquevaultman_random_013 = \
      "~kObert says, \"With nary a ship in port in over a score of years, I "
      "found myself easily in the means of acquiring these unused "
      "warehouses. And that proved most wise on the part of me, for now "
      "nearly every soul in the land comes to fill my buildings with their "
      "collectibles.\""
   barloquevaultman_random_014 = \
      "~kObert says, \"My children hath grown so much in so few years. How "
      "fare thy kin?\""
   barloquevaultman_random_015 = \
      "~kObert says, \"I pray thee, be on thy guard in hither docks. A "
      "magnificent city is Barloque, but not so much in that it hath not a "
      "bad side.\""
   barloquevaultman_random_016 = \
      "~kObert says, \"It appears that the Duke shall not claim the crown. "
      "The land shall see new trouble as another pretender tries to usurp "
      "the throne.\""
   barloquevaultman_random_017 = \
      "~kObert says, \"I am rather busy as thou can see. Make haste with thy "
      "business.\""
   barloquevaultman_random_018 = "~kThe smell of fish hangs in the air."
   barloquevaultman_trigger_barloque = "barloque"
   barloquevaultman_trigger_sell = "sell"
   barloquevaultman_trigger_bye = "bye"
   barloquevaultman_trigger_cor_noth = "cor noth"
   barloquevaultman_trigger_council = "council"
   barloquevaultman_trigger_duke = "duke"
   barloquevaultman_trigger_hello = "hello"
   barloquevaultman_trigger_help = "help"
   barloquevaultman_trigger_jasper = "jasper"
   barloquevaultman_trigger_marion = "marion"
   barloquevaultman_trigger_princess = "princess"
   barloquevaultman_trigger_buy = "buy"
   barloquevaultman_trigger_tokens = "tokens"
   barloquevaultman_trigger_tokens_2 = "tokens"
   barloquevaultman_trigger_tos = "tos"

   // GuildCreator (Frular)
   guildcreator_speech_001 = \
      "~kFrular says, \"Barloque doth house a favored hall of mine. The Hall "
      "of Explorers lies 'round the eastern corner here in south Barloque.\""
   guildcreator_speech_002 = \
      "~kFrular says, \"I need not buy from peddlers.\""
   guildcreator_speech_003 = "~kFrular says, \"Fare thee well.\""
   guildcreator_speech_004 = \
      "~kFrular says, \"'Twas King Zarcos IV, who demanded the priest's "
      "temple exist not within the walls of the cities. I could not let that "
      "abandoned Shal'ille temple go to ruin in the middle of Cor Noth. A "
      "fine guild hall it has made.\""
   guildcreator_speech_005 = \
      "~kFrular says, \"I have more than enough politics with mine chartered "
      "guilds and truly care not for the council's state affairs.\""
   guildcreator_speech_006 = \
      "~kFrular says, \"Even under Akardius, my halls are safe from search "
      "and seizure.\""
   guildcreator_speech_007 = "~kFrular says, \"Hail, %s!\""
   guildcreator_speech_008 = \
      "~kFrular says, \"If thou wish to make thy guild official, then thou "
      "shouldst buy a title from me. I maintain the records on Guild Halls.\""
   guildcreator_speech_009 = \
      "~kFrular says, \"Jaarba had paranoia in great measure. Before his "
      "affliction of insanity, he housed a small group of rebels. His abode "
      "is most unique in its maze layout.\""
   guildcreator_speech_010 = \
      "~kFrular says, \"No more bizarre town is there than yonder Jasper. "
      "What tales I could tell thee about Jaarba's Abode and the Wryn's "
      "Keep!\""
   guildcreator_speech_011 = \
      "~kFrular says, \"I hold no leases in Marion. They tolerate not the "
      "troubles that guilds bring forth.\""
   guildcreator_speech_012 = \
      "~kFrular says, \"Hail the Princess. It is through her grace that I am "
      "able to lease these halls. Yet, in truth, the Princess doth tax me "
      "too much.\""
   guildcreator_speech_013 = \
      "~kFrular says, \"I rent the finest guild halls in the land.\""
   guildcreator_speech_014 = \
      "~kFrular says, \"For centuries, Konima's Dwelling lay vacant in Tos "
      "awaiting the hero's return. I was only granted lease of said property "
      "with the clause that should Konima himself ask for it back, the "
      "building would be immediately emptied and the keys presented to him.\""
   guildcreator_speech_015 = \
      "~kFrular says, \"In days of yore, the mayor of Jasper sought to "
      "extract himself from the sovereignty of the crown. He had dug a great "
      "keep within the south mines, a perfect palace to hole up in the event "
      "of siege. No war came about. The King knew that the Mayor would "
      "eventually lose his fire as the mine's gold was depleted. I found it "
      "to be a rather reasonable lease from the town.\""
   guildcreator_random_001 = \
      "~kFrular says, \"I grow weary of dealing with fledgling guilds of "
      "little intention. I tell thee truly, I have canceled more than one "
      "charter in my time.\""
   guildcreator_random_002 = \
      "~kFrular says, \"There are many ways to take possession of a Hall "
      "from another guild. But thou must be patient, cunning and determined, "
      "indeed. So many believe they possess said talents, but only the best "
      "succeed.\""
   guildcreator_random_003 = \
      "~kFrular says, \"Take care in who thou asks to join thy guild. I've "
      "heard many a tale of new members outnumbering the old and ousting the "
      "master in favor of their own.\""
   guildcreator_random_004 = \
      "~kFrular says, \"A sad thing is those lonely men who hath true belief "
      "they can take the world by themselves. A man who hath no allies shall "
      "prosper nary a whit.\""
   guildcreator_random_005 = \
      "~kFrular says, \"Yon globe is for established Guild Masters to post "
      "their charter or to appeal for more members.\""
   guildcreator_random_006 = \
      "~kFrular says, \"Mayhaps, plenty of guild halls would be well "
      "received. Yet I do find the treaty breaking and subterfuge to be more "
      "interesting drama.\""
   guildcreator_random_007 = \
      "~kFrular says, \"I care not how a guild comes to possess my halls, "
      "only that they are kind enough to pay the rent.\""
   guildcreator_random_008 = \
      "~kFrular says, \"How fickle the boons of friendship. Friends make "
      "thee stronger. Yet, friends make thee more vulnerable as well.\""
   guildcreator_random_009 = \
      "~kFrular says, \"'Tis a sad guild that has but one or two members. In "
      "truth, I will traffic not with them and will endeavor to revoke the "
      "charter.\""
   guildcreator_random_010 = \
      "~kFrular says, \"Let me tell thee in hushed tones, ~I I believe that "
      "popinjay Herbutte spends his idle hours listening through yon wall.\""
   guildcreator_random_011 = \
      "~kFrular says, \"Hmm. My book shows me an error in a certain guild's "
      "charter. I've half a mind to revoke them.\""
   guildcreator_random_012 = \
      "~kThrough the western wall, you can hear the muffled sound of someone "
      "yelling. You can't quite make out what is said."
   guildcreator_random_013 = \
      "~kFrular flips through his book, casually checking that the guild "
      "charters are in proper order."
   guildcreator_random_014 = \
      "~kOn the floor behind Frular, you can see a spool of fine golden "
      "thread."
   guildcreator_random_015 = \
      "~kFrular says, \"My favored guildhall comes with the name the "
      "Bookmaster's Guild House. If managed with half a knat's brain, the "
      "guild who inhabits her can make shillings in great measure by opening "
      "her doors to the public.\""
   guildcreator_random_016 = \
      "~kFrular says, \"At the castle, thou will find fair Madelia. I take "
      "her to be sweet and supple. A most entertaining hostess is she. I "
      "protest unto thee, speak not to mine wife about these words.\""
   guildcreator_random_017 = \
      "~kFrular says, \"Mayhaps, I should retire and buy this city for "
      "myself and buy Cor Noth for the fair Madelia... How Now! How long "
      "hast thou been standing there?\""
   guildcreator_random_018 = \
      "~kFrular says, \"Can life become better than 'tis now? Guilds abound "
      "and mine profits soar to the sky above.\""
   guildcreator_random_019 = \
      "~kFrular says, \"I grow weary of dealing with the petty squabbling of "
      "these guilds. For certain, their bickering only serves to profit me, "
      "but mayhap more money is worth not the pains mine ears endure when "
      "they whine like babes.\""
   guildcreator_random_020 = \
      "~kFrular says, \"I am a very busy man. Seat thyself and wait or seek "
      "to come back at another time.\""
   guildcreator_trigger_barloque = "barloque"
   guildcreator_trigger_sell = "sell"
   guildcreator_trigger_bye = "bye"
   guildcreator_trigger_cor_noth = "cor noth"
   guildcreator_trigger_council = "council"
   guildcreator_trigger_duke = "duke"
   guildcreator_trigger_hello = "hello"
   guildcreator_trigger_help = "help"
   guildcreator_trigger_jaarba = "jaarba"
   guildcreator_trigger_jasper = "jasper"
   guildcreator_trigger_marion = "marion"
   guildcreator_trigger_princess = "princess"
   guildcreator_trigger_buy = "buy"
   guildcreator_trigger_tos = "tos"
   guildcreator_trigger_wryn = "wryn"

   // PrincessGuard (Keep Guard)
   princessguard_speech_001 = \
      "~kThe royal guard says, \"Barloque is truly a fine city.\""
   princessguard_speech_002 = \
      "~kThe royal guard says, \"A pox on Blackstone Keep.\""
   princessguard_speech_003 = \
      "~kThe royal guard says, \"Cor Noth is at the cross roads between the "
      "towns.\""
   princessguard_speech_004 = \
      "~kThe royal guard says, \"Hail the Council of Advisors!\""
   princessguard_speech_005 = \
      "~kThe royal guard says, \"Jasper is to the south and west.\""
   princessguard_speech_006 = \
      "~kThe royal guard says, \"Marion is in the west.\""
   princessguard_speech_007 = \
      "~kThe royal guard says, \"Long Live the Princess!\""
   princessguard_speech_008 = \
      "~kThe royal guard says, \"Miserable Tos is beyond the badlands.\""
   princessguard_trigger_barloque = "barloque"
   princessguard_trigger_blackstone = "blackstone"
   princessguard_trigger_cor_noth = "cor noth"
   princessguard_trigger_council = "council"
   princessguard_trigger_jasper = "jasper"
   princessguard_trigger_marion = "marion"
   princessguard_trigger_princess = "princess"
   princessguard_trigger_tos = "tos"

