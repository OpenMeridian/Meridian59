   // Barloquetailor (Barloquetailor)
   barloquetailor_speech_001 = \
      "~kMadelia says, \"Nearby Barloque is the capital city of our fair "
      "kingdom. By my troth, I do prefer her to the crusted streets of Tos.\""
   barloquetailor_speech_002 = "~kMadelia says, \"Fare thee well, my %s.\""
   barloquetailor_speech_003 = \
      "~kMadelia says, \"If thou can not afford my fine apparels, Cor Noth "
      "houses a tailor of lesser skill.\""
   barloquetailor_speech_004 = \
      "~kMadelia says, \"I do not involve myself in the affairs of the "
      "council save where Her Highness is concerned.\""
   barloquetailor_speech_005 = \
      "~kMadelia says, \"I have counseled the princess in private to be wary "
      "of these men, but alas, she doth believe in the good in others. I can "
      "but hope she sees through their deceitful intentions ere she too is "
      "hurt.\""
   barloquetailor_speech_006 = \
      "~kMadelia says, \"I truly thought they wished to help me. How was I "
      "to know they did but lie to further their own cause? I have business "
      "to attend to, I pray thee, go now.\""
   barloquetailor_speech_007 = \
      "~kMadelia says, \"They are just as deceitful and wicked as they "
      "accuse the others of being. If thou knew the truth about the .... "
      "situation, thou wouldst not support them as thou dost now.\""
   barloquetailor_speech_008 = \
      "~kMadelia says, \"The Duke is dead. It is funny that he has as much "
      "to offer Meridian now as he did in life.\""
   barloquetailor_speech_009 = \
      "~kMadelia says, \"I do recall reading somewhere of a vision of the "
      "three, which were clearly different sides of the same power.\""
   barloquetailor_speech_010 = \
      "~kMadelia whispers, \"I have an ancient text, found in the storeroom "
      "of a necromancer. I am not even certain he ever read it, but it tells "
      "of another god. One with no bond to those we now worship. This god, "
      "so saith the text, was imprisoned in another place, so that its "
      "presence was removed from this land. It further saith that this god "
      "shall return. Since then I have wished to know more of the old "
      "legends that seem to have vanished from our records. Why would anyone "
      "have made these records vanish on purpose?\""
   barloquetailor_speech_011 = \
      "~kMadelia says, \"Good morrow, my %s. How may I tailor thee?\""
   barloquetailor_speech_012 = \
      "~kMadelia says, \"Good day to thee, my %s. Doth thou require a new "
      "gown?\""
   barloquetailor_speech_013 = \
      "~kMadelia says, \"Her weavings do ever seem the very essence of life, "
      "yet my gowns are more in fashion. Her tapestries can hold thee "
      "spellbound for hours.\""
   barloquetailor_speech_014 = \
      "~kMadelia says, \"There be no insect here. To great lengths, I have "
      "gone to rid this room of moths.\""
   barloquetailor_speech_015 = \
      "~kMadelia says, \"Strong and hard working are the mining men of yon "
      "Jasper. I must say that Jonas fits in well there.\""
   barloquetailor_speech_016 = \
      "~kMadelia says, \"'Tis a sweet place, thither Marion. Yet, I pray "
      "thee, tell me what is there to do in such a quaint spot?\""
   barloquetailor_speech_017 = \
      "~kMadelia says, \"Many believe she is a menace, and I feel that she "
      "is not merely a misguided young girl, but that this is only the "
      "surface of a deeper matter that shall soon be revealed.\""
   barloquetailor_speech_018 = \
      "~kMadelia says, \"Had anyone but listened to that poor child, mayhap "
      "Miriana would not have resorted to such violent deeds.\""
   barloquetailor_speech_019 = \
      "~kMadelia says, \"The nodes do fill once more, and it doth seem that "
      "Miriana hath wrought no lasting harm.\""
   barloquetailor_speech_020 = \
      "~kMadelia says, \"I am most certain that mine opinion on this matter "
      "is of no import.\""
   barloquetailor_speech_021 = \
      "~kMadelia says, \"Hail Kateriina. Her Highness hath brought me from "
      "the filth of yon Tos to the magnificent glory of hither castle.\""
   barloquetailor_speech_022 = \
      "~kMadelia looks you over with an approving smile and says, \"Mayhap "
      "later.\""
   barloquetailor_speech_023 = \
      "~kMadelia says, \"Can thou see not, I am busy at work.\""
   barloquetailor_speech_024 = \
      "~kMadelia says, \"My head doth pound with pain at this time.\""
   barloquetailor_speech_025 = \
      "~kMadelia says, \"I pray thee, speak not of Tos. Her lights are far "
      "behind me.\""
   barloquetailor_speech_026 = \
      "~kMadelia says, \"As sharp as shears, some would say, and just as "
      "deadly.\""
   barloquetailor_random_001 = \
      "~kMadelia says, \"I use only the best of material.\""
   barloquetailor_random_002 = \
      "~kMadelia says, \"Hast thou seen those atrocious red pants? Forsooth, "
      "cheaper garments could be made not. I laugh at those ill-bred enough "
      "to wear them.\""
   barloquetailor_random_003 = \
      "~kMadelia says, \"If thou seeks to be entertained, thou will find Her "
      "Highness' library to be most exhilarating.\""
   barloquetailor_random_004 = \
      "~kMadelia says, \"Pledge thyself to Her Highness and thou wilt find "
      "learning of skills and magic to be of greater ease.\""
   barloquetailor_random_005 = \
      "~kMadelia says, \"The princess hath a heart made of pure gold. Thou "
      "art most welcome to use her banquet room for any of thy grand "
      "gatherings.\""
   barloquetailor_random_006 = \
      "~kMadelia says, \"'Tis strange, every now and again the door to the "
      "tower is locked. I know not what goings about happen within the "
      "chamber of the Mocker.\""
   barloquetailor_random_007 = \
      "~kMadelia says, \"The Brownstone Inn is a perfect place to settle "
      "down for the night. If thou sees dear Pritchett within, I pray thee, "
      "tell him that I have forgotten not our plans to dine together.\""
   barloquetailor_random_008 = \
      "~kMadelia says, \"In faith, 'tis difficult not to speak in the manner "
      "befitting the nobles of Barloque. Thou must only know when to use "
      "thees, thous, thys and wherefores. Try it and thou will see how easy "
      "it is.\""
   barloquetailor_random_009 = \
      "~kMadelia says, \"I am without blue mushrooms. 'Tis time to make nice "
      "to that simpkin Frisconar.\""
   barloquetailor_random_010 = \
      "~kMadelia says, \"Thou should always have an excess of quality "
      "apparel. And a healthy variety for thy every occasion.\""
   barloquetailor_random_011 = \
      "~kMadelia stitches up a beautiful embroidered ballroom gown."
   barloquetailor_random_012 = \
      "~kMadelia sorts through a box of fine threads and wonders aloud, "
      "\"Now where did I leave my goldenrod?\""
   barloquetailor_random_013 = \
      "~kA young girl's voice calls from the other room, \"Mistress, we are "
      "finished with the hems. May we go out and play now?\" Madelia curtly "
      "calls back, \"I will check thy work when I finish with my customer.\""
   barloquetailor_random_014 = \
      "~kMadelia looks up briefly as you come through the door, and you can "
      "see a hint of tears in her eyes."
   barloquetailor_random_015 = \
      "~kMadelia says, \"Believe not all thou hearest. Though most is but "
      "truth diminished by perception, sometimes the most trustworthy source "
      "is the least reliable information.\""
   barloquetailor_random_016 = \
      "~kMadelia says, \"This facade begins to weary me. The only reason I "
      "keep it up is to spare poor Kateriina more grief than she already "
      "bears.\""
   barloquetailor_random_017 = \
      "~kMadelia says, \"Dost thou belong to a guild? Frular, the guild "
      "creator, is a ~Ivery good ~Ifriend of mine.\""
   barloquetailor_random_018 = \
      "~kMadelia says, \"I do believe that Frular is the most handsome man "
      "in all of the kingdom. Perchance, thou were sent not to me by his "
      "wife?\""
   barloquetailor_random_019 = \
      "~kMadelia says, \"Oh dear Pritchett, he tries in such great measure "
      "to blend with the nobility. If only he could properly learn the "
      "tongue of Barloque as I have. In faith, I do love him.\""
   barloquetailor_random_020 = \
      "~kMadelia says, \"I dread the thought of going back to Tos. 'Twas a "
      "most ugly affair when I left Frisconar.\""
   barloquetailor_random_021 = \
      "~kMadelia says, \"Her Highness doth require my full attention on this "
      "gown. I pray thee, be gone from mine room.\""
   barloquetailor_random_022 = \
      "~kYou hear some girlish giggles coming from the back room. Madelia "
      "yells to the door, \"Thou had better be hard at work back there.\""
   barloquetailor_trigger_barloque = "barloque"
   barloquetailor_trigger_bye = "bye"
   barloquetailor_trigger_cor_noth = "cor noth"
   barloquetailor_trigger_council = "council"
   barloquetailor_trigger_councilor = "councilor"
   barloquetailor_trigger_duke = "duke"
   barloquetailor_trigger_fate = "fate"
   barloquetailor_trigger_god = "god"
   barloquetailor_trigger_hello = "hello"
   barloquetailor_trigger_hester_gilk = "hester gilk"
   barloquetailor_trigger_insect = "insect"
   barloquetailor_trigger_jasper = "jasper"
   barloquetailor_trigger_marion = "marion"
   barloquetailor_trigger_miriana = "miriana"
