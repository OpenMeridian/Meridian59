   // BarloqueMerchant (Herbutte)
   barloquemerchant_speech_001 = \
      "~kHerbutte says, \"An axwaddle is a lazy person, you uncouth "
      "drumble.\""
   barloquemerchant_speech_002 = \
      "~kHerbutte says, \"Barloque is the only city worthy of attention. The "
      "others are but barnyards for the common cattle.\""
   barloquemerchant_speech_003 = \
      "~kHerbutte says, \"I offer fair values for thy gems and jewels. Mind "
      "you, I have quite an eye for flaws.\""
   barloquemerchant_speech_004 = "~kHerbutte says, \"To thee, Anon.\""
   barloquemerchant_speech_005 = \
      "~kHerbutte says, \"The clepsydra in the center of North Barloque is a "
      "clock. I presume thou are not so simple that thou can read it not.\""
   barloquemerchant_speech_006 = \
      "~kHerbutte says, \"Promise had Cor Noth as an offspring of grand "
      "Barloque, yet those young students add only waste to her river and "
      "sully her fine streets. Its clock tower is a common sundial compared "
      "to our fair clepsydra.\""
   barloquemerchant_speech_007 = \
      "~kHerbutte says, \"The council fill their cups with more than what's "
      "offered. They should let the Princess rule the land and return to the "
      "level of Advisors.\""
   barloquemerchant_speech_008 = "~kHerbutte says, \"Thou mockest me now!\""
   barloquemerchant_speech_009 = \
      "~kHerbutte says, \"Dost thou speak the language not? A drumble is a "
      "sluggish haskard.\""
   barloquemerchant_speech_010 = \
      "~kHerbutte says, \"Mayhap with the Duke out of the way, the Princess "
      "can take her rightful crown.\""
   barloquemerchant_speech_011 = "~kHerbutte says, \"Thou mockest me now!\""
   barloquemerchant_speech_012 = \
      "~kHerbutte says, \"I am the only fair dealer. Seek not Skivlat for a "
      "lowly axwaddle is he.\""
   barloquemerchant_speech_013 = \
      "~kHerbutte says, \"My word, never have I seen such a haskard as thee. "
      "A haskard is a fellow of low degree.\""
   barloquemerchant_speech_014 = "~kHerbutte says, \"Good morrow.\""
   barloquemerchant_speech_015 = \
      "~kHerbutte says, \"I am Meridian's first most jeweler. If thou hath "
      "gems to sell or if thou hath need of jewels, then I am at thy "
      "service. If not, then find ye the door behind thee.\""
   barloquemerchant_speech_016 = \
      "~kHerbutte says, \"Jasper hath but one value, the gems her mines "
      "produce.\""
   barloquemerchant_speech_017 = \
      "~kHerbutte says, \"I am the only fair dealer. Seek not Skivlat for a "
      "lowly axwaddle is he.\""
   barloquemerchant_speech_018 = \
      "~kHerbutte says, \"I just don't see what he hopes to gain by this, "
      "it's not like they will ever let him have a title of his own, besides "
      "traitor.\""
   barloquemerchant_speech_019 = \
      "~kHerbutte says, \"Thou jests. Marion is not a town of any stature.\""
   barloquemerchant_speech_020 = \
      "~kHerbutte says, \"On my allegiance, the Princess Kateriina be worthy "
      "to rule. She hath been properly bred for such, unlike that villainous "
      "Duke.\""
   barloquemerchant_speech_021 = \
      "~kHerbutte says, \"Pritchett doth belong elsewhere. His common tongue "
      "hath no control over the proper speak of Barloque. He doth create his "
      "own language.\""
   barloquemerchant_speech_022 = \
      "~kHerbutte says, \"The poor, of course. Only here in Barloque can "
      "thou truly find worthwhile gentlefolk.\""
   barloquemerchant_speech_023 = \
      "~kHerbutte says, \"Rat!?\" Herbutte jumps back, \"Oh no! Where be "
      "it?\""
   barloquemerchant_speech_024 = \
      "~kHerbutte says, \"I presume thou hast gold enough to view my gems.\""
   barloquemerchant_speech_025 = \
      "~kHerbutte says, \"I am the only fair dealer. Seek not Skivlat for a "
      "lowly axwaddle is he.\""
   barloquemerchant_speech_026 = \
      "~kHerbutte says, \"What of Solomon? He may be a friend to me, but he "
      "hath no sway here in Barloque.\""
   barloquemerchant_speech_027 = \
      "~kHerbutte says, \"I am of no mood to talk of my fair neighbor's "
      "dealings.\""
   barloquemerchant_speech_028 = \
      "~kHerbutte says, \"What doth thou think of me? I shall not tell thee "
      "Frular's secrets!\""
   barloquemerchant_speech_029 = \
      "~kHerbutte says, \"The tokens be fascinating magical objects the "
      "council seeks to study. If thou ever happens upon one, seek ye the "
      "council and rewarded wilt thou be.\""
   barloquemerchant_speech_030 = \
      "~kHerbutte says, \"I have not been to a more disagreeable spot than "
      "Tos. The city streets doth run rampant with the most unworthy of "
      "cretins.\""
   barloquemerchant_random_001 = \
      "~kHerbutte says, \"I won't traffic with those vanishing tokens. In "
      "faith, even the council knows not why they teleport out to the "
      "wilds.\""
   barloquemerchant_random_002 = \
      "~kHerbutte says, \"The clepsydra keeps perfect time. 'Tis a pity the "
      "dreary rabble knows not how to read it.\""
   barloquemerchant_random_003 = \
      "~kHerbutte says, \"No better place is there than Barloque. Mayhaps "
      "there be no worse place than the foul docks and sewers.\""
   barloquemerchant_random_004 = \
      "~kHerbutte says, \"By my troth, we've no rat problem. 'Tis but rumors "
      "spread by the lesser cities.\""
   barloquemerchant_random_005 = \
      "~kHerbutte says, \"Madelia is naught but a lightskirt. Were she not "
      "the only clothier of merit, she would surely be selling something "
      "else by the docks.\""
   barloquemerchant_random_006 = \
      "~kHerbutte says, \"Frular deals in guild halls in the thin walled "
      "building beside me. Mine ears know quite a few stories of his "
      "clientele.\""
   barloquemerchant_random_007 = \
      "~kHerbutte says, \"Vermin infest our streets, and no, I speak not of "
      "rats. I refer to the new residents, that groundling Fehr'loi Qan and "
      "that candlewaster Pritchett.\""
   barloquemerchant_random_008 = \
      "~kHerbutte says, \"To the south east, the Bourgeois Castle foliage "
      "blooms beautifully this time of year. 'Tis a magnificent palace "
      "befitting of our proud Kateriina.\""
   barloquemerchant_random_009 = \
      "~kA slight sneer comes to Herbutte's lips as he looks you over."
   barloquemerchant_random_010 = \
      "~kHerbutte cranes his head slightly as if listening to the eastern "
      "wall."
   barloquemerchant_random_011 = \
      "~kHerbutte says, \"Perchance, wouldst thou have thy gems appraised, "
      "good gentle?\""
   barloquemerchant_random_012 = \
      "~kHerbutte says, \"Through these thin walls it hath come to mine ears "
      "that this world holds a great many prattling fools.\""
   barloquemerchant_random_013 = \
      "~kHerbutte says, \"No reason do I see for ever setting foot outside "
      "of Barloque, except perchance to pay visit to the glorious Castle of "
      "her Highness.\""
   barloquemerchant_random_014 = \
      "~kHerbutte says, \"Astounded am I at the utter incompetence abound in "
      "this world. Take for example, that drumble Solomon, hath thou ever "
      "set eyes upon another man who wears his belly so far from his back.\""
   barloquemerchant_random_015 = \
      "~kHerbutte says, \"How may I be of service to thee?\""
   barloquemerchant_random_016 = \
      "~kHerbutte says, \"Doth thou smell that sea air? Verily, 'tis "
      "refreshing. Thou wilt find it not quite so hale in any other city.\""
   barloquemerchant_random_017 = \
      "~kHerbutte says, \"Alas, this world brims with inadequate drumble. "
      "How I long to have words with a civilized gentleman of the proper "
      "class.\""
   barloquemerchant_random_018 = \
      "~kHerbutte says, \"Wilt thou buy nothing more?! Thy useless "
      "countenance merely wastes space in my shop.\""
   barloquemerchant_random_019 = "~kHerbutte casts a withering glance at you."
   barloquemerchant_random_020 = \
      "~kHerbutte says, \"Be gone, thou artless rump-fed giglet!\""
   barloquemerchant_random_021 = \
      "~kHerbutte says, \"Away, thou surly idle-headed puttock!\""
   barloquemerchant_random_022 = \
      "~kHerbutte says, \"Trouble me no more, thou mewling ill-breeding "
      "foot-licker!\""
   barloquemerchant_random_023 = \
      "~kHerbutte says, \"Remove thyself, thou wayward common-kissing "
      "gudgeon!\""
   barloquemerchant_random_024 = \
      "~kHerbutte says, \"Enough, thou infectious fool-born bugbear!\""
   barloquemerchant_random_025 = \
      "~kHerbutte says, \"Away with thee, thou craven pox-marked lout!\""
   barloquemerchant_random_026 = \
      "~kHerbutte says, \"Leave, thou fobbing half-faced hugger-mugger!\""
   barloquemerchant_random_027 = \
      "~kHerbutte says, \"I say be gone, thou spongy milk-livered codpiece!\""
   barloquemerchant_random_028 = \
      "~kHerbutte yells, \"Thou droning onion-eyed malt-worm, leave me!\""
   barloquemerchant_random_029 = \
      "~kHerbutte yells, \"Thou tottering doghearted barnacle, I wish never "
      "to see thy face again!\""
   barloquemerchant_trigger_axwaddle = "axwaddle"
   barloquemerchant_trigger_barloque = "barloque"
