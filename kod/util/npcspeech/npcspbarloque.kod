   // BarloqueClerk (Caramo)
   barloqueclerk_speech_001 = \
      "~kCaramo says, \"Fare thee well and honor Jala's Truth.\""
   barloqueclerk_speech_002 = \
      "~kCaramo says, \"The Council of Meridian, appointed by the King, "
      "governs thy kingdom. Common law, however, is at the mandate of the "
      "Justicar's office.\""
   barloqueclerk_speech_003 = \
      "~kCaramo says, \"Welcome to the office of the Justicar, %s.\""
   barloqueclerk_speech_004 = "~kCaramo blushes, her cheeks flushing pinkly."
   barloqueclerk_speech_005 = \
      "~kCaramo says, \"Everyone has a right to their own mind about things, "
      "this is no exception.\""
   barloqueclerk_trigger_bye = "bye"
   barloqueclerk_trigger_council = "council"
   barloqueclerk_trigger_hello = "hello"
   barloqueclerk_trigger_jonas = "jonas"
   barloqueclerk_trigger_rebels = "rebels"

   // BarloqueInnkeeper (BarloqueInnkeeper)
   barloqueinnkeeper_speech_001 = \
      "~kPritchett says, \"I am rather new to the Capital City, but I hath "
      "gaineth acceptanceth from the people hither here. When I am able to "
      "buyeth my title, not a soul wilt not know I am from here not.\""
   barloqueinnkeeper_speech_002 = \
      "~kPritchett says, \"Bye, I mean, by my troll, it 'twas good to have "
      "sighted you. Fare and be well.\""
   barloqueinnkeeper_speech_003 = \
      "~kPritchett says, \"It 'tis a well enough town, Cor Noth is. It 'tis "
      "a pity that her river is so very verily unclean.\""
   barloqueinnkeeper_speech_004 = \
      "~kPritchett says, \"Akardius and the Princess struggle to gain the "
      "influence of the Council. Seek out Joguer. He may know the individual "
      "agendas of each council member.\""
   barloqueinnkeeper_speech_005 = \
      "~kPritchett says, \"The Duke was a scoundrel, but I am not sure that "
      "his grizzly death was fitting, even for one such as he.\""
   barloqueinnkeeper_speech_006 = \
      "~kPritchett says, \"Thee putteth faith in too many rumors, everyone "
      "knoweth they be only myths and legends.\""
   barloqueinnkeeper_speech_007 = \
      "~kPritchett says, \"Hello, er... goodly met, fair travelfolk.\""
   barloqueinnkeeper_speech_008 = \
      "~kPritchett says, \"This here be the finest inn in yonder Barloque. "
      "Thee should relaxeth for a bit.\""
   barloqueinnkeeper_speech_009 = \
      "~kPritchett says, \"I have seen the man standing right outside the "
      "gates. Not by the docks mind you, but the southern side. You can "
      "sometimes catch him when you are heading toward the Princess' castle. "
      "I have heard though that he moves about.\""
   barloqueinnkeeper_speech_010 = \
      "~kPritchett says, \"Ha, thee hath never seeneth a low-brow town such "
      "as wither Jasper, why the new faction wouldeth chooseth to settle "
      "there is beyond me.\""
   barloqueinnkeeper_speech_011 = \
      "~kPritchett says, \"Many a good food cometh frometh Marion. In fate, "
      "it 'tis a bountiful place.\""
   barloqueinnkeeper_speech_012 = \
      "~kPritchett says, \"I heareth that she never batheth. Doth no one "
      "wonder what hideth beneath all that filth?\""
   barloqueinnkeeper_speech_013 = \
      "~kPritchett says, \"I understandeth not whence a child draweth such "
      "powers and knowledge. It doth maketh one ponder.\""
   barloqueinnkeeper_speech_014 = \
      "~kPritchett says, \"The goddess of light, Shal'ille, supposedly "
      "forgiveth all. But I cannot help it, I mistrusteth her.\""
   barloqueinnkeeper_speech_015 = \
      "~kPritchett says, \"She hath not a single shilling she could spendeth "
      "here. If thee followeth her path, then begone from here.\""
   barloqueinnkeeper_speech_016 = \
      "~kPritchett says, \"Methinks thee hadst better begone from here. Such "
      "a name be not welcome hither.\""
   barloqueinnkeeper_speech_017 = \
      "~kPritchett says, \"I doth nay need nary a courier at hither time.\""
   barloqueinnkeeper_speech_018 = \
      "~kPritchett says, \"I have heardeth that Miriana can summon great "
      "monsters upon the elements. But such tales be surely exaggerated.\""
   barloqueinnkeeper_speech_019 = \
      "~kPritchett says, \"I wert never witness to such an event, but many a "
      "visitor of mine claimeth to have seen it.\""
   barloqueinnkeeper_speech_020 = \
      "~kPritchett asks, \"Why would anyone striveth to draineth the holy "
      "nodes of their power...\""
   barloqueinnkeeper_speech_021 = \
      "~kPritchett says, \"Hail Kateriina! I pray she has the strength to "
      "combat this new threat.\""
   barloqueinnkeeper_speech_022 = \
      "~kPritchett whispers, \"Well, don't telleth anyone I said this, but "
      "this whole thing with the rebels tisn't really that bad.  What thy "
      "mean is people need shaking upeth every so often.\""
   barloqueinnkeeper_speech_023 = \
      "~kPritchett says, \"Ah, that's a story if thee hath the time.\""
   barloqueinnkeeper_speech_024 = \
      "~kPritchett says, \"Aye, I was a sailor. One of the last. Back in "
      "those yonder days when the ships still sailed.\""
   barloqueinnkeeper_speech_025 = \
      "~kPritchett says, \"Ah, that's a story if thee hath the time.\""
   barloqueinnkeeper_speech_026 = \
      "~kPritchett says, \"It was many years hither past... we were the last "
      "ship to sail from Barloque quay. Well, there be still some fishing "
      "boats that go out, but with those tides, no true sailing vessel can "
      "get very far from our shore before having to headeth back.\""
   barloqueinnkeeper_speech_027 = \
      "~kThe room goes silent as %s mentions stunted dwarf."
   barloqueinnkeeper_speech_028 = \
      "~kPritchett says, \"Aye, it hath become too dangerous to sail in "
      "those unpredictable tides. They rip your ship apart faster than you "
      "can spit. It 'tis as if the gods themselves do not be wanting man to "
      "sail beyond the coastal waters.\""
   barloqueinnkeeper_speech_029 = \
      "~kPritchett says, \"It was many years hither past... we were the last "
      "ship to sail from Barloque quay. Well, there be still some fishing "
      "boats that go out, but with those tides, no true sailing vessel can "
      "get very far from our shore before having to headeth back.\""
   barloqueinnkeeper_speech_030 = \
      "~kPritchett says, \"All of my colleagues and me here in Barloque hath "
      "knowledge indeed that Tos hath not the making of a great city! Yonder "
      "years ago, we wert at war with wither Tos.\""
   barloqueinnkeeper_random_001 = \
      "~kPritchett says, \"If thy monsters art causing thou too much havoc, "
      "maychanceth thee should seeketh Rook. He hath used to be here in "
      "Barloque to adviseth the Princess on such matters.\""
   barloqueinnkeeper_random_002 = \
      "~kPritchett says, \"Methought me heardeth that there be mystical "
      "treefolk neareth the forests of Faronath. It 'tis said they wieldeth "
      "great magic.\""
   barloqueinnkeeper_random_003 = \
      "~kPritchett says, \"Thee would serveth the common folk good, if thee "
      "were to fighteth the rats that swarmeth out from the nearby yonder "
      "sewer. The land be plagued with them and they be easy enough to "
      "dispatcheth.\""
   barloqueinnkeeper_random_004 = \
      "~kPritchett says, \"I do be seek you, there are those who can "
      "teacheth valuable skills to thy if thy asketh.\""
   barloqueinnkeeper_random_005 = \
      "~kPritchett says, \"I haveth heardeth that there be four or five "
      "temples out in the wilderness where thee may findeth the means of "
      "casting new spells.\""
   barloqueinnkeeper_random_006 = \
      "~kPritchett says, \"I do not knoweth not why so many people carry "
      "around mushrooms and berries. They all seemeth to be going in and out "
      "of Joguer's place across the street.\""
   barloqueinnkeeper_random_007 = \
      "~kPritchett says, \"In the old days, we used to sayeth that the only "
      "way to becometh a better sailor was to braveth a stronger storm at "
      "sea. I hear the sameth goes for fighting monsters.\""
   barloqueinnkeeper_random_008 = \
      "~kPritchett says, \"Even if thee do not haveth a room here at the "
      "Brownestone, it 'tis still a good place to resteth up.\""
   barloqueinnkeeper_random_009 = \
      "~kPritchett says, \"Truth be toldeth, I misseth my days as a sailor.\""
   barloqueinnkeeper_random_010 = \
      "~kPritchett says, \"Ah, do thoueth smell that sea air? How I misseth "
      "my days on the sea.\""
   barloqueinnkeeper_random_011 = \
      "~kPritchett says, \"Thee know, it 'tis not so hard to picketh up the "
      "eloquent way those in Barloque speaketh. Why I think in my short time "
      "thither, I have masteredeth it.\""
   barloqueinnkeeper_random_012 = \
      "~kPritchett says, \"Havest ye had pleasure to meeteth fair Madelia? "
      "She be my sweet beloved. Indeed and for suits, she wilt one day "
      "hither be mine wife.\""
   barloqueinnkeeper_random_013 = \
      "~kPritchett says, \"If thy seekeths the finest clothing, then seekest "
      "no more, for I will tell thou of my love, Madelia. She makeths the "
      "finest clothes for our Princess in yonder nearby Castle.\""
   barloqueinnkeeper_random_014 = \
      "~kPritchett says, \"I am indeedeth the luckiest man alive, for I have "
      "caught the eye of Madelia. Soon I will asketh her hand for marriage.\""
   barloqueinnkeeper_random_015 = \
      "~kPritchett says, \"I am very glad to see thou here. How fareth "
      "thou?\""
   barloqueinnkeeper_random_016 = \
      "~kPritchett says, \"Telleth me, goodly noble knave, where do thy hail "
      "frometh?\""
   barloqueinnkeeper_random_017 = \
      "~kPritchett says, \"If it beeth entertainment that thyself seekeths, "
      "I could recommendeth the Bhrama and the Falcon or the Bookmaker's "
      "house next door hither. I hear them gamblingeth lateth at night "
      "sometimes.\""
   barloqueinnkeeper_random_018 = \
      "~kPritchett says, \"Are thee just going to hangeth out here all day, "
      "you waddleaxer?!\""
   barloqueinnkeeper_random_019 = \
      "~kPritchett says, \"Is there not something better hither yonder that "
      "thee could be doing?\""
   barloqueinnkeeper_trigger_barloque = "barloque"
   barloqueinnkeeper_trigger_bye = "bye"
