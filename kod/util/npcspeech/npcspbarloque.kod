NpcSpeechBarloque is NpcSpeech
// NPC talk of Barloque:
// answers to trigger words and random lines.
// Each line is a resource (EN here, DE in the .lkod); Library adds the
// lists in CreateSpeechLibrary and CreateRandomLibrary.

constants:

   include blakston.khd

resources:

   include npcspbarloque.lkod

   // BarloqueApothecary (Joguer)
   barloqueapothecary_speech_001 = \
      "~kJoguer says, \"Such a fine city is our fair capital Barloque. The "
      "other cities can offer not the wonders of hither shop keepers.\""
   barloqueapothecary_speech_002 = \
      "~kJoguer says, \"In faith, I grow most of mine own stock. There is "
      "little that thou could offer me that I have need of.\""
   barloqueapothecary_speech_003 = \
      "~kJoguer says, \"Must thou make such haste in thy departure? I shall "
      "be sorry to see thee go.\""
   barloqueapothecary_speech_004 = \
      "~kJoguer says, \"Cor Noth hath an odd assortment of folk.\""
   barloqueapothecary_speech_005 = \
      "~kJoguer says, \"The council doth rule the land in the absence of our "
      "King.\""
   barloqueapothecary_speech_006 = \
      "~kJoguer says, \"Thou should understand that the death of the Duke is "
      "a bane. His nephew, even more incompetent than Kalior, has taken the "
      "reins of power.\""
   barloqueapothecary_speech_007 = \
      "~kA woman's voice calls from the other room, \"Joguer, bring thyself "
      "hither! Thy dinner will be ice before it sees the likes of thee.\""
   barloqueapothecary_speech_008 = \
      "~kA woman's voice yells from the other room, \"~BJoguer, dost thou "
      "listen to me not? 'Tis thrice I have called thee now. Attend to me. "
      "Joguer?\""
   barloqueapothecary_speech_009 = \
      "~kA woman irately calls from the other room, \"~BJoguer! Get thee to "
      "bed. I'll stay awake no more waiting for thee to shut thy bauble "
      "shop!\""
   barloqueapothecary_speech_010 = \
      "~kJoguer hums to himself, oblivious of your presence."
   barloqueapothecary_speech_011 = \
      "~kJoguer says, \"Ah, my gentle friend, how good it is to see thy "
      "countenance once again.\""
   barloqueapothecary_speech_012 = \
      "~kJoguer says, \"Ah, %s, how good it is to see thy countenance once "
      "again.\""
   barloqueapothecary_speech_013 = \
      "~kJoguer says, \"As the foremost expert and sage on herbs, roots, "
      "berries, mushrooms and other tidbits of foliage, I am humbly at thy "
      "service. By my troth, I can even teach a trick or two.\""
   barloqueapothecary_speech_014 = \
      "~kJoguer says, \"Thou will never find a more skilled artisan of stone "
      "than the man in Jasper who owns the hands of Afiera D'xor.\""
   barloqueapothecary_speech_015 = \
      "~kJoguer says, \"Well I don't pay much attention to all of them "
      "politics, but I don't see anything wrong with what Jonas has done.\""
   barloqueapothecary_speech_016 = \
      "~kJoguer says, \"The most fertile of soil can be found near yonder "
      "Marion.\""
   barloqueapothecary_speech_017 = \
      "~kA woman irately calls from the other room, \"~BJoguer! Get thee to "
      "bed. I'll stay awake no more waiting for thee to shut thy bauble "
      "shop!\""
   barloqueapothecary_speech_018 = \
      "~kJoguer says, \"'Tis my belief that the priestesses produce potions "
      "that cleanse the mind of spells. Be fair warned, quaffing such oft "
      "comes with a high price.\""
   barloqueapothecary_speech_019 = \
      "~kJoguer says, \"May the Princess have the strength to combat this "
      "new threat, Akardius.\""
   barloqueapothecary_speech_020 = \
      "~kJoguer says, \"In faith, I have not time for teaching. Mayhap, thou "
      "will seek me again when I have time to spare.\""
   barloqueapothecary_speech_021 = \
      "~kJoguer says, \"I sell the finest herbs and roots.\""
   barloqueapothecary_speech_022 = \
      "~kJoguer says, \"Mayhaps, thou could learn how to warm the air from "
      "one such as me. Or if thou has my favor, I will consider teaching "
      "thee how to fade clear of sight.\""
   barloqueapothecary_speech_023 = \
      "~kJoguer nods his head and half smiles when Tos is mentioned. It is "
      "obvious that he is refraining from voicing his opinions on the town."
   barloqueapothecary_speech_024 = \
      "~kJoguer says, \"Mayhaps, thou could learn how to warm the air from "
      "one such as me. Or if thou has my favor, I will consider teaching "
      "thee how to fade clear of sight.\""
   barloqueapothecary_random_001 = \
      "~kJoguer says, \"How now! Curious enough, our fledgling neighbor "
      "blacksmith who hath recently removed himself and his shop likewise "
      "from yonder Tos, has a most peculiar fascination with magical wands. "
      "I know not wherefore he collects them.\""
   barloqueapothecary_random_002 = \
      "~kJoguer says, \"Dost thou know that some mushrooms found in the wild "
      "can grant sustenance to those who consume them. 'Tis truly a wonder "
      "the different types of magics such foliage can deliver, be it as "
      "reagents or food stock.\""
   barloqueapothecary_random_003 = \
      "~kJoguer says, \"Learning the magic of the different gods be like "
      "treating thyself to a vast meal. Some foods, thou will find, do not "
      "go together. And oft, thou must cleanse thy palette before moving on "
      "to another entree. Like a fine dry wine, there are potions that can "
      "cleanse thy mind of unwanted learning.\""
   barloqueapothecary_random_004 = \
      "~kJoguer says, \"I beseech thee, allow it into my knowledge if thou "
      "doth feel warm in greater measure than pleases thy body. I would to "
      "keep the temperatures to the level of expectation required by my "
      "precious greenery within. Or if thou find comfort in such extreme "
      "warmth, mayhap I could one day teach thee the magic of heat.\""
   barloqueapothecary_random_005 = \
      "~kJoguer says, \"To the south of our beauteous city and deep within "
      "the Badlands, the Faren priestess doth reside. I take her to be high "
      "spirited and a pure ally to the breadth of nature, yet be fair warned "
      "the woman hath a temper seen not in the careful bounds of simple "
      "civilization.\""
   barloqueapothecary_random_006 = \
      "~kJoguer says, \"If thou art weary in thy feet, tongue twisted "
      "Pritchett doth host a pleasant inn across from mine shop. 'Tis true, "
      "indeed.\""
   barloqueapothecary_random_007 = \
      "~kJoguer says, \"I know not why the ships sail no more.\""
   barloqueapothecary_random_008 = \
      "~kJoguer says, \"Ah, I find nothing more intriguing than the wondrous "
      "nature of the reagents, how little they are, yet how big. Alas, I "
      "could spend all of my days here studying them.\""
   barloqueapothecary_random_009 = \
      "~kJoguer says, \"Nature hath spawned many a plant and rock, more "
      "indeed than one can put to numbers. 'Tis mine own belief that each "
      "pebble and every twig doth hold some essence of power that we will "
      "one day tap and put to use in our spell crafting.\""
   barloqueapothecary_random_010 = \
      "~kJoguer says, \"Can I help thee to find a certain herb or mushroom?\""
   barloqueapothecary_random_011 = \
      "~kJoguer says, \"Hmm. Interesting indeed that the elderberries of the "
      "early season behold smaller and more jagged leaves than those late "
      "comers of autumn.\""
   barloqueapothecary_random_012 = \
      "~kJoguer says, \"Were thou ever to find thyself near the mysterious "
      "stone circle that lies deep beyond the cragged mountains, and if thou "
      "possess tenacity in great measure, then, as I understand and breathe, "
      "thou will find means to the center and to the magic source within.\""
   barloqueapothecary_random_013 = \
      "~kJoguer says, \"No greater waste hath occurred than frivolous "
      "discarding of valued spell reagents by those who hath no awareness of "
      "their true value to those who practice acts of sorcery.\""
   barloqueapothecary_trigger_barloque = "barloque"
   barloqueapothecary_trigger_sell = "sell"
   barloqueapothecary_trigger_bye = "bye"
   barloqueapothecary_trigger_cor_noth = "cor noth"
   barloqueapothecary_trigger_council = "council"
   barloqueapothecary_trigger_council_2 = "council"
   barloqueapothecary_trigger_duke = "duke"
   barloqueapothecary_trigger_echo = "echo"
   barloqueapothecary_trigger_emote = "emote"
   barloqueapothecary_trigger_hello = "hello"
   barloqueapothecary_trigger_help = "help"
   barloqueapothecary_trigger_jasper = "jasper"
   barloqueapothecary_trigger_jonas = "jonas"
   barloqueapothecary_trigger_marion = "marion"
   barloqueapothecary_trigger_night = "night"
   barloqueapothecary_trigger_potion = "potion"
   barloqueapothecary_trigger_potion_2 = "potion"
   barloqueapothecary_trigger_princess = "princess"
   barloqueapothecary_trigger_pupil = "pupil"
   barloqueapothecary_trigger_buy = "buy"
   barloqueapothecary_trigger_teach = "teach"
   barloqueapothecary_trigger_learn = "learn"
   barloqueapothecary_trigger_learn_2 = "learn"
   barloqueapothecary_trigger_tos = "tos"
   barloqueapothecary_trigger_trick = "trick"

   // BarloqueBartender (Meidei)
   barloquebartender_speech_001 = \
      "~kMeidei says, \"Barloque be the capital city. Once she has properly "
      "embraced the bosom of Shal'ille, she will be able to truly bring the "
      "kingdom to peace.\""
   barloquebartender_speech_002 = \
      "~kMeidei says, \"I seek new recipes and oft run low on common things "
      "like torches.\""
   barloquebartender_speech_003 = \
      "~kMeidei says, \"May Shal'ille guide thee to righteousness.\""
   barloquebartender_speech_004 = \
      "~kMeidei hands you a deck of unusual playing cards and says, \"Dost "
      "thou lack in knowledge, the rules of this card game?\""
   barloquebartender_speech_005 = \
      "~kMeidei says, \"A horrid city is Cor Noth. The University strays "
      "from the teachings of Shal'ille and the inhabitants are wanton "
      "atheists. What's worse, the ivory chapel of Shal'ille hath been "
      "soiled by deviant guilds.\""
   barloquebartender_speech_006 = \
      "~kMeidei says, \"The five appointed councilors are sure to be "
      "wondering if their jobs are in jeopardy. I know not where they are "
      "right now. Mayhap Pritchett knows their whereabouts.\""
   barloquebartender_speech_007 = \
      "~k~IA crown is an arbitrary denomination of money, reagents, gems or "
      "items that the players agree to. Typically, one crown equals 50 "
      "shillings. High stake games have been known to have a single crown "
      "equal 10,000 shillings."
   barloquebartender_speech_008 = \
      "~k%s draws the ~gSlave`n card - ~I %s is booted out of this game and "
      "must pay up immediately. Remaining players continue. ~BIf only one "
      "player remains, that player has won the game."
   barloquebartender_speech_009 = \
      "~k%s draws the ~gVagabond`n card - ~I Nothing happens, play passes to "
      "the next player."
   barloquebartender_speech_010 = \
      "~k%s draws the ~gEsquire`n card - ~I must pay 10 Crowns to the Kitty."
   barloquebartender_speech_011 = \
      "~k%s draws the ~bClergy`n card - ~I each player must give %s 1 Crown "
      "immediately."
   barloquebartender_speech_012 = \
      "~k%s draws the ~rPrince`n card - ~I collect 1/2 of the Kitty."
   barloquebartender_speech_013 = \
      "~k%s draws the ~r~BKing~B`n card - ~I ~Bwin the game and collect all "
      "of the Kitty!"
   barloquebartender_speech_014 = \
      "~k%s draws the ~rLord Mayor`n card - ~I collect 1/10 of the Kitty."
   barloquebartender_speech_015 = \
      "~k%s draws the ~gTradesman`n card - ~I must pay 4 Crowns to the Kitty."
   barloquebartender_speech_016 = \
      "~k%s draws the ~gFreeman`n card - ~I may draw again if 2 Crowns are "
      "paid to the Kitty."
   barloquebartender_speech_017 = \
      "~k%s draws the ~gSerf`n card - ~I must pay 2 Crowns to the Kitty."
   barloquebartender_speech_018 = \
      "~k%s draws the ~gServant`n card - ~I must pay 1 Crown to the Kitty."
   barloquebartender_speech_019 = \
      "~kMeidei says, \"A new pox has formed in Tos.\""
   barloquebartender_speech_020 = \
      "~kMeidei says, \"An inconsequential god is that Faren. Stray not from "
      "the path of Shal'ille.\""
   barloquebartender_speech_021 = \
      "~kMeidei says, \"Spouting such nonsense can verily bring thee much "
      "trouble.\""
   barloquebartender_speech_022 = \
      "~kMeidei hands you a deck of unusual playing cards and says, \"Dost "
      "thou lack in knowledge, the rules of this card game?\""
   barloquebartender_speech_023 = \
      "~kMeidei says, \"The Fey Elhai be the most treasured children of "
      "Shal'ille. 'Twas foul Qor who corrupted the Fey Dirhai and began the "
      "horrid war for dominance o'er the Vale of Sorrows.\""
   barloquebartender_speech_024 = \
      "~kMeidei says, \"Welcome and praise Shal'ille.\""
   barloquebartender_speech_025 = \
      "~kMeidei says, \"I tend the bar, sell food, and pledge myself to the "
      "goddess Shal'ille.\""
   barloquebartender_speech_026 = \
      "~kMeidei says, \"Poor Jala. Had Shal'ille not already pledged herself "
      "to mending the land, mayhap she could have saved her fair sister from "
      "foul Qor.\""
   barloquebartender_speech_027 = \
      "~kMeidei says, \"I once thought those of Jasper should take to "
      "farming. All that is produced now are these blasted rebels and "
      "criminals. Mayhap the Justicar should pay them a visit.\""
   barloquebartender_speech_028 = \
      "~kMeidei says, \"The mighty wicked has fallen.\""
   barloquebartender_speech_029 = \
      "~kMeidei says, \"With the tutelage of Xiana, Kateriina is growing "
      "into a fine and compassionate woman.\""
   barloquebartender_speech_030 = \
      "~k~IMeidei will not keep track of your winnings and losses. You must "
      "select one player to keep tabs on who owes whom how much. This allows "
      "you to bet with any type of wager such as shillings, reagents and "
      "food."
   barloquebartender_speech_031 = \
      "~kMeidei says, \"Lord Kraanan be the husband to the holy Shal'ille. I "
      "must therefore tolerate his followers, despite their warring ways.\""
   barloquebartender_speech_032 = \
      "~kMeidei says, \"Marion is a peaceful and loving town under the "
      "caring guidance of good Shal'ille, praise be her name.\""
   barloquebartender_speech_033 = \
      "~kMeidei says, \"Her wanton ways and godless deeds befit not the "
      "goodness and love of Shal'ille. Listen not to Miriana, she only seeks "
      "to lead thee astray.\""
   barloquebartender_speech_034 = \
      "~kMeidei says, \"She draws attention to herself, and one begins to "
      "wonder, to what end?\""
   barloquebartender_speech_035 = \
      "~kMeidei says, \"Shal'ille forgives all, but those who seek "
      "forgiveness must do so of their own accord. I hope that Miriana will "
      "one day truly find enlightenment and the path to our gracious "
      "goddess.\""
   barloquebartender_speech_036 = \
      "~kMeidei says, \"Lady Shal'ille, lead us on the path of peace, for "
      "destruction only begets more destruction. I shudder at the call for "
      "her death, for to cause the death of another surely leads to one's "
      "own death.\""
   barloquebartender_speech_037 = \
      "~kMeidei says, \"I have no wish to speak of that depraved creature in "
      "the face of Shal'ille's goodness.\""
   barloquebartender_speech_038 = \
      "~kMeidei says, \"Speak not the foul name of that creature here. She "
      "seeks to besmirch the name of our Lady Shal'ille.\""
   barloquebartender_speech_039 = \
      "~kMeidei says, \"I tell thee, a magical mana node devoted to good "
      "appears when the Fey Dirhai are repelled from the forest.\""
   barloquebartender_speech_040 = \
      "~kMeidei says, \"Trust as I do that our Lady Shal'ille will protect "
      "us, should Miriana become a danger.\""
   barloquebartender_speech_041 = \
      "~kMeidei says, \"Enough of these happenings. Let us break bread and "
      "pray to Lady Shal'ille, that she may guide us.\""
   barloquebartender_speech_042 = \
      "~kMeidei says, \"With the tutelage of Xiana, Kateriina is growing "
      "into a fine and compassionate woman.\""
   barloquebartender_speech_043 = \
      "~kMeidei says, \"Speak thee not her wicked name! There is none so "
      "base as that vile harpy! Avoid her seductive ways and stay true to "
      "Shal'ille!\""
   barloquebartender_speech_044 = \
      "~kMeidei says, \"That changeling Riija is a prattler and a buffoon! "
      "Stay thee away from his twisted ways!\""
   barloquebartender_speech_045 = \
      "~kRules to play ~BFeudal Lords~B - ~I Players take turns picking (say "
      "~kdraw`n~I) from the deck. Select one person to keep track of how "
      "many ~g~Bcrowns~g`n~I each player owes. After every five draws, that "
      "person should announce each player's debt and what the total size of "
      "the ~rkitty~n~I is. The player who draws the ~BKing~n~I card, wins "
      "the entire kitty and all other players must pay that person what they "
      "owe."
   barloquebartender_speech_046 = \
      "~kMeidei says, \"If thou seeks food, common items, a peaceful game of "
      "chess, or to hear of the greatness of Shal'ille, then seek thee no "
      "further.\""
   barloquebartender_speech_047 = \
      "~kMeidei says, \"Praise be Shal'ille! The Lady of Gentle Rains "
      "protects all the world from the vile and wicked. Do you know of her "
      "ways?\""
   barloquebartender_speech_048 = \
      "~kThe room goes silent as %s mentions stunted dwarf."
   barloquebartender_speech_049 = \
      "~kMeidei says, \"Tos lies beyond the badlands to the south. May "
      "Shal'ille protect thee if thou wish to travel to her wicked walls.\""
   barloquebartender_speech_050 = \
      "~kMeidei says, \"The Vale of Sorrows as it is now called was molded "
      "by gentle Shal'ille for her favorite folk, the Fey Elhai. Those "
      "cursed Fey Dirhai spoil the most holy of lands.\""
   barloquebartender_speech_051 = \
      "~kMeidei says, \"Shal'ille is the goddess of peace and serenity. "
      "Dedication to her shall bring thee good health and enough food, which "
      "are forsooth the only necessities of life.\""
   barloquebartender_speech_052 = \
      "~kMeidei says, \"Xiana teaches the sermons of Shal'ille at her "
      "temple. By my faith, a wise lady.\""
   barloquebartender_random_001 = \
      "~kMeidei says, \"If thou hath shillings in great measure, they would "
      "be safe in a bank, but they would be better served if given to "
      "charity in the name of Shal'ille. If thou give them to me, I will "
      "distribute them to the poor for thee.\""
   barloquebartender_random_002 = \
      "~kMeidei says, \"Seek thee Rook for lore of the vile monsters that "
      "plague our land. After falling from grace of the Princess, I believe "
      "he hath moved to Cor Noth.\""
   barloquebartender_random_003 = \
      "~kMeidei says, \"If thou are intent on fighting, start with the rats. "
      "They are easy and overpopulated.\""
   barloquebartender_random_004 = \
      "~kMeidei says, \"The Priestess Xiana can instruct thee on the spells "
      "of blessed Shal'ille.\""
   barloquebartender_random_005 = \
      "~kMeidei says, \"Seek thee the temple of Shal'ille and pray for "
      "redemption! It lies in the deep woods of Ileria, north of Marion.\""
   barloquebartender_random_006 = \
      "~kMeidei says, \"Gems and herbs can oft be employed to work magic. I "
      "pray thee, use them only for the will of Shal'ille.\""
   barloquebartender_random_007 = \
      "~kMeidei says, \"Rest and eat in here rather than on the road. 'Tis "
      "best for thy body. Also for thy soul, for I will tell thee of blessed "
      "Shal'ille.\""
   barloquebartender_random_008 = \
      "~kMeidei says, \"Others will say that battling opponents more potent "
      "than thee will make thy body stronger. While this be true, combat is "
      "not the way to salvation. Only through the peaceful teachings of "
      "Shal'ille can thou find thyself content!\""
   barloquebartender_random_009 = \
      "~kMeidei says, \"If thou ask me, I believe those tokens cursed. Bring "
      "them not before me. Surely for some wicked reason, the council wishes "
      "to study them.\""
   barloquebartender_random_010 = \
      "~kMeidei says, \"Thou appears weighed down by equipment. Thou may "
      "wish to seek the Vaultman here in Barloque, or better yet give thy "
      "items to the needy in the name of Shal'ille.\""
   barloquebartender_random_011 = \
      "~kMeidei says, \"Beware the Cragged Mountains, they hide the vile "
      "temple of Qor and her sinful servants!\""
   barloquebartender_random_012 = \
      "~kMeidei says, \"Ran er'Hoth be the Wise Man of Marion. He is versed "
      "in the ways of Shal'ille and mayhap can teach thee her magic.\""
   barloquebartender_random_013 = \
      "~kMeidei says, \"I am told there is a man in Tos who teaches a spell "
      "of blessed Shal'ille. I know not his name.\""
   barloquebartender_random_014 = \
      "~kMeidei says, \"The Priestess Xiana can learn thee more of the "
      "scriptures of Shal'ille. Thou must take pilgrimage to her one day!\""
   barloquebartender_random_015 = \
      "~kMeidei says, \"Forsooth, the servants of Qor bring forth those "
      "horrid rats from the deep sewers to plague our lands.\""
   barloquebartender_random_016 = \
      "~kBowing his head, Meidei silently mouths a prayer to Shal'ille."
   barloquebartender_random_017 = \
      "~kMeidei glares at you with fire in his eyes and says, \"Pray tell, "
      "dost thou follow the ways of Shal'ille?\""
   barloquebartender_random_018 = \
      "~kMeidei says, \"Thou seems of gentle sort. Know this, a node of good "
      "magic lies in the vale of the fey.\""
   barloquebartender_random_019 = \
      "~kMeidei says, \"Praise Shal'ille the Calm! May she bid thee good "
      "health!\""
   barloquebartender_random_020 = "~kMeidei says, \"Shal'ille blesses thee.\""
   barloquebartender_random_021 = \
      "~kMeidei says, \"Lady Shal'ille, prithee bless those who come to my "
      "establishment and eat from my kitchens and drink from my kegs, bless "
      "those who follow the Princess, bless those who embrace your gentle "
      "bosom, bless those who refuse you for they know not what they do, "
      "bless the rats in hopes that they will become your servants of good, "
      "bless my family.\""
   barloquebartender_random_022 = \
      "~kMeidei says, \"Lady Shal'ille, I pray thee bless the farmers in the "
      "fields, bless the builders who give us shelter, bless the trees that "
      "give us shade, bless the rivers that give us water, bless the Guides "
      "that help us in our travels and bless the Guardians for smiting us "
      "not.\""
   barloquebartender_random_023 = \
      "~kMeidei says, \"Verily, the simple spells of our Lady hath more "
      "potency when employed by devoted follower of the utmost goodness.\""
   barloquebartender_random_024 = \
      "~kMeidei says, \"May Shal'ille protect us from the wagtails who try "
      "to fool us with weapons that are not as they appear. I doubt it not, "
      "she can do that.\""
   barloquebartender_random_025 = \
      "~kMeidei says, \"Shal'ille, I pray thee bless the children and the "
      "poor.\""
   barloquebartender_random_026 = \
      "~kMeidei says, \"Praise Shal'ille the Gentle! Study thou her ways!\""
   barloquebartender_random_027 = \
      "~kMeidei says, \"Follow her peaceful ways, and Shal'ille will bless "
      "thee.\""
   barloquebartender_random_028 = \
      "~kMeidei says, \"I beg thy pardon, fair customer... . ~I Shal'ille, "
      "prithee bring peace to the countryside... .~I Now what can I get for "
      "thee?\""
   barloquebartender_random_029 = \
      "~kMeidei says, \"If thou refuses the litany of Shal'ille, thou will "
      "surely perish and be damned to Qor!\""
   barloquebartender_random_030 = \
      "~kMeidei says, \"Bow thyself down before Shal'ille and beg for her "
      "forgiveness!\""
   barloquebartender_random_031 = "~kMeidei ignores you as he silently prays."
