   // BarloqueBlacksmith (Fehr'loi Qan)
   barloqueblacksmith_speech_001 = \
      "~kFehr'loi Qan says, \"I never use no armor, since I found out I can "
      "just think about a shield and it appears. Perhaps I could try to "
      "teach you.\""
   barloqueblacksmith_speech_002 = \
      "~kFehr'loi Qan says, \"Barloque is my new home. Uh, it may be too "
      "good fer the likes of me.\""
   barloqueblacksmith_speech_003 = \
      "~kFehr'loi Qan says, \"What you got? I'll look at weapons and armor. "
      "Maybe other interestin' stuff if you got any.\""
   barloqueblacksmith_speech_004 = "~kFehr'loi Qan says, \"G'bye.\""
   barloqueblacksmith_speech_005 = \
      "~kFehr'loi Qan says, \"Rook lives in Cor Noth. He can teach you how "
      "t' fight.\""
   barloqueblacksmith_speech_006 = \
      "~kFehr'loi Qan says, \"I care little for the politics of the "
      "council.\""
   barloqueblacksmith_speech_007 = \
      "~kFehr'loi Qan says, \"It is a shame to hear of Kalior's demise. I "
      "hope that Duke Akardius does not raise the taxes.\""
   barloqueblacksmith_speech_008 = "~kFehr'loi Qan says, \"What expedition?\""
   barloqueblacksmith_speech_009 = \
      "~kFehr'loi Qan says, \"I use the forge to... forge weapons and "
      "armor.\""
   barloqueblacksmith_speech_010 = "~kFehr'loi Qan says, \"'ello.\""
   barloqueblacksmith_speech_011 = \
      "~kFehr'loi Qan says, \"Uh... I can make armor... or... uh... a "
      "weapon. I'll also buy old stuff if it ain't broke or if it's unusual "
      "even if everyone else thinks it ain't worth nothin'. M' mum says I "
      "gots an eye for quality.\""
   barloqueblacksmith_speech_012 = \
      "~kFehr'loi Qan says, \"Quintor's the smith in Jasper.  He was my "
      "friend a long time ago, but then his wife left him and he hasn't "
      "been, uh, the same since.  I hear he found himself a friend though, I "
      "think the name was Queasy, or something.\""
   barloqueblacksmith_speech_013 = \
      "~kFehr'loi Qan says, \"Well I don't know much about politics and the "
      "like, but I do know that Jonas could never make a fairer ruler than "
      "Princess Kateriina.\""
   barloqueblacksmith_speech_014 = \
      "~kFehr'loi Qan says, \"Colhorr's up in Marion. We go drinking once a "
      "month and talk about, well, makin' weapons and stuff.\""
   barloqueblacksmith_speech_015 = \
      "~kFehr'loi Qan says, \"The Princess is a nice lady. She uh...has lots "
      "to do.\""
   barloqueblacksmith_speech_016 = \
      "~kFehr'loi Qan says, \"He also knows a bunch of gossip about the "
      "designers.\""
   barloqueblacksmith_speech_017 = \
      "~kFehr'loi Qan says, \"I sell armor and weapons.\""
   barloqueblacksmith_speech_018 = \
      "~kFehr'loi Qan says, \"Uh... I'm a smith. Can I help you?\""
   barloqueblacksmith_speech_019 = \
      "~kFehr'loi Qan says, \"Um, I can try to show you how to make a magic "
      "shield.\""
   barloqueblacksmith_speech_020 = \
      "~kFehr'loi Qan says, \"I left Tos. I got m' reasons.\""
   barloqueblacksmith_speech_021 = \
      "~kFehr'loi Qan says, \"You got a wand? Let me see it.\""
   barloqueblacksmith_speech_022 = \
      "~kFehr'loi Qan says, \"Weapons are good if you want to... kill "
      "stuff.\""
   barloqueblacksmith_random_001 = \
      "~kFehr'loi Qan says, \"There's a lot of Guilds around here. Frular, "
      "down the street, he makes 'em official like.\""
   barloqueblacksmith_random_002 = \
      "~kFehr'loi Qan says, \"I didn't like having m' shop across the, uh, "
      "street from that graveyard. Every night, I would hear such a ruckus. "
      "But Kraanan protected me from the zombies.\""
   barloqueblacksmith_random_003 = \
      "~kFehr'loi Qan says, \"I wasn't scared of nothin' dead. That's not "
      "why I left Tos.\""
   barloqueblacksmith_random_004 = \
      "~kFehr'loi Qan says, \"If you want to try out these weapons, take 'em "
      "down to Tos. The Arena of Kraanan's a good place to practice. Nobody "
      "really gets hurt there.\""
   barloqueblacksmith_random_005 = \
      "~kFehr'loi Qan says, \"If you're bored, people 'round here usually "
      "have an errand or two, if you're willin' to work.\""
   barloqueblacksmith_random_006 = \
      "~kFehr'loi Qan says, \"Some weapons are better for fightin' certain "
      "monsters than others, y'know.\""
   barloqueblacksmith_random_007 = \
      "~kFehr'loi Qan says, \"I once went to the, uh, temple of Kraanan. "
      "It's hard to get to. I got lost a couple times near that ancient "
      "place with the stones.\""
   barloqueblacksmith_random_008 = \
      "~kFehr'loi Qan says, \"Do you follow Kraanan the Fist? He's the "
      "strongest god.\""
   barloqueblacksmith_random_009 = \
      "~kFehr'loi Qan says, \"I, uh, still don't know many people in town. "
      "Rycksher always had good gossip 'bout everybody in Tos. I don't know "
      "no nothin' 'bout Barloque.\""
   barloqueblacksmith_random_010 = \
      "~kFehr'loi Qan carefully examines a half finished hammer."
   barloqueblacksmith_random_011 = \
      "~kFehr'loi Qan mumbles a short prayer to Kraanan."
   barloqueblacksmith_random_012 = \
      "~kWiping the sweat from his brow, Fehr'loi Qan returns to his work."
   barloqueblacksmith_random_013 = \
      "~kYour eyes sting slightly from the soot in the air."
   barloqueblacksmith_random_014 = \
      "~kThe heat from the furnace makes it uncomfortably warm in here."
   barloqueblacksmith_random_015 = \
      "~kFehr'loi Qan says, \"Does Paddock still run his grubby shop in "
      "Tos?\""
   barloqueblacksmith_random_016 = \
      "~kFehr'loi Qan says, \"The ocean air smells so good up here. I should "
      "go out for a cool swim before I get back to the forge.\""
   barloqueblacksmith_random_017 = \
      "~kFehr'loi Qan says, \"Oh, it's good to be alive.\""
   barloqueblacksmith_random_018 = \
      "~kFehr'loi Qan says, \"You're my friend.\""
   barloqueblacksmith_random_019 = \
      "~kFehr'loi Qan says, \"I'm glad you are here. I don't like those "
      "strangers that come in to my shop.\""
   barloqueblacksmith_random_020 = \
      "~kFehr'loi Qan says, \"I'm happier up here in Barloque, ain't you?\""
   barloqueblacksmith_random_021 = \
      "~kFehr'loi Qan says, \"Anything else I can help you with? I got to "
      "get on with my work.\""
   barloqueblacksmith_random_022 = \
      "~kFehr'loi Qan says, \"I don't like being here. Every morning, that "
      "bad fish smell.\""
   barloqueblacksmith_random_023 = \
      "~kFehr'loi Qan says, \"I'm gettin' mad now. You better leave before I "
      "give you a good punch.\""
   barloqueblacksmith_random_024 = \
      "~kFehr'loi Qan says, \"Don't look at me that way. I'll take you "
      "outside and give you a good bruisin'.\""
   barloqueblacksmith_random_025 = \
      "~kFehr'loi Qan says, \"Are you makin' fun of me? I don't like people "
      "makin' fun of me and I'm bigger than you.\""
   barloqueblacksmith_random_026 = \
      "~kFehr'loi Qan says, \"Stop hangin' around m' shop, little person, or "
      "I'll give you what for.\""
   barloqueblacksmith_random_027 = \
      "~kFehr'loi Qan says, \"I don't like strangers hangin' around my "
      "shop.\""
   barloqueblacksmith_random_028 = \
      "~kFehr'loi Qan says, \"What are you lookin' at? You wantin' to fight "
      "me?\""
   barloqueblacksmith_random_029 = \
      "~kFehr'loi Qan says, \"I'm not happy. Somebody pawned a magic weapon "
      "off on me and it turns out that it wasn't magical at all.\""
   barloqueblacksmith_trigger_armor = "armor"
