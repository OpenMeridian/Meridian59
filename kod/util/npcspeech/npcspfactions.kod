   // PrincessLiege (Princess Kateriina)
   princessliege_speech_001 = \
      "~kPrincess Kateriina says, \"Such tangible evidence would surely "
      "prove that there is more to the old story than first thought. Bring "
      "me one of these pendants.\""
   princessliege_speech_002 = \
      "~kPrincess Kateriina says, \"Bring me one of these pendants. It is "
      "vital for us to have the chance to study one of these artifacts.\""
   princessliege_speech_003 = \
      "~kPrincess Kateriina says, \"Fair Barloque, 'tis the royal city of "
      "the land. The loyal citizens merit the respect befitting of the "
      "gentlemen and ladies of the court.\""
   princessliege_speech_004 = \
      "~kPrincess Kateriina says, \"The King always told me Brax is where my "
      "family's bloodlines began.  It was my ancestor, Zarrus, who fled that "
      "land to settle in Tos.\""
   princessliege_speech_005 = \
      "~kPrincess Kateriina says, \"Of course I have heard the story of how "
      "the city fell beneath the earth by the magic of Tendrath.  I believe "
      "the exact historical location is somewhat southwest of here.\""
   princessliege_speech_006 = \
      "~kPrincess Kateriina says, \"Fare thee well. Travel with my "
      "blessings.\""
   princessliege_speech_007 = \
      "~kPrincess Kateriina says, \"I have been not to Cor Noth, but one day "
      "I may go to learn from its grand university.\""
   princessliege_speech_008 = \
      "~kPrincess Kateriina says, \"Dear father hath sent five elders to "
      "advise me in his own absence. All are tolerably old but wise. Shall I "
      "tell thee their names?\""
   princessliege_speech_009 = \
      "~kPrincess Kateriina says, \"Although I find Duke Akardius amiable, I "
      "still don't see as to why this silly contention with him must "
      "persist, for I am rightful heir to the throne.\""
   princessliege_speech_010 = \
      "~kPrincess Kateriina says, \"Welcome %s, my loyal subject.\""
   princessliege_speech_011 = \
      "~kPrincess Kateriina says, \"I am the ruler of Barloque. I show favor "
      "to those who ~Ijoin~I my faction.\""
   princessliege_speech_012 = \
      "~kPrincess Kateriina says, \"Should the necromancers truly be out "
      "there, let us hope that there are a few hunters out there as well.\""
   princessliege_speech_013 = \
      "~kPrincess Kateriina says, \"The story tells that Kara'set was the "
      "very first huntress of this kind. The story also mentions that she "
      "possessed a magic sword which was taken by Venya'cyr.\""
   princessliege_speech_014 = \
      "~kPrincess Kateriina says, \"I have heard that their swords are "
      "filled with magical energy that is especially effective against those "
      "whose souls are black as a moonless night.\""
   princessliege_speech_015 = \
      "~kPrincess Kateriina says, \"Murder and treachery within the ranks is "
      "unacceptable, although bringing a criminal to their due justice is an "
      "honorable service.\""
   princessliege_speech_016 = \
      "~kPrincess Kateriina says, \"Thou hath no reason to carry my "
      "insignia.\""
   princessliege_speech_017 = \
      "~kPrincess Kateriina says, \"Jasper produces such pretty gems.  It is "
      "a shame that they have chosen to rebel against order and stability, "
      "but I am sure in time they shall recognize the error of their "
      "actions.\""
   princessliege_speech_018 = \
      "~kPrincess Kateriina says, \"There is little reason to join at this "
      "time.\""
   princessliege_speech_019 = \
      "~kPrincess Kateriina says, \"The evil powers of the Urn transformed "
      "Venya'cyr into a being called a Lich. The legends say that Liches "
      "cannot be killed.\""
   princessliege_speech_020 = \
      "~kPrincess Kateriina says, \"Hail %s %s. How may I give help to thee? "
      "\""
   princessliege_speech_021 = \
      "~kPrincess Kateriina says, \"I thank thee, but I have no errands for "
      "thee.\""
   princessliege_speech_022 = \
      "~kPrincess Kateriina says, \"A pleasant town is Marion. I should wish "
      "to play in her orchards as I did as a girl.\""
   princessliege_speech_023 = \
      "~kPrincess Kateriina says, \"Closest to my dear father is Alzahakar "
      "the All-Mage, there is none more learned in the ways of magic as he. "
      "Kind Esseldi and calm Drechx, I have pleasure to call friends. "
      "Hardened Cylill and stingy Bei Naq are not entirely foreign to me as "
      "well.\""
   princessliege_speech_024 = \
      "~kPrincess Kateriina says, \"Many have told me that they truly roam "
      "the world. I think we must find out where and why?\""
   princessliege_speech_025 = \
      "~kPrincess Kateriina says, \"There are many young men and women among "
      "the land who look to us for protection, make sure to treat them as "
      "you would your own sibling, for in time they could grow to be of much "
      "help to our cause.\""
   princessliege_speech_026 = \
      "~kPrincess Kateriina says, \"How now, kind and gentle.\""
   princessliege_speech_027 = \
      "~kPrincess Kateriina says, \"We are as close as any family, and like "
      "a family any member who would think to harm another will be punished "
      "and cast out.\""
   princessliege_speech_028 = \
      "~kPrincess Kateriina says, \"I am weary from evaluating people to "
      "join my army.  Please, leave me in peace for now.\""
   princessliege_speech_029 = \
      "~kPrincess Kateriina says, \"He is the old mage who made the city of "
      "Brax sink into the earth. The hunter swords were crafted by him as "
      "well. His is a sad story.\""
   princessliege_speech_030 = \
      "~kPrincess Kateriina says, \"Yonder Tos seems not to have the loyalty "
      "that the crown requires, yet still, 'tis a goodly town.\""
   princessliege_speech_031 = \
      "~kPrincess Kateriina says, \"There are many young men and women among "
      "the land who look to us for protection, make sure to treat them as "
      "you would your own sibling, for in time they could grow to be of much "
      "help to our cause.\""
   princessliege_speech_032 = \
      "~kPrincess Kateriina says, \"Well, as the story goes, her reign ended "
      "when her entire palace was eaten by the earth.  Legends say that she "
      "made a pact to live forever.\""
   princessliege_speech_033 = \
      "~kPrincess Kateriina says, \"Yes he is one of my oldest ancestors.  "
      "One rumor states that when he served in the court of Venya'cyr he had "
      "the misfortune of touching a vessel of great corruption.  Many of my "
      "family believe that we have been cursed from that day forward.\""
   princessliege_random_001 = \
      "~kPrincess Kateriina says, \"Many of my loyal subjects require "
      "errands run from time to time. If thou could help them, they may "
      "reward thy efforts accordingly.\""
   princessliege_random_002 = \
      "~kPrincess Kateriina says, \"In faith, salvation rests in magic. It "
      "would behoove thee to seek one of the several temples spread about "
      "our land.\""
   princessliege_random_003 = \
      "~kPrincess Kateriina says, \"If thou finds thyself in yonder Twisted "
      "Forest, take time to visit ancient Alzahakar in his home. He is a "
      "most wondrous sorcerer.\""
   princessliege_random_004 = \
      "~kPrincess Kateriina says, \"It is my greatest pleasure of late to "
      "have the fair lady Madelia here within mine own castle to sew my "
      "dresses. How gleeful am I indeed.\""
   princessliege_random_005 = \
      "~kPrincess Kateriina says, \"Unlike the Duke, my banquet room remains "
      "ever accessible to all of my subjects. Mayhap one day I shall have "
      "fine chefs in waiting as well.\""
   princessliege_random_006 = \
      "~kPrincess Kateriina says, \"Yonder temple of our lady, Shal'ille, "
      "lies betwixt gentle Marion and the forest of the Fey.\""
   princessliege_random_007 = \
      "~kPrincess Kateriina says, \"I miss mine mother. Though I have never "
      "met her but for a moment on birth, my feelings for her are as strong "
      "as any child for their parent.\""
   princessliege_random_008 = \
      "~kPrincess Kateriina says, \"My dear father is not at all well. He "
      "was ever in mourning with the passing of my mother, yet of late, his "
      "mind loses hold of the tangible world around him.\""
   princessliege_random_009 = \
      "~kPrincess Kateriina says, \"Hath thou seen Captain Rook of late? I "
      "took him to be gallant, yet perchance my judgment hath mistook his "
      "temper. How doth he fare, I do wonder.\""
   princessliege_random_010 = \
      "~kPrincess Kateriina says, \"~ILoyalty~I must be continually shown, "
      "not merely proven but once.\""
   princessliege_random_011 = \
      "~kPrincess Kateriina says, \"I grant thee my permission and blessing "
      "to explore mine libraries. Thou will find knowledge of great measure "
      "within.\""
   princessliege_random_012 = \
      "~kPrincess Kateriina says, \"Spirits are high in hither court. I "
      "would to declare that I am most pleased with the affairs of state.\""
   princessliege_random_013 = \
      "~kPrincess Kateriina says, \"All is well with the kingdom. Mayhap I "
      "should declare a holiday or dedicate a structure.\""
   princessliege_random_014 = \
      "~kPrincess Kateriina says, \"Am I not the blood of mine own father? "
      "Is he not the King? Although the young Duke is quite intelligent he "
      "is still not of the royal line.  I am most displeased.\""
   princessliege_random_015 = \
      "~kPrincess Kateriina says, \"I am most displeased at present, please "
      "remove thyself from mine audience room.\""
   princessliege_trigger_amulet = "amulet"
