   // RebelLiege (Jonas D'Accor)
   rebelliege_speech_001 = \
      "~kJonas says, \"You wanna join the fighting elite?\""
   rebelliege_speech_002 = \
      "~kJonas says, \"You are not fit to be a soldier!\""
   rebelliege_speech_003 = \
      "~kJonas says, \"I am not out on a shopping trip, you idiot.\""
   rebelliege_speech_004 = \
      "~kJonas says, \"Some say Konima still rages a war deep in the bowels "
      "of those caves.  Others say Shal'ille still cries for the lost "
      "warrior.  Either way, he saved humankind from the foul orcs.\""
   rebelliege_speech_005 = \
      "~kJonas says, \"This is a trick to reveal all illusionary tricks to "
      "the pragmatic warrior's eye.\""
   rebelliege_speech_006 = \
      "~kJonas says, \"Can you believe that the Princess contends with that "
      "fool? He has no claim to the throne! He is incapable of leadership! "
      "He makes a mockery of the crown, and yet Kateriina puts up with it?\""
   rebelliege_speech_007 = \
      "~kJonas says, \"Meridian can't go on forever split between the Royal "
      "Houses! Some one must take charge, and I think I know who...\""
   rebelliege_speech_008 = \
      "~kJonas says, \"The axe has fallen! If the queen does not take the "
      "throne, then I shall!\""
   rebelliege_speech_009 = \
      "~kJonas says, \"Gilliz Pass is away in the mountains south of Jasper "
      "many leagues. It was at Gilliz that we slaughtered the caravan under "
      "the orc chieftain Huibin, and put the rest to the torch.\""
   rebelliege_speech_010 = \
      "~kJonas says, \"One would think that one would be greatly honored to "
      "be a part of such a grand beginning such as this.\""
   rebelliege_speech_011 = \
      "~kJonas says, \"Haste will give you stamina for a forced march.\""
   rebelliege_speech_012 = \
      "~kJonas crisply nods at you and says, \"At ease.\""
   rebelliege_speech_013 = \
      "~kJonas says, \"There may be help for you yet. The winds of change "
      "blow toward Jasper. Maybe your services can be rendered there.\""
   rebelliege_speech_014 = \
      "~kJonas says, \"This spell grants knowledge of weapons and shows the "
      "caster the true properties of a weapon.\""
   rebelliege_speech_015 = \
      "~kJonas says, \"The best irregular light infantry in the land, the "
      "Jasper folk. When on the campaign I have always used them as scouts "
      "and guides. Now they serve me well as the backbone of the new "
      "rebellion.\""
   rebelliege_speech_016 = \
      "~kJonas says, \"Konima was the greatest hero known to man.  His war "
      "party led a vicious assault on the Orc caves beyond the Western "
      "Twisted Forest.  Sixty warriors went in those caves, none came back.\""
   rebelliege_speech_017 = \
      "~kJonas says, \"I would have walked across the ocean itself to come "
      "to her aid.\""
   rebelliege_speech_018 = \
      "~kJonas says, \"Do not sully the name of that maiden or you shall "
      "incur my wrath. And that is not an enviable position, you may ask the "
      "orcs of Gilliz Pass about that. If you can find one living.\""
   rebelliege_speech_019 = "~kJonas says, \"Be gone, ~Iknave~I.\""
   rebelliege_speech_020 = \
      "~kJonas says, \"Resist poison is a little extra protection for the "
      "warrior against toxins.\""
   rebelliege_speech_021 = \
      "~kJonas says, \"Reveal is more lasting than identify, and will reveal "
      "the nature of a weapon for all to see.\""
   rebelliege_speech_022 = \
      "~kJonas says, \"He really is a remarkable swordsman. Fantastic.\""
   rebelliege_speech_023 = \
      "~kJonas says, \"A little man. Small, like. You know, a regular runt "
      "of a guy, trying to make up for his lack of ~Istature~I with fancy "
      "swordplay. I would say that he's a good man to have along in a fight "
      "if it weren't for his little guy attitude.\""
   rebelliege_speech_024 = \
      "~kJonas says, \"Like I'm scared of that little rodent? THAT MAN IS A "
      "COCKROACH!!\""
   rebelliege_speech_025 = \
      "~kJonas says, \"I play number eight for Marion in the annual test. "
      "First rate team.\""
   rebelliege_speech_026 = \
      "~kJonas says, \"I might be able to show you a few tricks, things I've "
      "picked up along the way.\""
   rebelliege_speech_027 = \
      "~kJonas says, \"Shroud is a powerful incantation that when cast upon "
      "a weapon, will protect that weapon from magical tampering.\""
   rebelliege_speech_028 = \
      "~kJonas says, \"I have evaluated enough soldiers for the rebel "
      "militia today.\""
   rebelliege_random_001 = \
      "~kJonas D'Accor watches the area carefully, as if expecting trouble."
   rebelliege_random_002 = "~kJonas is a formidable man by any reckoning."
   rebelliege_random_003 = \
      "~kJonas keeps his armor spotless, the very picture of a professional "
      "soldier."
   rebelliege_random_004 = "~kJonas seems quite pleased with himself."
   rebelliege_random_005 = "~kJonas says, \"I love this honorable land.\""
   rebelliege_random_006 = \
      "~kJonas says, \"There is only one thing worth fighting for, and "
      "that's honor. For a soldier that means the honor of their country.\""
   rebelliege_random_007 = \
      "~kJonas says, \"You better make sure that you understand what it is "
      "you're fighting over. Because nothing is worth fighting over, unless "
      "it's also worth dying for too.\""
   rebelliege_random_008 = \
      "~kJonas says, \"Will you give me a little room, please?\""
   rebelliege_random_009 = \
      "~kJonas says, \"This is the reward for the most promising military "
      "officer this country has ever produced. Retired by the politicians, "
      "and at an age when my career should be the strongest.\""
   rebelliege_random_010 = \
      "~kJonas says, \"You looking to join a real army?\""
   rebelliege_random_011 = \
      "~kJonas says, \"I think I'll pass on being a political toady. I "
      "desire to be more than that; I will be more than that.\""
   rebelliege_random_012 = "~kJonas says, \"What are you talking about?\""
   rebelliege_random_013 = "~kJonas says, \"Get away from me.\""
   rebelliege_random_014 = \
      "~kJonas says, \"Politics have been pushing me back my entire military "
      "career. Now is the time that I started pushing back.\""
   rebelliege_random_015 = \
      "~kJonas says, \"I smell the makings of an army. How long has it been "
      "since we had a decent army around here?\""
   rebelliege_random_016 = \
      "~kJonas says, \"Cylill is qualified to represent the military on the "
      "Meridian Council, I suppose, if you want a dried up old man in that "
      "spot. He seems lucid enough, though, despite his senility.\""
   rebelliege_random_017 = \
      "~kJonas says, \"The state of leadership in this land has become quite "
      "shocking when governing is split between the rightful Royal house and "
      "some beggard dog dressed in expensive merchant's clothing and calling "
      "himself a Duke. I have a mind to seek the crown myself.\""
   rebelliege_random_018 = \
      "~kJonas stares off into the distance with a faraway gaze."
   rebelliege_random_019 = "~kJonas looks tired."
   rebelliege_random_020 = \
      "~kJonas still retains the ramrod straight posture of a professional "
      "soldier."
   rebelliege_random_021 = "~kJonas is a very proud man."
   rebelliege_random_022 = "~kJonas stares about, menacing and stern."
   rebelliege_random_023 = \
      "~kJonas looks straight into your eyes, undaunted and with icy "
      "precision."
   rebelliege_random_024 = "~kJonas smiles to himself."
   rebelliege_random_025 = \
      "~kJonas absently rubs the long scar that runs the length of his face "
      "on the right hand side."
   rebelliege_random_026 = \
      "~kJonas has the reputation of being a brilliant tactician."
   rebelliege_random_027 = \
      "~kJonas says, \"If you venture to battle the Lupogg King, then follow "
      "this tactical advice for it is sound. Take a large band of warriors "
      "to the task, for indeed he has been known to shred five or more with "
      "ease. Also, one warrior should lead the attack at a time, retiring as "
      "they receive grievous wounds.\""
   rebelliege_random_028 = \
      "~kJonas says, \"When in the face of battle, your first order must be "
      "to defend your allies. For your opponents will certainly do so, "
      "whether man or beast.\""
   rebelliege_random_029 = \
      "~kJonas says, \"The most effective of ways for a warrior to reach the "
      "extremes of their karma is to slay another at the opposite extreme.\""
   rebelliege_random_030 = \
      "~kJonas makes a show of shifting his armor around, making some noise."
   rebelliege_random_031 = \
      "~kJonas says, \"I've been researching the old Konima legends.  You "
      "know the stories of the great Konima, don't you?\""
   rebelliege_random_032 = \
      "~kJonas is mostly just a tired old man. You can see that now."
   rebelliege_random_033 = "~kJonas grumbles to himself."
   rebelliege_random_034 = "~kJonas says, \"Bah.\""
   rebelliege_random_035 = \
      "~kJonas says, \"I think it is time I showed the people how important "
      "I can be.\""
   rebelliege_random_036 = \
      "~kJonas says, \"To the underworld with the lot of you.\""
   rebelliege_random_037 = "~kJonas says, \"Are you laughing at me?\""
   rebelliege_trigger_army = "army"
   rebelliege_trigger_sell = "sell"
   rebelliege_trigger_caves = "caves"
   rebelliege_trigger_dispel_illusion = "dispel illusion"
   rebelliege_trigger_duke = "duke"
   rebelliege_trigger_gilliz_pass = "gilliz pass"
   rebelliege_trigger_grumbles = "grumbles"
   rebelliege_trigger_uprising = "uprising"
   rebelliege_trigger_haste = "haste"
   rebelliege_trigger_hello = "hello"
   rebelliege_trigger_help = "help"
   rebelliege_trigger_identify = "identify"
   rebelliege_trigger_jasper = "jasper"
   rebelliege_trigger_konima = "konima"
   rebelliege_trigger_princess = "princess"
   rebelliege_trigger_resist_poison = "resist poison"
   rebelliege_trigger_reveal = "reveal"
   rebelliege_trigger_reveal_2 = "reveal"
   rebelliege_trigger_rook = "rook"
   rebelliege_trigger_roluk = "roluk"
   rebelliege_trigger_rugby = "rugby"
   rebelliege_trigger_buy = "buy"
   rebelliege_trigger_shroud = "shroud"
   rebelliege_trigger_soldier = "soldier"

