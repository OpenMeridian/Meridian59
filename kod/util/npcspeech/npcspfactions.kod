NpcSpeechFactions is NpcSpeech
// NPC talk of the faction leaders:
// answers to trigger words and random lines.
// Each line is a resource (EN here, DE in the .lkod); Library adds the
// lists in CreateSpeechLibrary and CreateRandomLibrary.

constants:

   include blakston.khd

resources:

   include npcspfactions.lkod

   // DukeLiege (Duke Akardius)
   dukeliege_speech_001 = \
      "~kDuke Akardius says, \"You'd best not consider such an option, your "
      "health depends upon it. I assure you.\""
   dukeliege_speech_002 = \
      "~kDuke Akardius says, \"You'd best not consider such an option, your "
      "health depends upon it. I assure you.\""
   dukeliege_speech_003 = \
      "~kDuke Akardius says, \"Barloque is an overly haughty capital.  "
      "Blackstone Keep is a far better choice as the Royal center.\""
   dukeliege_speech_004 = "~kThe Duke smiles, \"You may rise now.\""
   dukeliege_speech_005 = "~kThe Duke smiles, \"You may rise now.\""
   dukeliege_speech_006 = \
      "~kDuke Akardius says, \"You are dismissed. Now go...\""
   dukeliege_speech_007 = \
      "~kDuke Akardius says, \"The mettle of a true champion is tested not "
      "only in the Arena of combat, but also in the arena of the mind.\""
   dukeliege_speech_008 = \
      "~kDuke Akardius says, \"The people of Cor Noth have not a clue as to "
      "the gem they so casually sit upon.\""
   dukeliege_speech_009 = \
      "~kDuke Akardius says, \"King Zarcos appointed a council of elders to "
      "assist the Princess in her youth.  Although their advice is welcome I "
      "doubt either of us have such need for them anymore.\""
   dukeliege_speech_010 = \
      "~kDuke Akardius says, \"You would do well to address me as ~IMy "
      "Liege~I. I may forgive this transgression.\""
   dukeliege_speech_011 = \
      "~kDuke Akardius says, \"Hello to you %s. You may take your place "
      "among the other petitioners at this time.\""
   dukeliege_speech_012 = \
      "~kDuke Akardius says, \"I am lord here. Should you prove worthy to "
      "join my faction certain benefits would be at your disposal.\""
   dukeliege_speech_013 = \
      "~kDuke Akardius says, \"Any faction members caught fighting amongst "
      "themselves shall be flogged and exiled.  There are more than enough "
      "worthy foes outside our ranks.\""
   dukeliege_speech_014 = \
      "~kDuke Akardius says, \"I do not wish to hand out another insignia at "
      "this time.\""
   dukeliege_speech_015 = \
      "~kDuke Akardius says, \"I had a feeling all along that those people "
      "were plotting against us, it was just a matter of time until they "
      "suckered someone into leading their fictitious cause.\""
   dukeliege_speech_016 = \
      "~kDuke Akardius looks you over and smirks, \"Not a chance. Be gone!\""
   dukeliege_speech_017 = \
      "~kDuke Akardius says, \"Hail %s. So you seek the help of your Duke do "
      "you?\""
   dukeliege_speech_018 = \
      "~kDuke Akardius says, \"Good %s, as you can see, I don't have a task "
      "for you at this time.\""
   dukeliege_speech_019 = \
      "~kDuke Akardius says, \"Marion is a center of peace loving bores, not "
      "even the food is worth the trip.\""
   dukeliege_speech_020 = \
      "~kDuke Akardius says, \"The mettle of a true champion is tested not "
      "only in the arena of combat, but also in the arena of the mind.\""
   dukeliege_speech_021 = \
      "~kDuke Akardius says, \"Remember, there are many young warriors in "
      "the land who have yet to come of age to join us, watch out for them "
      "and have care.  We do not wish to alienate those who might become our "
      "allies.\""
   dukeliege_speech_022 = \
      "~kDuke Akardius says, \"My men tell me the Orc Pitboss is a match for "
      "any man or woman alive. They purport it to be inhumanly fast and "
      "ungodly strong. I shall need a very special Champion indeed.\""
   dukeliege_speech_023 = \
      "~kDuke Akardius says, \"My men tell me the Orc Pitboss is a match for "
      "any man or woman alive. They purport it to be inhumanly fast and "
      "ungodly strong. I shall need a very special Champion indeed.\""
   dukeliege_speech_024 = \
      "~kDuke Akardius says, \"A willful woman is the Princess. Fine royal "
      "blood courses through her delicate veins. She would make an excellent "
      "consort to a worthy King. Of course, if she were too unruly, I would "
      "toss her out on her ear. Let her find her way back to her threadbare "
      "temple.\""
   dukeliege_speech_025 = \
      "~kDuke Akardius says, \"I am not reviewing applicants right now.  "
      "Come back later.\""
   dukeliege_speech_026 = \
      "~kDuke Akardius says, \"I do so enjoy the cultured presence of Tos.\""
   dukeliege_speech_027 = \
      "~kDuke Akardius says, \"Remember, there are many young warriors in "
      "the land who have yet to come of age to join us, watch out for them "
      "and have care.  We do not wish to alienate those who might become our "
      "allies.\""
   dukeliege_random_001 = \
      "~kDuke Akardius says, \"My subjects have often need of couriers.  "
      "Should you prove your worth to them, I may be inclined to pay you "
      "attention.\""
   dukeliege_random_002 = \
      "~kDuke Akardius sighs, \"My dear uncle almost emptied the coffers to "
      "refurbish that stone creation of an Arena. And to think that there "
      "still aren't padded seats.\""
   dukeliege_random_003 = \
      "~kDuke Akardius says, \"I'd like to build another castle on the "
      "island of Ko'catan someday.  Blackstone Keep is the second oldest "
      "castle in the land, and quite drafty.\""
   dukeliege_random_004 = \
      "~kDuke Akardius says, \"Presently the council spends far too much "
      "time studying those tokens, but if that is what makes her...them "
      "happy then I shall lend whatever resources available to help them.\""
   dukeliege_random_005 = \
      "~kDuke Akardius says, \"The Princess spends far too much time with "
      "her nose in those books, the space from her library could be put to "
      "much better use.\""
   dukeliege_random_006 = \
      "~kDuke Akardius says, \"I trust you have indulged in the marvels of "
      "Tos. If not, then you must take in the sunset from the old graveyard; "
      "the view is...unforgettable.\""
   dukeliege_random_007 = \
      "~kDuke Akardius says, \"My poor, dear uncle. Is it not odd how he met "
      "his death under mysterious circumstances similar to King Zarcos IV?  "
      "Maybe the keep is cursed.\""
   dukeliege_random_008 = \
      "~kDuke Akardius says, \"To this day, I do wonder if the spirit of "
      "Queen Katria revels in her most marvellous sacrifice of life for her "
      "daughters.\""
   dukeliege_random_009 = \
      "~kDuke Akardius says, \"By my word the King is mad and must never "
      "again regain power!\""
   dukeliege_random_010 = \
      "~kDuke Akardius yawns, \"Why again is it that you seek an audience "
      "with me?\""
   dukeliege_random_011 = \
      "~kDuke Akardius says, \"The more inexperienced look to our faction "
      "and members for leadership and guidance throughout this land.\""
   dukeliege_random_012 = \
      "~kDuke Akardius says, \"Periodically, I ask that my followers display "
      "their ~Iloyalty~I.\""
   dukeliege_random_013 = \
      "~kDuke Akardius says, \"All is well in this kingdom. The council "
      "quite reasonably accords me the respect due my station through their "
      "support of me.\""
   dukeliege_random_014 = \
      "~kDuke Akardius says, \"I assume you are aware of proper etiquette "
      "when presented before one such as a Duke.\""
   dukeliege_random_015 = \
      "~kDuke Akardius says, \"If you train well, I might consider you to "
      "Champion me so that we might best the Chieftain of the Orcs.\""
   dukeliege_random_016 = \
      "~kDuke Akardius says, \"Although I can see how the council could be "
      "so taken with the Princess, surely they shall come to realize her "
      "innocence in matters of politics and power.\""
   dukeliege_random_017 = \
      "~kDuke Akardius says sourly, \"Kateriina appears to be busy beguiling "
      "the council at present. Quite interesting.\""
   dukeliege_trigger_back_stabbing = "back stabbing"
   dukeliege_trigger_backstabbing = "backstabbing"
   dukeliege_trigger_barloque = "barloque"
   dukeliege_trigger_bow = "bow"
   dukeliege_trigger_bows = "bows"
   dukeliege_trigger_bye = "bye"
   dukeliege_trigger_bye_2 = "bye"
   dukeliege_trigger_bye_3 = "bye"
