   // TosBanker (Skivlat)
   tosbanker_speech_001 = \
      "~kSkivlat says, \"They have lots of shillings up in Barloque. They "
      "are all rich up there. I don't like Herbut though. He's snooty. I "
      "sometimes ~Iguh~I-trade gems with him. Oh, but you shouldn't. I can "
      "give a better deal here for your gems.\""
   tosbanker_speech_002 = \
      "~kSkivlat says, \"I will buy shillings off of you for a gem or two.\""
   tosbanker_speech_003 = \
      "~kSkivlat says, \"Good bye %s! Come back again. Say hello to whoever "
      "you are going to see for me!\""
   tosbanker_speech_004 = \
      "~kSkivlat pulls out a coin, prepares to flip it, and says, \"Heads or "
      "Stones?\""
   tosbanker_speech_005 = \
      "~kSkivlat says, \"I don't know how many shillings are in Cor Noth. "
      "Probably more than Jasper.\""
   tosbanker_speech_006 = \
      "~kSkivlat says, \"There is one guy in the council I really admire. "
      "His name is Bei Naq. He has a lot of shillings. More than anyone else "
      "in the world.\""
   tosbanker_speech_007 = \
      "~kSkivlat says, \"The Duke lives in the Blackstone Keep on the north "
      "end of Tos. He has a lot of Shillings because he can collect taxes. I "
      "wish I could collect taxes. I also wish he wouldn't collect taxes "
      "from me. But over all, he helps lower the cost of items so I can save "
      "more of my money. He's nice.\""
   tosbanker_speech_008 = \
      "~kSkivlat pulls out a coin, prepares to flip it, and says, \"Heads or "
      "Stones?\""
   tosbanker_speech_009 = \
      "~kSkivlat says, \"What did you say 'guh' for? You talk funny.\""
   tosbanker_speech_010 = \
      "~kSkivlat flips a shilling in the air, looks at the coin and says, "
      "\"Heads it is! You're right!\""
   tosbanker_speech_011 = \
      "~kSkivlat flips a shilling in the air, looks at the coin and says, "
      "\"Sorry, it's Stones.\""
   tosbanker_speech_012 = \
      "~kSkivlat flips a shilling in the air, looks at the coin and says, "
      "\"The coin is Heads up! Good call!\""
   tosbanker_speech_013 = \
      "~kSkivlat flips a shilling in the air, looks at the coin and says, "
      "\"Uh-uh, sorry. It's Stones.\""
   tosbanker_speech_014 = \
      "~kSkivlat flips a shilling in the air, looks at the coin and says, "
      "\"It ~Iis~I Heads\""
   tosbanker_speech_015 = \
      "~kSkivlat flips a shilling in the air, looks at the coin and says, "
      "\"Nope, it came up Stones.\""
   tosbanker_speech_016 = \
      "~kSkivlat says, \"Good %s, %s! What can I ~Iguh~I-do for you?\""
   tosbanker_speech_017 = \
      "~kSkivlat says, \"~IGuh~I-hello, %s, how are you on this beautiful "
      "%s!\""
   tosbanker_speech_018 = \
      "~kSkivlat says, \"I can keep your money safe even if you die. I also "
      "know a lot about money. I love money, actually.\""
   tosbanker_speech_019 = \
      "~kSkivlat says, \"Interest? Your money will be safe in my bank, they "
      "won't have children though.\""
   tosbanker_speech_020 = \
      "~kSkivlat says, \"I like Jasper. I would live there because it is so "
      "close to the mines, but Yevitan already beat me there.\""
   tosbanker_speech_021 = \
      "~kSkivlat says, \"The people of Marion don't have many shillings. "
      "Those poor people.\""
   tosbanker_speech_022 = \
      "~kSkivlat says, \"The original official coins of Meridian had a "
      "castle on one side and Prince Far'Nohl on the other. They don't exist "
      "anymore these days.\""
   tosbanker_speech_023 = \
      "~kSkivlat says, \"The Princess has a lot of money. She's way up near "
      "Barloque.\""
   tosbanker_speech_024 = \
      "~kSkivlat spits, \"Them rebels, shaking up the balance and all, "
      "running amuck, and to think, Yevitan is wasting his own money on "
      "them.\""
   tosbanker_speech_025 = \
      "~kSkivlat says, \"I have some gems to sell. I won't sell shillings "
      "though, they are too valuable. Oh, and what would you buy them with? "
      "It's kind of like a pair a ducks. When you can only buy one duck with "
      "another. Huh huh he he.\""
   tosbanker_speech_026 = \
      "~kSkivlat says, \"I'll give ~Iguh~I-you a little known piece of "
      "information. The princess depicted on the back of the coin was "
      "Princess Demetia. If she were still alive, she would be 248 today, oh "
      "no, wait, let me think, 249 years old.\""
   tosbanker_speech_027 = \
      "~kSkivlat says, \"I reckon that was a fine picture. ~IUh-huh~I.\""
   tosbanker_speech_028 = \
      "~kSkivlat flips a shilling in the air, looks at the coin and says, "
      "\"Good ~IGuh~I guess, it is Stones.\""
   tosbanker_speech_029 = \
      "~kSkivlat flips a shilling in the air, looks at the coin and says, "
      "\"Aww, too bad. It came up Heads.\""
   tosbanker_speech_030 = \
      "~kSkivlat flips a shilling in the air, looks at the coin and says, "
      "\"You can't ~IGuh~I guess them all. It is Heads.\""
   tosbanker_speech_031 = \
      "~kSkivlat flips a shilling in the air, looks at the coin and says, "
      "\"Yes. The coin came up Stones.\""
   tosbanker_speech_032 = \
      "~kSkivlat flips a shilling in the air, looks at the coin and says, "
      "\"Stones!\""
   tosbanker_speech_033 = \
      "~kSkivlat flips a shilling in the air, looks at the coin and says, "
      "\"Nope, the coin came Heads up.\""
   tosbanker_speech_034 = \
      "~kSkivlat says, \"Tos is a ~Iguh~I-great town to live in.\""
   tosbanker_speech_035 = \
      "~kSkivlat says, \"Yevitan runs the Bank in Jasper. My bank has more "
      "money in it so he's jealous. I think he cheats his clients too. He "
      "doesn't like me. He's like a, uh, like a creature that wouldn't like "
      "me very much. Maybe a troll, they probably don't like me.  Not to "
      "mention that he is wasting all his money on those rebels, the fool.\""
   tosbanker_random_001 = \
      "~kSkivlat says, \"Did you know this coin was made back during the "
      "reign of King Zarcos II?\""
   tosbanker_random_002 = \
      "~kSkivlat says, \"Shillings, my wonderful friends, your golden "
      "sparkle never ends. Huh huh he he.\""
   tosbanker_random_003 = \
      "~kSkivlat says, \"Most people say money is dirty. Not me, I "
      "~Iguh~I-wash those shillings every day.\""
   tosbanker_random_004 = "~kSkivlat polishes the same coin over and over."
   tosbanker_random_005 = \
      "~kSkivlat says, \"I bet you didn't know that shillings aren't pure "
      "gold. They have copper and iron in them. Only a small part of the "
      "coin is true gold.\""
   tosbanker_random_006 = \
      "~kSkivlat says, \"I love gems. Not as much as I love shillings. But "
      "they are pretty. But not as pretty as shillings.\""
   tosbanker_random_007 = \
      "~kSkivlat counts a stack of shillings. After a few moments, he counts "
      "the same stack again."
   tosbanker_random_008 = \
      "~kA weird grin crosses Skivlat's face as he shines a few shillings."
   tosbanker_random_009 = \
      "~kSkivlat incessantly shakes his pouch of coins. With each metallic "
      "clink, his smile broadens. \"I love that sound,\" he says."
   tosbanker_random_010 = \
      "~kSkivlat says, \"I love flipping coins. Make a guess, Heads or "
      "Stones?\""
   tosbanker_random_011 = \
      "~kSkivlat says, \"The original official coin of Meridian had a castle "
      "on one side and Prince Far'Nohl on the other. You can't find those "
      "around anymore.\""
   tosbanker_random_012 = \
      "~kSkivlat says, \"Here's a little known fact for ~Iguh~I-you. The "
      "Princess depicted on the back of the shilling was Princess Demetia. "
      "If she were still alive, she would be 248, uh no, wait, let me think, "
      "249 years old.\""
   tosbanker_random_013 = \
      "~kSkivlat says, \"I don't think my ~Iguh~I-vault can hold much more. "
      "I might have to rent the room next door for extra storage space.\""
   tosbanker_random_014 = \
      "~kSkivlat says, \"I'm so happy. If my bank were, um, a creature that "
      "likes to eat a lot, it would be full. I mean because my vault has a "
      "lot of ~Iguh~I-money in it right now. Like a troll. They like to eat "
      "a lot.\""
   tosbanker_random_015 = \
      "~kSkivlat says, \"I'm not sure why those stupid rats scurry off with "
      "shillings. I mean I know why I would ~Iguh~I-scurry off with "
      "shillings. But they are so little, what do rats need with money.\""
   tosbanker_random_016 = \
      "~kSkivlat says, \"The Vault's getting a little lonely for my friends. "
      "Do you want to deposit some shillings, please?\""
   tosbanker_random_017 = \
      "~kSkivlat says, \"What's going on out in the world? Too many people "
      "are withdrawing their shillings. That's not fair, they were so "
      "comfortable here with their friends.\""
   tosbanker_trigger_barloque = "barloque"
   tosbanker_trigger_sell = "sell"
   tosbanker_trigger_bye = "bye"
   tosbanker_trigger_coin = "coin"
   tosbanker_trigger_cor_noth = "cor noth"
   tosbanker_trigger_council = "council"
   tosbanker_trigger_duke = "duke"
   tosbanker_trigger_flip = "flip"
   tosbanker_trigger_guh = "guh"
   tosbanker_trigger_gumpf = "gumpf"
   tosbanker_trigger_heads = "heads"
   tosbanker_trigger_hello = "hello"
   tosbanker_trigger_help = "help"
   tosbanker_trigger_interest = "interest"
   tosbanker_trigger_interest_2 = "interest"
   tosbanker_trigger_jasper = "jasper"
   tosbanker_trigger_marion = "marion"
   tosbanker_trigger_money = "money"
   tosbanker_trigger_princess = "princess"
   tosbanker_trigger_rebels = "rebels"
   tosbanker_trigger_buy = "buy"
   tosbanker_trigger_shilling = "shilling"
   tosbanker_trigger_sling_blade = "sling blade"
   tosbanker_trigger_stones = "stones"
   tosbanker_trigger_stones_2 = "stones"
   tosbanker_trigger_tos = "tos"
   tosbanker_trigger_yevitan = "yevitan"

   // TosInnKeeper (Paddock)
   tosinnkeeper_speech_001 = \
      "~kPaddock says, \"Zhieu B'hob's a good friend of mine down in Jasper. "
      "His general store has all the essentials.\""
   tosinnkeeper_speech_002 = \
      "~kPaddock says, \"Barloque. It's the most stuck up qordamned city "
      "you'll ever see. They think they are the center of power. Ha. They do "
      "have the office of the Justicar though.\""
   tosinnkeeper_speech_003 = \
      "~kPaddock says, \"Fehr'loi Qan was our local blacksmith. I think "
      "being so close to the graveyard spooked him out of town.\""
   tosinnkeeper_speech_004 = "~kPaddock says, \"See you tomorrow, %s.\""
   tosinnkeeper_speech_005 = \
      "~kPaddock says, \"Aw, get out of here already. Same time tomorrow?\""
   tosinnkeeper_speech_006 = \
      "~kPaddock says, \"See you later. Go kill an Orc.\""
   tosinnkeeper_speech_007 = \
      "~kPaddock says, \"Cheaters? Nasty rabble, that lot. Not good for "
      "business at all.\""
   tosinnkeeper_speech_008 = \
      "~kPaddock says, \"Cor Noth is a nice town. We ought to get a clock "
      "tower here.\""
   tosinnkeeper_speech_009 = \
      "~kPaddock says, \"King Zarcos left a council of five men in charge of "
      "the land. Well actually they just advise the Duke and Princess. Most "
      "of the time they try to figure out those weird tokens. That's "
      "government for you.\""
   tosinnkeeper_speech_010 = "~kPaddock says, \"Hail Duke Akardius!\""
   tosinnkeeper_speech_011 = \
      "~kPaddock says, \"I think I've heard of that before? Isn't that like "
      "the Spinner, the Weaver and the Tailor? Well, it's just an old wives' "
      "tale, just forget it again.\""
   tosinnkeeper_speech_012 = \
      "~kPaddock says, \"Fehr'loi Qan was our local blacksmith. I think "
      "being so close to the graveyard spooked him out of town.\""
   tosinnkeeper_speech_013 = \
      "~kPaddock says, \"Oh, for the love of Shal'ille, go somewhere else, "
      "%s! Your effusiveness makes me quite sick.\""
   tosinnkeeper_speech_014 = \
      "~kPaddock says, \"Frisconar owns the Magic Shop around the corner. "
      "Don't get him started on the ills of the world though. You will "
      "regret it if you do.\""
   tosinnkeeper_speech_015 = \
      "~kPaddock says, \"I'm a little uneasy about setting up shop so close "
      "to the old graveyard. When night falls, the dead pull themselves out "
      "of their graves. So far, the people of Tos have been pretty good "
      "about keeping them contained, but I'm still uncomfortable.\""
   tosinnkeeper_speech_016 = \
      "~kPaddock says, \"The Guides? Oh, nice lads they are. Well, a bit "
      "loud sometimes.\""
   tosinnkeeper_speech_017 = \
      "~kPaddock says, \"They always drink free brew here. Bad customers.\""
   tosinnkeeper_speech_018 = "~kPaddock says, \"Hail, %s!\""
   tosinnkeeper_speech_019 = \
      "~kPaddock says, \"Welcome to Familiars, the best bar in all of "
      "Meridian.\""
   tosinnkeeper_speech_020 = \
      "~kPaddock says, \"Well met traveler, can I get you a brew?\""
   tosinnkeeper_speech_021 = \
      "~kPaddock says, \"Maybe you should ask an administrator.\""
   tosinnkeeper_speech_022 = \
      "~kPaddock says, \"Go look up by Barloque. He knows better than to "
      "show his face in or around Tos.\""
   tosinnkeeper_speech_023 = \
      "~kPaddock says, \"I was just in Jasper the other day to pick up some "
      "general supplies from Zhieu B'hob. I must say that I am quite "
      "impressed with the town's turnaround. Jonas and his rebels might just "
      "be doing Jasper some good.\""
   tosinnkeeper_speech_024 = \
      "~kPaddock says, \"Up in Barloque, the common folk can elect their own "
      "Justicar to hold trial. The Justicar can pass sentence or pardon law "
      "breakers.\""
   tosinnkeeper_speech_025 = \
      "~kPaddock says, \"Poor, poor Kalior. May he rest in peace.\""
   tosinnkeeper_speech_026 = \
      "~kPaddock says, \"Look. There is enough trouble with Trolls, Orcs, "
      "and the such. Why stir up more trouble?\""
   tosinnkeeper_speech_027 = \
      "~kPaddock says, \"Marion's a town full of peaceful yokels. A nice "
      "place to live, but I wouldn't want to visit there.\""
   tosinnkeeper_speech_028 = \
      "~kPaddock says, \"You want a mend, go across the street. I'm sick of "
      "those qordamn menders making a profit here and not paying me a "
      "percentage. The least they could do is buy a drink now and again.\""
   tosinnkeeper_speech_029 = \
      "~kPaddock says, \"For the love of Shal'ille, will you guys go do your "
      "mending business across the street.\""
   tosinnkeeper_speech_030 = \
      "~kPaddock says, \"I'm going to have to change the name of this place "
      "to Familiars Mending Shop. For crying out loud, go do your business "
      "across the street.\""
   tosinnkeeper_speech_031 = \
      "~kPaddock says, \"How about this, every time someone gets something "
      "mended, they also buy a brew. Otherwise, take your mending across the "
      "qordamn street.\""
   tosinnkeeper_speech_032 = \
      "~kPaddock says, \"You know, there is a perfectly good freelanced "
      "mending shop across the street.\""
   tosinnkeeper_speech_033 = \
      "~kPaddock says, \"Psychochild and Q brought the world back to life. "
      "And Arantis brought it here.\""
   tosinnkeeper_speech_034 = \
      "~kPaddock says, \"A strange little girl, that Miriana. Always "
      "stirring up trouble. One wonders what she does all the time, alone "
      "out there in the forest.\""
   tosinnkeeper_speech_035 = \
      "~kPaddock says, \"Maybe she just wants to be noticed, and this is the "
      "way she can draw attention to herself.\""
   tosinnkeeper_speech_036 = \
      "~kPaddock shrugs, \"I really can't understand why the magic nodes "
      "would call on someone like her of all people to protect them.\""
   tosinnkeeper_speech_037 = \
      "~kPaddock says, \"What else can you expect from someone who was cast "
      "out of society and has lived in the wilderness for so long? She has "
      "no idea of civilization, and so she tries to destroy it.\""
   tosinnkeeper_speech_038 = \
      "~kPaddock says, \"What, you have something to do with that little "
      "nature freak? Out of my tavern.\""
   tosinnkeeper_speech_039 = \
      "~kPaddock says, \"Hold on, let me check... nope, no outgoing "
      "letters.\""
   tosinnkeeper_speech_040 = \
      "~kPaddock says, \"Sorry, %s, I don't have any letters to be "
      "delivered.\""
   tosinnkeeper_speech_041 = \
      "~kPaddock says, \"I'm working on writing a letter to the council. "
      "Come back later after I've finished it.\""
   tosinnkeeper_speech_042 = "~kPaddock says, \"No, %s.\""
   tosinnkeeper_speech_043 = "~kPaddock says, \"I don't need any couriers.\""
   tosinnkeeper_speech_044 = \
      "~kPaddock says, \"I heard that the power of the nodes restores itself "
      "after a while, as if it were refilled from a great reservoir.\""
   tosinnkeeper_speech_045 = \
      "~kPaddock shrugs, \"The councilors tell us that she is dangerous and "
      "must be destroyed. I suppose we should believe them, shouldn't we?\""
   tosinnkeeper_speech_046 = \
      "~kPaddock says, \"I've heard enough of your comments now. This gloom "
      "is bad for business. Drink up and get out of here!\""
   tosinnkeeper_speech_047 = \
      "~kPaddock says, \"I feel Akardius is more fit to rule Meridian than "
      "the Princess.\""
   tosinnkeeper_speech_048 = \
      "~kPaddock says, \"Fehr'loi Qan was our local blacksmith. I think "
      "being so close to the graveyard spooked him out of town.\""
   tosinnkeeper_speech_049 = \
      "~kPaddock says, \"You know this is exactly how the Duke's family came "
      "into power, although they will never admit it.\""
   tosinnkeeper_speech_050 = \
      "~kPaddock says, \"Is my little brother in trouble again? Ever since I "
      "got him the job working in the Duke's Banquet Room, he's been nothing "
      "but trouble.\""
   tosinnkeeper_speech_051 = \
      "~kThe room goes silent as %s mentions stunted dwarf."
   tosinnkeeper_speech_052 = \
      "~kPaddock says, \"Tos is the place to be. It has it all, the Arena of "
      "Kraanan, the old city crypt, Blackstone Keep, the best bank in the "
      "land, and a great blacksmith. Actually, scratch that, we lost the "
      "blacksmith to Barloque.\""
   tosinnkeeper_speech_053 = \
      "~kPaddock says, \"Zhieu B'hob's a good friend of mine down in Jasper. "
      "His general store has all the essentials.\""
   tosinnkeeper_random_001 = \
      "~kPaddock says, \"Tos really isn't the oldest place. There's an "
      "ancient castle beyond the land of trolls. The old kingdom used to be "
      "centered there. Now it's abandoned and some say ~Ihaunted.~I\""
   tosinnkeeper_random_002 = \
      "~kPaddock says, \"If you want to know about those qordamned creatures "
      "out there, go to Cor Noth. There's this guy named Rook. He knows it "
      "all.\""
   tosinnkeeper_random_003 = \
      "~kPaddock says, \"Money, they say you can't take it with you when you "
      "die. That's what banks are for.\""
   tosinnkeeper_random_004 = \
      "~kPaddock says, \"It's dangerous outside those city walls. If I were "
      "you, I'd get myself some traveling companions. There's safety in "
      "numbers.\""
   tosinnkeeper_random_005 = \
      "~kPaddock says, \"Frisconar says there is an underground lake "
      "somewhere around these parts.\""
   tosinnkeeper_random_006 = \
      "~kPaddock says, \"Qordamn sewer rats are everywhere nowadays. Good "
      "thing they're like baby spiders, easy to squash.\""
   tosinnkeeper_random_007 = \
      "~kPaddock says, \"Oh yeah, if you're interested Frisconar teaches a "
      "spell or two. Shal'ille, I think. He pays me a commission if I refer "
      "business to him.\""
   tosinnkeeper_random_008 = \
      "~kPaddock says, \"It's interesting to see all the different types "
      "that frequent my place. Soldiers, masons, bards, and acolytes of the "
      "Priestesses bring news. The acolytes usually have interesting stories "
      "to tell about their pilgrimages to the temples.\""
   tosinnkeeper_random_009 = \
      "~kPaddock says, \"Before I forget, if you need reagents like "
      "mushrooms and herbs for your spells, see Frisconar. Let him know I "
      "referred you to him.\""
   tosinnkeeper_random_010 = \
      "~kPaddock says, \"I'm surprised that the Councilors haven't had much "
      "to say about Jonas and his new faction.\""
   tosinnkeeper_random_011 = \
      "~kPaddock says, \"Our Arena in East Tos is a great place to take a "
      "brew and watch a fight. I'm amazed at how good those guys get just "
      "practicing in there.\""
   tosinnkeeper_random_012 = \
      "~kPaddock says, \"You look tired. Why don't you pull up a chair, buy "
      "a drink, and get some rest. Familiars is one of the best places to "
      "recuperate.\""
   tosinnkeeper_random_013 = \
      "~kPaddock says, \"My philosophy is ~Ithe better the customers, the "
      "less I need to chew their ear off~I.\""
   tosinnkeeper_random_014 = \
      "~kPaddock leans behind the bar, cleaning out empty mugs."
   tosinnkeeper_random_015 = "~kPaddock taps another keg of brew open."
   tosinnkeeper_random_016 = \
      "~kPaddock says, \"I'm a little uneasy about setting up shop so close "
      "to the old graveyard. When night falls, the dead pull themselves out "
      "of their graves. So far, the people of Tos have been pretty good "
      "about keeping them contained, but I'm still uncomfortable.\""
   tosinnkeeper_random_017 = \
      "~kPaddock says, \"Ever since I renovated Familiars, more and more "
      "guests seem to come here from all over the land.\""
   tosinnkeeper_random_018 = \
      "~kPaddock says, \"Rumor has it that at night the Seafarers' Lookout "
      "is one of the most romantic places of all. Sadly, I've never been "
      "there myself. But who needs romance when he has a cool stout to call "
      "his own?\""
   tosinnkeeper_random_019 = \
      "~kPaddock says, \"Don't drink that stuff they sell on Ko'Catan. From "
      "the taste of it, it contains ingredients that were still whimpering "
      "for their lives when it was mixed.\""
   tosinnkeeper_random_020 = \
      "~kPaddock says, \"By Kraanan. Always all this riffraff loitering "
      "about in here. Is this a tavern or a standing party?\""
   tosinnkeeper_random_021 = \
      "~kPaddock says, \"At this time of year it always gets a little "
      "windier outside. Pity no snow falls in these parts.\""
   tosinnkeeper_random_022 = \
      "~kPaddock says, \"I'm all for you buying your comrades a proper "
      "round.\""
   tosinnkeeper_random_023 = \
      "~kPaddock says, \"Have you heard? Over in Marion, the old crypt is "
      "said to have reopened. So much for the city of rest and peace and all "
      "that.\""
   tosinnkeeper_random_024 = \
      "~kPaddock says, \"If you see Frisconar, ask him for that wonderful "
      "recipe for mushroom ragout. If I remember correctly, you chop up a "
      "fungus beast together with fine herbs and stew it in a special white "
      "wine sauce. But better ask him yourself, I'm a barkeep, not a cook.\""
   tosinnkeeper_random_025 = \
      "~kPaddock says, \"Want to earn a little money? Then do me a favor and "
      "sweep up a bit around here.\""
   tosinnkeeper_random_026 = \
      "~kPaddock says, \"Do you know about the new back door yet? It leads "
      "to a hidden alcove where undigested stout can be... well... disposed "
      "of again unseen.\""
   tosinnkeeper_random_027 = \
      "~kPaddock says, \"I'm mighty glad and grateful that we're rid of that "
      "rat plague once and for all. Now we just have to drive that rabble "
      "out of Jasper.\""
   tosinnkeeper_random_028 = \
      "~kPaddock says, \"Around here they tell stories about fallen heroes "
      "who creep across the graveyard at night. Be careful - perhaps you'll "
      "soon be one of them too.\""
   tosinnkeeper_random_029 = \
      "~kPaddock says, \"Back in my younger days, I too tried my hand at the "
      "teachings of Qor... until that terrible accident when.. oh, I'd "
      "better not talk about it.\""
   tosinnkeeper_random_030 = \
      "~kPaddock says, \"Come in, sit down, make yourself comfortable, have "
      "some cheese and drink a little glass. Nowhere else will you get drunk "
      "for so little reason.\""
   tosinnkeeper_random_031 = \
      "~kPaddock says, \"If you knew what old Qesino puts in her soups, "
      "you'd also know why she's a widow today.\""
   tosinnkeeper_random_032 = \
      "~kPaddock says, \"Just a few days ago I bought myself new trousers "
      "from Hester Gilk in Cor Noth. You can say a lot about that woman, but "
      "her clothes are simply of formidable quality.\""
   tosinnkeeper_random_033 = \
      "~kPaddock says, \"You should have seen that boozy roughneck earlier. "
      "Comes in here, drinks the whole place dry and sidles up to every "
      "female guest. If only I could remember his name...\""
   tosinnkeeper_random_034 = \
      "~kPaddock says, \"Is it actually true that somewhere, in a place "
      "called Brakks or some such, there's a queen who feeds on souls? I'm "
      "wondering whether it could be my long-lost mother.\""
   tosinnkeeper_random_035 = \
      "~kPaddock says, \"If you want some excitement, walk into an Avar "
      "village provocatively holding up a bag of birdseed. I'm sure they'll "
      "thank you for it.\""
   tosinnkeeper_random_036 = \
      "~kPaddock says, \"Hey, you! Next time, wipe your shoes before you "
      "drag all the dirt back in.\""
   tosinnkeeper_random_037 = \
      "~kPaddock says, \"I wish I could offer you more to drink, but that "
      "boozy troll, Grunk or something, regularly empties my stock and "
      "vanishes without paying.\""
   tosinnkeeper_random_038 = \
      "~kPaddock says, \"Can you even imagine what it's like to stand around "
      "your whole life in the same grubby apron? Sometimes I'd like to just "
      "toss it in the corner and turn up all casual.\""
   tosinnkeeper_random_039 = \
      "~kPaddock says, \"Greetings, traveler. Try something new - stout at 3 "
      "degrees. Ice-cold from the frosty Yeti caves for that fresh taste.\""
   tosinnkeeper_random_040 = \
      "~kPaddock tells you, \"Come on! Surely you can handle one more little "
      "stout. Just one. Then that's it.\""
   tosinnkeeper_random_041 = \
      "~kPaddock wipes his hands on his apron, and faint scraping noises can "
      "be heard."
   tosinnkeeper_random_042 = \
      "~kSometimes you remember what a lovely feeling it is to stand in "
      "Familiars."
   tosinnkeeper_random_043 = "~kA floorboard creaks under your foot."
   tosinnkeeper_random_044 = \
      "~kPaddock watches you secretly, but attentively."
   tosinnkeeper_random_045 = \
      "~kPaddock tells you, \"Come on, don't be stingy, order another "
      "tankard!\""
   tosinnkeeper_random_046 = \
      "~kPaddock says, \"Sometimes you see shady figures disappearing into "
      "the old smithy. I wonder what they're doing in there...\""
   tosinnkeeper_random_047 = \
      "~kPaddock says, \"Beware of the vampires. I've heard some have been "
      "sighted again now and then.\""
   tosinnkeeper_random_048 = \
      "~kPaddock says, \"Well, look at that. You come here often too, huh?\""
   tosinnkeeper_random_049 = \
      "~kPaddock says, \"With some people I wonder whether they have no "
      "home. They stand around here for hours, mumbling incantations and "
      "enchanting every guest who comes in. I'm slowly starting to think "
      "about gently beating some house rules into them.\""
   tosinnkeeper_random_050 = \
      "~kPaddock says, \"I am a very hard-working man. But sometimes it "
      "seems to me that people only respect me because of the stout. And no "
      "woman looks twice at a tavern keeper either.\""
   tosinnkeeper_random_051 = \
      "~kPaddock says, \"Sometimes I'd rather open a flower shop.\""
   tosinnkeeper_random_052 = \
      "~kPaddock says, \"Irony is when many oh-so-tough adventurers commit "
      "suicide because they were a tiny bit too weak, instead of fighting "
      "their way up.\""
   tosinnkeeper_random_053 = \
      "~kPaddock says, \"Hmmmm.. I seem to have lost my beautiful signet "
      "ring somehow. If you find it, I'll gladly slip you a little "
      "something, if you know what I mean..\""
   tosinnkeeper_random_054 = \
      "~kNow would be the best time for a little stout among friends."
   tosinnkeeper_random_055 = \
      "~kA soft murmur drifts through Familiars. It seems to you as if the "
      "air itself were whispering with voices silent for years."
   tosinnkeeper_random_056 = \
      "~kPaddock says, \"I don't even know how long I've been running this "
      "tavern and how many faces I've seen. But one thing I know for sure - "
      "each of them held its own story, its own past, its own personality. "
      "And I will never forget any of them.\""
   tosinnkeeper_random_057 = \
      "~kPaddock says, \"If those fey didn't fight each other all the time, "
      "the Valley of Sorrow would be a nice spot for a little picnic.\""
   tosinnkeeper_random_058 = \
      "~kPaddock says, \"Sadly the crackers are out right now, but I can "
      "gladly offer you a few pieces of cheese. It's fresh and tastes simply "
      "splendid.\""
   tosinnkeeper_random_059 = \
      "~kPaddock says, \"Would you perhaps like a stout with your stout? "
      "Together they're simply unbeatable.\""
   tosinnkeeper_random_060 = \
      "~kPaddock says, \"Sometimes I get the feeling that people take me for "
      "a foolish chatterbox who forever babbles the same thing.\""
   tosinnkeeper_random_061 = \
      "~kPaddock says, \"Just between us: I don't know what to make of the "
      "new Duke. He's not even old enough to order a stout, but he commands "
      "the whole army.\""
   tosinnkeeper_random_062 = \
      "~kPaddock pauses for a brief moment, scratches himself in various "
      "places, and goes on cleaning the beer mugs."
   tosinnkeeper_random_063 = \
      "~kPaddock gazes absent-mindedly at the Arena painting and sighs "
      "inaudibly."
   tosinnkeeper_random_064 = \
      "~kPaddock mutters something to himself that you can't possibly "
      "understand from this distance."
   tosinnkeeper_random_065 = \
      "~kPaddock says, \"They say you can bathe wonderfully in the lake "
      "Jala's Song. Unfortunately those cursed little spiders know it too.\""
   tosinnkeeper_random_066 = \
      "~kPaddock says, \"I still remember exactly how I slew my first slime "
      "in my youth. Then I sugared it and sold it as jelly.\""
   tosinnkeeper_random_067 = \
      "~kPaddock says, \"I don't know what smells worse - the unwashed feet "
      "of some of the locals or my delicate hand cheese. They say many a "
      "shining hero doesn't change his socks even once in 50 years.\""
   tosinnkeeper_random_068 = \
      "~kSomehow you always feel cozy and at home here."
   tosinnkeeper_random_069 = \
      "~kPaddock says, \"I'm not sure if I should take tomorrow off. Maybe "
      "I'll go have Skivlat flip a coin for me. That's what I always do when "
      "I've got a simple decision to make.\""
   tosinnkeeper_random_070 = \
      "~kPaddock says, \"If you find yourself in Marion, the best place, "
      "well, the only place to take a load off your feet is the Limping Toad "
      "Inn. The guy who owns it, Tova, is a pretty funny guy. I think he "
      "holds a grudge against me for running a better tavern, though.\""
   tosinnkeeper_random_071 = \
      "~kPaddock says, \"Can I get anyone another round of brew?\""
   tosinnkeeper_random_072 = \
      "~kPaddock says, \"This is a bar. If you're not going to drink, "
      "there's the door.\""
   tosinnkeeper_random_073 = \
      "~kPaddock says, \"I hear there's a new gambling house in North "
      "Barloque. The owners would be making a big mistake if they don't "
      "manage it right.\""
   tosinnkeeper_random_074 = \
      "~kPaddock says, \"Kraanan's Arena is a good place to get better at "
      "fighting, but it's no replacement for the real thing. True warriors "
      "only get stronger by taking on stronger beasts in the wilds.\""
   tosinnkeeper_random_075 = \
      "~kPaddock says, \"I was just thinking to myself, maybe I should give "
      "brew away for free. You know, just open the keg to the house. It's "
      "not like you cheap loafers are going to actually spend money to buy "
      "it.\""
   tosinnkeeper_random_076 = \
      "~kPaddock says, \"It's a wonder I stay in business. So many people "
      "come in here. But at the end of the night, my profits don't show it. "
      "If people don't start drinking, I should charge a qordamn entrance "
      "fee.\""
   tosinnkeeper_random_077 = \
      "~kPaddock says, \"What's the matter? Is everybody so qordamned cheap, "
      "you can't buy a lousy brew?\""
   tosinnkeeper_trigger_b_hob = "b'hob"
   tosinnkeeper_trigger_bob = "bob"
   tosinnkeeper_trigger_barloque = "barloque"
   tosinnkeeper_trigger_blacksmith = "blacksmith"
   tosinnkeeper_trigger_bye = "bye"
   tosinnkeeper_trigger_bye_2 = "bye"
   tosinnkeeper_trigger_bye_3 = "bye"
   tosinnkeeper_trigger_cheater = "cheater"
   tosinnkeeper_trigger_cor_noth = "cor noth"
   tosinnkeeper_trigger_council = "council"
   tosinnkeeper_trigger_duke = "duke"
   tosinnkeeper_trigger_fate = "fate"
   tosinnkeeper_trigger_fehr_loi = "fehr'loi"
   tosinnkeeper_trigger_ferloi = "ferloi"
   tosinnkeeper_trigger_forgiveness = "forgiveness"
   tosinnkeeper_trigger_frisconar = "frisconar"
   tosinnkeeper_trigger_graveyard = "graveyard"
   tosinnkeeper_trigger_guides = "guides"
   tosinnkeeper_trigger_hello = "hello"
   tosinnkeeper_trigger_help = "help"
   tosinnkeeper_trigger_izzio = "izzio"
   tosinnkeeper_trigger_jasper = "jasper"
   tosinnkeeper_trigger_justicar = "justicar"
   tosinnkeeper_trigger_justicar_2 = "justicar"
   tosinnkeeper_trigger_kalior = "kalior"
   tosinnkeeper_trigger_kateriina = "kateriina"
   tosinnkeeper_trigger_marion = "marion"
   tosinnkeeper_trigger_mend = "mend"
   tosinnkeeper_trigger_mend_2 = "mend"
   tosinnkeeper_trigger_mending = "mending"
   tosinnkeeper_trigger_mending_2 = "mending"
   tosinnkeeper_trigger_meridian = "meridian"
   tosinnkeeper_trigger_miriana = "miriana"
   tosinnkeeper_trigger_need_a_courier = "need a courier?"
   tosinnkeeper_trigger_nodes = "nodes"
   tosinnkeeper_trigger_nodes_2 = "nodes"
   tosinnkeeper_trigger_princess = "princess"
   tosinnkeeper_trigger_qan = "qan"
   tosinnkeeper_trigger_rebels = "rebels"
   tosinnkeeper_trigger_rycksher = "rycksher"
   tosinnkeeper_trigger_rulker = "rulker"
   tosinnkeeper_trigger_stunted_dwarf = "stunted dwarf"
   tosinnkeeper_trigger_tos = "tos"
   tosinnkeeper_trigger_zhieu = "zhieu"
   tosinnkeeper_trigger_zhieu_2 = "zhieu"

   // TosWatcher (Watcher)
   toswatcher_speech_001 = \
      "~kThe Watcher says, \"General Cylill is a member of the Council and "
      "he is my father. He resides on the River Ille.\""
   toswatcher_speech_002 = \
      "~kThe Watcher says, \"Hail the Memory of Kalior! Hail Duke Akardius!\""
   toswatcher_speech_003 = "~kThe Watcher says, \"Hail %s!\""
   toswatcher_speech_004 = \
      "~kThe Watcher says, \"I judge all arena matches. Read my banners to "
      "learn how to enter.\""
   toswatcher_speech_005 = \
      "~kThe Watcher says, \"Hail our lord and god, Kraanan of the Fist! "
      "Fight in his name, and you will know true strength.\""
   toswatcher_speech_006 = "~kThe Watcher says, \"Hail Princess Kateriina!\""
   toswatcher_speech_007 = \
      "~kThe Watcher says, \"You speak of the Priestess Qerti'nya, my "
      "mother. She has taught me discipline and courage. You would be wise "
      "to visit her out at the Temple of Kraanan beyond the Cragged "
      "Mountains.\""
   toswatcher_speech_008 = \
      "~kThe Watcher says, \"Hail Tos, the oldest city in all of Meridian!\""
   toswatcher_trigger_cylill = "cylill"
   toswatcher_trigger_zylill = "zylill"
   toswatcher_trigger_duke = "duke"
   toswatcher_trigger_hello = "hello"
   toswatcher_trigger_help = "help"
   toswatcher_trigger_kraanan = "kraanan"
   toswatcher_trigger_princess = "princess"
   toswatcher_trigger_qerti_nya = "qerti'nya"
   toswatcher_trigger_qertina = "qertina"
   toswatcher_trigger_tos = "tos"

messages:

   GetSpeechLibrary()
   "Speech library nodes: [class, [[triggers, mood, action, key], ...]]"
   {
      local lLib;

      lLib = $;

      lLib = Cons([&BasicInnKeeper,[
         [[basicinnkeeper_trigger_weissman],0,
            [LIBACT_QUOTE_RSC,basicinnkeeper_speech_081],81],
         [[basicinnkeeper_trigger_wells],0,
            [LIBACT_QUOTE_RSC,basicinnkeeper_speech_082],82],
         [[basicinnkeeper_trigger_wrapped,
            basicinnkeeper_trigger_wrapped_2,
            basicinnkeeper_trigger_wrapped_3],0,
            [LIBACT_QUOTE_RSC,basicinnkeeper_speech_083],83],
         [[basicinnkeeper_trigger_zach],0,
            [LIBACT_QUOTE_RSC,basicinnkeeper_speech_084],84]
      ]],lLib);

      lLib = Cons([&BasicInnKeeper,[
         [[basicinnkeeper_trigger_hello],0,
            [LIBACT_QUOTE_RSC,basicinnkeeper_speech_041],41],
         [[basicinnkeeper_trigger_help],0,
            [LIBACT_QUOTE_RSC,basicinnkeeper_speech_042],42],
         [[basicinnkeeper_trigger_island],0,
            [LIBACT_QUOTE_RSC,basicinnkeeper_speech_043],43],
         [[basicinnkeeper_trigger_kennedy],0,
            [LIBACT_QUOTE_RSC,basicinnkeeper_speech_044],44],
         [[basicinnkeeper_trigger_kirmse],0,
