   // DukeGuard (Keep Guard)
   dukeguard_speech_001 = \
      "~kThe Duke's guard says, \"Haughty Barloque is on the north shore of "
      "the great ocean.\""
   dukeguard_speech_002 = \
      "~kThe Duke's guard says, \"I'd never serve at Bourgeois Castle.\""
   dukeguard_speech_003 = \
      "~kThe Duke's guard says, \"Cor Noth lies between all other towns.\""
   dukeguard_speech_004 = \
      "~kThe Duke's guard says, \"Hail the Council of Five!\""
   dukeguard_speech_005 = "~kThe Duke's guard says, \"Hail Duke Akardius!\""
   dukeguard_speech_006 = \
      "~kThe Duke's guard says, \"Jasper is west of the lake.\""
   dukeguard_speech_007 = \
      "~kThe Duke's guard says, \"Head west to find Marion.\""
   dukeguard_speech_008 = "~kThe Duke's guard says, \"Hail Tos!\""
   dukeguard_trigger_barloque = "barloque"
   dukeguard_trigger_bourgeois = "bourgeois"
   dukeguard_trigger_cor_noth = "cor noth"
   dukeguard_trigger_council = "council"
   dukeguard_trigger_council_2 = "council"
   dukeguard_trigger_duke = "duke"
   dukeguard_trigger_jasper = "jasper"
   dukeguard_trigger_marion = "marion"
   dukeguard_trigger_tos = "tos"

   // TosApothecary (Frisconar)
   tosapothecary_speech_001 = \
      "~kFrisconar says, \"I don't want to talk about Barloque. That city "
      "has been nothing but trouble for my love and me.\""
   tosapothecary_speech_002 = \
      "~kFrisconar says, \"Let me see your reagents. I may buy them if they "
      "aren't spoiled.\""
   tosapothecary_speech_003 = \
      "~kFrisconar says, \"See you again, unless one of us dies first, which "
      "is entirely likely to happen in this world.\""
   tosapothecary_speech_004 = \
      "~kFrisconar says, \"Cor Noth is a disgusting city. The last time I "
      "was there I caught this terrible cold, lasted for months. It's "
      "because they aren't sanitary at all there. Why, once I saw a slime "
      "floating in their river. Yech!\""
   tosapothecary_speech_005 = \
      "~kFrisconar says, \"Oh the grand and mighty council. Those has-beens "
      "don't know the first thing about government. Seems they're switching "
      "their opinion on who should rule every day. They should get jobs.\""
   tosapothecary_speech_006 = \
      "~kFrisconar says, \"The cults have been plotting against me for "
      "years. They think I'm not aware of them, but I know they are out "
      "there.\""
   tosapothecary_speech_007 = \
      "~kFrisconar says, \"I think I can get along with Duke Akardius... At "
      "least I hope I can.\""
   tosapothecary_speech_008 = "~kFrisconar says, \"Do I know you, %s?\""
   tosapothecary_speech_009 = \
      "~kFrisconar says, \"I thought I wasn't going to see your face in here "
      "again, %s.\""
   tosapothecary_speech_010 = \
      "~kFrisconar says, \"What do you want? You're not here to rob me, are "
      "you?\""
   tosapothecary_speech_011 = \
      "~kFrisconar says, \"You need help? Always about what you need, is it. "
      "I buy and sell ingredients for spell casting.\""
   tosapothecary_speech_012 = \
      "~kFrisconar says, \"Jasper.  That's a thriving town all right.  Going "
      "up against the known ways, just asking for trouble.  It's suicide "
      "they're asking for, if you ask me.\""
   tosapothecary_speech_013 = \
      "~kFrisconar says, \"Doomed, we're all doomed, doomed I tell you!!\""
   tosapothecary_speech_014 = \
      "~kFrisconar says, \"There's a temple or something down on an "
      "underground lake in the dark caves. I wouldn't bother going if I were "
      "you. First off, you need a key. And if you do get in, the chill is "
      "just miserable.\""
   tosapothecary_speech_015 = \
      "~kFrisconar says, \"The fair Madelia is my true love. She used to "
      "live here in Tos when we were together. Then that miserable Frular "
      "told her that her cloth shop would do better near Barloque. And the "
      "Princess commissioned her to make her royal gowns. The next thing I "
      "know my dear Madelia has moved to the Bourgeois Castle. I'm sure she "
      "is bewitched by some cruel Riija cult.\""
   tosapothecary_speech_016 = \
      "~kFrisconar says, \"The fair Madelia is my true love. She used to "
      "live here in Tos when we were together. Then that miserable Frular "
      "told her that her cloth shop would do better near Barloque. And the "
      "Princess commissioned her to make her royal gowns. The next thing I "
      "know my dear Madelia has moved to the Bourgeois Castle. I'm sure she "
      "is bewitched by some cruel Riija cult.\""
   tosapothecary_speech_017 = \
      "~kFrisconar says, \"I don't see why anyone would want to spend time "
      "in Marion. I wouldn't even call it a town. I don't understand why "
      "blessed Shal'ille would drape her protection over such a backwater "
      "village. And their wise man, ha, I've got more common sense in this "
      "thumb.\""
   tosapothecary_speech_018 = \
      "~kFrisconar says, \"What, did Paddock tell you to see me? Seems I "
      "have to give that thief a commission every time someone mentions his "
      "name in here. And he's brought me nothing but trouble.\""
   tosapothecary_speech_019 = \
      "~kFrisconar says, \"Despite her faults, I'm probably the only one in "
      "all of Tos who supports the Princess.\""
   tosapothecary_speech_020 = \
      "~kFrisconar cries, \"What are you waiting for?  It's rude to keep "
      "death waiting.  Do I have a fever, I think I do, this is it, the end, "
      "goodbye cruel world.  Aren't you going to buy anything?\""
   tosapothecary_speech_021 = \
      "~kFrisconar says, \"What do you think I would sell? This is a magic "
      "reagent shop.\""
   tosapothecary_speech_022 = \
      "~kFrisconar says, \"I really should move from Tos. They say it's the "
      "oldest town. That just means it's the drabbest place you'll find. I "
      "think the fountain is beginning to smell.\""
   tosapothecary_random_001 = \
      "~kFrisconar says, \"We used to have a blacksmith in town, until he "
      "moved away. I don't blame him wanting to leave this Shal'ille "
      "forsaken town. Of course, the town's probably better off without his "
      "sort in it. He was an odd one. For some unknown reason, he was "
      "interested in buying wands. He was probably part of some cult.\""
   tosapothecary_random_002 = \
      "~kFrisconar says, \"If you don't want to be part of a school of magic "
      "anymore, ask the Priestess for a ~Ipotion of forgetfulness~I. It will "
      "clear your mind of their spells. Of course, drinking it may have bad "
      "side effects. I've drunk several of them now. Each one left more than "
      "a bad taste in my mouth.\""
   tosapothecary_random_003 = \
      "~kFrisconar says, \"I hear that some people are coming back from "
      "another land with knowledge of the forgotten Riija spells. That's "
      "just what we need, more spells of deception.\""
   tosapothecary_random_004 = \
      "~kFrisconar says, \"People don't realize that many of the things they "
      "come across can be used by mages to help them cast spells. Maybe "
      "that's why my shop is doing so poorly.\""
   tosapothecary_random_005 = \
      "~kFrisconar says, \"If you have nothing better to do, shop keepers "
      "are often looking for someone to run errands for them.\""
   tosapothecary_random_006 = \
      "~kFrisconar says, \"You haven't been to Barloque recently by any "
      "chance, have you? Did you see Madelia? How is she looking? Did she "
      "mention me at all?\""
   tosapothecary_random_007 = \
      "~kFrisconar says, \"You know, the watcher only got his position "
      "because of some behind the doors deal between the Priestess Qerti'nya "
      "and the Duke.\""
   tosapothecary_random_008 = \
      "~kFrisconar says, \"Rycksher's an idiot. For some reason the Duke "
      "gave him a job running the bar in the Royal Ballroom. Something's "
      "wrong with that. I haven't figured out what the real deal is yet.\""
   tosapothecary_random_009 = \
      "~kFrisconar says, \"I wouldn't trust Skivlat with my money. He loves "
      "money just a little too much. He may be part of a cult.\""
   tosapothecary_random_010 = \
      "~kFrisconar says, \"I know some spells. You know I could have been a "
      "priest, but all the positions were filled. And the ~Igods~I always "
      "pick their favorites to represent them.\""
   tosapothecary_random_011 = \
      "~kFrisconar says, \"Barloque and Jasper really need to do something "
      "about their sewers. They are out of control. The rats have run out of "
      "breeding room, that's why they are all over. They will probably start "
      "spreading the black plague.\""
   tosapothecary_random_012 = \
      "~kFrisconar says, \"The world is such a crummy place. Monsters run "
      "rampant everywhere. I know a spell to protect myself from them, but "
      "sooner or later, they'll kill us all. It's only a matter of time.\""
   tosapothecary_random_013 = \
      "~kFrisconar says, \"Ah.. ~Bah.. AH-CHOOOO!!! ~B This cold will be the "
      "death of me yet. A few months back, everybody got it. For some "
      "reason, I'm the only one who can't shake it off. Always me.\""
   tosapothecary_random_014 = \
      "~kFrisconar says, \"I think I'm coming down with cholera.\""
   tosapothecary_random_015 = \
      "~kFrisconar says, \"I think I'm coming down with rubella.\""
   tosapothecary_random_016 = \
      "~kFrisconar says, \"I think I'm coming down with the consumption. My "
      "mother was taken by the consumption.\""
   tosapothecary_random_017 = \
      "~kFrisconar says, \"I think I'm developing a goiter. I think that "
      "could be fatal.\""
   tosapothecary_random_018 = \
      "~kFrisconar says, \"There's that itch again. Knowing my luck, it's "
      "probably hives.\""
   tosapothecary_random_019 = \
      "~kFrisconar says, \"Do you smell smoke? Ever since I ate that spicy "
      "food at Familiars, my nose has been off. If there is ever a fire, "
      "I'll probably die because I won't be able to smell the smoke.\""
   tosapothecary_random_020 = \
      "~kFrisconar says, \"You don't have any grapes on you, do you? I'm "
      "allergic to grapes.\""
   tosapothecary_random_021 = "~kFrisconar says, \"My throat hurts.\""
   tosapothecary_random_022 = \
      "~kFrisconar says, \"What are the symptoms of an ulcer? I think I'm "
      "coming down with one.\""
   tosapothecary_random_023 = \
      "~kFrisconar says, \"My feet ache. Oh, how I would like to sit down "
      "right now, but my hemorrhoids, you know.\""
   tosapothecary_random_024 = \
      "~kFrisconar says, \"I think I feel nauseous. Is it too warm in here?\""
   tosapothecary_random_025 = \
      "~kFrisconar says, \"Ever since I tried that lightning spell, I "
      "haven't been able to move my hand as much as I used to.\""
   tosapothecary_random_026 = \
      "~kFrisconar says, \"I have a feeling the weather is going to be just "
      "abysmal tomorrow.\""
   tosapothecary_random_027 = \
      "~kFrisconar says, \"I feel awful. I should close up early today.\""
   tosapothecary_random_028 = \
      "~kFrisconar says, \"Are warts contagious? I heard that they were.\""
   tosapothecary_random_029 = \
      "~kFrisconar says, \"I had a dog once. He died of the black rot.\""
   tosapothecary_random_030 = \
      "~kFrisconar says, \"You aren't sick, are you? I hate being around "
      "sick people. They always make it sound worse than it really is.\""
   tosapothecary_random_031 = \
      "~kFrisconar says, \"What's the difference between scarlet fever and "
      "spotted fever? I know I have a fever of some sort.\""
   tosapothecary_random_032 = \
      "~kFrisconar says, \"Don't stand too close to me. You might get "
      "infected.\""
   tosapothecary_random_033 = \
      "~kFrisconar says, \"I don't think Madelia is ever coming back to me. "
      "Life is so disappointing. You never get what you want. And I have a "
      "hard time meeting new women for some reason.\""
   tosapothecary_random_034 = \
      "~kFrisconar says, \"My hair is falling out. I've only seen thirty "
      "winters. I may have leprosy.\""
   tosapothecary_random_035 = \
      "~kFrisconar says, \"Ow. There's that back pain again.\""
   tosapothecary_random_036 = \
      "~kFrisconar says, \"Did you eat at Familiars today? I think I have "
      "food poisoning.\""
   tosapothecary_random_037 = \
      "~kFrisconar says, \"Actually, I'm not feeling too bad today.\""
   tosapothecary_random_038 = \
      "~kFrisconar coughs and clears his throat. Unsatisfied, he coughs some "
      "more."
   tosapothecary_random_039 = \
      "~kMassaging his neck, Frisconar lets out a sigh of discomfort."
   tosapothecary_random_040 = \
      "~kFrisconar wipes his nose with a well worn rag."
   tosapothecary_random_041 = \
      "~kFrisconar lets out a long sigh, then starts scrunching his nose and "
      "making a low honking noise."
   tosapothecary_random_042 = \
      "~kFrisconar snorts loudly. He says, \"Excuse me.\""
   tosapothecary_random_043 = \
      "~kFrisconar says, \"I think I'm coming down with foot-and-mouth "
      "disease.\""
   tosapothecary_random_044 = \
      "~kFrisconar says, \"I think I'm coming down with mad cow disease.\""
   tosapothecary_random_045 = \
      "~kFrisconar says, \"Hard day, %s? Aren't they all.\""
   tosapothecary_random_046 = \
      "~kFrisconar says, \"What are you so happy about? There's nothing that "
      "good going on in the world.\""
   tosapothecary_trigger_barloque = "barloque"
   tosapothecary_trigger_sell = "sell"
   tosapothecary_trigger_bye = "bye"
   tosapothecary_trigger_cor_noth = "cor noth"
   tosapothecary_trigger_council = "council"
   tosapothecary_trigger_cult = "cult"
   tosapothecary_trigger_duke = "duke"
   tosapothecary_trigger_hello = "hello"
   tosapothecary_trigger_help = "help"
   tosapothecary_trigger_jasper = "jasper"
   tosapothecary_trigger_jonas = "jonas"
   tosapothecary_trigger_lake = "lake"
   tosapothecary_trigger_love = "love"
   tosapothecary_trigger_madelia = "madelia"
   tosapothecary_trigger_marion = "marion"
   tosapothecary_trigger_paddock = "paddock"
   tosapothecary_trigger_princess = "princess"
