NpcSpeechTos is NpcSpeech
// NPC talk of Tos:
// answers to trigger words and random lines.
// Each line is a resource (EN here, DE in the .lkod); Library adds the
// lists in CreateSpeechLibrary and CreateRandomLibrary.

constants:

   include blakston.khd

resources:

   include npcsptos.lkod

   // BasicInnKeeper (Rycksher)
   basicinnkeeper_speech_001 = \
      "~kRycksher says, \"All hail the original design team, they put a "
      "great many hours into this land.\""
   basicinnkeeper_speech_002 = \
      "~kRycksher says, \"You have a memory as long as mine, I see.\""
   basicinnkeeper_speech_003 = \
      "~kRycksher says, \"She makes things, lots of things. The world would "
      "seem pretty empty without her stuff.\""
   basicinnkeeper_speech_004 = \
      "~kRycksher says, \"This isn't the only music they play, you know.\""
   basicinnkeeper_speech_005 = \
      "~kRycksher says, \"Oh, without them it surely wouldn't be half as "
      "much fun around here.\""
   basicinnkeeper_speech_006 = \
      "~kRycksher says, \"Oh, don't get me started on Barloque. We hate "
      "those guys. They, uh, they did something or other to us. So we hate "
      "them.\""
   basicinnkeeper_speech_007 = \
      "~kRycksher says, \"We here in Tos hate Barloque. I'm not sure why, "
      "but we probably have a pretty good reason. Those pompous people up "
      "there, all snooty with all their money and riches and gold. They "
      "aren't in need of a bartender, are they?\""
   basicinnkeeper_speech_008 = \
      "~kRycksher says, \"He's the Man. I mean it, he is the hook up man. "
      "Anything I need, Tom can get.\""
   basicinnkeeper_speech_009 = \
      "~kRycksher says, \"Huh, you're leaving? But you hardly even danced. "
      "Or tipped the bartender.\""
   basicinnkeeper_speech_010 = \
      "~kRycksher says, \"He's a big bully. He makes us say things we don't "
      "want to say. Ran er'Hoth isn't really crazy, you know. Peter said he "
      "would beat the old man up if he didn't act crazy. Well, I'm not going "
      "to let him push me around. Freedom, I say, ~BFREEDOM!~B\""
   basicinnkeeper_speech_011 = \
      "~kRycksher says, \"Charles is an ass prodder. Oh, my bad. I mean "
      "Associate Producer.\""
   basicinnkeeper_speech_012 = \
      "~kRycksher says, \"Nasty fellows, those. They belong in the debtors' "
      "prison.\""
   basicinnkeeper_speech_013 = \
      "~kRycksher says, \"He always has a smile on his face. What does he "
      "know that we don't?\""
   basicinnkeeper_speech_014 = \
      "~kRycksher says, \"That Ellis brother is a brave soul for signing up "
      "for duty in this world!\""
   basicinnkeeper_speech_015 = \
      "~kRycksher says, \"He offered me a choice once. Join him or die. I "
      "said I'd join and he didn't know what to do. Then I said I'll choose "
      "to die, and he's even more confused. Wish he would make up his mind "
      "on what he wants, damn Gemini.\""
   basicinnkeeper_speech_016 = \
      "~kRycksher says, \"Well... no comment on that... Thankfully that was "
      "a long time ago.\""
   basicinnkeeper_speech_017 = \
      "~kRycksher says, \"Watch your back with this guy.\""
   basicinnkeeper_speech_018 = \
      "~kRycksher says, \"Cort is the Watcher of the Arena. He was appointed "
      "by the Duke around the same time I got this job. We're old school "
      "chums. So I'm a little older than he is... he was just a fast "
      "learner.\""
   basicinnkeeper_speech_019 = \
      "~kRycksher says, \"I'll drink to the Council!\""
   basicinnkeeper_speech_020 = "~kRycksher says, \"A pox on the Council!\""
   basicinnkeeper_speech_021 = \
      "~kRycksher says, \"She is on a mission. Beware!\""
   basicinnkeeper_speech_022 = \
      "~kRycksher says, \"Uprising, huh. Kind of ironic that they chose that "
      "name, if you ask me.\""
   basicinnkeeper_speech_023 = \
      "~kRycksher says, \"I serve imported brew here. If you want the cheap "
      "stuff, it's in pitchers in the feast hall next door.\""
   basicinnkeeper_speech_024 = \
      "~kRycksher says, \"Poor Kalior. He was the common man's ruler. His "
      "death is a warning of the dark times to come.\""
   basicinnkeeper_speech_025 = \
      "~kRycksher says, \"There's TWO of them now?  Shal'ille help us.\""
   basicinnkeeper_speech_026 = \
      "~kRycksher says, \"Fehr'loi Qan is an imbecile. We used to make fun "
      "of him. But he showed us. Up and moved his shop to Barloque. Making a "
      "lot more money now, I hear. I think he was bribed to leave Tos.\""
   basicinnkeeper_speech_027 = \
      "~kRycksher says, \"This place needs a good artist like her.  I think "
      "she'll do just fine.\""
   basicinnkeeper_speech_028 = \
      "~kRycksher says, \"Frisconar, he's a strange guy, always whining "
      "about something. 'oh, I think I'm getting the Orc plague.', 'oh, why "
      "did Madelia have to leave me, I'm so lonely and pitiful. Pity me.' or "
      "'oh, Rycksher, why do you get all the ladies, I'm a little loser, I "
      "don't get any of the ladies. The ladies don't like me. Wah-wah.'\""
   basicinnkeeper_speech_029 = "~kRycksher says, \"Grumpf...\""
   basicinnkeeper_speech_030 = \
      "~kRycksher says, \"Sure, if you offer me something, I'll wrap it up "
      "for you. It's part of my job, though I'll need something to cover my "
      "expenses.\""
   basicinnkeeper_speech_031 = \
      "~kRycksher says, \"Is he here?! Damn, he's going to take my job as "
      "bartender.\""
   basicinnkeeper_speech_032 = \
      "~kRycksher says, \"He's got two qualities I love, drunken AND surly.  "
      "Runs a nice gathering place, too, I hear.\""
   basicinnkeeper_speech_033 = \
      "~kRycksher says, \"Tony is ~Iso money~I. He doesn't even know how "
      "money he is.\""
   basicinnkeeper_speech_034 = \
      "~kRycksher says, \"Goes by Psychochild, right?  An apt name if I ever "
      "saw one.\""
   basicinnkeeper_speech_035 = \
      "~kRycksher says, \"If you have a problem, talk to them. They will "
      "help you.\""
   basicinnkeeper_speech_036 = \
      "~kRycksher says, \"Yeah, hackey sack, that's all they do. You didn't "
      "really think they spent their time working, did you?\""
   basicinnkeeper_speech_037 = \
      "~kRycksher says, \"Don't mess with him. He's a big meany!\""
   basicinnkeeper_speech_038 = \
      "~kRycksher says, \"Just don't call him ~IJhankee~I.\""
   basicinnkeeper_speech_039 = \
      "~kRycksher says, \"Throw a problem at Asif and he will put his head "
      "to it, just like a hackey sack.\""
   basicinnkeeper_speech_040 = \
      "~kRycksher says, \"What can I say, he once paid my salary.\""
   basicinnkeeper_speech_041 = \
      "~kRycksher says, \"What?... oh. Welcome to the Grand Ballroom of his "
      "lordship, Akardius, Duke of Tos, Protectorate of the People, and, "
      "er... um, oh yeah, future Sovereign of all Meridian.\""
   basicinnkeeper_speech_042 = \
      "~kRycksher says, \"I'm Rycksher, the bartender. The Duke appointed me "
      "to make sure the Ballroom guests are having a good time. Are you "
      "having a good time? Like the Music? Have a gift to be wrapped? Need a "
      "drink?\""
   basicinnkeeper_speech_043 = \
      "~kRycksher says, \"What island? My brother Paddock mentioned there "
      "was some newly discovered island.\""
   basicinnkeeper_speech_044 = \
      "~kRycksher says, \"He's just doing this in his spare time. He's "
      "really a screen writer.\""
   basicinnkeeper_speech_045 = \
      "~kRycksher says, \"I wouldn't be here if not for those guys.\""
   basicinnkeeper_speech_046 = \
      "~kRycksher says, \"A spirited lass, she is, she is.\""
   basicinnkeeper_speech_047 = \
      "~kRycksher says, \"Call him Prego, everybody does.\""
   basicinnkeeper_speech_048 = \
      "~kRycksher says, \"Madelia makes clothes. She moved to the Bourgeois "
      "Castle to make the big money. I think she had a thing for me.\""
   basicinnkeeper_speech_049 = \
      "~kRycksher says, \"Huzzah! A toast to the couple!\""
   basicinnkeeper_speech_050 = \
      "~kRycksher says, \"A work of Psychochild and Q. And our Arantis "
      "brought this land here.\""
   basicinnkeeper_speech_051 = \
      "~kRycksher says, \"A great place to have fun. You should check it "
      "out.\""
   basicinnkeeper_speech_052 = \
      "~kRycksher says, \"Haven't seen him around here in a while, but I owe "
      "a lot to him.\""
   basicinnkeeper_speech_053 = \
      "~kRycksher says, \"The whole world would not be so moody if not for "
      "that Andy character.\""
   basicinnkeeper_speech_054 = \
      "~kRycksher says, \"At the Bard's request, the orchestra may play a "
      "different song. They know all the tunes in Meridian.\""
   basicinnkeeper_speech_055 = \
      "~kRycksher says, \"Truth be told, I like Near Death Studios a bit "
      "more than my previous owners.  Hail NDS!\""
   basicinnkeeper_speech_056 = \
      "~kRycksher says, \"Never been to Xeen. I hear it's nice.\""
   basicinnkeeper_speech_057 = \
      "~kRycksher says, \"I don't like him. He makes me say things. In fact, "
      "he makes everybody say things. You think we like being told what to "
      "say? No! We want the freedom to say what's on our mind, not just what "
      "Kevin tells us to say. That son of a... \""
   basicinnkeeper_speech_058 = \
      "~kRycksher says, \"My brother Paddock owns Familiars. He's the best "
      "bartender in the world. In case you haven't guessed, I'm the second "
      "best.\""
   basicinnkeeper_speech_059 = \
      "~kRycksher says, \"She's amazing. I ought to know, look at me.\""
   basicinnkeeper_speech_060 = \
      "~kRycksher says, \"What, you think I made it up?\""
   basicinnkeeper_speech_061 = "~kRycksher says, \"A pox on the Princess!\""
   basicinnkeeper_speech_062 = \
      "~kRycksher says, \"She must be sitting smugly in her little castle. A "
      "pox on her! A pox on her!\""
   basicinnkeeper_speech_063 = \
      "~kRycksher says, \"Have you seen the hours he keeps?  If that's not "
      "crazy, what is?\""
   basicinnkeeper_speech_064 = \
      "~kRycksher says, \"Fehr'loi Qan is an imbecile. We used to make fun "
      "of him. But he showed us. Up and moved his shop to Barloque. Making a "
      "lot more money now, I hear. I think he was bribed to leave Tos.\""
   basicinnkeeper_speech_065 = \
      "~kRycksher says, \"Look around you, %s, this place wouldn't be here "
      "if not for Rob. In fact, most of the world would not exist. You'd be "
      "still stuck in the forests of Meridian.\""
   basicinnkeeper_speech_066 = \
      "~kRycksher says, \"That guy is nuts! He wants to rule the world by "
      "changing the laws of physics.\""
   basicinnkeeper_speech_067 = \
      "~kRycksher says, \"Be nice to him, he's just here to help.\""
   basicinnkeeper_speech_068 = \
      "~kRycksher says, \"Steve, Mike, Chris or Charles?\""
   basicinnkeeper_speech_069 = \
      "~kRycksher says, \"Skivlat has the perfect job. He just sits around "
      "counting money all day. I wish I were him.\""
   basicinnkeeper_speech_070 = \
      "~kRycksher says, \"That is an interesting game!\""
   basicinnkeeper_speech_071 = \
      "~kRycksher says, \"Don't you like the music?\""
   basicinnkeeper_speech_072 = \
      "~kRycksher says, \"I think he's part of the mafia.\""
   basicinnkeeper_speech_073 = \
      "~kRycksher says, \"He worked on Generations. At least that's what "
      "they say.\""
   basicinnkeeper_speech_074 = \
      "~kThe room goes silent as %s mentions stunted dwarf."
   basicinnkeeper_speech_075 = \
      "~kRycksher says, \"It's good to be the King.\""
   basicinnkeeper_speech_076 = \
      "~kRycksher says, \"One day she'll take a relaxing vacation and get "
      "away from it all. Yeah, right.\""
   basicinnkeeper_speech_077 = \
      "~kRycksher says, \"Tos is my home town. I know everybody here. Go "
      "ahead, ask me about anyone in town.\""
   basicinnkeeper_speech_078 = "~kRycksher says, \"Terrible!\""
   basicinnkeeper_speech_079 = "~kRycksher says, \"Traitor!\""
   basicinnkeeper_speech_080 = \
      "~kRycksher says, \"Cort is the Watcher of the Arena. He was appointed "
      "by the Duke around the same time I got this job. We're old school "
      "chums. So I'm a little older than he is... so I helped him with his "
      "studies. Really.\""
   basicinnkeeper_speech_081 = \
      "~kRycksher says, \"That guy just can't play a normal game of hackey "
      "sack. Always has to make up new rules.\""
   basicinnkeeper_speech_082 = \
      "~kRycksher says, \"Watch out for this guy. There is a lot more to him "
      "than you think. That quiet exterior is just an act, I tell you.\""
   basicinnkeeper_speech_083 = \
      "~kRycksher says, \"Sure, if you offer me something, I'll wrap it up "
      "for you. It's part of my job. However the wrapping paper isn't free.\""
   basicinnkeeper_speech_084 = \
      "~kRycksher says, \"That guy keeps this place available for you to "
      "visit.  Make sure to thank him if you get a chance.\""
