// CornothGrocer
cornothgrocer_speech_001 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_002 = de \
   "~kSolomon sagt, \"Das ist ein Satz in whagzii, den wir nur gegenüber den "
   "dümmsten Leuten benutzen. Und er bedeutet 'Geh und steck Deinen Kopf in "
   "den Haferschleimtopf'. Ja, nur bei den dümmsten Leuten!! Ha, ha ha ha "
   "ha!!\""
cornothgrocer_speech_003 = de \
   "~kSolomon sagt, \"Bagab? Ha, ha ha ha ha, nun, ein bagab ist jemand, der "
   "nicht so viel Verstand hat, Schuhe zu tragen! Ha, ha ha ha ha!!\""
cornothgrocer_speech_004 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_005 = de \
   "~kSolomon sagt, \"Wenn Du in Barloque bist, kannst Du von allem nur das "
   "Beste bekommen! Und ich muss es wissen, da alle zu Solomon kommen, um "
   "ihre erlesensten Wünsche zu befriedigen! Ha, ha ha ha ha!! Wenn Du in "
   "Barloque bist, Tabu, dann suche den Laden meines lieben Freundes Herbut "
   "auf! Ein sehr kultivierter Gentleman! Denk daran, ihm meine herzlichsten "
   "Grüße auszurichten.\""
cornothgrocer_speech_006 = de \
   "~kSolomon sagt, \"Es ist die Stadt der alten Könige von Meridian und sie "
   "ist sehr, sehr wohlhabend! Ja, ich reise oft geschäftlich dorthin und "
   "kenne die Leute gut. Und lass Dir sagen, edle Seele, dass es in Barloque "
   "unvorstellbare Reichtümer gibt. Und welch kultivierter Geschmack! Das "
   "beste Geschäft.\""
cornothgrocer_speech_007 = de \
   "~kSolomon sagt, \"Nun, sie halten Bettler und Vieh am Haupttor von "
   "Barloque auf, so dass Du weder auf die eine noch auf die andere Weise "
   "Glück haben wirst, 'Oh Du Manierenloser'. Ha, ha ha ha ha!!\""
cornothgrocer_speech_008 = de \
   "~kSolomon sagt, \"Baszoo bedeutet einfach, dass es nichts mehr zu dem "
   "Thema zu sagen gibt und dass es nun eine Frage der Götter und der Zeit "
   "ist.\""
cornothgrocer_speech_009 = de \
   "~kSolomon sagt, \"Binghi ghaloob? Binghi ghaloob lässt sich nicht genau "
   "übersetzen. Die Bedeutung von binghi ghaloob ist ziemlich kompliziert.\""
cornothgrocer_speech_010 = de \
   "~kSolomon sagt, \"Binghi ghaloob bedeutet 'Du hast schreckliche "
   "Manieren, wie ein Esel mit Blähungen, und ich hoffe, dass Du in Deiner "
   "eigenen Galle verrottest'. Ha, ha ha ha ha!!!\""
cornothgrocer_speech_011 = de \
   "~kSolomon sagt, \"Was soll es denn Deiner Meinung nach bedeuten, mein "
   "Freund?\""
cornothgrocer_speech_012 = de \
   "~kSolomon sagt, \"Mögen Dich die guten Winde begleiten, mein Freund. Ich "
   "vermisse Dich bereits.\""
cornothgrocer_speech_013 = de \
   "~kSolomon sagt, \"Segen sei mit Dir. Ich zähle die Tage, bis Du uns "
   "wieder besuchst.\""
cornothgrocer_speech_014 = de \
   "~kSolomon sagt, \"Meide den Zorn Deiner eigenen Unwissenheit, mein "
   "Freund. Ha, ha ha ha ha! Aebu sikal gah tamaal! Auf Wiedersehen, "
   "siidhika! Baszoo!!\""
cornothgrocer_speech_015 = de \
   "~kSolomon sagt, \"Du solltest dies hier als Dein zweites Zuhause "
   "betrachten, Tabu. Komm wieder und besuch uns oft.\""
cornothgrocer_speech_016 = de \
   "~kSolomon sagt, \"Ich nenne dies hier mein Heim fern der Heimat, denn "
   "obwohl meine Heimat so weit weg ist und nichts sie in meinem Herzen "
   "ersetzen wird, so ist Cor Noth doch der kostbarste und freieste "
   "Edelstein in ganz Meridian.\""
cornothgrocer_speech_017 = de \
   "~kSolomon sagt, \"Wie bist Du durchs Haupttor gelangt? Bei den ganzen "
   "Steuern, die ich bezahle, muss ich wirklich mal ein Wörtchen mit dem "
   "Wachtmeister reden. Ha, ha ha ha ha!! Nein, wirklich, das glaube ich "
   "nicht. Dies ist eine freie Stadt, die jedem freien Zutritt und "
   "Redefreiheit gewährt. Sogar Dummköpfen und Hamstern wie Dir selbst!! Ha, "
   "ha ha ha ha!\""
cornothgrocer_speech_018 = de \
   "~kSolomon sagt, \"Das sind ein paar sehr weise Männer, wirklich sehr "
   "weise. Und damit betraut, für das ganze Land Entscheidungen zu fällen! "
   "Manchmal denke ich jedoch, dass sie den Rat einer Frau gebrauchen "
   "könnten...\""
cornothgrocer_speech_019 = de \
   "~kSolomon sagt, \"Eine Gruppe sehr feiner und edler Herren, Tabu, sehr "
   "fein! Vom König höchstselbst beauftragt, von keinem Geringeren! Und "
   "immer bereit, zu lehren und ihr Wissen zu teilen, wie ich höre.\""
cornothgrocer_speech_020 = de \
   "~kSolomon sagt, \"Bah!! Was weißt Du schon vom Rat, siidhika?\""
cornothgrocer_speech_021 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_022 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_023 = de \
   "~kSolomon sagt, \"Ha, ha ha ha ha!! Dinki padarapoomy ist ein Wort aus "
   "der Maldive-Sprache und bedeutet 'Zimmermann, der sich die eigenen Füße "
   "an den Türpfosten genagelt hat'. Ha, ha ha ha ha!!\""
cornothgrocer_speech_024 = de \
   "~kSolomon sagt, \"Ja, Tabu, diwesafi bedeutet ... wie sagt man doch "
   "gleich? Verständnis. Wie göttliches Verständnis. So ungefähr, aber doch "
   "wieder ein bisschen anders.\""
cornothgrocer_speech_025 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_026 = de \
   "~kSolomon sagt, \"Ein trauriger Stand der Dinge. Ich bin immer noch "
   "geschockt über die Nachricht von dem Tod des Herzogs. Ich hoffe, dass "
   "die Steuern nicht noch weiter erhöht werden.\""
cornothgrocer_speech_027 = de "~kSolomon sagt, \"Aebu sikal gah tamaal!\""
cornothgrocer_speech_028 = de \
   "~kSolomon sagt, \"Immer krank dieser Mann, genau wie sein Geschäft! "
   "Ungesund! Er leidet wegen Madelia an gebrochenem Herzen, er hat keine "
   "andere Unpässlichkeit! Haga dhami zeet!! Baszoo!!\""
cornothgrocer_speech_029 = de \
   "~kSolomon sagt, \"So ist es gut, siidhika, mach Deine Geschäfte mit "
   "diesem Schwachkopf!! Bah!! Da kriegst Du genau, was Du suchst! Baszoo!!\""
cornothgrocer_speech_030 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_031 = de \
   "~kSolomon sagt, \"Ja, dieser ghazzabu ist ein großes und dummes Tier, "
   "das wir in meiner Heimat mit großen Steinen jagen, die wir aus "
   "größtmöglicher Höhe auf ihre Köpfe fallen lassen. Platsch!! Überall "
   "Hirnmasse. Doch trotz all dieser Hirnmasse kann der dumme ghazzabu immer "
   "noch nicht wie ein kluges Tier denken!! Ha, ha ha ha ha!!\""
cornothgrocer_speech_032 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_033 = de \
   "~kSolomon sagt, \"Das bezeichnet einen Morgen mit einem großen Frühstück "
   "und ist ein großes Kompliment auf whagzii.\""
cornothgrocer_speech_034 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_035 = de \
   "~kSolomon sagt, \"Ah, ja, ghum dikka! Nun, das ist ein Ding aus meiner "
   "fernen Heimat, mit dem wir ein Baby säubern, nachdem es zu viel kaab "
   "farlu gegessen hat.\""
cornothgrocer_speech_036 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_037 = de \
   "~kSolomon sagt, \"Das bedeutet einfach 'es ist mir ein Vergnügen'.\""
cornothgrocer_speech_038 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_039 = de \
   "~kSolomon sagt, \"Ah, das sind die Worte, die in meiner Muttersprache "
   "bedeuten 'ein Mann, durch dessen Hohlräume im Kopf Wasser rinnt'. "
   "Lustig, nicht wahr? Ha, ha ha ha ha!!\""
cornothgrocer_speech_040 = de \
   "~kSolomon sagt, \"Dies ist ein großes Tier aus meiner Heimat mit "
   "schrecklichen Zähnen und einem schrecklichen Brüllen, das bei schnellen "
   "Bewegungen oder dem kleinsten Geräusch Reißaus nimmt!\""
cornothgrocer_speech_041 = de \
   "~kSolomon sagt, \"Solomon steht Dir zu Diensten, edle Seele. Ghiza Tabu, "
   "haatik.\""
cornothgrocer_speech_042 = de \
   "~kSolomon sagt, \"Komm herein, Tabu, komm herein. Es ist schon so lange "
   "her, dass wir uns gesehen haben!\""
cornothgrocer_speech_043 = de \
   "~kSolomon sagt, \"Ja? Was genau will siidhika denn genau, genau?\""
cornothgrocer_speech_044 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_045 = de \
   "~kSolomon sagt, \"Ich glaube, er ist mit der königlichen Familie "
   "verwandt! Ja, ich glaube, das ist wahr!\""
cornothgrocer_speech_046 = de \
   "~kSolomon sagt, \"Ein sehr feiner und edler Herr und ebenso ... mein "
   "Freund! Herbut besitzt einen Laden mit wunderschönen Dingen in "
   "Barloque.\""
cornothgrocer_speech_047 = de \
   "~kSolomon sagt, \"Ich frage mich, ob solch ein edler Herr wie Herbut "
   "Dich in seinem Laden dulden würde. Nein, ich denke nicht. Ich bin in "
   "vielen Dingen viel zu tolerant!\""
cornothgrocer_speech_048 = de \
   "~kSolomon sagt, \"Wusstest Du, dass Jasper einst ein eigenes Königreich "
   "war und noch lange, nachdem der König in Meridian erklärt hatte, dass es "
   "sich ergeben müsste, Widerstand leistete? Das sollte Dir etwas über "
   "Jasper sagen. Ein schrecklicher Krieg folgte. Die Festung der alten "
   "Kriegsherren von Jasper, die Würms-Feste, legt davon bis heute beredtes "
   "Zeugnis ab. Die Bürger Jaspers, glaube ich, sehnen sich immer noch nach "
   "ihrer ehemaligen Unabhängigkeit zurück! Sogar heute noch gibt es viele "
   "Geheimnisse in Jasper. Besonders heute.\""
cornothgrocer_speech_049 = de \
   "~kSolomon sagt, \"Obwohl die Minen in Jasper ausgebeutet und die "
   "Minenarbeiter weggezogen sind, kommt immer noch eine beträchtliche Menge "
   "an Edelsteinen aus den westlichen Zerklüfteten Bergen, und aus Jasper "
   "insbesondere. Natürlich gibt es jetzt, da die Rebellion dort ihr Zentrum "
   "hat, noch viel mehr Möglichkeiten, zu Reichtum zu kommen.\""
cornothgrocer_speech_050 = de \
   "~kSolomon sagt, \"Ich hörte, dass Jasper das Zentrum der Unruhen ist, "
   "die das Land ins Chaos zu stürzen drohen.\""
cornothgrocer_speech_051 = de \
   "~kSolomon sagt, \"Dies ist ein Wort aus meiner Muttersprache whagzii. "
   "Jhonee bedeutet ungefähr 'kleines Eichhörnchen'.\""
cornothgrocer_speech_052 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_053 = de \
   "~kSolomon sagt, \"Ich denk noch nicht mal über einen Kommentar zu diesem "
   "kleinen Händler nach. Wie ein hagzjaffe, mit großen Zähnen, der niemals "
   "beißt. Papperlapapp, aber die Qualität seiner Waren? Unterster "
   "Standard.\""
cornothgrocer_speech_054 = de \
   "~kSolomon sagt, \"So ist es gut, siidhika, mach Deine Geschäfte mit "
   "diesem Schwachkopf!! Bah!! Da kriegst Du genau, was Du suchst! Baszoo!!\""
cornothgrocer_speech_055 = de \
   "~kSolomon sagt, \"Kaab farlu? Ah, Tabu, eine köstliche Mischung aus "
   "Bohnen und gegorenem Salat! Es ist ganz köstlich, doch ein Gericht, mit "
   "dem man niemals ein Baby füttern sollte. Das ist ganz schlecht.\""
cornothgrocer_speech_056 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_057 = de \
   "~kSolomon sagt, \"Kagdur ist ein Begriff aus dem whagzii und bedeutet so "
   "viel wie 'absurde Klarheit der Vision' oder so ähnlich. Ha, ha ha ha "
   "ha!!\""
cornothgrocer_speech_058 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_059 = de \
   "~kSolomon sagt, \"Ja, Tabu, der Inbegriff einer Lady. So großzügig und "
   "freundlich ist Lady Aftyn, dass sie in Marion eine Zufluchtsstätte "
   "eröffnet hat, wo sie sich um die Kranken und Unglückseligen kümmert! Und "
   "das mit ihrem eigenen Geld! Ja, Tabu, ihre Kinder sind ob ihres "
   "Verhaltens seit dem Tod ihres Gatten sehr aufgebracht. Er war ein sehr "
   "reicher Lord, den ich gut kannte - mögen die Götter seiner Seele gnädig "
   "sein... Die Kinder leben noch in Barloque, was für ein Skandal, und "
   "machen viel Lärm darum, dass ihre Mutter ihr Erbe für ihre wohltätige "
   "Arbeit und für das Wirken von Shal'ille verschleudert! Meine Güte, Tabu, "
   "meine Güte.\""
cornothgrocer_speech_060 = de \
   "~kSolomon sagt, \"Ja, sie ist sehr begehrenswert, eine schreckliche "
   "Herzensbrecherin! Armer jhonee!! Sie hat Frisconar abgewiesen, und zu "
   "Recht, denn er ist dumma, ungesund. Jetzt soll sie eine große "
   "Liebesaffäre mit Frular, dem Gildenmeister, haben! Aber, edle Seele, das "
   "hast Du nicht von mir gehört, denn er ist ein verheirateter Mann! Ach "
   "je, was für ein Skandal! Baszoo!!\""
cornothgrocer_speech_061 = de \
   "~kSolomon sagt, \"Sie lebt in Barloque, und was für eine perfekte "
   "Schneiderin sie ist! Sie fertigt alle Kleider für die königlichen "
   "Hoheiten, und man sagt ihr nach, sie hätte großen Einfluss!! Ja, großen "
   "Einfluss!! Nur gut, dass sie die Liebe dieses dinki padarapoomy "
   "Frisconar mit Füßen getreten hat!\""
cornothgrocer_speech_062 = de \
   "~kSolomon sagt, \"Marion ist so stabil und die Leute sind so komisch in "
   "ihrer Art!! Doch die Wälder um Marion sind tief und voller Geheimnisse! "
   "Ich habe ein paar unglaubliche Dinge gesehen, die aus diesen Wäldern "
   "gebracht wurden. Ich bin der Meinung, dass die Entdeckung des Tales der "
   "Trauer nur der Anfang unglaublicher Dinge ist, die zukünftige Forscher "
   "finden werden! Stell Dir den Handel vor, Tabu, die geschäftlichen "
   "Möglichkeiten, die sich eröffnen!!\""
cornothgrocer_speech_063 = de \
   "~kSolomon sagt, \"Eine einfache Stadt voller einfacher Menschen. Bauern! "
   "Das Fundament der Erde! Eine ehrliche Stadt, mein Freund. Wir alle "
   "müssen dem Bauern und dem Hof danken!!\""
cornothgrocer_speech_064 = de \
   "~kSolomon sagt, \"Du wirst dort in guter Gesellschaft sein, siidhika, "
   "zusammen mit den Schweinen. Ha, ha ha ha ha!!\""
cornothgrocer_speech_065 = de \
   "~kSolomon sagt, \"Dieser ghazzabu kann eine Drachenschuppe nicht von "
   "einem Orkzahn unterscheiden! Ha, ha ha ha ha!! Einer meiner Kunden "
   "verkaufte ihm drei Dutzend essbare Pilze mit großem Gewinn, denn "
   "Morrigan dachte, er würde lila Pilze kaufen!! Ha, ha ha ha ha!!\""
cornothgrocer_speech_066 = de \
   "~kSolomon sagt, \"So ist es gut, siidhika, mach Deine Geschäfte mit "
   "diesem Schwachkopf!! Bah!! Da kriegst Du genau, was Du suchst! Baszoo!!\""
cornothgrocer_speech_067 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_068 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_069 = de \
   "~kSolomon sagt, \"Nach dem Tod des Herzogs und da die Prinzessin nun "
   "erwachsen wird, sollte Kateriina bald die Krone tragen.\""
cornothgrocer_speech_070 = de \
   "~kSolomon sagt, \"Viele lachen über diesen Mann, doch er ist ein Prophet "
   "und hat Visionen und Vorahnungen, die viel über unsere Zukunft verraten. "
   "Baszoo!!\""
cornothgrocer_speech_071 = de \
   "~kSolomon sagt, \"Ran'er Zen ist ohne Wissen, wie auch der Wind ohne "
   "Wissen ist. Baszoo!!\""
cornothgrocer_speech_072 = de \
   "~kSolomon sagt, \"Ach ja, Roluk! Die traurige Geschichte Roluks ist eine "
   "traurige Geschichte unerfüllter Liebe! Wir können nicht wissen, ob es "
   "eine Liebe ist, die aus Pflicht geboren wurde, oder eine Liebe zu der "
   "Frau selbst. Doch seine Liebe zur Prinzessin geriet mit seinen Pflichten "
   "als Major der Königlichen Garde in Konflikt und er wurde gezwungen, den "
   "Hof zu verlassen! Er kämpfte für sie auf dem Feld der Ehre! Tragisch, "
   "nicht wahr? Jetzt verbringt er seine Tage damit, Schüler in die "
   "Waffenschule aufzunehmen und auf eine Nachricht von ihr zu warten, die "
   "ihn an ihre Seite zurückruft. Nur Warten und Warten auf eine Nachricht, "
   "die möglicherweise nie kommt. Aber er ist ein harter Mann und er wird "
   "warten, bis er stirbt. Baszoo.\""
cornothgrocer_speech_073 = de \
   "~kSolomon sagt, \"Roluk, ja Roluk? Ahhh, Roluk! Ja Roluk ist ein großer "
   "Waffenmeister, der einst als Major der Königlichen Garde diente, ehe er "
   "sich in dieser schönen Stadt zur Ruhe setzte und eine Waffenschule "
   "aufmachte. Er ist ein unnachgiebiger, jedoch verständnisvoller Mann und "
   "wir in Cor Noth sind geehrt, ihn hier zu haben. Man erzählt, zu seiner "
   "Zeit bei Hofe sei er ein wilder Duellant gewesen, wenn das Temperament "
   "mit ihm durchging. Aber heute ist er nicht mehr so. Baszoo.\""
cornothgrocer_speech_074 = de \
   "~kSolomon sagt, \"Warum fragst Du mich nach Roluk, dummer siidhika? Komm "
   "nicht auf dumme Gedanken, Du brauchst Roluk nicht herauszufordern, um "
   "uns zu beeindrucken! Wir sind bereits genügend von Deinem trüben Geist "
   "beeindruckt, dinki padarapoomy. Baszoo.\""
cornothgrocer_speech_075 = de \
   "~kSolomon sagt, \"Ich frage mich, was er jetzt tun wird.\""
cornothgrocer_speech_076 = de \
   "~kSolomon sagt, \"Oh, er ist eine schreckliche Klatschtante! Immer "
   "bereit, über irgendjemand anders zu reden! Ich missbillige Klatsch.\""
cornothgrocer_speech_077 = de \
   "~kSolomon sagt, \"Geh und finde ihn im Schloss des Herzogs, siidhika, "
   "und tratsch mit ihm! Und wenn Du da bist, dann sag ihm, er soll mal in "
   "meinem Laden vorbeikommen, damit ich ihm ein paar auf die Ohren geben "
   "kann!!\""
cornothgrocer_speech_078 = de \
   "~kSolomon sagt, \"Die sepkas? Du weißt nicht, was sepkas sind? Ha, ha ha "
   "ha, Du bist so lustig!!\""
cornothgrocer_speech_079 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_080 = de \
   "~kSolomon sagt, \"Siidhika ist ein Wort aus meiner fernen Heimat und "
   "bedeutet 'ein unterbelichteter Tölpel, der über die Voraussicht eines "
   "leeren Misthaufens verfügt'. Ha, ha ha ha ha!\""
cornothgrocer_speech_081 = de \
   "~kSolomon sagt, \"Tabu ist ein Wort meines Volkes und bedeutet "
   "'geschätzter und wohl gesonnener Freund'.\""
cornothgrocer_speech_082 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_083 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_084 = de \
   "~kSolomon sagt, \"Tos ist das Finanzzentrum von Meridian. Viele "
   "Geschäftsleute scheuen sich, dies laut zu sagen, doch ich sage Dir, dass "
   "es wahr ist.\""
cornothgrocer_speech_085 = de \
   "~kSolomon sagt, \"Das Gedenken an Kalior möge für immer in Tos erhalten "
   "bleiben. Denn er machte Tos zu der großen Stadt, die sie heute ist. Ich "
   "frag mich, ob das alles zerfallen soll?\""
cornothgrocer_speech_086 = de \
   "~kSolomon sagt, \"Kommst Du von da, Du kleiner vertrockneter Fisch, "
   "kommst Du aus Tos? Nun, es ist nur eine kurze Rückreise, und ich denke, "
   "Du solltest sie bald antreten. Du solltest nach Hause gehen und intensiv "
   "lernen, ehe Du zu uns zurückkommst, siidhika.\""
cornothgrocer_speech_087 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_speech_088 = de \
   "~kSolomon sagt, \"Das ist der Mann in meinem Heimatland, der auf dem "
   "Markt stehen und überzählige sepkas von den Bauern und ihren Familien "
   "einsammeln muss. Ha, ha ha ha ha!!\""
cornothgrocer_speech_089 = de \
   "~kSolomon sagt, \"Das ist die Muttersprache meines Heimatlandes, viele "
   "Meilen entfernt von hier.\""
cornothgrocer_speech_090 = de \
   "~kSolomon sagt, \"Warum stellst Du mir Fragen über solche Wörter? Ich "
   "traue Dir nicht zu, irgendetwas zu verstehen, siidhika, und schon gar "
   "nicht die Worte einer uralten und ehrwürdigen Sprache wie whagzii. Aber "
   "verzweifle nicht, denn daraus kann nichts Gutes kommen! Es ist ja nicht "
   "Deine Schuld, dass Du als Büffel unter Menschen geboren wurdest. Ha, ha "
   "ha ha ha!!\""
cornothgrocer_random_001 = de \
   "~kSolomon sagt, \"Ich habe oben ein paar kleine Wohnungen, die "
   "gelegentlich vermietet werden. Zur Zeit sind sie alle belegt, doch setz "
   "Dich später mit mir in Verbindung, falls Du interessiert bist.\""
cornothgrocer_random_002 = de \
   "~kSolomon sagt, \"Du bist genau zum richtigen Ort gekommen, um Dich mit "
   "magischen Reagenzien einzudecken!! Vielleicht führe ich nicht alles, was "
   "Du brauchst, doch was ich habe, ist von bester Qualität! Nur unter uns - "
   "ich hab' wirklich Mitleid mit den Kunden, die mit Koldor handeln "
   "müssen.\""
cornothgrocer_random_003 = de \
   "~kSolomon sagt, \"Oh, dieser Roluk! Was für einen traurigen Freund ich "
   "in diesem Mann Roluk habe. Er versteckt sich vor seiner verlorenen "
   "Liebe, als wäre es eine vergessene Liebe, nicht wahr? Oh ja, er liebt, "
   "doch er liebt die Prinzessin, und diese Liebe wird vielleicht nie "
   "Erfüllung finden. Ach, so tragisch und verzwickt!\""
cornothgrocer_random_004 = de \
   "~kSolomon sagt, \"Und was ist aus dem Kaufmann Qesino aus Jasper "
   "geworden? Ja, ein Kneipenwirt aus Jasper, vielleicht kennst Du ihn, denn "
   "er war ein reicher Mann. Großzügig? Nein! Reich? Ja! Doch jetzt ist er "
   "verschwunden und das mit einem ganzen Haufen ~IGold~I.\""
cornothgrocer_random_005 = de "~kSolomon sagt, \"Bung dabba!\""
cornothgrocer_random_006 = de \
   "~kSolomon sagt, \"Fühle Dich, als wäre es Dein Laden, edle Seele. Als "
   "wäre es Deiner.\""
cornothgrocer_random_007 = de \
   "~kSolomon sagt, \"Entspanne Dich und genieße meine Gastfreundschaft, "
   "mein lieber Freund. Auch wenn sie nur bescheiden ist, biete ich Dir doch "
   "alle Annehmlichkeiten, die ich habe.\""
cornothgrocer_random_008 = de \
   "~kSolomon sagt, \"Sieh Dich um, Tabu, verfüge über meine Zeit. Wenn Du "
   "in meinem Laden bist, dann lasse alle Zeit und allen Ärger an der "
   "Schwelle zurück, wo sie sich miteinander beschäftigen mögen, solange Du "
   "mein Gast bist.\""
cornothgrocer_random_009 = de \
   "~kSolomon sagt, \"Die Vorsehung hat mich heute wahrlich mit Deiner "
   "Anwesenheit gesegnet, Tabu. Ich bin in jeder Hinsicht gesegnet.\""
cornothgrocer_random_010 = de \
   "~kSolomon sagt, \"Reisende trugen mir zu, dass es im Wald ein altes "
   "Gebäude gäbe, das eine Zwergenhalle war. Das hat mich sehr neugierig "
   "gemacht.\""
cornothgrocer_random_011 = de \
   "~kSolomon sagt, \"Wenn Du von Stadt zu Stadt reist, wirst Du meiner "
   "Meinung nach feststellen, dass es Leute gibt, die Dich damit "
   "beauftragen, Dinge an entlegene Ziele zu bringen! Oh, die Überlandwege "
   "sind für unbewaffnete Boten kaum sicher!\""
cornothgrocer_random_012 = de \
   "~kSolomon sagt, \"Es ist ein sonderbares und freigiebiges Land, edle "
   "Seele. Viele der exotischen Dinge, die Dir auf Deinen Wanderungen "
   "begegnen, lassen sich, sobald Du eine Stadt erreichst, verkaufen. "
   "Deshalb bewahre so viel wie möglich auf. Es gibt ein paar Sachen, nach "
   "denen ich stets Ausschau halte und für die ich einen guten Preis in Gold "
   "mache.\""
cornothgrocer_random_013 = de \
   "~kSolomon sagt, \"Viele der Dinge in meinem Laden kommen über die "
   "südlichen Pässe der Zerklüfteten Berge. Es ist eine gefährliche Reise, "
   "Tabu, da diese Pässe die Heimat der furchterregendsten Trolle sind. Und "
   "seit ein paar Jahren höre ich auch Berichte über Orks und mutierte "
   "Ameisen. Kein Wunder, dass unsere Einfuhrpreise steigen!\""
cornothgrocer_random_014 = de \
   "~kSolomon sagt, \"Cor Noth ist das Zentrum des Handels und anderer "
   "kultureller Aktivitäten in diesem Land, edle Seele. Du musst Dir die "
   "Zeit nehmen und diese schöne Stadt genießen, während Du hier bist. Ich "
   "bin sicher, es wird Dir gefallen!\""
cornothgrocer_random_015 = de \
   "~kSolomon sagt, \"Ich habe eine große Sammlung magischer Reagenzien "
   "hier, von denen viele recht selten sind. Außerdem mache ich die besten "
   "Preise für Qualitätswaren, mein Freund, deshalb suche zuerst mich auf, "
   "ehe Du nach Tos, Barloque oder Marion gehst. Wir können uns einigen, "
   "jhonee tabu, da wir alte Freunde sind.\""
cornothgrocer_random_016 = de \
   "~kSolomon sagt, \"Meine Freunde kommen aus allen Teilen der Welt, um "
   "mich zu besuchen und die Gastfreundschaft zu genießen, Tabu. Ich bin ob "
   "ihrer Gegenwart, der Großzügigkeit der Götter und der vielen, vielen "
   "Geschichten meiner Gäste selig! Oh, ich höre Geschichten aus allen "
   "Teilen des Königreiches.\""
cornothgrocer_random_017 = de \
   "~kSolomon sagt, \"Ja, und warst Du in Marion, um den Verrückten zu "
   "sehen? Ah, Tabu, welch wirres Gerede! Welch eine diwesafi! Welch ein "
   "kagdur! Vor vielen Jahren zog er durchs Land. Ich kannte ihn damals, und "
   "ich glaube, dass er ein Prophet ist. Ja, wirklich!\""
cornothgrocer_random_018 = de \
   "~kSolomon sagt, \"Meinem lieben Freund Herbut gehört ein sehr schöner "
   "Laden in Barloque. Und was für ein feiner Herr er ist, von höchst "
   "königlicher Haltung!! Und sein Laden ist voll der schönsten Dinge. Wenn "
   "Du etwas brauchst, was ich nicht habe, führt er es vielleicht. Sag ihm "
   "auf jeden Fall, dass ich Dich geschickt habe!!\""
cornothgrocer_random_019 = de \
   "~kSolomon sagt, \"Ja, wunderschöne Dinge. Exotische, wunderschöne "
   "Dinge.\""
cornothgrocer_random_020 = de \
   "~kSolomon sagt, \"Ich bin sicher, edle Seele, dass ich hier etwas habe, "
   "das Du schon zu lange entbehrst.\""
cornothgrocer_random_021 = de \
   "~kSolomon sagt, \"Was für ein glücklicher Umstand, dass Du heute hier "
   "bist, Tabu. Ich habe gerade Waren erhalten, die Dir sicherlich gefallen "
   "werden.\""
cornothgrocer_random_022 = de \
   "~kSolomon sagt, \"Es ist mir eine sagenhafte Freude, dass Du mich "
   "besuchst, Tabu. Kann ich Dir etwas Bestimmtes zeigen? Oder bist Du heute "
   "gekommen, um etwas zu verkaufen?\""
cornothgrocer_random_023 = de \
   "~kSolomon sagt, \"Bitte, Du bist mein Gast. Fühle Dich wohl und genieße "
   "das bescheidene Juwel, das mein Laden darstellt.\""
cornothgrocer_random_024 = de \
   "~kSolomon sagt, \"Binghi ghaloob, mein Freund, binghi ghaloob.\""
cornothgrocer_random_025 = de \
   "~kSolomon sagt, \"Wie glücklich bin ich, Dich zu sehen, edle Seele.\""
cornothgrocer_random_026 = de \
   "~kSolomon sagt, \"Dein ergebener Diener, Tabu. Es ist mir eine Ehre, "
   "Dich zu meinen Freunden zählen zu dürfen. Bitte sei so gut und verbringe "
   "Deine Zeit mit mir.\""
cornothgrocer_random_027 = de \
   "~kSolomon sagt, \"So wie ich es verstanden habe, kann der unbehauene "
   "Seraphym, der auf Konimas Insel zu finden ist, von einem Juwelier "
   "bearbeitet und zum Glänzen gebracht werden. Wunderschön sieht er dann "
   "aus, Tabu. Und für die Juweliere ist es nur ein Zeitvertreib!\""
cornothgrocer_random_028 = de \
   "~kSolomon sagt, \"Für Zaubersprüche sollte man nur einwandfreie "
   "Reagenzien verwenden, Tabu. Da sind einmal ein paar Orkzähne und die "
   "noch selteneren Augen der Drachenfliege sowie Kriipaklauen, die eher "
   "minderwertig sind!\""
cornothgrocer_random_029 = de \
   "~kSolomon sagt, \"Alle Welt redet von dieser neuen Magielehre, der "
   "Riija-Schule. Wie ich es verstanden habe, Tabu, zeichnet sie sich aus "
   "durch größte Machtausbeute bei hohem Kosteneinsatz, doch im Grunde "
   "genommen ist sie ziemlich anfällig. Alles in allem fehlerhaft.\""
cornothgrocer_random_030 = de \
   "~kSolomon sagt, \"Vielleicht würdest Du mit denen, mit denen Du Handel "
   "treibst, besser zurechtkommen, siidhika, wenn Du dem, was die Gegenseite "
   "wünscht, größere Beachtung schenkst! Jede Transaktion, jede Unterhaltung "
   "hat zwei Seiten, aber wie könnte ich von einem wagzidi herak erwarten, "
   "dies zu verstehen!\""
cornothgrocer_random_031 = de \
   "~kSolomon sagt, \"Ah, Plappermaul! Wie sehr Du mich doch an den Narren "
   "Rulker aus Tos erinnerst. Immer am Reden. Klatsch und Tratsch und die "
   "Angelegenheiten aller anderen. Ha, ha ha ha!! Nun, Du wirst kein "
   "Geschwätz in meinem Laden zu hören bekommen!\""
cornothgrocer_random_032 = de \
   "~kSolomon sagt, \"Was für ein Gestank ist das denn? Oh, Du bist es, mein "
   "Freund! Oh, es tut mir ja so leid, so leid, aber ich hätte Dich in "
   "Deiner Bedeutungslosigkeit völlig übersehen, wenn Du nicht einen so "
   "entsetzlichen Geruch ausströmen würdest!! Ha, ha ha ha ha! Oh, siidhika "
   "bagab, es tut mir ja so leid, aber Du bist abstoßend, wie gebratene "
   "Leber und stinkendes Gras! Ha, ha ha ha ha!\""
cornothgrocer_random_033 = de \
   "~kSolomon sagt, \"Sei vorsichtig, siidhika, dass Du nicht ein paar von "
   "Deinen Flöhen auf meine Teppiche und Wandbehänge fallen lässt, sonst "
   "müsste ich einen Flicker von Kraanan kommen lassen, der den Laden "
   "entlaust. Ha, ha ha ha ha!! Nichts für ungut, ghazzabu, aber Du bist "
   "wirklich ein jämmerliches Exemplar, ha, ha ha ha ha! Was kann ich für "
   "Dich tun? Ich fürchte, dass ich keine Seife oder ghum dikka verkaufe!!\""
cornothgrocer_random_034 = de \
   "~kSolomon sagt, \"Verschmutzt Du immer noch meinen bescheidenen und "
   "einfachen Laden, Du Schmutzkäfer? Ah, das ist wirklich das Schlimme "
   "dabei, wenn man die Tür offen lässt, siidhika. Man weiß nie, welch "
   "widerlichen Unrat die nächste Brise hereinweht! Ha, ha ha ha ha!\""
cornothgrocer_random_035 = de \
   "~kSolomon sagt, \"Ah, wenn Du das nächste Mal in meinen Laden kommst, "
   "tritt Dir vorher die Füße ab, Dreckspatz! Dies ist ein Laden, den "
   "angenehme Menschen aufsuchen, um sich die Zeit zu vertreiben, und kein "
   "Viehpferch, wie Du ihn gewohnt bist, Du Ziegenbock! Haga dhami zeet, "
   "siidhika.\""
cornothgrocer_trigger_bye = de "ciao"
cornothgrocer_trigger_council = de "ratsmitglied"
cornothgrocer_trigger_duke = de "herzog"
cornothgrocer_trigger_duke_princess = de "herzog prinzessin"
cornothgrocer_trigger_hello = de "hallo"
cornothgrocer_trigger_herbutte = de "herbut"
cornothgrocer_trigger_herbut = de "herbutte"
cornothgrocer_trigger_joguer = de "koldor"
cornothgrocer_trigger_koldor = de "joguer"
cornothgrocer_trigger_princess = de "prinzessin"
cornothgrocer_trigger_ran_er_hoth = de "ran'er zen"
cornothgrocer_trigger_ran_er_zen = de "ran er'zen"
cornothgrocer_trigger_ran_er_zen_2 = de "ran er'hoth"
cornothgrocer_trigger_rook = de "roluk"
cornothgrocer_trigger_roluk = de "rook"
cornothgrocer_trigger_rycksher = de "rulker"
cornothgrocer_trigger_rulker = de "rycksher"

// CorNothInnkeeper
cornothinnkeeper_speech_001 = de \
   "~kD'Franko sagt, \"Man kann aus einem der Biester wahrscheinlich ein "
   "ganzes Federbett machen, wenn es stimmt, was ich höre. Ich denke aber, "
   "dass wir hierbei keine Zeit zu verlieren haben. Wir führen eine Armee "
   "direkt durch diese Menschensiedlung und nehmen die ganze verdammte Insel "
   "mit einem einzigen Schlag ein. Einfach so, genau so.\""
cornothinnkeeper_speech_002 = de \
   "~kD'Franko sagt, \"Ich sage, schlagen wir zu, bevor sie zuschlagen, und "
   "zwar hart.\""
cornothinnkeeper_speech_003 = de \
   "~kD'Franko sagt, \"Na los, Du. Genug herumgeschnüffelt.\""
cornothinnkeeper_speech_004 = de \
   "~kD'Franko sagt, \"Die reinste Platzverschwendung. Ein Schandfleck auf "
   "dem Antlitz dieses Landes. Man sollte die ganze Stadt bis auf die "
   "Grundmauern ~Iniederbrennen~I und die Bewohner in die Wildnis schicken, "
   "wo sie selbst sehen sollen, wie sie zurechtkommen. Nichts als Lackaffen "
   "und Spitzbuben.\""
cornothinnkeeper_speech_005 = de \
   "~kD'Franko sagt, \"Hübsche Gegend, glaube ich. Wenn man auf den ganzen "
   "Pomp und Prunk des Königshauses steht oder wenn man die Sorte "
   "gekünstelten Zuspruch liebt, die eine königliche Familie so von sich "
   "gibt. Für mich ist das nichts - ich würde da nicht leben wollen. "
   "Garantiert nicht.\""
cornothinnkeeper_speech_006 = de \
   "~kD'Franko sagt, \"Stammst Du etwa von dort, Fremdling? Ich lach' mich "
   "kaputt. Aus der Jauchegrube der Korruption und Königstreue.\""
cornothinnkeeper_speech_007 = de \
   "~kD'Franko sagt, \"Komm bald wieder bei uns vorbei, %s!\""
cornothinnkeeper_speech_008 = de \
   "~kD'Franko sagt, \"Auf Wiedersehen. Pass gut auf Dich auf.\""
cornothinnkeeper_speech_009 = de \
   "~kD'Franko sagt, \"Gut, dass Du gehst. Hmpf.\""
cornothinnkeeper_speech_010 = de \
   "~kD'Franko sagt, \"Cor Noth ist eine großartige Stadt, dem Königreich "
   "gegenüber loyal und patriotisch. Ich finde, sie ist ein wenig ~Izu~I "
   "tolerant geworden, wenn Du weißt, was ich meine. Jede Menge Fremde hier "
   "- und die meisten sehr zwielichtig.\""
cornothinnkeeper_speech_011 = de \
   "~kD'Franko sagt, \"Ich liebe diese Stadt. Sie ist herrlich. Ich habe ihr "
   "gedient - in den Streitkräften - und ich würde für ihre Verteidigung "
   "ohne zu zögern mein Leben geben.\""
cornothinnkeeper_speech_012 = de \
   "~kD'Franko sagt, \"Kümmere Dich um Deinen eigenen Kram, Du. Und störe "
   "mit Deinem Gejammer die anständigen Leute nicht.\""
cornothinnkeeper_speech_013 = de \
   "~kD'Franko sagt, \"Das sind nicht die schlechtesten Kerle, wenn man auf "
   "das Geschwätz impotenter alter Männer steht. Für sowas habe ich "
   "allerdings keine Zeit.\""
cornothinnkeeper_speech_014 = de \
   "~kD'Franko sagt, \"Die Fragen gehen Dir wohl nicht aus, was? Nun, der "
   "Rat ist eine Art Überbleibsel aus der Zeit, in der der König noch von "
   "Barloque aus regierte. Heutzutage ist es hauptsächlich eine zeremonielle "
   "Instanz, eine Art Ehrenamt.\""
cornothinnkeeper_speech_015 = de \
   "~kD'Franko sagt, \"Halte Deine Nase aus meinen Angelegenheiten heraus, "
   "Fremdling. Ich habe keine Ahnung, wer Du bist.\""
cornothinnkeeper_speech_016 = de "~kD'Franko sagt, \"Ein ehrenhafter Mann.\""
cornothinnkeeper_speech_017 = de \
   "~kD'Franko sagt, \"Akardius sollte sich besser um seine Armee kümmern. "
   "Kalior verbrachte viele Jahre damit, sie zu der besten im Land zu "
   "machen.\""
cornothinnkeeper_speech_018 = de \
   "~kD'Franko sagt, \"Ich salutiere vor Kalior, selbst im Tod!\""
cornothinnkeeper_speech_019 = de \
   "~kD'Franko sagt, \"Ich hörte Geschichten, doch nur Geschichten, über "
   "eine Macht, die auf drei Gesichter aufgeteilt wurde. Die Geschichte "
   "besagt, die Macht müsse Wächter finden, um sich anderen offenbaren zu "
   "können. Die Geschichte war alt, und kaum einer erinnert sich mehr daran. "
   "Das ist alles, was ich Dir dazu erzählen kann.\""
cornothinnkeeper_speech_020 = de \
   "~kD'Franko sagt, \"Es waren drei Schützen.\""
cornothinnkeeper_speech_021 = de \
   "~kD'Franko sagt, \"Sei gegrüßt, %s! Komm herein und mach es Dir bequem.\""
cornothinnkeeper_speech_022 = de \
   "~kD'Franko sagt, \"Hallo! Willkommen in der Kneipe zum Bach.\""
cornothinnkeeper_speech_023 = de "~kD'Franko sagt, \"Hmpf.\""
cornothinnkeeper_speech_024 = de \
   "~kD'Franko sagt, \"Ja, ich habe ihn gesehen. Dieser erbärmliche "
   "Hausierer war hier. Ich hoffe, er verpestet nicht schon wieder mit "
   "seiner Anwesenheit den Weg des Königs. Er sollte sich besser eine "
   "richtige Arbeit suchen, statt den müden Reisenden, die in unsere Stadt "
   "kommen, seinen Kram aufzuschwatzen.\""
cornothinnkeeper_speech_025 = de \
   "~kD'Franko sagt, \"Verräter! Die Bürger von Jasper sind Verräter! Herzog "
   "Akardius wird sich zur rechten Zeit um sie kümmern...\""
cornothinnkeeper_speech_026 = de \
   "~kD'Franko sagt, \"Halte Dich von Jasper fern, wenn ich Dir einen Rat "
   "geben darf. Das ist ein gefährlicher, trügerischer Ort.\""
cornothinnkeeper_speech_027 = de \
   "~kD'Franko sagt, \"Warum schnüffelst Du hier in meinem Gasthaus herum, "
   "he? Mach', dass Du fortkommst, Du Lump.\""
cornothinnkeeper_speech_028 = de \
   "~kD'Franko sagt, \"Wenn Du Zarcos beseitigst, werden einige Leute, die "
   "mir wohlbekannt sind, Dich dermaßen belohnen, wie es Deine wildesten "
   "Fantasien sich nicht ausmalen können.\""
cornothinnkeeper_speech_029 = de \
   "~kD'Franko tut so, als hättest Du nichts gesagt."
cornothinnkeeper_speech_030 = de "~kD'Franko ignoriert Dich."
cornothinnkeeper_speech_031 = de \
   "~kD'Franko sagt, \"Pass in Marion gut auf Dich auf. Royalisten, Du weißt "
   "schon.\""
cornothinnkeeper_speech_032 = de \
   "~kD'Franko sagt, \"Marion ist eine beeindruckende Stadt, wenn man gern "
   "herumsitzt und dem Gras beim Wachsen zusieht.\""
cornothinnkeeper_speech_033 = de \
   "~kD'Franko sagt, \"Du gefällst mir nicht, nicht im Geringsten.\""
cornothinnkeeper_speech_034 = de \
   "~kD'Franko erschaudert unmerklich, \"Reisende haben mir von den "
   "unverschämten Reden und Taten dieses ~IKindes~I erzählt. Ich fürchte, "
   "sie hat uns nicht die Wahrheit über ihre Absichten gesagt.\""
cornothinnkeeper_speech_035 = de \
   "~kD'Franko sagt, \"Ich vertraue darauf, dass unser guter Herzog Pläne "
   "hat, um uns von ihrer Bedrohung zu befreien. Doch im Namen der "
   "Gelehrsamkeit mache ich mir Sorgen, welche Auswirkungen das haben "
   "könnte.\""
cornothinnkeeper_speech_036 = de \
   "~kD'Franko sagt, \"Auch wenn sie eine Armee von fähigen Kämpfern um sich "
   "versammelt hat, was ich eigentlich nicht glaube, sehe ich keinen Grund, "
   "sich wegen dieses Kindes Sorgen zu machen.\""
cornothinnkeeper_speech_037 = de \
   "~kD'Franko sagt, \"Ich muss zugeben, der Gedanke an all die Macht in "
   "ihren Händen macht mich ganz nervös. Mich schaudert bei dem Gedanken, "
   "was sie damit alles anstellen könnte. Zweifellos könnte sie eine ganze "
   "Stadt dem Erdboden gleichmachen, wenn sie wollte.\""
cornothinnkeeper_speech_038 = de \
   "~kD'Franko sagt, \"Was soll das mit Dir und diesem übermütigen Kind? "
   "Bist Du mit ihr verbündet?\""
cornothinnkeeper_speech_039 = de \
   "~kD'Franko sagt, \"Mir wurde Nachricht von ihren Äußerungen zugetragen, "
   "sie ist bestimmt wahnsinnig. Bring solchen Wahnsinn nicht in mein Haus, "
   "sonst ist er am Ende noch ansteckend.\""
cornothinnkeeper_speech_040 = de \
   "~kD'Franko sagt, \"Vergiss es. Ich verleihe kein Geld.\""
cornothinnkeeper_speech_041 = de \
   "~kD'Franko sagt, \"Nicht jetzt, %s. Vielleicht später.\""
cornothinnkeeper_speech_042 = de \
   "~kD'Franko sagt, \"Ich frage mich, was der Grund für Mirianas Taten ist. "
   "Ist es Wahnsinn? Ist es Einsamkeit? Oder könnte es etwas sein, von dem "
   "wir uns wünschen würden, es nie erahnt zu haben?\""
cornothinnkeeper_speech_043 = de \
   "~kD'Franko schaudert, \"Diese Wesen, die Miriana herbeiruft, vielleicht "
   "sind sie ihre einzigen Freunde? Wäre das nicht traurig?\""
cornothinnkeeper_speech_044 = de \
   "~kD'Franko sagt, \"Ich hab nicht die Zeit, mich mit Dir zu unterhalten. "
   "Geh und sprich mit Hester Gilk, sie weiß sicherlich mehr, als sie "
   "zugibt, und vielleicht kann sie Dir mehr über das erzählen, was Du "
   "wissen willst.\""
cornothinnkeeper_speech_045 = de \
   "~kD'Franko sagt, \"Wir sollten ihre Bauten fluten.\""
cornothinnkeeper_speech_046 = de \
   "~kD'Franko sagt, \"Diese furchtbaren Bestien sollten ausgelöscht werden. "
   "Vor ein paar Jahren haben wir es versucht - ich verlor bei diesem "
   "Feldzug viele meiner Freunde. Wir haben sie eine Weile aufgehalten und "
   "ihren Vormarsch gebremst, aber Du kannst darauf wetten, dass sie mit "
   "ganzer Kraft und Wut zurückkehren werden.\""
cornothinnkeeper_speech_047 = de \
   "~kD'Franko sagt, \"Was weißt Du schon, wie man Orks bekämpft? Kümmere "
   "Dich um Deinen eigenen Kram.\""
cornothinnkeeper_speech_048 = de \
   "~kD'Franko sagt, \"Man sollte ihr den Prozess machen wegen der "
   "Verbrechen, die ihre Familie dem Land angetan hat... das heißt, falls "
   "sie sich als Vertreterin der Zarcos-Familie ausgibt. Und wenn nicht, "
   "sollte sie aus dem Palast verschwinden und wie wir alle ein ehrliches "
   "Leben führen.\""
cornothinnkeeper_speech_049 = de \
   "~kD'Franko sagt, \"Prinzessin Kateriina Zarcos? Ich erkenne ihr "
   "Nachfolgerecht nicht an, und auch nicht die Art, wie ihre Familie dieses "
   "Land während der letzten zig Generationen zugrunde gerichtet hat. "
   "Jawohl, ~IGenerationen~I.\""
cornothinnkeeper_speech_050 = de \
   "~kD'Franko sagt, \"Du machst wohl Witze, wenn Du dieses mitleiderregende "
   "Frauenzimmer Erbin irgendeines Throns nennst.\""
cornothinnkeeper_speech_051 = de \
   "~kD'Franko sagt, \"Wie kommst Du eigentlich dazu, wie ein Spion des "
   "Königs in anderer Leute Angelegenheiten herumzuschnüffeln? Verschwinde "
   "bloß von hier. Ich habe Dir nichts zu sagen.\""
cornothinnkeeper_speech_052 = de "~kD'Franko sagt, \"Hängt die Reichen.\""
cornothinnkeeper_speech_053 = de \
   "~kIm Raum wird es still, als %s den verkümmerten Zwerg erwähnt."
cornothinnkeeper_speech_054 = de \
   "~kD'Franko sagt, \"Ich weiß nicht, was passiert ist... es war... also "
   "gut, ich hab irgendwie die Nerven verloren, ja? Ich wusste nicht, was "
   "ich tun sollte, ich konnte mir auf nichts einen Reim machen, ich geriet "
   "in Panik, ja? Aber man weiß einfach nicht, was man in so einem Moment "
   "tun wird, bis man dort ist, weißt Du das? Weißt Du das?\""
cornothinnkeeper_speech_055 = de \
   "~kD'Franko sagt, \"Wir marschierten den ganzen Tag in der Sonne, stiegen "
   "einen felsigen Pfad hinauf, etwa zwei Tagesreisen südlich von Jasper. Es "
   "war heiß, und wir hatten nichts gesehen, seit wir aufgebrochen waren. "
   "Das muss man den Orks lassen - wenn sie nicht gesehen werden wollen, "
   "dann sieht man sie auch nicht. Doch kurz vor Sonnenuntergang griffen sie "
   "uns an, von beiden Seiten. Sie drängten die Späher ab, schnitten sie ab "
   "und metzelten sie bis auf den letzten Mann nieder. Sie kamen in drei "
   "Wellen, und nach einer Stunde waren sie weg. Wir verloren das halbe "
   "Bataillon, alles Männer aus Cor Noth, etwa zweihundertzwanzig. In jener "
   "Nacht kehrten wir um und schleppten die Verwundeten durch den Pass "
   "zurück nach Hause.\""
cornothinnkeeper_speech_056 = de \
   "~kD'Franko sagt, \"Darüber rede ich nicht mit Dir.\""
cornothinnkeeper_speech_057 = de \
   "~kD'Franko sagt, \"Tos ist die wahre Hauptstadt von Meridian, und die, "
   "die etwas anderes behaupten, können sich von mir aus aufhängen. Für mich "
   "ist es das Zentrum der Regierung, der Sitz der wahren Macht.\""
cornothinnkeeper_speech_058 = de \
   "~kD'Franko sagt, \"Cor Noth mag der beste Ort für interessante Gespräche "
   "und Ideen sein, aber Tos ist das Handelszentrum von Meridian. Ich bemühe "
   "mich, so oft wie möglich dorthin zu kommen.\""
cornothinnkeeper_speech_059 = de \
   "~kD'Franko sagt, \"Hast Du nichts Besseres zu tun, als mit Deinem "
   "Gequatsche einen anständigen Geschäftsmann zu belästigen? Du gehst mir "
   "auf die Nerven.\""
cornothinnkeeper_speech_060 = de "~kD'Franko sagt, \"Tova ist ein Idiot.\""
cornothinnkeeper_speech_061 = de \
   "~kD'Franko sagt, \"Das sind Dämonen, Kriegsbestien, die den Orks als "
   "Sklaven dienen, wenn deren Armeen marschieren, wegen irgendeines "
   "boshaften Paktes aus uralten Zeiten. Das habe ich mit eigenen Augen "
   "gesehen, in der Schlacht von Tangee Bluff.\""
cornothinnkeeper_speech_062 = de \
   "~kD'Franko sagt, \"Stell Deine Fragen woanders.\""
cornothinnkeeper_random_001 = de \
   "~kD'Franko sagt, \"Ein Wort, nur ein Wort. Bürgerkrieg. Denk darüber "
   "nach.\""
cornothinnkeeper_random_002 = de \
   "~kD'Franko sagt, \"Abkömmlinge von Konima oder nicht. Ich sage, machen "
   "wir diese Militaristen von der Insel platt. Löschen wir sie aus, sofort. "
   "Oder sollen wir darauf warten, dass sie mit uns genau das machen?\""
cornothinnkeeper_random_003 = de \
   "~kD'Franko sagt, \"Die Royalisten bauen insgeheim Unterstützung auf. Ich "
   "bin alt genug, um mich daran zu erinnern, wie es unter der Herrschaft "
   "eines korrupten Königs ist. Da mache ich nicht mehr mit. Nur über meine "
   "Leiche.\""
cornothinnkeeper_random_004 = de \
   "~kD'Franko sagt, \"Der König lebt noch, obwohl er sich im Verborgenen "
   "hält. Ich weiß nicht, wo er sich aufhält oder wann er wieder auftauchen "
   "wird, aber Du kannst sicher sein, dass er es tut. Verrückt? Verrückt wie "
   "ein Fuchs ist dieser alte Mann.\""
cornothinnkeeper_random_005 = de \
   "~kD'Franko sagt, \"Ich habe gehört, dass eine ~Ibeträchtliche~I "
   "Belohnung für denjenigen loyalen Bürger ausgesetzt wurde, der den alten "
   "Fuchs König Zarcos findet. Das ist nicht allgemein bekannt. Ich habe "
   "außerdem den Verdacht, dass, wenn jemand ihn findet und er irgendeine "
   "Art von Unfall hat, diese Person in der Tat ein paar ~Ieinflussreiche~I "
   "Freunde gewinnen würde.\""
cornothinnkeeper_random_006 = de \
   "~kD'Franko sagt, \"Die Prinzessin ist eine ~IVerräterin~I. Akardius muss "
   "die Truppen zusammenziehen, denn in diesem Land herrscht der "
   "Ausnahmezustand. Orkbauten! Armeen von vogelartigen Biestern! Wir "
   "brauchen eine starke Führung, und was die Prinzessin angeht? Werft sie "
   "den Hunden zum Fraß vor!\""
cornothinnkeeper_random_007 = de \
   "~kD'Franko sagt, \"Sobald wir uns um die Orks, die Avar und die "
   "sogenannte menschliche Siedlung in Ko'catan gekümmert haben, muss etwas "
   "bezüglich Jasper getan werden. Das ist ein rebellisches Volk, das zu "
   "Gewalt und Auflehnung neigt. Ihre Geschichte zeigt das sehr deutlich.\""
cornothinnkeeper_random_008 = de \
   "~kD'Franko sagt, \"Diesen Yevitan oben in Jasper muss man im Auge "
   "behalten. Er ist intrigant und schlau, und ich weiß, dass er ~Ietwas~I "
   "vorhat.\""
cornothinnkeeper_random_009 = de \
   "~kD'Franko sagt, \"Die Zeiten, zu denen wir eine Königsfamilie "
   "brauchten, sind ~Ivorüber~I. Das ist nur sentimentaler Unsinn. Nostalgie "
   "und billiger Kitsch. Bah!\""
cornothinnkeeper_random_010 = de \
   "~kD'Franko sagt, \"Ich bin noch nicht auf Konimas Insel gewesen, und ich "
   "sag Dir eins, ich glaube auch nicht, dass ich es will. Aber ich habe ein "
   "paar Waren von diesen ~ILeuten~I gesehen und ich muss sagen, dass ihr "
   "handwerkliches Geschick nicht mit unserem hier in Meridian mithalten "
   "kann.\""
cornothinnkeeper_random_011 = de \
   "~kD'Franko sagt, \"Immer wieder schön, Dich zu sehen.\""
cornothinnkeeper_random_012 = de \
   "~kD'Franko sagt, \"Far'Nohl war ein großer Mann, der bösartig wurde. Er "
   "herrschte vor vielen Jahren über dieses Königreich, bevor sein Verrat "
   "ein böses Ende mit ihm nahm. Doch jetzt geht sein ruheloser Geist wieder "
   "auf der Erde um. Er ist der Inbegriff der Bosheit.\""
cornothinnkeeper_random_013 = de \
   "~kD'Franko sagt, \"Ich habe von einer Reisenden gehört, dass es dort "
   "einen Diktator gibt, der das Inselvolk regiert. Sie behauptet, sie habe "
   "ihn gesehen ... sie sagt, er sei alt und klapprig, doch ein direkter "
   "Nachkomme von Konima selbst!\""
cornothinnkeeper_random_014 = de \
   "~kD'Franko sagt, \"Du liebe Zeit! Wer soll die Armee aufstellen, um die "
   "Orks aufzuhalten? Wir wissen, wo sie sind, aber gibt es eine "
   "Streitmacht, die sie aufhalten kann?\""
cornothinnkeeper_random_015 = de \
   "~kD'Franko sagt, \"Weißt Du, all die Veränderungen im Land, die neue "
   "Fraktion, Jonas, der die Rebellen führt, diese Angriffe auf die "
   "Manaknoten... da fragt man sich, was noch vor uns liegt.\""
cornothinnkeeper_random_016 = de \
   "~kD'Franko sagt, \"Ich bete dafür, dass Kaliors Armee in seiner "
   "Abwesenheit nicht zerbröckelt. Es bräuchte einen starken Führer, um in "
   "seine Fußstapfen zu treten. Wer wird die Unruhen im Volk aufhalten?\""
cornothinnkeeper_random_017 = de \
   "~kD'Franko sagt, \"Ich trauere um den Fall von Kalior. Er war wohl der "
   "Einzige, der in der Lage war, die Bedrohungen, die über dem Land "
   "schweben, aufzuhalten. Gepriesen sei Kalior! Möge die Erinnerung an ihn "
   "ewig leben!\""
cornothinnkeeper_random_018 = de \
   "~kD'Franko sagt, \"Dieses Inselvolk, die sogenannten Anhänger von Konima "
   "... wer sagt, dass sie unsere Verbündeten sind? Was wissen wir denn "
   "eigentlich über sie? Sie sind ein unbekanntes Element und so müssen wir "
   "sie auch behandeln. Man muss sie auf Distanz halten.\""
cornothinnkeeper_random_019 = de \
   "~kD'Franko sagt, \"Diese Artefakte des Rates von Meridian sind wirklich "
   "geheimnisvolle Sachen. Ich habe sogar gehört, dass derjenige, der ein "
   "solches Artefakt mit sich führt, gegen die Auswirkungen des Todes gefeit "
   "ist!\""
cornothinnkeeper_random_020 = de \
   "~kD'Franko sagt, \"Um Deine Fähigkeiten als Krieger zu verbessern, geh "
   "und sprich mit Roluk. Er wohnt hier in Cor Noth, gleich die Straße rauf. "
   "Er ist einer der besten Schwertkämpfer, die je gelebt haben, und ganz "
   "sicher der beste, der dieses Handwerk heute lehrt. Auch wenn seine "
   "Ergebenheit bestenfalls ... suspekt ist.\""
cornothinnkeeper_random_021 = de \
   "~kD'Franko sagt, \"Eine Kneipe ist der beste Ort, um nach einer Reise "
   "oder einem Kampf wieder zu Kräften zu kommen. Du bist hier sicher, und "
   "wir werden uns um alle Deine Wünsche kümmern.\""
cornothinnkeeper_random_022 = de \
   "~kD'Franko sagt, \"Wenn Du gerade erst den Weg des Kriegers "
   "eingeschlagen hast, dann halte Dich erst einmal an Geschöpfe, die nicht "
   "~Izu~I stark sind. Ich begann mit Riesenratten und kleinen Spinnen, ehe "
   "ich zur Armee ging und richtig zu kämpfen lernte.\""
cornothinnkeeper_random_023 = de \
   "~kD'Franko sagt, \"Die Stadtleute in Meridian brauchen oft jemanden, der "
   "Botengänge für sie erledigt oder ihnen einen Gefallen tut. Wenn Du dabei "
   "aushelfen kannst, ist das eine gute Gelegenheit, um die eine oder andere "
   "Belohnung zu bekommen. Von irgendetwas müssen wir schließlich alle "
   "leben.\""
cornothinnkeeper_random_024 = de \
   "~kD'Franko sagt, \"Viele der Stadtleute hier waren einige Zeit in "
   "Abenteuer verstrickt und haben deshalb ~Ibesondere~I Kenntnisse, von "
   "denen Du profitieren könntest. Man muss nur richtig an sie rankommen, um "
   "ihre Ansichten zu erfahren.\""
cornothinnkeeper_random_025 = de \
   "~kD'Franko sagt, \"So weit ich weiß, gibt es jetzt einen fünften Tempel, "
   "in den die Anhänger gehen, um in ihrem Feld der Magie zu lernen. Es "
   "handelt sich dabei um den Riija-Tempel, von dem es lange hieß, er sei "
   "verschwunden, und der sich jetzt auf einer abgelegenen und "
   "geheimnisvollen Insel befinden soll.\""
cornothinnkeeper_random_026 = de \
   "~kD'Franko sagt, \"Ich weiß nicht, wie es Dir geht, aber ich habe "
   "allmählich genug vom überflüssigen Gebrauch von Magie in den Städten. "
   "Ein Zauberer lässt es dunkel werden und dann ist es wieder zu hell durch "
   "die Tricks eines anderen, Streitkolben und Äpfel liegen überall herum "
   "... Bei mir würde ich so etwas nicht dulden, und Du kannst davon "
   "ausgehen, dass der Herzog sich darum kümmert. Das ist Belästigung, ganz "
   "einfach.\""
cornothinnkeeper_random_027 = de \
   "~kD'Franko sagt, \"Als die Geschäfte gut gingen, war jeder glücklich. "
   "Herzog Kalior hielt die Räder am Laufen und das Geld wechselte den "
   "Besitzer. Er war und ist immer noch ein großer Mann.\""
cornothinnkeeper_random_028 = de \
   "~kD'Franko sagt, \"Räuber und Diebe machen das ganze Land unsicher ... "
   "was kommt als Nächstes? Jemand muss diese mordenden, raubenden Schweine "
   "in Schach halten. Faren sei Dank für den Mut derjenigen, die es tun.\""
cornothinnkeeper_random_029 = de \
   "~kD'Franko sagt, \"Ich habe gehört, dass es im Herzen dieser Orkbauten "
   "eine riesige Ansammlung von Schätzen gibt, sollte die eine oder andere "
   "Gruppe von Abenteurern mutig und ausdauernd genug sein, dorthin zu "
   "gelangen.\""
cornothinnkeeper_random_030 = de \
   "~kD'Franko sagt, \"Nicht alle Meinungen sind von gleichem Wert. Manche "
   "Meinungen sind besser als andere Meinungen. Da dies mein Etablissement "
   "ist, ist meine Meinung die beste, die es gibt.\""
cornothinnkeeper_random_031 = de \
   "~kD'Franko sagt, \"Sieh Dir mal die Nachrichtenkugel dort in der Ecke "
   "an, es gibt ein paar interessante Beiträge.\""
cornothinnkeeper_random_032 = de \
   "~kD'Franko sagt, \"Die Barden sind eine große Bereicherung für unsere "
   "Stadt. Immer hilfsbereit und voller Informationen.\""
cornothinnkeeper_random_033 = de \
   "~kD'Franko sagt, \"Diese Tage mit rotem Himmel sind ein merkwürdiges "
   "Ereignis. Ich bleibe hier in der Kneipe, wenn es wieder soweit ist. Hier "
   "ist es sicher.\""
cornothinnkeeper_random_034 = de \
   "~kD'Franko sagt, \"Manch seltsame Berichte kommen von der "
   "geheimnisvollen Insel. Man sagt, dort gibt es eine Rasse von "
   "vogelartigen Männern mit einer ganz eigenen tödlichen Magie.\""
cornothinnkeeper_random_035 = de \
   "~kD'Franko sagt, \"Ich diente in der Armee von Herzog Kalior, als der "
   "Einberufungsbefehl kam. Die leichte Infanterie von Cor Noth, drittes "
   "Bataillon unter General D'Accor. Ich war bei Tangee Bluff mit dabei. Du "
   "hast bestimmt von der Schlacht dort gehört.\""
cornothinnkeeper_random_036 = de \
   "~kD'Franko sagt, \"In meiner Kneipe kann jeder frei seine Meinung "
   "äußern. Du kannst hier alles frei heraussagen unter der Voraussetzung, "
   "dass Du gute Manieren an den Tag legst.\""
cornothinnkeeper_random_037 = de \
   "~kD'Franko sagt, \"Ich könnte Dir ein paar Dinge über den Dritten "
   "Orkfeldzug erzählen, da würden Dir die Haare zu Berge stehen ... aber "
   "ich mag nicht darüber reden. Ich habe zu viel gesehen, sag ich Dir, zu "
   "viel.\""
cornothinnkeeper_random_038 = de \
   "~kD'Franko sagt, \"Ich bin stolz darauf, aus Cor Noth zu stammen. "
   "Bereits in der vierten Generation, und meine Familie kann auf eine lange "
   "Reihe von Pflichterfüllung und Patriotismus zurückschauen.\""
cornothinnkeeper_random_039 = de \
   "~kD'Franko sagt, \"Der Handel hält dieses Land am Leben.\""
cornothinnkeeper_random_040 = de \
   "~kD'Franko sagt, \"Geld. Vielleicht magst Du es nicht, aber Du brauchst "
   "es.\""
cornothinnkeeper_random_041 = de \
   "~kD'Franko sagt, \"Alle sind in der Kneipe zum Bach willkommen und alle "
   "dürfen ihre Meinung frei kundtun. Wir bitten nur darum, dass man den "
   "anderen Gästen zuliebe höflich bleibt.\""
cornothinnkeeper_random_042 = de \
   "~kD'Franko sagt, \"Komm und mach es Dir bequem. Gibt es was Neues von "
   "außerhalb dieser Mauern?\""
cornothinnkeeper_random_043 = de \
   "~kD'Franko sagt, \"Kann ich Dir irgendetwas bringen?\""
cornothinnkeeper_random_044 = de "~kD'Franko sagt, \"Was?\""
cornothinnkeeper_random_045 = de "~kD'Franko sagt, \"Autsch.\""
cornothinnkeeper_random_046 = de \
   "~kD'Franko sagt, \"Muss etwas gewesen sein, das ich gegessen habe.\""
cornothinnkeeper_random_047 = de \
   "~kD'Franko sagt, \"Das verdammte Sodbrennen fängt wieder an.\""
cornothinnkeeper_random_048 = de \
   "~kD'Franko rülpst laut und sagt, \"Entschuldigung.\""
cornothinnkeeper_random_049 = de \
   "~kD'Franko sagt, \"Als Gastwirt kann man sich keine bessere Stadt für "
   "sein Geschäft wünschen als Cor Noth. Mit der Universität hier und all "
   "den Durchreisenden ist an diesem Ort immer was los. Cor Noth ist das "
   "Drehkreuz von Meridian, da gibt es keinen Zweifel.\""
cornothinnkeeper_random_050 = de \
   "~kD'Franko sagt, \"Es ist schön, am Leben zu sein, hier und jetzt.\""
cornothinnkeeper_random_051 = de \
   "~kD'Franko sagt, \"Freut mich, dass Du hier bist.\""
cornothinnkeeper_random_052 = de "~kD'Franko gähnt auffällig."
cornothinnkeeper_random_053 = de "~kD'Franko bohrt abwesend in der Nase."
cornothinnkeeper_random_054 = de \
   "~kD'Franko wischt sich die Stirn und schaut finster drein."
cornothinnkeeper_random_055 = de \
   "~kD'Franko schaut Dich nur an und schüttelt dabei den Kopf."
cornothinnkeeper_random_056 = de "~kD'Franko lässt Dich nicht aus den Augen."
cornothinnkeeper_random_057 = de \
   "~kD'Franko wischt seine Hände an seinem Hemd ab und schaut Dich finster "
   "an."
cornothinnkeeper_random_058 = de "~kD'Franko murmelt zerstreut vor sich hin."
cornothinnkeeper_random_059 = de "~kD'Franko beäugt Dich und spuckt aus."
cornothinnkeeper_random_060 = de "~kD'Franko räuspert sich laut."
cornothinnkeeper_random_061 = de \
   "~kD'Franko sagt, \"Hmpf. Ich glaube, Du solltest gehen.\""
cornothinnkeeper_random_062 = de \
   "~kD'Franko scheppert mit dem Geschirr, während er aufräumt, und ist "
   "merklich ungehalten."
cornothinnkeeper_random_063 = de "~kD'Franko grinst Dich höhnisch an."
cornothinnkeeper_random_064 = de \
   "~kD'Franko sagt, \"Du bist ein Liberaler, nicht wahr!?!\""
cornothinnkeeper_trigger_bye = de "tschüss"
cornothinnkeeper_trigger_council = de "ratsmitglied"
cornothinnkeeper_trigger_duke = de "herzog"
cornothinnkeeper_trigger_fate = de "schicksal"
cornothinnkeeper_trigger_grassy_knoll = de "grashügel"
cornothinnkeeper_trigger_hello = de "hallo"
cornothinnkeeper_trigger_king = de "könig"
cornothinnkeeper_trigger_money = de "geld"
cornothinnkeeper_trigger_need_a_courier = de "brauchst du einen boten?"
cornothinnkeeper_trigger_node_attack = de "quellenangriff"
cornothinnkeeper_trigger_orc = de "ork"
cornothinnkeeper_trigger_princess = de "prinzessin"
cornothinnkeeper_trigger_stunted_dwarf = de "verkümmerter zwerg"

// CorNothSergeant
cornothsergeant_speech_001 = de \
   "~kRoluk sagt, \"Sie sind sehr gefährlich, wenn man den Berichten glauben "
   "kann, die ich hörte. Ich erfuhr, dass die Avaren Armeen aufstellen "
   "können, genau wie wir! Doch ich glaube nicht, dass Du in dieser Gegend "
   "jemals eine solche Streitmacht zu Gesicht bekommen wirst.\""
cornothsergeant_speech_002 = de \
   "~kRoluk sagt, \"Ich wünschte, ich wäre niemals weggegangen, und "
   "verfluche den Tag, an dem ich das erste Mal meinen Fuß in diesen "
   "ausgedörrten Ort setzte. Doch die Entscheidung lag nicht bei mir, musst "
   "Du wissen. Mit der Zeit müssen wir alle unseren Meistern gehorchen. Und "
   "genauso wichtig, denen, die unsere Meister beraten.\""
cornothsergeant_speech_003 = de \
   "~kRoluk sagt, \"Es gibt keinen schöneren Ort auf der Welt als das "
   "königliche Barloque. Bei meinem Leben, den gibt es nicht.\""
cornothsergeant_speech_004 = de \
   "~kRoluk sagt, \"Ihr seid es nicht wert, den Namen überhaupt "
   "auszusprechen, Schurke. Verschwindet, kümmert Euch um Eure eigenen "
   "Angelegenheiten.\""
cornothsergeant_speech_005 = de "~kRoluk sagt, \"Lebe wohl, mein Freund.\""
cornothsergeant_speech_006 = de "~kRoluk sagt, \"Guten Tag.\""
cornothsergeant_speech_007 = de \
   "~kRoluk sieht Dir sehr aufmerksam nach, als Du gehst."
cornothsergeant_speech_008 = de \
   "~kRoluk sagt, \"Ich bin noch keinem Höhlenork begegnet, doch Du kannst "
   "sicher sein, dass die genauso gefährlich sind wie ihre Verwandtschaft in "
   "den Bergen südlich von hier.\""
cornothsergeant_speech_009 = de \
   "~kRoluk sagt, \"Cor Noth ist strategisch in einer starken Position. Es "
   "liegt in der Flanke jedes Angriffs auf Barloque, der von Tos oder aus "
   "den dahinter liegenden Bergen kommen könnte. Es ist kein Zufall, dass "
   "ich diesen Ort für mein ~Ivorübergehendes~I Exil gewählt habe.\""
cornothsergeant_speech_010 = de \
   "~kRoluk sagt, \"Es ist eine schöne Provinzstadt. Angemessen für meine "
   "Schule, doch ich muss sagen, dass sie von Bücherwürmern und Dummköpfen "
   "dominiert wird.\""
cornothsergeant_speech_011 = de \
   "~kRoluk sagt, \"Geh hinaus und sieh es Dir an, Schurke.\""
cornothsergeant_speech_012 = de \
   "~kRoluk sagt, \"Alte Männer. Welchen Platz haben wir in der derzeitigen "
   "Situation für eine lahme Gesellschaft von zahnlosen wie geistig "
   "umnachteten Gestalten? Nimm sie mit auf eine lange Reise und komm allein "
   "zurück. Darüber wäre ich sehr glücklich.\""
cornothsergeant_speech_013 = de \
   "~kRoluk sagt, \"Einst wurden sie respektiert. Bestimmt. Doch meiner "
   "Meinung nach ist es Zeit, dass sie nur noch eine beratende Funktion "
   "ausüben und durch jüngere, forscher denkende Bürger ersetzt werden.\""
cornothsergeant_speech_014 = de "~kRoluk sagt, \"Flieh, Narr. Lauf davon.\""
cornothsergeant_speech_015 = de \
   "~kRoluk sagt, \"Ein ehrenhafter Offizier und ein Veteran mit einer "
   "einwandfreien Laufbahn. Doch er ist auf der falschen Seite und dient in "
   "der Armee des Herzogs. Ich fürchte, dass wir uns eines Tages im Kampf "
   "begegnen.\""
cornothsergeant_speech_016 = de \
   "~kRoluk sagt, \"Höchst bemerkenswert, wenn das wahr ist, was man so "
   "hört! Du wirst jedoch keine Drachenfliege auf dem Festland von Meridian "
   "antreffen. Sie sind auf Konimas Insel beschränkt.\""
cornothsergeant_speech_017 = de \
   "~kRoluk sagt, \"Ich schätze, ich habe die Chance verpasst, das Schwein "
   "eigenhändig zu erlegen.\""
cornothsergeant_speech_018 = de \
   "~kRoluk sagt, \"Dieser Akardius lässt mir die Haare im Nacken zu Berge "
   "stehen. Jemand sollte ihn überwachen.\""
cornothsergeant_speech_019 = de \
   "~kRoluk sagt, \"Was für eine Verschwendung! All diese Jahre wurde um den "
   "Thron gewetteifert. Wieso konnte er nicht schon vor Jahren sterben und "
   "Kateriinas rechtmäßige Thronbesteigung erleichtern?\""
cornothsergeant_speech_020 = de \
   "~kRoluk sagt, \"Tretet ein. Es ist mir eine Freude, Euch wiederzusehen.\""
cornothsergeant_speech_021 = de "~kRoluk sagt, \"Guten Tag, %s.\""
cornothsergeant_speech_022 = de \
   "~kRoluk schaut Dich an, während er langsam die Fingerspitzen über seiner "
   "Oberlippe vor und zurück bewegt."
cornothsergeant_speech_023 = de \
   "~kRoluk sagt, \"Seit Anbeginn der Zeit ein Stachel im Fleisch dieses "
   "Königreiches, haben die Einwohner von Jasper mehr Feldzüge gegen den "
   "Thron angezettelt als alle Horden der Orks zusammen.\""
cornothsergeant_speech_024 = de \
   "~kRoluk sagt, \"Ein aufrührerischer Ort und ein zähes Volk, geborene "
   "Partisanen. Gute Soldaten.\""
cornothsergeant_speech_025 = de \
   "~kRoluk sagt, \"Für solches Gerede habe ich keine Zeit.\""
cornothsergeant_speech_026 = de \
   "~kRoluk schnaubt verächtlich, \"Pah, was kommt als nächstes? König "
   "Jonas? HAH! Dieser flennende Hanswurst könnte nicht mal eine Armee "
   "hirntoter Trolle anführen, geschweige denn seine eigene Fraktion.\""
cornothsergeant_speech_027 = de \
   "~kRoluk sagt, \"Er ist etwas verschwiegener geworden. Ich hörte auch, "
   "dass er häufiger umherwandert.... Ich frage mich, was er vorhat.\""
cornothsergeant_speech_028 = de \
   "~kRoluk sagt, \"Selbst jetzt sammeln sich seine Streitkräfte in "
   "Erwartung des kommenden Kampfes.\""
cornothsergeant_speech_029 = de \
   "~kRoluk sagt, \"Ich habe dieses Monster noch nie gesehen, denn es lebt "
   "weit weg von hier im Dschungel auf Konimas Insel.\""
cornothsergeant_speech_030 = de \
   "~kRoluk sagt, \"Es gibt nur eine einzige Möglichkeit, den Lupoggkönig "
   "anzugreifen, und zwar in großen Scharen. Schicke verschiedene, einzeln "
   "angeführte Gruppen los, um den Kampf aufzunehmen, und zieh jene Krieger "
   "zurück, die verwundet werden.\""
cornothsergeant_speech_031 = de \
   "~kRoluk sagt, \"Die Königstreuen haben viele loyale Verbündete in "
   "Marion. Die Mannschaften jeder Königsarmee sind in jedem Krieg in der "
   "Geschichte dieses Landes von Marion aus unter dem Banner der Familie "
   "Zarcos marschiert. Das Volk von Marion hält sogar jetzt zum König.\""
cornothsergeant_speech_032 = de \
   "~kRoluk sagt, \"Eine schöne Stadt. Stets treu, stets tapfer, stets "
   "stark.\""
cornothsergeant_speech_033 = de "~kRoluk sagt, \"Pah.\""
cornothsergeant_speech_034 = de "~kRoluk sagt, \"Ein ausgemachter Narr.\""
cornothsergeant_speech_035 = de \
   "~kRoluk sagt, \"Ein treuer Verbündeter des Königs.\""
cornothsergeant_speech_036 = de \
   "~kRoluk sagt, \"Nur der mächtigste Krieger sollte seine Fähigkeiten im "
   "Einzelkampf mit dem Ork-Grubenboss messen, denn er ist unfassbar schnell "
   "und stärker als zwei Männer.\""
cornothsergeant_speech_037 = de \
   "~kRoluk sagt, \"Nur der mächtigste Krieger sollte seine Fähigkeiten im "
   "Einzelkampf mit dem Ork-Grubenboss messen, denn er ist unfassbar schnell "
   "und stärker als zwei Männer.\""
cornothsergeant_speech_038 = de \
   "~kRoluk sagt, \"Den Ork-Zauberer findest Du in den Grotten und "
   "unterirdischen Gängen der Ork-Höhlen. Sie besitzen mächtige Magie, aber "
   "ihre Stärke kann ich nicht einschätzen.\""
cornothsergeant_speech_039 = de \
   "~kRoluk sagt, \"Dieser Maid habe ich mein Leben gewidmet und warte nun "
   "auf die Gelegenheit, meine Stärke auf die Probe zu stellen. Ich weiß, "
   "dass sie mich wegschicken musste, genau so wie ich weiß, dass die Zeit "
   "kommen wird, in der sie meine treuen Dienste wieder benötigen wird. Ich "
   "warte auf diese Zeit und übe meine Fertigkeiten.\""
cornothsergeant_speech_040 = de \
   "~kRoluk sagt, \"Ich grüße Dich! Welche Neuigkeiten von der holden Dame "
   "bringst Du mir?\""
cornothsergeant_speech_041 = de \
   "~kRoluk sagt, \"Ihr habt nicht die Ehre, solch einen edlen Namen in den "
   "Mund zu nehmen, ohne ihn zu besudeln. Geh mir aus den Augen, Narr, bevor "
   "ich Dir die Eingeweide durchbohre und Dich wie den Hund, der Du bist, "
   "verrecken lasse.\""
cornothsergeant_speech_042 = de \
   "~kRoluk sagt, \"Denke ich, dass sie eine Bedrohung sind? Ich kann über "
   "sie nur lachen. Ihr Hauptquartier liegt in einer Kneipe.\""
cornothsergeant_speech_043 = de \
   "~kRoluk sagt, \"In Wahrheit ist dieser Regifan keine Bedrohung für "
   "Mensch oder Tier. Er ist ein Nagetier mit Ideen. Ich sehe keinen großen "
   "Nutzen in Akademikern, Intellektuellen und ihresgleichen, denn ich habe "
   "genug ihrer Theorien gehört, warum es diesem Land schlecht geht.\""
cornothsergeant_speech_044 = de \
   "~kRoluk sagt, \"Natürlich habe ich gespielt, als ich jünger war... ich "
   "war Verbindungsmann auf der Akademie und für Barloque. Doch heute kann "
   "ich nicht mehr spielen, weil diese Hooligans aus Marion mir bei einem "
   "unfairen Tackle das Rückgrat gebrochen haben.\""
cornothsergeant_speech_045 = de \
   "~kRoluk sagt, \"Ich habe gehört, dass die Schattenbestie die Fähigkeit "
   "hat, ihre Umgebung zu verdunkeln. Ich bin noch nie so einem Wesen "
   "begegnet, aber ich weiß, dass sie ein gewaltiger Gegner ist.\""
cornothsergeant_speech_046 = de \
   "~kRoluk sagt, \"Ich nehme Schüler nach Bedarf an.\""
cornothsergeant_speech_047 = de \
   "~kRoluk sagt, \"Eine Lasterhöhle. Wir werden es noch erleben, dass Tos "
   "niedergebrannt, belagert und mit dem Schwert erobert wird. Du hast mein "
   "Wort als Ehrenmann darauf.\""
cornothsergeant_speech_048 = de \
   "~kRoluk sagt, \"Das Geschäftszentrum von Meridian. Muss ich mehr dazu "
   "sagen? Natürlich habe ich nicht viele Gelegenheiten, dorthin zu reisen.\""
cornothsergeant_speech_049 = de \
   "~kRoluk sagt, \"Hohlkopf. Geh und ärgere jemand anderen oder ich lasse "
   "Dich von einem meiner Schüler ins Jenseits befördern.\""
cornothsergeant_speech_050 = de \
   "~kRoluk sagt, \"Ha ha ha ha ha! Was ist das? Wo? Ultra was?\""
cornothsergeant_random_001 = de \
   "~kRoluk sagt, \"König Zarcos lebt. Er versteckt sich irgendwo in "
   "Barloque und jetzt ist die Zeit für ihn gekommen, um zurückzukehren.\""
cornothsergeant_random_002 = de \
   "~kRoluk sagt, \"Ich lebe nach den Gesetzen der Ehre und der Klinge. Es "
   "gibt keine Frage, die sich nicht mit diesen heiligen Gesetzen lösen "
   "ließe.\""
cornothsergeant_random_003 = de \
   "~kRoluk ist ganz offensichtlich ein kleiner Mann mit einem übermäßig "
   "ausgeprägten Ego."
cornothsergeant_random_004 = de \
   "~kRoluk sagt, \"Ihr haltet Euch für einen Schwertkämpfer? Vielleicht "
   "könnte ich Euch in Eurer Disziplin ein wenig anleiten, wenn Ihr genug "
   "Übung habt und bereit seid, Fortschritte zu machen.\""
cornothsergeant_random_005 = de \
   "~kRoluk sagt, \"Arbeitet Ihr also mit der Streitaxt, um ihre Finessen zu "
   "meistern? Auch ich habe mein Leben den Kampffertigkeiten und ihrer "
   "Vervollkommnung geweiht und verdiene mein Geld nun damit, das zu lehren, "
   "was ich kann. Wenn Ihr bereit seid, mehr Fertigkeiten zu lernen, dann "
   "helfe ich Euch vielleicht, gegen einen Preis.\""
cornothsergeant_random_006 = de \
   "~kRoluk sagt, \"Wenn Ihr ein Anhänger des Bogenschießens seid, dann seid "
   "Ihr an den falschen Ort gekommen, denn ich weiß nichts über diese Waffe, "
   "außer, dass diejenigen, die mit dem Bogen kämpfen, ohne Ehre sind. Wenn "
   "Ihr ein Anhänger des Bogenschießens seid, dann schließt Euch Schurken "
   "und Wegelagerern an, denn die sind es, die solch eine Waffe benutzen.\""
cornothsergeant_random_007 = de \
   "~kRoluk sagt, \"Ist der Streitkolben Eure bevorzugte Waffe? Es ist eine "
   "ehrenhafte Waffe und eine tödliche dazu in den Händen desjenigen, der "
   "versteht, sie zu meistern.\""
cornothsergeant_random_008 = de \
   "~kRoluk sagt, \"Bei den traditionellen Waffen schätze ich das "
   "Langschwert am meisten. Es ist die Hauptstütze der Armee des Königs und "
   "aus diesem Grund habe ich den besten Teil meines Lebens der "
   "Vervollkommnung meiner Fähigkeiten an dieser Waffe gewidmet.\""
cornothsergeant_random_009 = de \
   "~kRoluk sagt, \"Die Magie ist die Waffe der Priester, der Schwachen und "
   "Blinden. Wahrlich, die Magie ist die Waffe derjenigen, die ohne Mut "
   "sind, mit Ehre und Würde zu kämpfen.\""
cornothsergeant_random_010 = de \
   "~kRoluk sagt, \"Für den wagemutigen Reisenden gibt es häufig "
   "Botschaften, die zwischen den Parteien über das ganze Land transportiert "
   "werden müssen. Ihr werdet bestimmt Wohlwollen erlangen und häufig "
   "Gewinne machen, wenn Ihr den Gesandten spielt.\""
cornothsergeant_random_011 = de \
   "~kRoluk sagt, \"Das Kurzschwert ist eine ehrenvolle Waffe. Es ist die "
   "Waffe der ehemaligen Gladiatoren von Tos. Wegen seiner Reichweite kann "
   "es nicht gegen das Langschwert ankommen, doch es ist tödlich auf kurze "
   "Distanz.\""
cornothsergeant_random_012 = de \
   "~kRoluk sagt, \"Bald wird es zu Auseinandersetzungen zwischen den "
   "streitenden Parteien kommen. Gewalttätigen Auseinandersetzungen...\""
cornothsergeant_random_013 = de \
   "~kRoluk sagt, \"Wenn Du Deine Fertigkeiten als Krieger verbessern "
   "möchtest, dann musst Du gegen Gegner kämpfen, die es wert sind, die "
   "sogar jenseits Deiner Fähigkeiten liegen.\""
cornothsergeant_random_014 = de \
   "~kRoluk sagt, \"Du wirst keine Fortschritte machen, wenn Du nicht "
   "gewillt bist, Risiken einzugehen. Wenn Du stärker werden willst, musst "
   "Du großen Gefahren gegenübertreten und bereit sein, verletzt zu werden.\""
cornothsergeant_random_015 = de \
   "~kRoluk sagt, \"Alle Dinge deuten darauf hin, dass Kateriina den Thron "
   "jetzt einnehmen muss. Sie ist im richtigen Alter, Kalior weilt nicht "
   "mehr unter uns und Akardius, dieser Politiker-Neuling, ist nicht würdig, "
   "das Land zu regieren.\""
cornothsergeant_random_016 = de \
   "~kRoluk sagt, \"Ihr seid gekommen, um den besten Schwertmeister zu "
   "suchen, der dieses Land je beehrt hat, und nun steht Ihr vor ihm. Was "
   "ist Eure untertänige Bitte?\""
cornothsergeant_random_017 = de \
   "~kRoluk sagt, \"Es gibt ein paar Krieger, die Trost beim mächtigen "
   "Kraanan suchen. Sie haben in seinem mächtigen Namen Zaubersprüche, "
   "Tränke und Zauberstäbe entwickelt ... ich bin sicher, dass Kraanan "
   "selbst über diese Schwächlinge und ihre Unfähigkeit, eine Klinge zu "
   "führen, erzürnt ist. Ein Krieger hat nicht die Zeit, während des Kampfes "
   "zu beten.\""
cornothsergeant_random_018 = de \
   "~kRoluk sagt, \"Auf welcher Seite steht Ihr, Freund? Barloque oder Tos? "
   "Wenn Ihr aus dem Lager des Herzogs kommt, dann tragt Euer Anliegen vor "
   "und wir werden uns jetzt darum kümmern. Wenn Ihr jedoch auf der Seite "
   "der Prinzessin steht, dann seid herzlich willkommen und seht mein Haus "
   "als das Eure an.\""
cornothsergeant_random_019 = de \
   "~kRoluk sagt, \"Wenn ein Mann den Tod nicht fürchtet, bringt es nichts, "
   "ihm zu drohen.\""
cornothsergeant_random_020 = de \
   "~kRoluk sagt, \"Die höchste Ehre eines Kriegers ist es, den Zeitpunkt "
   "und den Ort seines Todes selbst zu bestimmen.\""
cornothsergeant_random_021 = de \
   "~kRoluk sagt, \"Übung, Übung, Übung. Das ist das ganze Geheimnis eines "
   "jeden großen Kriegers.\""
cornothsergeant_random_022 = de \
   "~kRoluk sagt, \"Der Schild ist recht nützlich, und wenn Ihr mit einem "
   "kämpft, dann wählt den Euren sorgfältig aus.\""
cornothsergeant_random_023 = de \
   "~kRoluk sagt, \"Die großen Yetis aus den Eishöhlen im Westen stellen "
   "selbst für die erfahrensten Kämpfer eine Herausforderung dar.\""
cornothsergeant_random_024 = de \
   "~kRoluk sagt, \"Die Orks sind mächtige Kämpfer, doch fehlt es ihnen an "
   "Finesse, die nur ein langes Training vermitteln kann. Doch unterschätze "
   "sie nicht. Du könntest für diesen Fehler mit Deinem Leben bezahlen.\""
cornothsergeant_random_025 = de \
   "~kRoluk sagt, \"Ja, ich bin der größte Schwertkämpfer, den es jemals "
   "gab. Der größte.\""
cornothsergeant_random_026 = de \
   "~kRoluk sagt, \"Wähle Deine Kämpfe sorgfältig aus. Du wirst Deine Feinde "
   "für immer behalten, denn die stärksten von ihnen werden nie vergeben "
   "oder vergessen.\""
cornothsergeant_random_027 = de \
   "~kRoluk sagt, \"Du darfst vor ~Ikeinem~I Kampf zurückweichen, gegen "
   "~Ijeden~I Widersacher. Gib niemals nach und gib keinen Fußbreit Boden "
   "preis. Selbst wenn Du getötet wirst, dann mit Deinem Stolz.\""
cornothsergeant_random_028 = de \
   "~kRoluk sagt, \"Halte Deine Sinne geschärft und sei Deinen Gegnern immer "
   "um zwei Schritte voraus. Durch Strategie und Fertigkeit wirst Du Dich "
   "sogar gegen den stärksten Feind durchsetzen, der nur seine "
   "Waffenfertigkeit ins Spiel bringt.\""
cornothsergeant_random_029 = de \
   "~kRoluk sagt, \"Du stehst vor einem Meister. Verbeuge Dich.\""
cornothsergeant_random_030 = de \
   "~kRoluk sagt, \"Bringt die zehn talentiertesten Schwertkämpfer dieses "
   "Landes zusammen und lasst sie alle auf einmal gegen mich antreten. Ich "
   "werde Euch zehn Leichen liefern, zehn kopflose Bauern, und selbst ohne "
   "einen Kratzer sein.\""
cornothsergeant_random_031 = de \
   "~kRoluk ist ein Mann mit einem schon sprichwörtlich gewordenen "
   "Temperament und dem Ruf des größten Duellanten seiner Zeit."
cornothsergeant_random_032 = de \
   "~kRoluk hat das Benehmen eines gepflegten Armeeoffiziers, obwohl unter "
   "seinen tadellosen Manieren das Temperament eines rasenden Trolls steckt."
cornothsergeant_random_033 = de \
   "~kRoluk sagt, \"Was kann ich heute für Dich tun?\""
cornothsergeant_random_034 = de \
   "~kRoluk trommelt mit seinen Fingern rhythmisch auf den Rücken seiner "
   "linken Hand."
cornothsergeant_random_035 = de "~kRoluk mustert Dich kühl."
cornothsergeant_random_036 = de \
   "~kRoluk steht sehr, sehr gerade und beobachtet jede Deiner Bewegungen."
cornothsergeant_random_037 = de \
   "~kRoluk strahlt eine Anmut und Gewandtheit aus, die jedem in seiner Nähe "
   "sofort auffällt."
cornothsergeant_random_038 = de \
   "~kWenn man vor diesem kleinen Mann steht, versteht man, warum er den Ruf "
   "hat, der tödlichste lebende Schwertkämpfer zu sein. Jede seiner "
   "Bewegungen ist sorgfältig und fließend."
cornothsergeant_random_039 = de \
   "~kRoluk sagt, \"Wenn Ihr Euch mit genauso viel Begeisterung der "
   "Kampfkunst widmet, wie Ihr Euch in bedeutungslosem Geschwätz ergeht, "
   "dann werdet Ihr sicherlich ein Riese sein.\""
cornothsergeant_random_040 = de \
   "~kRoluk sagt, \"Der Säbel der Orks ist eine unhandliche Waffe, schwer "
   "und nicht ausgewogen. Er ist bestimmt nicht die Waffe für einen "
   "Offizier, obwohl er in den Händen eines geübten Kämpfers eine recht "
   "furchteinflößende Waffe ist. Es gibt hier welche, die einen Krieger "
   "diese Fähigkeiten lehren könnten. Ich selbst jedoch nicht.\""
cornothsergeant_random_041 = de \
   "~kRoluk sagt, \"Sieh Deinem Feind stets in die Augen, wenn der Kampf "
   "näherrückt, und auch während des Kampfes. Wende Deinen Blick nicht auf "
   "seine Hände, sein Schwert oder irgendeine Ablenkung, zu der er Dich "
   "verleiten will. Der Kampf wird durch seine Augen gewonnen oder verloren "
   "werden.\""
cornothsergeant_random_042 = de \
   "~kRoluk sagt, \"Der Schwertkämpfer bestimmt den Tag. Oder die "
   "Schwertkämpferin, denn viele der besten Krieger im Lande sind Frauen, "
   "wie ich wissen muss, denn sie alle kommen durch diese Tür und suchen den "
   "Rat des ~IMeisters~I.\""
cornothsergeant_random_043 = de \
   "~kRoluk sagt, \"Soviel ich weiß, gibt es im fernen Land von Ko'catan "
   "einen großen Lehrer, der die Kunst des Bogenschießens lehrt. Eine "
   "fantastische Waffe bei der Jagd, aber ich kann wahrlich nicht sagen, "
   "dass ein Krieger sie mit Ehre auf dem Gefechtsfeld einsetzen würde.\""
cornothsergeant_random_044 = de \
   "~kRoluk sagt, \"Solltet Ihr wünschen, Euch dem Säbel zuzuwenden, dann "
   "könnte es dort in Jasper einen Mann geben, soviel ich gehört habe, den "
   "man überreden könnte, Euch dabei zu helfen. Mir ist zu Ohren gekommen, "
   "dass es dort einen Lehrer mit großen Fähigkeiten bezüglich der Orkwaffe "
   "gibt.\""
cornothsergeant_random_045 = de \
   "~kRoluk sagt, \"Die Zukunft dieses Landes ist wie eine Karte, auf der "
   "anstelle von Meilensteinen Schwerter stecken. Es ist eine Karte, auf der "
   "die aufgetürmten Leichen der Feinde der Krone wie breite Straßenlinien "
   "den Weg der heldenhaften Streitkräfte von Prinzessin Kateriina "
   "markieren.\""
cornothsergeant_random_046 = de \
   "~kRoluk sagt, \"Ich bin nur der Krone und der Linie der Zarcos gegenüber "
   "loyal, einer Familie von höchst königlicher Geburt. In direkter Linie "
   "regiert sie dieses schöne Land seit zweieinhalb Jahrhunderten, und "
   "dieses Blut lebt nun in der rechtmäßigen Erbin Kateriina fort. Niemand "
   "wird dieses Recht mit dem Schwert herausfordern, solange ich stehe.\""
cornothsergeant_random_047 = de \
   "~kRoluk sagt, \"Allein bei Duellen tötete ich vierundzwanzig Männer. "
   "Glaubst Du, Du lebst nach Ehre? Nach Ritterlichkeit? Es liegt an Dir, "
   "wie Du leben und wie Du sterben willst. Wenn Du mit Würde und Ehre "
   "lebst, dann hat der Tod keine Bedeutung.\""
cornothsergeant_random_048 = de "~kRoluk scheint leicht kränkbar zu sein."
cornothsergeant_random_049 = de \
   "~kRoluk sagt, \"Euer Karma wird viel tiefgreifender beeinflusst, wenn "
   "Ihr einen anderen Menschen tötet, als wenn Ihr ein Tier erlegt.\""
cornothsergeant_random_050 = de \
   "~kRoluk sagt, \"Einen gewaltigen Feind wie den Lupoggkönig solltet Ihr "
   "nur in ausreichender Anzahl angreifen, um viele Schläge austeilen zu "
   "können - oder es ist Euer endgültiges Verderben.\""
cornothsergeant_random_051 = de \
   "~kRoluk sagt, \"Merkt Euch das: wenn jemand durch Zauberei angegriffen "
   "wird, schützt Euch die Festigkeit Eurer Waffen und Eurer Rüstung, falls "
   "Eure Ausstattung stark genug ist.\""
cornothsergeant_random_052 = de "~kRoluk sagt, \"Lass mich allein.\""
cornothsergeant_random_053 = de \
   "~kRoluk sagt, \"Ich habe keine Zeit für Dich. Verlasse diesen Ort.\""
cornothsergeant_random_054 = de \
   "~kRoluk sagt, \"Unsere Unterhaltung ist zu Ende. Lass mich jetzt "
   "allein.\""
cornothsergeant_random_055 = de \
   "~kRoluk murmelt, \"Unverschämter Emporkömmling! Die Macht ist jetzt so "
   "wichtig für ihn, dass er entschlossen ist, andere mit sich in den "
   "Untergang zu reißen.\""
cornothsergeant_random_056 = de "~kRoluk ignoriert Dich ganz bewusst."
cornothsergeant_random_057 = de \
   "~kRoluk sagt, \"Packt Euch. Ich bin der Last Eurer Gesellschaft "
   "überdrüssig und meine Geduld geht zu Ende.\""
cornothsergeant_random_058 = de \
   "~kRoluk sagt, \"Ich habe keine Zeit, sie mit Deinesgleichen zu "
   "verschwenden. Hinfort mit Dir.\""
cornothsergeant_random_059 = de \
   "~kRoluk sagt, \"Ihr wollt mich nicht verärgern, dessen könnt Ihr sicher "
   "sein. Geht, bevor Ihr mein Temperament zu spüren bekommt, Spitzbube.\""
cornothsergeant_random_060 = de \
   "~kRoluk sagt, \"Geh zurück zu Deinem Herzog und sag ihm, er solle seine "
   "Diener in seinem Haus behalten, wo sie sich nicht verletzen. Wenn Du "
   "hier bleibst, kann ich nicht für Deine Sicherheit garantieren, Sklave. "
   "Geht heim zu Eurer Mami.\""
cornothsergeant_random_061 = de \
   "~kRoluks Augen werden zu schmalen Schlitzen, während er Dich giftig "
   "mustert."
cornothsergeant_random_062 = de \
   "~kRoluk nickt langsam mit dem Kopf, während er Deinen Bewegungen durch "
   "den Raum folgt."
cornothsergeant_random_063 = de "~kRoluk kocht vor Wut."
cornothsergeant_trigger_bye = de "tschüss"
cornothsergeant_trigger_cave_orc = de "höhlenork"
cornothsergeant_trigger_council = de "ratsmitglied"
cornothsergeant_trigger_council_2 = de "hof"
cornothsergeant_trigger_cylill = de "zylill"
cornothsergeant_trigger_zylill = de "cylill"
cornothsergeant_trigger_dragonfly = de "drachenfliege"
cornothsergeant_trigger_duke = de "herzog"
cornothsergeant_trigger_hello = de "hallo"
cornothsergeant_trigger_king_zarcos = de "könig zarcos"
cornothsergeant_trigger_lupogg_king = de "lupogg könig"
cornothsergeant_trigger_lupogg_king_2 = de "lupoggkönig"
cornothsergeant_trigger_orc_chieftain = de "ork-häuptling"
cornothsergeant_trigger_orc_pitboss = de "ork-grubenboss"
cornothsergeant_trigger_orc_wizard = de "ork-zauberer"
cornothsergeant_trigger_princess = de "prinzessin"
cornothsergeant_trigger_rebels = de "rebellen"
cornothsergeant_trigger_regifan_du_bukise = de "hagen"
cornothsergeant_trigger_hagen = de "regifan du bukise"
cornothsergeant_trigger_shadowbeast = de "schattenbestie"
cornothsergeant_trigger_teach = de "lehren"

// CorNothTailor
cornothtailor_speech_001 = de \
   "~kHester Gilk sagt, \"Barloque ist eine Art, äh, eine Art leere Hülle "
   "von einer Stadt, fast das perfekte Abbild des Zustandes der "
   "Regierungsangelegenheiten hier in Meridian. Nichts ist übrig als der "
   "äußere Prunk des Königtums. Ein paar, äh, ein paar Überreste "
   "verfallender Pracht. Na und.\""
cornothtailor_speech_002 = de \
   "~kHester Gilk sagt, \"Das Meer bei Barloque ist sehr schön. Nur die "
   "Stadt selber finde ich ein bisschen, äh, trocken.\""
cornothtailor_speech_003 = de \
   "~kHester Gilk sagt, \"Ich habe nicht oft, äh, Gelegenheit, nach Barloque "
   "zu reisen.\""
cornothtailor_speech_004 = de \
   "~kHester Gilk sagt, \"Auf Wiedersehen. Sei vorsichtig.\""
cornothtailor_speech_005 = de \
   "~kHester Gilk sagt, \"Ah ja, auf Wiedersehen.\""
cornothtailor_speech_006 = de \
   "~kHester Gilk beobachtet Dich kurz und wendet sich dann wieder ihrer "
   "Näharbeit zu."
cornothtailor_speech_007 = de \
   "~kHester Gilk sagt, \"Cor Noth ist die Stadt meines Exils. Ich halte Cor "
   "Noth von allen Städten Meridians für die angenehmste, doch es ist nicht "
   "die Heimat, die ich zurückgelassen habe. Ich habe hier viel zu tun.\""
cornothtailor_speech_008 = de \
   "~kHester Gilk sagt, \"Ja, dies ist, äh, dies ist ein schöner Ort, mein "
   "neues Heim. Ich wurde sehr herzlich empfangen. Man könnte sagen, dass "
   "ich dankbar bin.\""
cornothtailor_speech_009 = de \
   "~kHester Gilk sagt, \"Nun, ich bin noch nicht lange genug hier, um mir "
   "in dieser oder jener Hinsicht eine Meinung gebildet zu haben.\""
cornothtailor_speech_010 = de \
   "~kHester Gilk sagt, \"Eine Veränderung ist überfällig. Unser derzeitiges "
   "Regierungssystem ist veraltet und im Schwinden begriffen. Und ihre "
   "Pläne, diesen Zustand zu verbessern, sind schlimmer, als Du es Dir "
   "überhaupt vorstellen kannst.\""
cornothtailor_speech_011 = de \
   "~kHester Gilk sagt, \"Der Rat? Soweit ich weiß, sind das sehr weise und "
   "ehrwürdige Männer.\""
cornothtailor_speech_012 = de \
   "~kHester Gilk sagt, \"Dummes Zeug, was gibt ihnen das Recht, zu glauben, "
   "sie könnten das Volk besser regieren als das Volk selbst. Arrogante "
   "Spieler in einem Spiel, das sie nicht selbst geschaffen haben. Sie "
   "fürchten sich vor dem Wandel, merk Dir meine Worte.\""
cornothtailor_speech_013 = de \
   "~kHester Gilk sagt, \"Ich verschicke meinen Faden, um ihn von anderen "
   "durchschneiden zu lassen. Mein Handwerk ist das Weben, das Schneiden "
   "überlasse ich jemand anders, jemandem, der besser dafür geeignet ist.\""
cornothtailor_speech_014 = de \
   "~kHester Gilk sagt, \"D'Franko ist über den Tod von Herzog Kalior "
   "sicherlich bestürzt.\""
cornothtailor_speech_015 = de \
   "~kHester Gilk sagt, \"Es scheint so, dass sogar jetzt, wo Kalior tot "
   "ist, seine Pläne, den Thron zu erobern, Meridian in einen Bürgerkrieg "
   "stürzen könnten.\""
cornothtailor_speech_016 = de \
   "~kHester Gilk sagt, \"Welcher? Der tote oder der lebendige?\""
cornothtailor_speech_017 = de \
   "~kHester Gilk blickt Dich seltsam an, \"Hmm, und was weißt ~IDu~I schon "
   "über das Schicksal, liebes Kind?\""
cornothtailor_speech_018 = de \
   "~kHester Gilk sagt, \"Wer kann schon sagen, was hinter den Grenzen des "
   "uns Bekannten liegt. Die großen Bibliotheken haben auch nicht alle "
   "Antworten. Kannst Du Dir auch nur im Geringsten vorstellen, was uns in "
   "diesen Geschichten nicht erzählt wird?\""
cornothtailor_speech_019 = de \
   "~kHester Gilk sagt, \"Man darf nie vergessen, dass die Geschichte von "
   "Siegern geschrieben wird und dass die Erinnerungen von Gefühlen "
   "verfälscht werden.\""
cornothtailor_speech_020 = de \
   "~kHester Gilk sagt, \"Denke immer daran, dass die Geschichte von den "
   "Siegern geschrieben wird. Wären die derzeitigen Götter die Sieger, was "
   "glaubst Du, welche Erzählung würden sie verheimlichen wollen?\""
cornothtailor_speech_021 = de \
   "~kHester Gilk sagt, \"Hallo. Kann ich Dir etwas zeigen?\""
cornothtailor_speech_022 = de "~kHester Gilk sagt, \"Ja, hallo.\""
cornothtailor_speech_023 = de \
   "~kHester Gilk nickt, ohne von ihrer Näharbeit aufzublicken."
cornothtailor_speech_024 = de \
   "~kHester Gilk sagt, \"Man könnte sagen, dass mich eine "
   "Seelenverwandtschaft mit Jasper und den Einwohnern von Jasper verbindet. "
   "Wie ich haben auch die Einwohner von Jasper den Missbrauch der Macht "
   "über ihren Geist und ihre Unabhängigkeit ertragen. Man könnte auch "
   "sagen, dass ich in ihren Daseinskampf und ihre Zukunft verwickelt bin.\""
cornothtailor_speech_025 = de \
   "~kHester Gilk sagt, \"Ich habe seit Kurzem viele Freunde in Jasper. Die "
   "Leute dort haben viel Ärger, viele Hürden zu überwinden.\""
cornothtailor_speech_026 = de \
   "~kHester Gilk sagt, \"Ich habe viele alte Freunde in Jasper. Die Leute "
   "dort haben viel Ärger, viele Hürden zu überwinden.\""
cornothtailor_speech_027 = de \
   "~kHester Gilk sagt, \"Ich weiß nichts über diesen Ort.\""
cornothtailor_speech_028 = de \
   "~kHester Gilk sagt, \"Soweit ich weiß, ist es eine malerische Stadt, "
   "obwohl ich zugeben muss, sie noch nicht besucht zu haben. Ich freue mich "
   "auf diese Zeit.\""
cornothtailor_speech_029 = de \
   "~kHester Gilk sagt, \"Die Leute scheinen oft seltsam zu werden, wenn sie "
   "sich selbst erkennen.\""
cornothtailor_speech_030 = de \
   "~kHester Gilk sagt, \"Armes Ding, es ist einfach nicht fair, dass sie so "
   "für ihren Glauben missbraucht wird.\""
cornothtailor_speech_031 = de \
   "~kHester Gilk sagt, \"Das Garn, das sie spinnt, war ganz verheddert. "
   "Jetzt glättet sie nur die Knoten.\""
cornothtailor_speech_032 = de \
   "~kHester Gilk sagt, \"Was glaubst Du, warum die Priesterinnen sich so "
   "vor dem Kind fürchten? Denk darüber nach und kehre dann zu mir zurück.\""
cornothtailor_speech_033 = de \
   "~kHester Gilk sagt, \"Hast Du die Gründe für ihr Verhalten erforscht? "
   "Die Antwort könnte Dich überraschen.\""
cornothtailor_speech_034 = de \
   "~kHester Gilk sagt, \"Diejenigen, die unbedingt etwas verändern wollen, "
   "bekommen die Aufmerksamkeit.\""
cornothtailor_speech_035 = de \
   "~kHester Gilk sagt, \"Möchtest Du mehr über die Macht oder ihre Taten "
   "lernen? Beides, sonst kann ich Dir nicht weiterhelfen und Dich "
   "unterrichten. Vielleicht solltest Du die Autoritäten auf diesem Gebiet "
   "aufsuchen, sie könnten Dir mehr sagen.\""
cornothtailor_speech_036 = de \
   "~kHester Gilk sagt, \"Sie ist eine Närrin und, äh, und muss angesichts "
   "des Fortschritts abtreten. Ich fürchte allerdings, dass sie sich unserer "
   "Entwicklung hin zum Fortschritt weiter widersetzen wird. Haben wir nicht "
   "das Recht auf Selbstbestimmung? Ja, das haben wir. In der Gegenwart ist "
   "kein Platz für Sentimentalität oder Nostalgie. Das Leben drängt.\""
cornothtailor_speech_037 = de \
   "~kHester Gilk sagt, \"Ja, Prinzessin Kateriina. Eine faszinierende Frau, "
   "wie ich höre. Ja, das Volk scheint sie sehr zu mögen.\""
cornothtailor_speech_038 = de \
   "~kHester Gilk sagt, \"Ich glaube, ich habe etwas über sie gehört.\""
cornothtailor_speech_039 = de \
   "~kHester Gilk sagt, \"Ich vertraue Solomon unbedingt. Er ist ein, äh, "
   "guter Freund gewesen.\""
cornothtailor_speech_040 = de \
   "~kHester Gilk sagt, \"Als ich in Meridian ankam, ging ich natürlich nach "
   "Tos. Aber ich konnte mich dort nicht niederlassen, ich muss sagen, es "
   "ist mir viel zu geschäftig. Cor Noth ist viel mehr nach meinem "
   "Geschmack.\""
cornothtailor_speech_041 = de \
   "~kHester Gilk sagt, \"Ich war noch nicht in Twitannia und ehrlich "
   "gesagt, ich, äh, ich hätte keine Lust zu gehen.\""
cornothtailor_speech_042 = de \
   "~kHester Gilk sagt, \"Ist es nicht seltsam, dass der Moment ihres Todes, "
   "der den meisten als ihr triumphalster Augenblick erschien, in Wahrheit "
   "ihr schwächster war?\""
cornothtailor_speech_043 = de \
   "~kHester Gilk lächelt und Du spürst, dass sie Dir etwas verheimlicht, "
   "\"Möchtest Du ein paar meiner Webwaren sehen? Man kann nie wissen, was "
   "man dabei entdeckt. Vielleicht entdeckst Du ja etwas über Dich selbst, "
   "was Du noch gar nicht wusstest.\""
cornothtailor_speech_044 = de \
   "~kHester Gilk sagt, \"Yevitan ist ein sehr interessanter Mann, äh, er "
   "hat sicherlich sehr vieles überlebt. Er ist ein Feind, der respektiert "
   "werden sollte, und ein mächtiger Verbündeter für seine Freunde.\""
cornothtailor_random_001 = de \
   "~kHester Gilk sagt, \"Oft erkennen Kinder in ihren Träumen die Wahrheit "
   "oder sehen die Zukunft. Die meisten Leute vergessen das aber im Laufe "
   "der Zeit.\""
cornothtailor_random_002 = de \
   "~kHester Gilk sagt, \"Bist Du auf das Kommende vorbereitet?\""
cornothtailor_random_003 = de \
   "~kHester Gilk sagt, \"Es gibt, äh, Leute, die denen helfen, die in Not "
   "sind und die, äh, die Mittel haben, solche Hilfe zu leisten. Leute, mit "
   "denen ich in Verbindung stehe und denen ich ungeachtet ihrer Motive "
   "vertraue.\""
cornothtailor_random_004 = de \
   "~kHester Gilk sagt, \"Sei besonders vorsichtig in Tos. Die haben zwei "
   "Herzöge - einen toten und einen lebendigen - und beide sind gleich "
   "gefährlich.\""
cornothtailor_random_005 = de \
   "~kHester Gilk sagt, \"Die Royalisten haben auch ihre Mittel - Spione, "
   "Soldaten und Geheimnisse. Hüte Dich vor den Anhängern der Prinzessin und "
   "lass Dich nicht von ihrem Charme täuschen.\""
cornothtailor_random_006 = de \
   "~kHester Gilk sagt, \"Die meisten Kaufleute dieses Landes stehen "
   "miteinander in Verbindung und versuchen, ein ideologisches Bollwerk zur "
   "Wahrung ihrer Interessen zu errichten. Nimm es nicht für bare Münze, "
   "wenn Du etwas Gegenteiliges hörst, denn es gibt eine ganze Menge "
   "Fehlinformationen.\""
cornothtailor_random_007 = de \
   "~kHester Gilk sagt, \"Du musst sehr vorsichtig sein mit dem, was Du "
   "anderen in Meridian und besonders in Tos über Deine politischen "
   "Ansichten erzählst. Du weißt nie, wohin diese Informationen schließlich, "
   "äh, gelangen.\""
cornothtailor_random_008 = de \
   "~kHester Gilk sagt, \"Für den richtigen Preis kannst Du jede Art von "
   "Hilfe bekommen, die Du brauchst, Hilfe unter ~Ijeglichen~I Umständen.\""
cornothtailor_random_009 = de \
   "~kHester Gilk sagt, \"Nimm Dir alle Zeit, die Du brauchst, um Dich im "
   "Laden umzuschauen. Wir können miteinander reden, wenn das erledigt ist.\""
cornothtailor_random_010 = de \
   "~kHester Gilk sagt, \"Wir behalten einander im Auge. Ich behalte Dich im "
   "Auge und Du mich.\""
cornothtailor_random_011 = de \
   "~kHester Gilk sagt, \"Da scheint ziemlich viel Aufregung zwischen den "
   "Anhängern des Herzogs und der Prinzessin hochgekommen zu sein. Es "
   "scheint sehr ernst zu sein.\""
cornothtailor_random_012 = de \
   "~kHester Gilk sagt, \"Wir einfachen Leute müssen füreinander da sein.\""
cornothtailor_random_013 = de \
   "~kHester Gilk sagt, \"Niemand kennt den Ursprung der berühmten Artefakte "
   "der Ratsmitglieder. Es kann keinen Zweifel daran geben, dass sie große "
   "Quellen der Macht sind, denn ich habe gehört, dass sie in der Lage sind, "
   "sich selbst zu teleportieren!\""
cornothtailor_random_014 = de \
   "~kHester Gilk sagt, \"Dieses Land braucht keinen starken König, um "
   "wieder auf die, äh, Beine zu kommen, sondern eine starke Königin. Die "
   "Männer dieses Landes hatten ihre Chance, die Dinge in Ordnung zu "
   "bringen, doch sie haben immer wieder versagt.\""
cornothtailor_random_015 = de \
   "~kHester Gilk sagt, \"Wie ich vernommen habe, gibt es da eine Menge "
   "Ärger in Tos, sobald die Dunkelheit hereinbricht. Es sei in den Straßen "
   "in der Nähe des Friedhofes nicht sicher. Keiner konnte bisher erklären, "
   "warum die Toten in dieser Stadt auferstehen und die Bürger angreifen.\""
cornothtailor_random_016 = de \
   "~kHester Gilk sagt, \"Ich habe etwas über eine alte Zwergenhalle "
   "irgendwo draußen in der Wildnis gehört. Was das wohl ist?\""
cornothtailor_random_017 = de \
   "~kHester Gilk sagt, \"Mir ist zu Ohren gekommen, dass rund um das neue "
   "grüne Mineral von der Insel des Illusionisten ein großer Schwarzmarkt "
   "entstanden ist.\""
cornothtailor_random_018 = de \
   "~kHester Gilk sagt, \"Kann ich Dir bei der Suche nach etwas Bestimmtem "
   "helfen? Ich hab' hier was, äh, ich hab ... \""
cornothtailor_random_019 = de \
   "~kHester Gilk sagt, \"Hast Du gehört, warum der Schmied Ferloi Qan mit "
   "seinem Laden von Tos nach Barloque umgezogen ist? Glaubst Du, es hat "
   "damit zu tun, dass die Streitkräfte der Prinzessin und die Royalisten "
   "einen großen, äh, großen Vorrat an Waffen und Rüstungen anlegen?\""
cornothtailor_random_020 = de \
   "~kHester Gilk sagt, \"Du magst Dir eine eigene Meinung über die Qualität "
   "meiner Arbeit bilden, doch die Kleider, die ich hier habe, sind, wenn "
   "ich es so sagen darf, unvergleichlich.\""
cornothtailor_random_021 = de \
   "~kHester Gilk sagt, \"Suchst Du nach Kleidung in einer bestimmten Farbe "
   "oder einem bestimmten Stil?\""
cornothtailor_random_022 = de \
   "~kHester Gilk näht geschickt an einer seidenen Bluse."
cornothtailor_random_023 = de \
   "~kHester Gilk scheint Dich bei Deinem Rundgang durch den Laden im Auge "
   "zu behalten, während sie zu ihrer Näharbeit zurückkehrt."
cornothtailor_random_024 = de \
   "~kDu siehst, dass der hervorragende Ruf, den dieser Laden genießt, "
   "wohlverdient ist. Er ist außerordentlich gut organisiert, sauber und "
   "gemütlich."
cornothtailor_random_025 = de \
   "~kHester Gilk vernäht den Faden und beißt das Ende mit den Zähnen ab."
cornothtailor_random_026 = de \
   "~kHester Gilk prophezeit, \"Ich kann fühlen, dass der Ostwind "
   "Veränderungen mit sich bringt. Wie wirst Du die kommenden Ereignisse "
   "anpacken?\""
cornothtailor_random_027 = de \
   "~kHester Gilk sagt, \"Es gibt noch mehr. Man sagt, Koldor würde in "
   "regelmäßigen Abständen nach Tos reisen, wo er jedes Mal riesige Summen "
   "in der Bank einzahlt. Ja, äh, sehr große Summen. Und das weiß ich aus "
   "erster Hand von jemandem, der es von Skivlat, dem Bankier, gehört hat. "
   "Damit ist es so gut wie wahr.\""
cornothtailor_random_028 = de \
   "~kHester Gilk sagt, \"Caramo hat viel mehr Einfluss auf das Amt des "
   "Justiziars, als Du es Dir vielleicht vorstellen kannst. In der Tat zählt "
   "sie nicht nur die Stimmen, sondern ist auch für die Durchführung der "
   "Entscheidungen des Justiziars verantwortlich. Das heißt, äh, so wie sie "
   "sie auslegt.\""
cornothtailor_random_029 = de \
   "~kHester Gilk sagt, \"In letzter Zeit hat es ziemlich viel Gerede über "
   "Frisconar gegeben. Hast Du davon gehört? Es scheint, er wird mit der "
   "jüngsten Zunahme der dubiosen Aktivitäten der Nekromanten in Verbindung "
   "gebracht! Fantastisch! Was meinst Du, sind seine Motive dafür, äh, falls "
   "es stimmen sollte?\""
cornothtailor_random_030 = de \
   "~kHester Gilk sagt, \"Hast Du irgendwelche Neuigkeiten über die Affäre "
   "von Herbut mit der Prinzessin?\""
cornothtailor_random_031 = de \
   "~kHester Gilk sagt, \"Ich habe gehört, dass Frular und Roluk "
   "miteinander, äh, Geschäfte machen. Ich habe gehört, dass sie mit Frulars "
   "Vermögen und, äh, Roluks Kenntnissen eine Armee aufstellen.\""
cornothtailor_random_032 = de \
   "~kHester Gilk sagt, \"Man sagt, Madelia sei die engste Vertraute der "
   "Prinzessin geworden. Wer weiß, welchen Einfluss dies auf die Politik des "
   "Hofes haben wird?\""
cornothtailor_random_033 = de \
   "~kHester Gilk sagt, \"Die Gerüchte verhärten sich, wonach Akardius und "
   "Alzahakar das Geschäft, welches mit Kalior gemacht wurde, beibehalten "
   "und sich verschwören, um den Thron zu erobern. Sie würden sicherlich "
   "sehr stark sein, falls die Gerüchte wahr sind.\""
cornothtailor_random_034 = de \
   "~kDu bekommst das Gefühl, dass Hester Gilk Dich absichtlich ignoriert."
cornothtailor_random_035 = de \
   "~kDa ist etwas in diesem Laden, das bei Dir ein ~Iunbehagliches~I Gefühl "
   "hervorruft."
cornothtailor_random_036 = de \
   "~kHester Gilk schaut Dich prüfend an, als würde sie in die Tiefen Deiner "
   "Seele blicken."
