NpcSpeechTemples is NpcSpeech
// NPC talk of temple priests:
// answers to trigger words and random lines.
// Each line is a resource (EN here, DE in the .lkod); Library adds the
// lists in CreateSpeechLibrary and CreateRandomLibrary.

constants:

   include blakston.khd

resources:

   include npcsptemples.lkod

   // FarenPriestess (Priestess Tenuv'vyal)
   farenpriestess_speech_001 = \
      "~kPriestess Tenuv'vyal says, \"They are instruments of death and "
      "decay. They should be destroyed at the first opportunity.\""
   farenpriestess_speech_002 = \
      "~kPriestess Tenuv'vyal says, \"~B~gBarloque is an abomination to the "
      "sanctity of the shores. I foresee that it will be destroyed by a rat "
      "plague of the likes not seen before.~B~k\""
   farenpriestess_speech_003 = \
      "~kPriestess Tenuv'vyal says, \"An ancient city.  It was destroyed "
      "because they ignored the powers of the land.  They chose civilization "
      "over nature.  Judge the results for yourself.\""
   farenpriestess_speech_004 = \
      "~kPriestess Tenuv'vyal says, \"~B~gFaren needs nothing but the earth "
      "and sky.~B~k\""
   farenpriestess_speech_005 = \
      "~kPriestess Tenuv'vyal says, \"~B~gBe gone!~B~k\""
   farenpriestess_speech_006 = \
      "~kPriestess Tenuv'vyal says, \"~B~gLord Faren is quite displeased at "
      "how that little pest of a town, Cor Noth, is damaging the fair stream "
      "that flows through it. Cor Noth will perish by its own refuse. Even "
      "now she spawns living slime.~B~k\""
   farenpriestess_speech_007 = \
      "~kPriestess Tenuv'vyal says, \"~B~gPolitics, what need have I for "
      "politics?!~B~k\""
   farenpriestess_speech_008 = \
      "~kPriestess Tenuv'vyal says, \"~B~gOnce every six years, all in the "
      "land must acknowledge the raw power of Faren. During this time, you "
      "are to eat nothing except that which you can forage, you are to cast "
      "no spells save those of Faren, and above all you are to stay clear of "
      "any town. The Gadfly shall ensure this.~B~k\""
   farenpriestess_speech_009 = \
      "~kPriestess Tenuv'vyal says, \"~B~gFah! Do not talk to me of mortal "
      "politics!~B~k\""
   farenpriestess_speech_010 = \
      "~kPriestess Tenuv'vyal says, \"~B~gLord Faren gave his life to the "
      "earth. His power can be felt in every tremor, heard in every thunder "
      "cloud, smelled in every fire, seen in every wave and tasted in every "
      "edible thing that comes from the ground.~B~k\""
   farenpriestess_speech_011 = \
      "~kPriestess Tenuv'vyal says, \"~B~gI hereby consider you a member of "
      "the Gadfly of Faren. Display this name on you for all to see. Lord "
      "Faren expects you to subvert the ways of civilization to return "
      "mankind back to the ways of nature.~B~k\""
   farenpriestess_speech_012 = \
      "~kPriestess Tenuv'vyal says, \"~B~gDo not mock me with your useless "
      "pleasantries.~B~k\""
   farenpriestess_speech_013 = \
      "~kPriestess Tenuv'vyal says, \"~B~gI can grant the powers of Faren, "
      "the god of storms.~B~k\""
   farenpriestess_speech_014 = \
      "~kPriestess Tenuv'vyal says, \"~B~gThe Gadfly of Faren is an "
      "important sect dedicated to driving people from the sacrilegious "
      "towns especially during the God Days. If you are true to the ways of "
      "Faren, merely say that you supplicate to our master and I will "
      "consider you part of the sect.~B~k\""
   farenpriestess_speech_015 = \
      "~kPriestess Tenuv'vyal says, \"They are a noble group. They have "
      "foresight and a respect for nature that is refreshing. Can they stop "
      "the necromancers? That is the great question.\""
   farenpriestess_speech_016 = \
      "~kPriestess Tenuv'vyal says, \"A noble weapon for a noble purpose. "
      "The Hunter sword is a unique creation. An admirable symbol for a true "
      "hero.\""
   farenpriestess_speech_017 = \
      "~kPriestess Tenuv'vyal says, \"~B~gSweet and innocent Jala's beauty "
      "glowed with light beyond that of the sun. There was no greater pain "
      "than that my master suffered when her light was extinguished by the "
      "vile one.~B~k\""
   farenpriestess_speech_018 = \
      "~kPriestess Tenuv'vyal says, \"~B~gAs Jasper has stripped the land of "
      "its well being, so does Faren instill fear and confusion in their "
      "hearts!~B~k\""
   farenpriestess_speech_019 = \
      "~kPriestess Tenuv'vyal says, \"~B~gWhy do you speak Kraanan's name in "
      "the temple of Lord Faren?!~B~k\""
   farenpriestess_speech_020 = \
      "~kPriestess Tenuv'vyal says, \"~B~gI can grant the powers of Faren, "
      "the god of storms.~B~k\""
   farenpriestess_speech_021 = \
      "~kPriestess Tenuv'vyal says, \"~B~gSpeak not to me of that spell! It "
      "is the key to evil!~B~k\""
   farenpriestess_speech_022 = \
      "~kPriestess Tenuv'vyal says, \"~B~gLord Faren only tolerates Marion "
      "because it is under the protection of the sister of his lost "
      "love.~B~k\""
   farenpriestess_speech_023 = \
      "~kTenuv'vyal laughs shakily, \"~B~gIf anyone had even a little sense, "
      "they would run straight into the forest and destroy her before it is "
      "too late.~n~k\""
   farenpriestess_speech_024 = \
      "~kTenuv'vyal laughs loudly, \"~B~gPeople call me mad, do not deny it, "
      "I know they do. And what do they call this creature of chaos and "
      "lies, sane?~n~k\""
   farenpriestess_speech_025 = \
      "~kTenuv'vyal says, \"~B~gLord Faren, what is your wish? Shall I be "
      "haunted forever by this misbegotten child?~n~k\""
   farenpriestess_speech_026 = \
      "~kTenuv'vyal says, \"~B~bDESTROY HER! RID THE LAND OF HER LIES AND "
      "HER CHAOS!! IT IS THE ONLY WAY!!! DO IT, DO IT NOW!!!!~n~k\""
   farenpriestess_speech_027 = \
      "~kTenuv'vyal looks at you piercingly, and suddenly you realize that "
      "she is about to show you the power of Faren magic first hand."
   farenpriestess_speech_028 = \
      "~kTenuv'vyal screams her lungs out, and you wonder whether she has "
      "now crossed the border of her sanity."
   farenpriestess_speech_029 = \
      "~kPriestess Tenuv'vyal says, \"Her existence is an abnormality of "
      "nature. She must be destroyed.\""
   farenpriestess_speech_030 = \
      "~kTenuv'vyal says, \"~B~gI said long ago that Miriana was up to no "
      "good, but did they listen to me? No, they did not, and now she seeks "
      "the power of the nodes. Those fools could have prevented this much "
      "sooner, had they listened to me.~n~k\""
   farenpriestess_speech_031 = \
      "~kTenuv'vyal screams, \"~B~gHow dare she call upon Faren's power for "
      "her little games. Faren's will shall overwhelm her and she will be "
      "destroyed.~n~k\""
   farenpriestess_speech_032 = \
      "~kTenuv'vyal says, \"~B~gShe summons the worst perversions of nature "
      "to aid her in these fruitless attacks. She must be DESTROYED!~n~k\""
   farenpriestess_speech_033 = \
      "~kPriestess Tenuv'vyal says, \"~B~gKateriina learns well the ways of "
      "Shal'ille. She should abandon the politics of mortals.~B~k\""
   farenpriestess_speech_034 = \
      "~kPriestess Tenuv'vyal screams, \"~B~gNEVER SPEAK HER NAME!~B~k\""
   farenpriestess_speech_035 = \
      "~kPriestess Tenuv'vyal says, \"~B~gRiija? Riija has no true "
      "power.~B~k\""
   farenpriestess_speech_036 = \
      "~kPriestess Tenuv'vyal says, \"~B~gHow dare you approach me with your "
      "petty gold.~B~k\""
   farenpriestess_speech_037 = \
      "~kPriestess Tenuv'vyal says, \"~B~gShal'ille is the peaceful sister "
      "of innocent Jala.~B~k\""
   farenpriestess_speech_038 = \
      "~kPriestess Tenuv'vyal says, \"~B~gThe time for a pupil does not "
      "depend on us.~B~k\""
   farenpriestess_speech_039 = \
      "~kPriestess Tenuv'vyal says, \"~B~gI hereby consider you a member of "
      "the Gadfly of Faren. Display this name on you for all to see. Lord "
      "Faren expects you to subvert the ways of civilization to return "
      "mankind back to the ways of nature.~B~k\""
   farenpriestess_speech_040 = \
      "~kPriestess Tenuv'vyal says, \"Never before or after has there walked "
      "a more righteous man.  All too well I understand his motives and his "
      "actions.  He represented all that was decent in that corrupt "
      "society.\""
   farenpriestess_speech_041 = \
      "~kPriestess Tenuv'vyal says, \"~B~gFor too long the walls of Tos have "
      "stood to mock Lord Faren. Nature will reclaim its bastions yet.~B~k\""
   farenpriestess_speech_042 = \
      "~kPriestess Tenuv'vyal says, \"That is the root of the unnatural "
      "happenings in the land. If it cannot be destroyed completely, it "
      "should be banished to the deepest chasm.\""
   farenpriestess_speech_043 = \
      "~kPriestess Tenuv'vyal says, \"If there is one person I could destroy "
      "before they were ever born, it would be this abomination.\""
   farenpriestess_speech_044 = \
      "~kPriestess Tenuv'vyal says, \"~B~gLegend says one Yrx'l tree "
      "survives on an island of deception.~B~k\""
   farenpriestess_speech_045 = \
      "~kPriestess Tenuv'vyal says, \"An unremarkable member of the Zarcos "
      "lineage, but then, most of their lineage is less than remarkable.  "
      "Aristocracy tends to breed with itself. This is not the way of "
      "nature.\""
   farenpriestess_random_001 = \
      "~kPriestess Tenuv'vyal says, \"~B~gNature is more powerful than any "
      "man. Why even the living trees can defend themselves with "
      "lightning.~B~k\""
   farenpriestess_random_002 = \
      "~kPriestess Tenuv'vyal says, \"~B~gLong ago nature was ravaged by man "
      "as they bled the Yrx'l trees dry. All have now vanished from the "
      "land. Except perhaps one.~B~k\""
   farenpriestess_random_003 = \
      "~kPriestess Tenuv'vyal says, \"~B~gThe hideous slime creature is not "
      "of nature. It is the wastes of human civilization which spawns "
      "it.~B~k\""
   farenpriestess_random_004 = \
      "~kPriestess Tenuv'vyal says, \"~B~gBeware of the witch named Miriana, "
      "she seeks to disrupt the balance.~B~k\""
   farenpriestess_random_005 = \
      "~kPriestess Tenuv'vyal says, \"~B~gThat fool Maleval will feel the "
      "fury of Faren for spreading his lies.~B~k\""
   farenpriestess_random_006 = \
      "~kPriestess Tenuv'vyal says, \"~B~gYour weapons are insignificant "
      "sticks before the raw power of Faren sorcery!~B~k\""
   farenpriestess_random_007 = \
      "~kPriestess Tenuv'vyal says, \"~B~gReject those foods tainted by "
      "human hands. There are many mushrooms that can provide all the "
      "nourishment you need.~B~k\""
   farenpriestess_random_008 = \
      "~kPriestess Tenuv'vyal says, \"~B~gA potion of Forgetfulness can "
      "cleanse your soul of those worthless spells you have learned from the "
      "other priestesses. I warn you now that Faren does not grant such boon "
      "without a price paid by your very being.~B~k\""
   farenpriestess_random_009 = \
      "~kPriestess Tenuv'vyal says, \"~B~gSociety has outlawed the use of "
      "some of Faren's magic. The fools! How dare they presume to outlaw the "
      "will of a god!~B~k\""
   farenpriestess_random_010 = \
      "~kPriestess Tenuv'vyal says, \"~B~gQerti'nya is so proud of how long "
      "her temple has stood. Ha! My temple is all of the outdoors. Hers is "
      "an insignificant sprig compared to the vast forest of my temple.~B~k\""
   farenpriestess_random_011 = \
      "~kPriestess Tenuv'vyal says, \"~B~gI have sworn to destroy Zuxana on "
      "sight. She can not hide her temple forever.~B~k\""
   farenpriestess_random_012 = \
      "~kPriestess Tenuv'vyal screeches, \"~B~gHa ha ha ha ha ha! Yes! Yes! "
      "The Power!~B~k\""
   farenpriestess_random_013 = \
      "~kPriestess Tenuv'vyal says, \"~B~gThe winds... they speak to "
      "me!~B~k\""
   farenpriestess_random_014 = \
      "~kPriestess Tenuv'vyal says, \"~B~gSmell that?! Clover. It's an omen. "
      "Change is in the air.~B~k\""
   farenpriestess_random_015 = \
      "~kPriestess Tenuv'vyal screams for no apparent reason."
   farenpriestess_random_016 = \
      "~kPriestess Tenuv'vyal says, \"~g~BThe living trees of Faronath are "
      "violent beings. They serve Faren.~B~k\""
   farenpriestess_random_017 = \
      "~kPriestess Tenuv'vyal says, \"~B~gThe herbalist follows the ways of "
      "Faren and even knows a bit of the power of heat.~B~k\""
   farenpriestess_random_018 = \
      "~kPriestess Tenuv'vyal says, \"~B~gMiriana must be destroyed. She "
      "mocks the natural order of things.~B~k\""
   farenpriestess_trigger_amulet = "amulet"
