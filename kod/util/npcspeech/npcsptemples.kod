   // JalaPriestess (Priestess Themala)
   jalapriestess_random_001 = \
      "~kPriestess Themala says, \"Music can affect you in so many ways.  A "
      "song can change your mood, even your whole day.\""
   jalapriestess_random_002 = \
      "~kPriestess Themala says, \"Golems are animated servants, neither "
      "alive nor dead.  They are powerful tools of Jala.\""
   jalapriestess_random_003 = \
      "~kPriestess Themala says, \"Those who have passed can still hear our "
      "songs. Remember to honor them with a gentle tune.\""
   jalapriestess_random_004 = \
      "~kPriestess Themala says, \"A prism is a handy tool.  You never know "
      "where it might come in handy.\""
   jalapriestess_random_005 = \
      "~kPriestess Themala says, \"A great song is one that endures, even "
      "when I'm not around.\""
   jalapriestess_random_006 = \
      "~kPriestess Themala says, \"Music gives us memories.  The longer a "
      "melody has existed, the more memories it holds.\""
   jalapriestess_random_007 = \
      "~kPriestess Themala says, \"If our king loves music, then there is "
      "little wrong in the land.\""
   jalapriestess_random_008 = \
      "~kPriestess Themala says, \"I don't think good and evil are "
      "opposites.  Anything done for love goes beyond both.\""
   jalapriestess_random_009 = \
      "~kPriestess Themala says, \"Music never lies - it makes you feel "
      "something.  A song lets you feel a thought.\""
   jalapriestess_random_010 = \
      "~kPriestess Themala says, \"So vast is art, so narrow is the human "
      "wit.\""
   jalapriestess_random_011 = \
      "~kPriestess Themala says, \"True ease in lyrics comes from art, not "
      "chance.  Those who have learned to dance move most gracefully.\""

   // KraananPriestess (Priestess Qerti'nya)
   kraananpriestess_speech_001 = \
      "~kPriestess Qerti'nya says, \"It is often the case that weaklings try "
      "to improve their abilities with magical things. Of course the "
      "necromancers need such things.\""
   kraananpriestess_speech_002 = \
      "~kPriestess Qerti'nya says, \"~B~bAll of those positions are filled "
      "at the moment.~B~k\""
   kraananpriestess_speech_003 = \
      "~kPriestess Qerti'nya says, \"~B~bYears ago, the worthy blacksmith "
      "Fehr'loi Qan journeyed to me and learned the ways of mighty Kraanan "
      "the Fist. He now resides in Barloque. Seek him for fine "
      "armaments.~B~k\""
   kraananpriestess_speech_004 = \
      "~kPriestess Qerti'nya says, \"The warriors of Brax were undisciplined "
      "and lazy.  Because of that, they lost their city.\""
   kraananpriestess_speech_005 = \
      "~kPriestess Qerti'nya says, \"~B~bI need nothing.~B~k\""
   kraananpriestess_speech_006 = \
      "~kPriestess Qerti'nya says, \"~B~bTravel with strength, warrior.~B~k\""
   kraananpriestess_speech_007 = \
      "~kPriestess Qerti'nya says, \"~B~bYou can learn much of the ways of "
      "battle from the weapon's master in Cor Noth.~B~k\""
   kraananpriestess_speech_008 = \
      "~kPriestess Qerti'nya says, \"~B~bMy boy Cort serves Kraanan the Fist "
      "by overseeing the tourneys that are held in the Arena. I am proud of "
      "his work and I am certain lord Kraanan is as well.~B~k\""
   kraananpriestess_speech_009 = \
      "~kPriestess Qerti'nya says, \"~B~bThe kingdom has been in confusion "
      "ever since Zarcos gave power to five separate men. The kingdom needs "
      "one strong ruler.~B~k\""
   kraananpriestess_speech_010 = \
      "~kPriestess Qerti'nya says, \"~B~bBah, don't bother bringing up "
      "Cylill. He was a competent general and is my son's father. That is "
      "all I have to say of the insufferable man.~B~k\""
   kraananpriestess_speech_011 = \
      "~kPriestess Qerti'nya says, \"~B~bKraanan's God Days occur once each "
      "six years. It is a time for warriors to prove their worth both in "
      "combat and in the bar. No person may refuse an arena challenge. To "
      "test our resolve, lord Kraanan has before brought great beasts to "
      "this temple so that we may vanquish them.~B~k\""
   kraananpriestess_speech_012 = \
      "~kPriestess Qerti'nya says, \"~B~bAkardius follows Riija? Bah! Kalior "
      "was the true Duke. He followed the mighty Kraanan!~B~k\""
   kraananpriestess_speech_013 = \
      "~kPriestess Qerti'nya says, \"~B~bFaren is one with the earth. His "
      "magic is for animals, not man.~B~k\""
   kraananpriestess_speech_014 = \
      "~kPriestess Qerti'nya says, \"~B~bBah, don't bother bringing up "
      "Cylill. He was a competent general and is my son's father. That is "
      "all I have to say of the insufferable man.~B~k\""
   kraananpriestess_speech_015 = \
      "~kPriestess Qerti'nya says, \"~B~bHail %s! You have traveled far to "
      "reach my temple. I welcome you.~B~k\""
   kraananpriestess_speech_016 = \
      "~kPriestess Qerti'nya says, \"~B~bThrough me, you will learn the ways "
      "of Kraanan, the god of might.~B~k\""
   kraananpriestess_speech_017 = \
      "~kPriestess Qerti'nya says, \"~B~bKraanan's God Days occur once each "
      "six years. It is a time for warriors to prove their worth both in "
      "combat and in the bar. No person may refuse an arena challenge. To "
      "test our resolve, lord Kraanan has before brought great beasts to "
      "this temple so that we may vanquish them.~B~k\""
   kraananpriestess_speech_018 = \
      "~kPriestess Qerti'nya says, \"They are a decent and mighty group. "
      "They are welcome in the House of the Fist.\""
   kraananpriestess_speech_019 = \
      "~kPriestess Qerti'nya says, \"A useful weapon. I consider it "
      "dangerous to rely on such things for victory in battle.\""
   kraananpriestess_speech_020 = \
      "~kPriestess Qerti'nya says, \"~B~bJala died in weakness. Mighty "
      "Kraanan would have prevented her death, had he not already committed "
      "himself to Meridian.~B~k\""
   kraananpriestess_speech_021 = \
      "~kPriestess Qerti'nya says, \"~B~bJasper's people are strong, but "
      "they waste their time digging for gems. Their only value is the ores "
      "they mine that are made into weapons.~B~k\""
   kraananpriestess_speech_022 = \
      "~kPriestess Qerti'nya says, \"~B~bExalt the Holy Might of Kraanan the "
      "Fist, Kraanan I, Patron of the Warrior!~B~k\""
   kraananpriestess_speech_023 = \
      "~kPriestess Qerti'nya says, \"~B~bThrough me, you will learn the ways "
      "of Kraanan, the god of might.~B~k\""
   kraananpriestess_speech_024 = \
      "~kPriestess Qerti'nya says, \"~B~bMarion is Shal'ille's domain. A "
      "town of holy peace. A good place, but not for a true warrior of "
      "Kraanan.~B~k\""
   kraananpriestess_speech_025 = \
      "~kPriestess Qerti'nya says, \"~B~bIs it not strange that only she can "
      "hear it when they call upon the magic nodes in their defense?~n~k\""
   kraananpriestess_speech_026 = \
      "~kPriestess Qerti'nya says, \"~B~bThe Fist of Kraanan shall be the "
      "justice with which her foul, deceitful ways are dealt with.~n~k\""
   kraananpriestess_speech_027 = \
      "~kPriestess Qerti'nya says, \"~B~bHer view of the gods is completely "
      "twisted. To listen to her is to listen to misguided tales of "
      "lies.~n~k\""
   kraananpriestess_speech_028 = \
      "~kPriestess Qerti'nya says, \"~B~bShe wants to make herself a god; "
      "her ignorance and deceit will not be tolerated in this holy temple of "
      "justice. Her end shall be swift and painless, yet it is a "
      "necessity.~n~k\""
   kraananpriestess_speech_029 = \
      "~kPriestess Qerti'nya says, \"~B~bThat little witch seeks only her "
      "own self-serving ways. She cannot be trusted.~n~k\""
   kraananpriestess_speech_030 = \
      "~kPriestess Qerti'nya says, \"~B~bThat demon must be stopped before "
      "she destroys not only the land but also the faith upon which our "
      "foundations are built. Her lies are unbearable to the ears of the "
      "true believers.~n~k\""
   kraananpriestess_speech_031 = \
      "~kPriestess Qerti'nya says, \"The way of the necromancers is a way of "
      "weakness. A true warrior should have no fear of these creatures. They "
      "die by the sword, just like the living.\""
   kraananpriestess_speech_032 = \
      "~kPriestess Qerti'nya says, \"~B~bTo stop Miriana and her creatures, "
      "you must beseech the strength of Kraanan.~n~k\""
   kraananpriestess_speech_033 = \
      "~kPriestess Qerti'nya says, \"~B~bKraanan does not deal gently with "
      "people who use lies and chaos to lead others astray, as Miriana will "
      "soon find out.~n~k\""
   kraananpriestess_speech_034 = \
      "~kPriestess Qerti'nya says, \"~B~bKraanan's justice must be hammered "
      "into her before she can gather enough power to fulfill her dark "
      "desires.~n~k\""
   kraananpriestess_speech_035 = \
      "~kPriestess Qerti'nya says, \"~B~bMaybe Kateriina should be "
      "crowned...Unless there is another...perhaps one who follows "
      "Kraanan.~B~k\""
   kraananpriestess_speech_036 = \
      "~kPriestess Qerti'nya says, \"~B~bKraanan cares little for pitiful "
      "Qor and her lackey servants.~B~k\""
   kraananpriestess_speech_037 = \
      "~kPriestess Qerti'nya says, \"~B~bSpeak not the name of the Trickster "
      "in my presence lest you seek the back of my hand!~B~k\""
   kraananpriestess_speech_038 = \
      "~kPriestess Qerti'nya says, \"~B~bSeek the blacksmiths for your "
      "armaments.~B~k\""
   kraananpriestess_speech_039 = \
      "~kPriestess Qerti'nya says, \"~B~bHail Shal'ille, she who stands by "
      "Kraanan's side as his faithful wife.~B~k\""
   kraananpriestess_speech_040 = \
      "~kPriestess Qerti'nya says, \"~B~bMy boy Cort serves Kraanan the Fist "
      "by overseeing the tourneys that are held in the Arena. I am proud of "
      "his work and I am certain lord Kraanan is as well.~B~k\""
   kraananpriestess_speech_041 = \
      "~kPriestess Qerti'nya says, \"What do you want me to say?  He was an "
      "old man who used magic. I know nothing else.\""
   kraananpriestess_speech_042 = \
      "~kPriestess Qerti'nya says, \"~B~bHone your skills in the Arena "
      "dedicated to my lord Kraanan. My son presides over all of the "
      "different combats in the name of the Fist.~B~k\""
   kraananpriestess_speech_043 = \
      "~kPriestess Qerti'nya says, \"She got what she deserved.\""
   kraananpriestess_speech_044 = \
      "~kPriestess Qerti'nya says, \"~B~bMy boy Cort serves Kraanan the Fist "
      "by overseeing the tourneys that are held in the Arena. I am proud of "
      "his work and I am certain lord Kraanan is as well.~B~k\""
   kraananpriestess_speech_045 = \
      "~kPriestess Qerti'nya says, \"What is your opinion of a man who "
      "leaves his country in its darkest hour to save himself?\""
   kraananpriestess_random_001 = \
      "~kPriestess Qerti'nya says, \"~B~bA warrior must be well fed for no "
      "battle was won on an empty stomach. Even a poor warrior can find "
      "mushrooms to feed themselves.~B~k\""
   kraananpriestess_random_002 = \
      "~kPriestess Qerti'nya says, \"~B~bFollowers of Kraanan must be true "
      "to him and him alone. A potion of forgetfulness will clear your mind "
      "of any paltry magic of the other schools.~B~k\""
   kraananpriestess_random_003 = \
      "~kPriestess Qerti'nya says, \"~B~bSeek the Arena in Tos and fight in "
      "the name of Kraanan. When you prove your valor, my boy may show favor "
      "on you.~B~k\""
   kraananpriestess_random_004 = \
      "~kPriestess Qerti'nya says, \"~B~bKraanan's God days were the first "
      "to be honored back in the time of Priest Alexand. Again, mighty "
      "warriors celebrate this holiday.~B~k\""
   kraananpriestess_random_005 = \
      "~kPriestess Qerti'nya says, \"~B~bTos no longer has a blacksmith. "
      "That is Barloque's gain.~B~k\""
   kraananpriestess_random_006 = \
      "~kPriestess Qerti'nya says, \"~B~bYou stand in the oldest temple in "
      "all the land. Yet, after all these years, it is still the strongest "
      "in structure.~B~k\""
   kraananpriestess_random_007 = \
      "~kPriestess Qerti'nya says, \"~B~bGaze upon the magnificent weapons "
      "around you. Each were used to further the name of Kraanan.~B~k\""
   kraananpriestess_random_008 = \
      "~kPriestess Qerti'nya says, \"~B~bMay you die in battle or not at "
      "all.~B~k\""
   kraananpriestess_random_009 = \
      "~kPriestess Qerti'nya says, \"~B~bA hard day of fighting should be "
      "followed by a long night of drinking.~B~k\""
   kraananpriestess_random_010 = \
      "~kPriestess Qerti'nya says, \"~B~bA follower of Kraanan always "
      "clearly speaks her mind. Deception and innuendoes are not the weapons "
      "of a true warrior.~B~k\""
   kraananpriestess_random_011 = \
      "~kPriestess Qerti'nya says, \"~B~bOne with true honor will announce "
      "their intentions to do battle and fight till killed or vanquished. "
      "Never would a warrior of Kraanan run away from their opponent.~B~k\""
   kraananpriestess_random_012 = \
      "~kPriestess Qerti'nya says, \"~B~bPathetic are those who sneak behind "
      "a warrior, attack then disappear. There is no honor in a cowardly "
      "attack.~B~k\""
   kraananpriestess_random_013 = \
      "~kPriestess Qerti'nya says, \"~B~bIt is the sacred duty of the strong "
      "warriors of Kraanan to protect the weak and helpless.~B~k\""
   kraananpriestess_random_014 = \
      "~kPriestess Qerti'nya says, \"~B~bThe dishonest and dishonorable will "
      "find little mercy from the warrior of Kraanan.~B~k\""
   kraananpriestess_random_015 = \
      "~kPriestess Qerti'nya stands determined behind her altar. It looks as "
      "though she is ready to jump into battle at a moment's notice."
   kraananpriestess_random_016 = \
      "~kA feeling of awe overcomes you as you stand before the various holy "
      "weapons of Kraanan."
   kraananpriestess_random_017 = \
      "~kPriestess Qerti'nya says, \"~B~bIf you are unwilling to honor the "
      "ways of Kraanan, then you have no business being here. In fact, you "
      "would have little business being alive.~B~k\""
   kraananpriestess_trigger_amulet = "amulet"
