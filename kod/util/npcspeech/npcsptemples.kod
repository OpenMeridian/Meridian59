   farenpriestess_trigger_hunter = "hunter"
   farenpriestess_trigger_hunter_sword = "hunter sword"
   farenpriestess_trigger_hunter_sword_2 = "hunter sword"
   farenpriestess_trigger_jala = "jala"
   farenpriestess_trigger_jasper = "jasper"
