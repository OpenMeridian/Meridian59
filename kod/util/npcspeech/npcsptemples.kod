   // QorPriestess (Priestess Zuxana)
   qorpriestess_speech_001 = \
      "~kPriestess Zuxana says, \"That is an interesting artifact. I am sure "
      "that if I had enough time to study one of them, I would figure out "
      "its abilities and its composition. Unfortunately I have no one who "
      "could bring me one of these pendants. A pity.\""
   qorpriestess_speech_002 = \
      "~kPriestess Zuxana says, \"~r~IBeneath the glimmering streets of "
      "Barloque, you will find one of my most efficient servants.~I~k\""
   qorpriestess_speech_003 = \
      "~kPriestess Zuxana says, \"An old city destroyed by the chaotic and "
      "unpredictable forces of nature.  How can so many trust those forces "
      "now and believe that they will guide them to salvation?  Nature cares "
      "little for the deeds or thoughts of humanity.\""
   qorpriestess_speech_004 = \
      "~kPriestess Zuxana says, \"~r~II need nothing. Qor provides for her "
      "children well enough.~I~k\""
   qorpriestess_speech_005 = \
      "~kPriestess Zuxana says, \"~r~IYou will return.~I~k\""
   qorpriestess_speech_006 = \
      "~kPriestess Zuxana says, \"~r~IIt is by no accident that the Ivory "
      "Chapel in Cor Noth no longer serves Shal'ille. I believe it is... "
      "merely a gathering place for bandits now.~I~k\""
   qorpriestess_speech_007 = \
      "~kPriestess Zuxana says, \"~r~IThe council. I would not put much "
      "faith in the council to run this land. All are blundering fools with "
      "no grasp on the true machinations that are in place.~I~k\""
   qorpriestess_speech_008 = \
      "~kPriestess Zuxana says, \"~r~IEvery six years, the servants conjoin "
      "here to perform the rituals of long ago. When the stars are aligned "
      "and the blood is sacrificed, the necromancers will raise the dead "
      "from their deep graves.~I~k\""
   qorpriestess_speech_009 = \
      "~kPriestess Zuxana says, \"~r~ILord Faren seeks to avenge himself on "
      "my Mistress. He is unaware of how his blind anger only helps serve "
      "the cause of Qor.~I~k\""
   qorpriestess_speech_010 = \
      "~kPriestess Zuxana says, \"~r~IWelcome to the dark temple, %s.~I~k\""
   qorpriestess_speech_011 = \
      "~kPriestess Zuxana says, \"~r~II can bring you into the sweet "
      "darkness of Qor, the goddess of black magic.~I~k\""
   qorpriestess_speech_012 = \
      "~kPriestess Zuxana says, \"~r~IEvery six years, the servants conjoin "
      "here to perform the rituals of long ago. When the stars are aligned "
      "and the blood is sacrificed, the necromancers will raise the dead "
      "from their deep graves.~I~k\""
   qorpriestess_speech_013 = \
      "~kPriestess Zuxana says, \"Everyone seems to accept these hunters as "
      "they are. I see a band of murderers who hunt people with the "
      "government's permission. What kind of society do we live in? I see a "
      "terrible hypocrisy in this. What is the difference between the "
      "hunters and the necromancers? One of these groups has good "
      "connections to our leader.\""
   qorpriestess_speech_014 = \
      "~kPriestess Zuxana says, \"~r~IHow my Mistress of Night misses little "
      "Jala and her squeaky songs. She almost regrets soiling her dagger on "
      "the girl's bare back.~I~k\""
   qorpriestess_speech_015 = \
      "~kPriestess Zuxana says, \"~r~IA pity that Jasper dies after having "
      "slit open its veins and drained all of the earth's blood from within. "
      " Suicide I would say.  Although some would say that this new "
      "'rebellion' of theirs is the stopgate to their life blood's "
      "loss.~I~k\""
   qorpriestess_speech_016 = \
      "~kPriestess Zuxana says, \"~r~IKalior has met Qor, and Qor is pleased "
      "with his new servant.~I~k\""
   qorpriestess_speech_017 = \
      "~kPriestess Zuxana says, \"~r~IKraanan, the perfect warrior, an "
      "abundance of strength with no brains to speak of. He was the first to "
      "throw away his life in the chaos.~I~k\""
   qorpriestess_speech_018 = \
      "~kPriestess Zuxana says, \"~r~II can bring you into the sweet "
      "darkness of Qor, the goddess of black magic.~I~k\""
   qorpriestess_speech_019 = \
      "~kPriestess Zuxana says, \"~r~IMalumnea is the perfect state of unity "
      "where Qor accepts the other gods with open arms, such that they may "
      "become a part of her. Then she will bring the universe together in "
      "dark harmony.~I~k\""
   qorpriestess_speech_020 = \
      "~kPriestess Zuxana says, \"~r~IHiss! Marion is the last remaining "
      "patch of innocence.~I~k\""
   qorpriestess_speech_021 = \
      "~kZuxana says, \"~I~rThe chaos she creates can only be tolerated with "
      "guidance - not like this all-consuming abomination that currently "
      "exists~n~k.\""
   qorpriestess_speech_022 = \
      "~kZuxana smiles sensually, \"~I~rNow, do not concern yourselves with "
      "her and her obvious lies. That will be taken care of very soon.~n~k\""
   qorpriestess_speech_023 = \
      "~kZuxana says, \"~I~rOf course she must be destroyed. Let her spread "
      "her little stories, she cannot destroy the truth with them.~n~k\""
   qorpriestess_speech_024 = \
      "~kZuxana says, \"~I~rI cannot be disturbed with such unimportant "
      "matters now. Begone!~n~k\""
   qorpriestess_speech_025 = \
      "~kZuxana says, \"~I~rThe impudent wench, even I must admit that she "
      "has gone too far. She must be destroyed, and as a servant of Qor you "
      "are required to carry out her will.~n~k\""
   qorpriestess_speech_026 = \
      "~kZuxana smiles ruthlessly, \"~I~rThink of the malicious destruction "
      "we can wreak with this power. You shall bring it back for me, my "
      "dear. Of course that will mean Miriana's death, but so be it.~n~k\""
   qorpriestess_speech_027 = \
      "~kZuxana says, \"~I~rHa, if Tenuval was worried before, then I think "
      "she has now thrown herself off the cliffs.~n~k\""
   qorpriestess_speech_028 = \
      "~kZuxana says, \"~I~rThis power rightfully belongs to Qor and her "
      "followers, what impudence of her to steal it from us. Our revenge "
      "will be death.~n~k\""
   qorpriestess_speech_029 = \
      "~kPriestess Zuxana says, \"~r~IKateriina is a fool to follow "
      "Shal'ille. I could teach her the true way to master the arts.~I~k\""
   qorpriestess_speech_030 = \
      "~kPriestess Zuxana says, \"~r~IYou look promising, %s, but I am not "
      "yet ready to take you on as a pupil.~I~k\""
   qorpriestess_speech_031 = \
      "~kPriestess Zuxana says, \"~r~IMistress Qor, the Vile One! I offer "
      "blood as sacrifice to your name.~I~k\""
   qorpriestess_speech_032 = \
      "~kPriestess Zuxana says, \"~r~IAh, the little trickster Riija. Qor "
      "misses his forked tongue and deceiving nature.~I~k\""
   qorpriestess_speech_033 = \
      "~kPriestess Zuxana says, \"~r~IDo not buy what you need. Take "
      "it.~I~k\""
   qorpriestess_speech_034 = \
      "~kPriestess Zuxana says, \"~r~IHiss! The Lady Shal'ille teaches of "
      "dead ideals and improbable peace. Her soft heart will be her "
      "undoing.~I~k\""
   qorpriestess_speech_035 = \
      "~kPriestess Zuxana says, \"I feel sorry for him.  Venya'cyr goes "
      "insane, kills his family, and he starts to fiddle with the chaotic "
      "powers of nature.  He was a tool.  I am sure his intentions were "
      "noble but the fact of the matter is he dealt in forces that he could "
      "not control and destroyed an entire city.  Because of him we have "
      "lost a culture.\""
   qorpriestess_speech_036 = \
      "~kPriestess Zuxana says, \"~r~IDreary Tos becomes more corrupt each "
      "day. Soon they will not be able to hold back the army of dead in the "
      "graveyard.~I~k\""
   qorpriestess_speech_037 = \
      "~kPriestess Zuxana says, \"I have begun to study the ancient relics "
      "in order to better understand the world in which we developed. I "
      "could also say that I collect such things and would pay a fair price "
      "for such a fossil. If it is worth nothing else, it can at least serve "
      "as an ornament in the temple.\""
   qorpriestess_speech_038 = "~kPriestess Zuxana says, \"Poor thing.\""
   qorpriestess_speech_039 = \
      "~kPriestess Zuxana says, \"The problems of our society can be traced "
      "back to this man and his deeds.  When times got hard for him he "
      "turned tail and fled.  It is because of his juvenile fears that "
      "prejudice has been allowed to destroy many schools of thought.  This "
      "is your world.  Is this how you would have things?\""
   qorpriestess_random_001 = \
      "~kPriestess Zuxana says, \"~r~ITenuv'vyal fears little Miriana "
      "because the young girl will one day replace her. How delicious, a "
      "Faren Master afraid of a little girl.~I~k\""
   qorpriestess_random_002 = \
      "~kPriestess Zuxana says, \"~r~IThe mana nodes of power lie about the "
      "world. We must locate them all and endeavor to possess them for our "
      "cause alone.~I~k\""
   qorpriestess_random_003 = \
      "~kPriestess Zuxana says, \"~r~IThe dark castle of the long dead "
      "Far'Nohl lies beyond the land of trolls. There, all manner of undead "
      "walk the ancient corridors. Look well upon it, for it shows the fate "
      "of the Bourgeois Castle and Blackstone Keep.~I~k\""
   qorpriestess_random_004 = \
      "~kPriestess Zuxana says, \"~r~IA source of magic exists beyond the "
      "realm of the living. There could be no simpler path to it, provided "
      "you are willing to pay the price with your life.~I~k\""
   qorpriestess_random_005 = \
      "~kPriestess Zuxana says, \"~r~II sense a new queen spider has taken "
      "possession of the spider nest. How delightful.~I~k\""
   qorpriestess_random_006 = \
      "~kPriestess Zuxana says, \"~r~IBeware. Innocent blood often invokes "
      "the most persistent of spirits bent on revenge. Take great care, for "
      "these revenants match strengths with the murderer and will not stop "
      "until they can drag their prey down to the Underworld.~I~k\""
   qorpriestess_random_007 = \
      "~kPriestess Zuxana says, \"~r~IMy followers are many and they have "
      "found insidious ways to blend back into the unsuspecting society, "
      "with such mundane disguises as a banker or an herbalist.~I~k\""
   qorpriestess_random_008 = \
      "~kPriestess Zuxana says, \"~r~IClear your mind of all other gods "
      "knowledge, for they only speak lies. To know absolute truth and grow "
      "stronger in your service to Qor, drink the potion of Forgetfulness. "
      "Do not worry about the ills the potion may cause, they are "
      "insignificant next to the power Qor can bestow upon you.~I~k\""
   qorpriestess_random_009 = \
      "~kPriestess Zuxana says, \"~r~ISome people feel death is such a "
      "tragedy, but not I. There are so many uses for the dead: as body "
      "guards, as a small spring of mana, or even as a supplier of common "
      "items.~I~k\""
   qorpriestess_random_010 = \
      "~kPriestess Zuxana says, \"~r~ILong ago when the Fey knew no better "
      "than Shal'ille, one of the Elhai lost its way through the Quilicia "
      "and happened upon our dark mistress. She took it in and cared for it "
      "for many weeks. When it was better, Qor sent it back to its brothers "
      "and sisters, requesting only that it take her along so that she may "
      "help more of the misguided Fey.~I~k\""
   qorpriestess_random_011 = \
      "~kPriestess Zuxana says, \"~r~IPrepare yourselves for the ceremonies "
      "of the ancient holiday.~I~k\""
   qorpriestess_random_012 = \
      "~kPriestess Zuxana says, \"~r~IMany years ago, this temple was "
      "removed from the fabric of spatial reality to give our persecuted "
      "ancestors the freedom to worship. When Qor has seduced the world "
      "again, our temple will rejoin with the earth.~I~k\""
   qorpriestess_random_013 = \
      "~kPriestess Zuxana says, \"~r~IWhen the Nine rise from their dark "
      "hell, in the land of life the undead will dwell.~I~k\""
   qorpriestess_random_014 = \
      "~kPriestess Zuxana looks deeply into your eyes. You feel both cold "
      "and hot at the same moment."
   qorpriestess_random_015 = \
      "~kFrom the lava below come sounds that are somewhere between laughter "
      "and screams."
   qorpriestess_random_016 = \
      "~kPriestess Zuxana says, \"~r~IIt is not the ways of Qor to randomly "
      "kill. Murder is a serious endeavor and should be performed with "
      "consideration of consequence. One must be discreet and "
      "discerning.~I~k\""
   qorpriestess_random_017 = \
      "~kPriestess Zuxana says, \"~r~IQor does not condone random slaughter. "
      "Such is the work of a beast. An elegant crime has both passion and "
      "reason.~I~k\""
   qorpriestess_random_018 = \
      "~kPriestess Zuxana says, \"~r~II see so much potential in you. So "
      "much that you do not realize.~I~k\""
   qorpriestess_random_019 = \
      "~kPriestess Zuxana says, \"~r~IListen to the other Priestesses if you "
      "must. In your heart, you will know their lies and see that Qor is the "
      "only goddess who indeed cares for you.~I~k\""
   qorpriestess_random_020 = \
      "~kPriestess Zuxana says, \"~r~II sense you know of another who could "
      "join our coven. Bring that person with you when you next come.~I~k\""
   qorpriestess_random_021 = \
      "~kPriestess Zuxana says, \"~r~II have many ways of showing you Qor's "
      "love. Attend this temple and you will feel her power like hot breath "
      "on your skin.~I~k\""
   qorpriestess_random_022 = \
      "~kPriestess Zuxana says, \"~r~IPray with me now, and feel the purity "
      "of Qor's love.~I~k\""
   qorpriestess_random_023 = \
      "~kPriestess Zuxana says, \"~r~IYou have done well to seek me out. "
      "Your dedication will not come without reward. Learn the ways of my "
      "Mistress and learn the truth.~I~k\""
   qorpriestess_random_024 = \
      "~kPriestess Zuxana says, \"~r~IDrink the dark knowledge of Qor. She "
      "desires you and can grant you powers undreamed.~I~k\""
   qorpriestess_trigger_amulet = "amulet"
