   // RiijaMonk (Monk of Riija)
   riijamonk_speech_001 = \
      "~kThe Monk of Riija says, \"Imagine eating and never becoming full.\""
   riijamonk_speech_002 = \
      "~kThe Monk of Riija says, \"If the base of your house is made of air, "
      "it will surely topple.\""
   riijamonk_speech_003 = \
      "~kThe Monk of Riija says, \"~I~bI would ~I~B~konly~B~I~g be "
      "interested in ~I~kbuying~I~g your soul~n~k.\""
   riijamonk_speech_004 = \
      "~kThe Monk of Riija says, \"~gDestiny ~B~rwill~B ~bbring ~I~kyou "
      "~I~rback.`n~k\""
   riijamonk_speech_005 = "~kThe Monk of Riija says, \"You are wise.\""
   riijamonk_speech_006 = \
      "~kThe Monk of Riija says, \"~I~gThe strongest emotion is "
      "~I~rFEAR.~I~g Hate is not an emotion at all. ~bHate is the only FEAR "
      "of what others are, ~ror more precisely, what we are not, %s~n~k.\""
   riijamonk_speech_007 = \
      "~kThe Monk of Riija intones, \"~I~rYou ~I~B~bhave ~I~gtraveled "
      "`n~kthrough ~b~Imuch~I ~B~gperil ~B~rto ~I~bsee ~kme.~n~k\""
   riijamonk_speech_008 = \
      "~kThe Monk of Riija says, \"~BYou ~I~bare~n~g beyond the "
      "~B~rpoint~g~B of needing ~kor deserving ~I~bhelp~n~k.\""
   riijamonk_speech_009 = \
      "~kThe Monk of Riija says, \"There was a time when the Prince and the "
      "Princess lived happily together.\""
   riijamonk_speech_010 = \
      "~kThe Monk of Riija says, \"What did you say, the hunger sword?\""
   riijamonk_speech_011 = \
      "~kThe Monk of Riija says, \"~BKonima~B~I~r was a ~bfool~g for leading "
      "~bhis ~I~B~rpeople~B~I~b to this island~n~k.\""
   riijamonk_speech_012 = \
      "~kThe Monk of Riija says, \"~I~bThe strongest emotion is ~I~rFEAR. "
      "~I~bLove is not an emotion at all, %s. ~rLove is the only FEAR of "
      "loneliness~n~k.\""
   riijamonk_speech_013 = \
      "~kThe Monk of Riija giggles, \"~b~bAre her ~B ~I~gwords words of "
      "~I~btruth or ~B~kwords of ~B~I~rlies. ~I~gWho are we ~B~rto "
      "~B~kjudge.\""
   riijamonk_speech_014 = \
      "~kThe Monk of Riija holds his hands over his ears and bellows, "
      "\"~B~gI ~bCAN'T ~rHEAR ~B~I~bYOU~k!~I ~rLA~gLA~bLA~kLA.\""
   riijamonk_speech_015 = \
      "~kThe Monk of Riija seems to shrug, \"~BTruth, ~I~rlies~I, ~g....the "
      "~bonly ~I~gdifference lies ~I~B~rin perception.~B~k\""
   riijamonk_speech_016 = \
      "~kThe Monk of Riija says, \"I have a parasite living inside me. To "
      "kill the parasite, I must kill myself.\""
   riijamonk_speech_017 = \
      "~kThe Monk of Riija says, \"Those who ~I~rbelieve ~gthey ~kare sane "
      "~bin a ~rworld ~bsuch ~ras ~bours ~rare ~b~I~Bdelusional~n~k.\""
   riijamonk_speech_018 = \
      "~kThe Monk of Riija calls, \"~B~bCome in, ~B~I~kit's open... "
      "~I~rOhhh, you, ~I~gperhaps ~Bnot ~B~bafter all.~n~k\""
   riijamonk_speech_019 = \
      "~kThe Monk of Riija says, \"~I~bIf ~I~B~kMiriana ~B~rand her "
      "~gcreatures ~B~rare to be defeated by you, ~B~Iyou must ~I~glearn "
      "much!~n~k\""
   riijamonk_speech_020 = \
      "~kThe Monk of Riija preaches, \"~B~rRiija the wanderer, ~bis the god "
      "~k~Iof the mind. ~BAnd nothing is more important ~I~gthan the "
      "MIND.~n~k\""
   riijamonk_speech_021 = \
      "~kThe Monk of Riija says, \"~II ~rsell ~I~Btruth~n~k.\""
   riijamonk_speech_022 = \
      "~kThe Monk of Riija says, \"~BI can ~ropen~k your eyes to ~rso~k very "
      "much~n~k.\""
   riijamonk_speech_023 = \
      "~kThe Monk of Riija says, \"When the Prince dies before the King, it "
      "is a day to weep.\""
   riijamonk_speech_024 = "~kThe Monk of Riija says, \"She was a man.\""
   riijamonk_speech_025 = \
      "~kThe Monk of Riija says, \"~B~gSooner than you think~n~k.\""
   riijamonk_speech_026 = \
      "~kThe Monk of Riija says, \"~BOne ~gwho ~ris ~ktruly ~ginsane ~bwould "
      "~khave ~rno ~gcognizance ~gof ~btheir ~rinsanity~n~k.\""
   riijamonk_speech_027 = \
      "~kThe Monk of Riija says, \"The real Zarrus died in Brax.\""
   riijamonk_random_001 = \
      "~kThe Monk of Riija chortles, \"~BRIIJA ~I~bis ~gpoWEr.~n~k\""
   riijamonk_random_002 = "~kThe Monk of Riija watches your every movement."
   riijamonk_random_003 = \
      "~kThe Monk of Riija says, \"~BInsanity is a misused ~blabel. ~I~kAre "
      "you insane? ~I~n~rSay \"~Byes~I\" and you are not. `n~g Say "
      "\"~Bno~B\" and you must be~n~k.\""
   riijamonk_random_004 = \
      "~kThe Monk of Riija says, \"~rSome ~Iwill tell you~I that seeing is "
      "believing. ~bThey are ~B~kblind~n~k.\""
   riijamonk_random_005 = \
      "~kThe Monk of Riija says, \"~B~bIn the sky, ~B~rthere is sometimes a "
      "~B~gF~bI`n~BS~kH,~B~r it flies ~Ihigher than the ~brainbow ~gand it "
      "can not be killed by any poison. ~I~kIf you were to touch its scales, "
      "~byou would ~Iknow what lies beyond the night. ~I~B~rHowever,~B~g the "
      "fish can not be caught because it does not ~Bexist~n~k.\""
   riijamonk_random_006 = \
      "~kThe Monk of Riija says, \"~rThe color of tears is not ~bred~r, but "
      "it should be~n~k.\""
   riijamonk_random_007 = \
      "~kThe Monk of Riija says, \"When you look into ~B~rfire~B~k, you do "
      "not see ~B~rfire~B~k. ~B~rFire~B~k is never in one precise spot. You "
      "only perceive where ~B~rfire~B~k has been~n~k.\""
   riijamonk_random_008 = \
      "~kThe Monk of Riija says, \"~B~bThere ~ris ~ga ~bpouch ~kdeep ~rin "
      "~gthe liver ~bof ~rman. ~kThat ~bis ~gwhere ~rthe fears ~kare "
      "~bkept~n~k.\""
   riijamonk_random_009 = \
      "~kThe Monk of Riija says, \"~g~IYou can't taste heat. ~bBut I "
      "can~n~k.\""
   riijamonk_random_010 = \
      "~kThe Monk of Riija says, \"~IBeing touched ~bby a ~rsword ~gmay kill "
      "you, ~byet ~knever ~rbeing touched ~gby another human ~rwill "
      "~bcertainly kill you~n~k.\""
   riijamonk_random_011 = \
      "~kThe Monk of Riija says, \"~II know why you are here.~I If that "
      "person would pay attention to you, ~byou would be with them. "
      "~rInstead you are with me. ~B~kHA HA HA HA HA HA HA HA~n~k!\""
   riijamonk_random_012 = \
      "~kThe Monk of Riija says, \"~B~gYou know when someone ~rhates~g you. "
      "~kThat is REALITY. ~gBut you never know if someone ~bloves~g you. "
      "There is always room for doubt. ~I~bOh, they will tell you that they "
      "fully love you with ~n~b~Ball~B~I of their heart. ~n~B~kThat is "
      "~rF~gA~kN~bT~rA~gS~bY~n~k.\""
   riijamonk_random_013 = \
      "~kThe Monk of Riija says, \"I know your mind. ~bYou often wonder if "
      "you are the only one here. ~I You wonder if every person you meet is "
      "just a figment of your imagination. ~gPut there to test you in some "
      "way. ~I~rYou wonder if any other person truly has a "
      "~I~B~gs~bo~ku~gl~r or exists outside of your field of vision. `n~kYou "
      "are right. ~IExcept that you do not exist either~n~k.\""
   riijamonk_random_014 = \
      "~kThe Monk of Riija says, \"~B~g'Why?'~B~k You have asked that "
      "question too often of life when you should be asking ~B~r'When?' "
      "~n~k\""
   riijamonk_random_015 = \
      "~kThe Monk of Riija says, \"~B~gTell ~bme, ~rmy ~gvisitor, ~I~rwhich "
      "is the strongest ~kemotion~n~k?\""
   riijamonk_trigger_amulet = "amulet"
   riijamonk_trigger_brax = "brax"
   riijamonk_trigger_sell = "sell"
   riijamonk_trigger_bye = "bye"
   riijamonk_trigger_fear = "fear"
   riijamonk_trigger_hate = "hate"
   riijamonk_trigger_hello = "hello"
   riijamonk_trigger_help = "help"
   riijamonk_trigger_hunter = "hunter"
