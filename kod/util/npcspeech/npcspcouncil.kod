         [50,0,[LIBACT_QUOTE_RSC,twocouncilor_random_007],7],
         [50,0,[LIBACT_QUOTE_RSC,twocouncilor_random_008],8],
         [50,0,[LIBACT_QUOTE_RSC,twocouncilor_random_009],9],
         [50,0,[LIBACT_QUOTE_RSC,twocouncilor_random_010],10],
         [50,0,[LIBACT_QUOTE_RSC,twocouncilor_random_011],11],
         [50,0,[LIBACT_QUOTE_RSC,twocouncilor_random_012],12],
         [50,LIBRES_MOOD_NOT_BAD,
            [LIBACT_QUOTE_RSC,twocouncilor_random_013],13],
         [50,LIBRES_MOOD_BAD,[LIBACT_QUOTE_RSC,twocouncilor_random_014],14],
