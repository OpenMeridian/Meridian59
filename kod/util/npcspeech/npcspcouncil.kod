NpcSpeechCouncil is NpcSpeech
// NPC talk of the five councilors:
// answers to trigger words and random lines.
// Each line is a resource (EN here, DE in the .lkod); Library adds the
// lists in CreateSpeechLibrary and CreateRandomLibrary.

constants:

   include blakston.khd

resources:

   include npcspcouncil.lkod

   // FiveCouncilor (Esseldi)
   fivecouncilor_speech_001 = \
      "~kEsseldi says, \"I would love to see one of those pendants.\""
   fivecouncilor_speech_002 = \
      "~kEsseldi says, \"Well, actually the animals scatter when you travel "
      "through. The monsters are the things to look out for.\""
   fivecouncilor_speech_003 = \
      "~kEsseldi says, \"Ah, old Barloque! It's been a few years since I've "
      "seen her. Truth to tell, I find her a bit stuffy. Only stop there to "
      "collect some gear on the way to visit the princess.\""
   fivecouncilor_speech_004 = \
      "~kEsseldi says, \"Now there is a place I would have liked to see. "
      "Tales of Brax are always about an enlightened civilization aspiring "
      "to construct the greatest city of their time. How brave they must "
      "have been, and how foolish.\""
   fivecouncilor_speech_005 = \
      "~kEsseldi says, \"May your journeys find you in fascinating locales.\""
   fivecouncilor_speech_006 = \
      "~kEsseldi says, \"You can really learn a great deal about your roots "
      "in Cor Noth.\""
   fivecouncilor_speech_007 = \
      "~kEsseldi says, \"Myself and four other gentlemen were chosen by King "
      "Zarcos V to guide the country while he was off doing his own "
      "exploring. I don't think he's coming back to the throne personally, "
      "so it's going to be ultimately up to us councilors to choose his "
      "successor. Personally, I could do without all the politics.\""
   fivecouncilor_speech_008 = \
      "~kEsseldi says, \"Drechx can usually be found out near old Castle "
      "Victoria. It's quite a hike from here. It's amazing how good a shape "
      "that old man is in.\""
   fivecouncilor_speech_009 = \
      "~kEsseldi says, \"I believe that the fabric of magic pulls the Tokens "
      "towards itself. In our world we have several mana nodes of power and "
      "dozens of wizards activating magic at different times and power "
      "levels. When the Tokens are pulled from enough angles, they pop "
      "towards, but not necessarily to, the strongest ones. I don't know why "
      "the monsters grab them up though, I think Drechx is working on that "
      "one.\""
   fivecouncilor_speech_010 = \
      "~kEsseldi says, \"I believe that the fabric of magic pulls the Tokens "
      "towards itself. In our world we have several mana nodes of power and "
      "dozens of wizards activating magic at different times and power "
      "levels. When the Tokens are pulled from enough angles, they pop "
      "towards, but not necessarily to, the strongest ones. I don't know why "
      "the monsters grab them up though, I think Drechx is working on that "
      "one.\""
   fivecouncilor_speech_011 = \
      "~kEsseldi says, \"Ho Traveler! What brings you out this way?\""
   fivecouncilor_speech_012 = "~kEsseldi says, \"I have heard of them.\""
   fivecouncilor_speech_013 = \
      "~kEsseldi says, \"I am very interested in getting a look at one of "
      "those swords.\""
   fivecouncilor_speech_014 = \
      "~kEsseldi says, \"There's some great people in Jasper, let me tell "
      "you. Hard working town with good, hard working people.\""
   fivecouncilor_speech_015 = \
      "~kEsseldi says, \"Ah, you have heard the story of Venya'cyr. Perhaps "
      "the lich cannot leave its cursed city.\""
   fivecouncilor_speech_016 = \
      "~kEsseldi says, \"Marion's such a nice little town. Friendly people. "
      "Good farmers. There's nothing better than a good hot meal in Marion "
      "after being out in the wilds for a few weeks.\""
   fivecouncilor_speech_017 = \
      "~kEsseldi says, \"Rook can tell you about monsters.\""
   fivecouncilor_speech_018 = \
      "~kEsseldi says, \"Yeah, it was ~Ihumoch~I. That means Troll in "
      "another language, I think.\""
   fivecouncilor_speech_019 = \
      "~kEsseldi says, \"What a spectacular night to be outside! Look, if "
      "you squint, you can see the East Star.\""
   fivecouncilor_speech_020 = \
      "~kEsseldi says, \"Yeah, the ones under Jasper and Barloque.\""
   fivecouncilor_speech_021 = \
      "~kEsseldi says, \"It's a little complicated to explain, but I think "
      "the tokens move around on their own because of the way they interact "
      "with the mana fields. Each act like magnets, pulling these items "
      "around in different directions. There's more to it than that. I won't "
      "bore you with the explanation.\""
   fivecouncilor_speech_022 = \
      "~kEsseldi says, \"I really don't have time to get into it right now. "
      "Maybe some other time.\""
   fivecouncilor_speech_023 = \
      "~kEsseldi says, \"I don't much care for Tos as a town. Don't get me "
      "wrong, the architecture is amazing, like a piece of history sitting "
      "right there. But the people don't much respect the antiquity of the "
      "city and tend to abuse it. I only go through Tos when I need to "
      "advise the Duke.\""
   fivecouncilor_speech_024 = \
      "~kEsseldi says, \"I remember that an urn played a part in the story "
      "of Venya'cyr, but I do not remember its significance.\""
   fivecouncilor_speech_025 = \
      "~kEsseldi says, \"Poor girl. She was trapped by the forces "
      "surrounding her. Would you have done any different? Could you have "
      "done any different? Can any of us say we have not succumbed to our "
      "darker instincts at some point? It just cost her more than it has the "
      "rest of us.\""
   fivecouncilor_speech_026 = \
      "~kEsseldi says, \"This is probably not the most popular thing to say "
      "but, I think the man was a coward for leaving his city without "
      "standing to fight.\""
   fivecouncilor_random_001 = \
      "~kEsseldi says, \"I've been studying these tokens for a long time "
      "now. I think I'm starting to figure out why they keep popping around "
      "on us. Just some theories really, but I'm making progress.\""
   fivecouncilor_random_002 = \
      "~kEsseldi says, \"If you're a clever explorer, you'll figure out the "
      "way to the inside of the stone circle in the land of Trolls.\""
   fivecouncilor_random_003 = \
      "~kEsseldi says, \"I tell you I have been almost everywhere it seems, "
      "except the underworld that is. Strange how there are so many ways to "
      "get out of the afterlife. A lot of open doors...\""
   fivecouncilor_random_004 = \
      "~kEsseldi says, \"I find that traveling around is the best way to "
      "learn about the world, but there are some people that can teach you a "
      "thing or two as well.\""
   fivecouncilor_random_005 = \
      "~kEsseldi says, \"All of the Gods have temples out here in the wilds. "
      "Problem is finding them. I still don't have a clue to where old Riija "
      "has hidden out. And I'm beginning to believe that whatever was left "
      "of Jala's temple is long gone, washed away by the servants of Qor.\""
   fivecouncilor_random_006 = \
      "~kEsseldi says, \"If you are hunting for the Mana Nodes, it's an "
      "awfully good idea to hire a mercenary to guide you. The paths are "
      "often treacherous. I'd guide you myself, but I'm off on my own quest "
      "now.\""
   fivecouncilor_random_007 = \
      "~kEsseldi says, \"I'm heading up towards the Seafarer's Peak myself. "
      "It's a wonderful view up there.\""
   fivecouncilor_random_008 = \
      "~kEsseldi says, \"The one place I hate exploring is those blasted "
      "sewers. They seem to go on forever. It would be interesting, but they "
      "just smell so bad.\""
   fivecouncilor_random_009 = \
      "~kEsseldi says, \"There's nothing like a good hike to clear your "
      "mind. As long as you're careful about the animals that is.\""
   fivecouncilor_random_010 = "~kEsseldi applies some balm to his feet."
   fivecouncilor_random_011 = \
      "~kYou detect the pungent scent of skunk in the forest."
   fivecouncilor_random_012 = \
      "~kEsseldi says, \"Watch out for trolls. You know I heard someone call "
      "them by some other name recently.\""
   fivecouncilor_random_013 = \
      "~kEsseldi says, \"Jonas D'Accor knows more than anybody about the old "
      "legends of Konima.\""
   fivecouncilor_random_014 = \
      "~kEsseldi says, \"History claims that the ancient Empire used to "
      "trade with us through the Nexus near Castle Victoria. The Nexus was "
      "destroyed centuries ago. Now only trolls guard the stones that once "
      "marked the gateway.\""
   fivecouncilor_random_015 = "~kEsseldi says, \"Smell that fresh air!\""
   fivecouncilor_random_016 = \
      "~kEsseldi says, \"What a beautiful day to be outside!\""
   fivecouncilor_speech_027 = \
      "~kEsseldi says, \"You like standing around in towns, Cor Noth's one "
      "of the nicer ones. They ask me to give lectures at the University "
      "from time to time. One day, I'll get around to it, I figure.\""
   fivecouncilor_trigger_amulet = "amulet"
   fivecouncilor_trigger_animal = "animal"
   fivecouncilor_trigger_barloque = "barloque"
   fivecouncilor_trigger_brax = "brax"
   fivecouncilor_trigger_bye = "bye"
   fivecouncilor_trigger_cor_noth = "cor noth"
   fivecouncilor_trigger_council = "council"
   fivecouncilor_trigger_drechx = "drechx"
   fivecouncilor_trigger_drex = "drex"
   fivecouncilor_trigger_explain = "explain"
   fivecouncilor_trigger_explanation = "explanation"
   fivecouncilor_trigger_hello = "hello"
   fivecouncilor_trigger_hunter = "hunter"
   fivecouncilor_trigger_hunter_sword = "hunter sword"
   fivecouncilor_trigger_jasper = "jasper"
   fivecouncilor_trigger_lich = "lich"
   fivecouncilor_trigger_marion = "marion"
   fivecouncilor_trigger_monsters = "monsters"
   fivecouncilor_trigger_name = "name"
   fivecouncilor_trigger_night = "night"
   fivecouncilor_trigger_sewers = "sewers"
   fivecouncilor_trigger_sewers_2 = "sewers"
   fivecouncilor_trigger_theory = "theory"
   fivecouncilor_trigger_theories = "theories"
   fivecouncilor_trigger_tos = "tos"
   fivecouncilor_trigger_urn = "urn"
   fivecouncilor_trigger_venya_cyr = "venya'cyr"
   fivecouncilor_trigger_zarrus = "zarrus"

   // FourCouncilor (Drechx)
   fourcouncilor_speech_001 = \
      "~kDrechx says, \"With their whole existence, the necromancers hate "
      "everything that lives. The amulet is the result of that perversion. "
      "Did you know that the only thing a necromancer can eat is the life "
      "force of living beings? Real food is like poison to them.\""
   fourcouncilor_speech_002 = \
      "~kDrechx says, \"That is the way they both feed. Themselves and their "
      "queen. It is truly disgusting. I only know what Alzahakar has told "
      "me.\""
   fourcouncilor_speech_003 = \
      "~kDrechx says, \"The capital city of Barloque is afflicted with rats. "
      "Those rich fellows there ought to spend some shillings on mercenaries "
      "to rid her sewers of the vermin, before disease is spread.\""
   fourcouncilor_speech_004 = \
      "~kDrechx says, \"I am no historian.  Talk to the malnourished wizard "
      "Alzahakar if you want to know about such things.  Let me ask you "
      "this, Have you ever seen that man eat? I have not.\""
   fourcouncilor_speech_005 = "~kDrechx says, \"Good health to you, friend.\""
   fourcouncilor_speech_006 = \
      "~kDrechx says, \"The scholars' town of Cor Noth suffers from a "
      "pollution problem. They best clean out their stream before it spawns "
      "more dreaded slime on the world.\""
   fourcouncilor_speech_007 = \
      "~kDrechx says, \"King Zarcos was wise to abdicate the throne to us "
      "five councilors. His mind is afflicted with mental health problems "
      "that have been seen in a few of the Kings before him. He needed to "
      "remove himself from the pressures of rule in order to heal. The five "
      "of us will see to the Kingdom, until a successor is chosen.\""
   fourcouncilor_speech_008 = \
      "~kDrechx says, \"This Akardius has his head on straight. If the "
      "people will it, my vote is his.\""
   fourcouncilor_speech_009 = \
      "~kDrechx says, \"Greetings, my friend. How's your health today?\""
   fourcouncilor_speech_010 = \
      "~kDrechx says, \"The Hunters' bond with their swords seems unhealthy "
      "to me. It is unnatural, so it is not good for the body.\""
   fourcouncilor_speech_011 = \
      "~kDrechx says, \"Anything that makes the body dependent on foreign "
      "material is bad for a person in the end. I know these weapons help "
      "the Hunters tremendously, but I often wonder what toll the body pays "
      "for it.\""
   fourcouncilor_speech_012 = \
      "~kDrechx says, \"I have heard that it is magical in nature.\""
   fourcouncilor_speech_013 = \
      "~kDrechx says, \"Since the intrusion of Jonas and the rebellion into "
      "their lives I must say that the citizens' health is much improved.  "
      "Although I could not recommend it as a usual treatment.\""
   fourcouncilor_speech_014 = \
      "~kDrechx says, \"He was deformed, if I remember the story correctly.  "
      "The people did not like the fact that their leader was so hunched "
      "over and quiet.  The story said that the king lost his voice. How can "
      "you have a king with no voice?\""
   fourcouncilor_speech_015 = \
      "~kDrechx says, \"From what I have heard, the Lich cannot die. Her "
      "body was changed by the powers that corrupted her. I wonder what it "
      "is like to live forever?\""
   fourcouncilor_speech_016 = \
      "~kDrechx says, \"Marion is a town in perfect health. It balances the "
      "simple needs of the body with the temperament of peaceful living. It "
      "is small, but I guarantee that town will outlive the others.\""
   fourcouncilor_speech_017 = \
      "~kDrechx says, \"Good, don't you feel more relaxed now?\""
   fourcouncilor_speech_018 = \
      "~kDrechx says, \"She has what it takes to rule the land, yet there is "
      "a naivete that prevents my full support.\""
   fourcouncilor_speech_019 = \
      "~kDrechx says, \"Isn't he the new vault man in Tos?\""
   fourcouncilor_speech_020 = \
      "~kDrechx says, \"The tokens have a warm life affirming glow coming "
      "from them. A soul, I'd say. That's why monsters scurry to gather "
      "them. It's the nature of life to attract other life. That's also why "
      "death doesn't seem to have such dire effects on us humans when we "
      "carry a token. It shares part of its life force with us. Alzahakar "
      "has some theories of his own on this.\""
   fourcouncilor_speech_021 = \
      "~kDrechx says, \"The city of Tos suffers from old age. All things in "
      "life must age, whether living or stone, and poor Tos rests on her "
      "last legs. Only new life can restore her walls.\""
   fourcouncilor_speech_022 = \
      "~kDrechx says, \"A truly despicable character.  She killed her own "
      "brother, Ker'toth.\""
   fourcouncilor_speech_023 = "~kDrechx says, \"Nope.\""
   fourcouncilor_speech_024 = "~kDrechx says, \"Who?\""
   fourcouncilor_random_001 = \
      "~kDrechx says, \"My fellow councilors are always looking to retrieve "
      "the mysterious tokens. We have been tasked with studying them. You'll "
      "find each of us have our own theories on how they function.\""
   fourcouncilor_random_002 = \
      "~kDrechx says, \"The quickest way to recover is to rest at an inn and "
      "have yourself a good, warm meal.\""
   fourcouncilor_random_003 = \
      "~kDrechx says, \"If you want your body to be more resilient, well, "
      "you'll have to break it down so that it can heal stronger. Might I "
      "say by taking on creatures that are tougher than you.\""
   fourcouncilor_random_004 = \
      "~kDrechx says, \"A good place to hone your body is in the Arena of "
      "Kraanan. You might get some bruises... but you won't face death like "
      "combats out in the wild.\""
   fourcouncilor_random_005 = \
      "~kDrechx says, \"While armor may be good protection, I think it just "
      "burdens you down.\""
   fourcouncilor_random_006 = \
      "~kDrechx says, \"The Tokens are wonderful creatures. Others might "
      "call them objects, but I know they have a certain life to them. I "
      "have some theories on why that is.\""
   fourcouncilor_random_007 = \
      "~kDrechx says, \"You'll heal a lot faster if you have a full "
      "stomach.\""
   fourcouncilor_random_008 = \
      "~kDrechx says, \"Now a human has to watch after their own body, but "
      "if you want a little help, the ways of Shal'ille can teach you a "
      "healing spell.\""
   fourcouncilor_random_009 = \
      "~kDrechx says, \"I've been out swimming far out in that great big "
      "ocean. Those rumors of sea creatures are nonsense. I don't know why "
      "they don't sail to deep waters anymore, but I don't believe in sea "
      "monsters.\""
   fourcouncilor_random_010 = \
      "~kDrechx says, \"I've seen over sixty five winters. That's a lot, my "
      "friend. You don't see sixty five winters by being careless with your "
      "body. Some men and women half my age aren't in nearly as good a "
      "shape. Ha, I show them, I do.\""
   fourcouncilor_random_011 = \
      "~kDrechx says, \"I'm particular to the Demon Skull token because it "
      "seems the most negative towards life force. I gather that whatever "
      "beast it came from was diametrically opposed to life. Being the "
      "healthiest councilor, it's best that I keep track of it.\""
   fourcouncilor_random_012 = \
      "~kDrechx says, \"This old castle here, it's the oldest structure in "
      "the land. I'm surprised it's still standing. Perhaps the spirit of "
      "ancient King Far'Nohl keeps it from crumbling to dust.\""
   fourcouncilor_random_013 = \
      "~kDrechx chants, \"Ohm... Ohm... Ohm... say it with me now... Ohm... "
      "Ohm... Ohm...\""
   fourcouncilor_random_014 = \
      "~kThe horrid smell of decay comes from the ancient castle."
   fourcouncilor_random_015 = \
      "~kYou have an uncomfortable feeling as you stand before the ancient "
      "castle, as if mankind was not meant to return to these walls."
   fourcouncilor_random_016 = \
      "~kInhuman screams can be heard from within the dark castle."
   fourcouncilor_random_017 = \
      "~kJust standing before the immense, dark structure, you are "
      "overwhelmed with an eerie feeling."
   fourcouncilor_random_018 = "~kDrechx begins to rigorously exercise."
   fourcouncilor_random_019 = \
      "~kDrechx says, \"Breathe in... breathe out... breathe in deeply... "
      "breathe out deeply...\""
   fourcouncilor_random_020 = \
      "~kDrechx says, \"My body is my temple. If you don't eat better, your "
      "body will be your junkyard.\""
   fourcouncilor_random_021 = \
      "~kDrechx says, \"What did you have to eat today? The best food is the "
      "most natural food.\""
   fourcouncilor_random_022 = \
      "~kDrechx says, \"If you want to live to see my age, you best eat "
      "better and exercise your mind and body often.\""
   fourcouncilor_random_023 = \
      "~kDrechx says, \"How often do you exercise each day? I'm guessing not "
      "enough.\""
   fourcouncilor_random_024 = \
      "~kDrechx says, \"What matters if you change the town you live in? The "
      "only true house that you own is your body and that address you can "
      "not change.\""
   fourcouncilor_random_025 = \
      "~kClosing his eyes and relaxing his body, Drechx enters a deep trance."
   fourcouncilor_trigger_amulet = "amulet"
   fourcouncilor_trigger_barloque = "barloque"
   fourcouncilor_trigger_brax = "brax"
