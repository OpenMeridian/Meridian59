// RebelLiege
rebelliege_speech_001 = de \
   "~kJonas sagt, \"Du willst Dich der kämpfenden Elite anschließen?\""
rebelliege_speech_002 = de "~kJonas sagt, \"Du taugst nicht zum Soldaten!\""
rebelliege_speech_003 = de \
   "~kJonas sagt, \"Ich bin nicht auf Einkaufstour, Du Idiot.\""
rebelliege_speech_004 = de \
   "~kJonas sagt, \"Manche sagen, Konima führe noch immer tief in den "
   "Eingeweiden dieser Höhlen Krieg. Andere sagen, Shal'ille weine noch "
   "immer um den verlorenen Krieger. So oder so, er hat die Menschheit vor "
   "den widerwärtigen Orks gerettet.\""
rebelliege_speech_005 = de \
   "~kJonas sagt, \"Das ist ein Zaubertrick, mit dem das Auge eines "
   "realistischen Kriegers alle vorgetäuschten Tricks durchschaut.\""
rebelliege_speech_006 = de \
   "~kJonas sagt, \"Kannst Du es glauben, dass die Prinzessin mit diesem "
   "Hanswurst wetteifert? Er hat kein Recht auf den Thron! Er ist unfähig zu "
   "führen! Er macht die Krone lächerlich, und doch lässt Kateriina sich das "
   "gefallen?\""
rebelliege_speech_007 = de \
   "~kJonas sagt, \"Meridian kann nicht ewig zwischen den Königshäusern "
   "gespalten bleiben! Jemand muss die Führung übernehmen, und ich denke, "
   "ich weiß, wer...\""
rebelliege_speech_008 = de \
   "~kJonas sagt, \"Die Würfel sind gefallen! Wenn die Königin den Thron "
   "nicht besteigt, dann werde ich es tun!\""
rebelliege_speech_009 = de \
   "~kJonas sagt, \"Der Gilliz-Pass liegt viele Meilen südlich von Jasper in "
   "den Bergen. Bei Gilliz vernichteten wir die Karawane des Ork-Häuptlings "
   "Huibin und steckten den Rest in Brand.\""
rebelliege_speech_010 = de \
   "~kJonas sagt, \"Man sollte meinen, man fühlte sich sehr geehrt, Teil "
   "eines so großartigen Anfangs wie diesem zu sein.\""
rebelliege_speech_011 = de \
   "~kJonas sagt, \"Eile gibt Dir Ausdauer für einen Gewaltmarsch.\""
rebelliege_speech_012 = de \
   "~kJonas nickt Dir knapp zu und sagt, \"Rührt euch.\""
rebelliege_speech_013 = de \
   "~kJonas sagt, \"Vielleicht gibt es doch noch Hilfe für Dich. Der Wind "
   "der Veränderung weht in Richtung Jasper. Vielleicht kannst Du Deine "
   "Dienste dort anbieten.\""
rebelliege_speech_014 = de \
   "~kJonas sagt, \"Dieser Spruch verleiht Wissen über Waffen und zeigt dem "
   "Anwender die wahren Eigenschaften einer Waffe.\""
rebelliege_speech_015 = de \
   "~kJonas sagt, \"Die beste leichte Freischärler-Infanterie im Land ist "
   "das Volk aus Jasper. Im Feld habe ich sie immer als Späher und Führer "
   "eingesetzt. Nun dienen sie mir gut als Rückgrat der neuen Rebellion.\""
rebelliege_speech_016 = de \
   "~kJonas sagt, \"Konima war der größte Held, den die Menschheit kennt. "
   "Sein Kriegstrupp führte einen erbitterten Angriff auf die Ork-Höhlen "
   "jenseits des westlichen Verwunschenen Waldes. Sechzig Krieger gingen in "
   "diese Höhlen, keiner kam zurück.\""
rebelliege_speech_017 = de \
   "~kJonas sagt, \"Ich wäre über den Ozean selbst gegangen, um ihr zu Hilfe "
   "zu eilen.\""
rebelliege_speech_018 = de \
   "~kJonas sagt, \"Zieh' den Namen dieses Mädchens nicht in den Dreck oder "
   "Du wirst meinen Zorn verspüren. Und das wäre kein beneidenswerter "
   "Zustand - da kannst Du die Orks vom Gilliz-Pass fragen. Wenn Du noch "
   "einen lebenden findest.\""
rebelliege_speech_019 = de "~kJonas sagt, \"Hinfort, ~ISchurke~I.\""
rebelliege_speech_020 = de \
   "~kJonas sagt, \"Der Zauber Gift widerstehen bedeutet für einen Krieger "
   "ein bisschen zusätzlichen Schutz gegen Giftstoffe.\""
rebelliege_speech_021 = de \
   "~kJonas sagt, \"Enthüllung hält länger an als Identifizieren und macht "
   "die wahre Natur einer Waffe für alle sichtbar.\""
rebelliege_speech_022 = de \
   "~kJonas sagt, \"Er ist wirklich ein bemerkenswerter Schwertkämpfer. "
   "Fantastisch.\""
rebelliege_speech_023 = de \
   "~kJonas sagt, \"Ein kleiner Mann. Klein, sozusagen. Weißt Du, ein "
   "richtiger Wicht von einem Kerl, der seinen Mangel an ~IKörpergröße~I mit "
   "kunstvollem Schwertkampf wettzumachen versucht. Ich würde sagen, er ist "
   "ein guter Mann an Deiner Seite im Kampf, wenn er nicht dieses Gehabe "
   "eines kleinen Kerls hätte.\""
rebelliege_speech_024 = de \
   "~kJonas sagt, \"Ich soll vor der kleinen Ratte Angst haben? DER KERL IST "
   "EINE KÜCHENSCHABE!!\""
rebelliege_speech_025 = de \
   "~kJonas sagt, \"Ich spiele als Nummer acht für Marion beim jährlichen "
   "Testspiel. Erstklassiges Team.\""
rebelliege_speech_026 = de \
   "~kJonas sagt, \"Vielleicht könnte ich Dir ein paar Tricks beibringen, "
   "die ich unterwegs aufgeschnappt habe.\""
rebelliege_speech_027 = de \
   "~kJonas sagt, \"Schutzhülle ist ein mächtiger Zauber, der, auf eine "
   "Waffe gewirkt, diese Waffe vor magischer Manipulation schützt.\""
rebelliege_speech_028 = de \
   "~kJonas sagt, \"Ich habe heute genug Soldaten für die Rebellenmiliz "
   "begutachtet.\""
rebelliege_random_001 = de \
   "~kJonas D'Accor beobachtet sorgfältig die Umgebung, so als würde er "
   "Ärger erwarten."
rebelliege_random_002 = de \
   "~kJonas ist in jeder Beziehung ein respekteinflößender Mann."
rebelliege_random_003 = de \
   "~kJonas hält seine Rüstung fleckenlos sauber, er ist das Ebenbild eines "
   "Berufssoldaten."
rebelliege_random_004 = de "~kJonas scheint mit sich sehr zufrieden zu sein."
rebelliege_random_005 = de \
   "~kJonas sagt, \"Ich liebe dieses ehrenvolle Land.\""
rebelliege_random_006 = de \
   "~kJonas sagt, \"Es gibt nur eine Sache, für die es wert ist zu kämpfen - "
   "und das ist Ehre. Für einen Soldaten bedeutet das die Ehre seines "
   "Landes.\""
rebelliege_random_007 = de \
   "~kJonas sagt, \"Du solltest Dir besser darüber im Klaren sein, wofür Du "
   "kämpfst. Denn nichts ist es wert, dafür zu kämpfen, wenn es nicht auch "
   "wert ist, dafür zu sterben.\""
rebelliege_random_008 = de \
   "~kJonas sagt, \"Würdest Du mal ein bisschen Platz machen, bitte?\""
rebelliege_random_009 = de \
   "~kJonas sagt, \"Das ist also der Lohn für den vielversprechendsten "
   "Offizier, den dieses Land jemals hervorgebracht hat. Von den Politikern "
   "in den Ruhestand versetzt, und das in einem Alter, in dem meine Karriere "
   "am stärksten sein sollte.\""
rebelliege_random_010 = de \
   "~kJonas sagt, \"Du möchtest also einer richtigen Armee angehören?\""
rebelliege_random_011 = de \
   "~kJonas sagt, \"Ich denke, ich verzichte darauf, ein politischer "
   "Speichellecker zu sein. Ich möchte mehr sein als das; ich werde mehr "
   "sein als das.\""
rebelliege_random_012 = de "~kJonas sagt, \"Wovon sprichst Du eigentlich?\""
rebelliege_random_013 = de "~kJonas sagt, \"Lass mich in Ruhe und geh.\""
rebelliege_random_014 = de \
   "~kJonas sagt, \"Die Politik hat mich in meiner ganzen militärischen "
   "Laufbahn immer wieder zurückgedrängt. Jetzt ist es an der Zeit, dass ich "
   "dagegenhalte.\""
rebelliege_random_015 = de \
   "~kJonas sagt, \"Ich merke, dass sich eine Armee bildet. Wann hatten wir "
   "hier zuletzt eine anständige Armee?\""
rebelliege_random_016 = de \
   "~kJonas sagt, \"Ich nehme an, Zylill ist qualifiziert, das Militär im "
   "Rat von Meridian zu vertreten, falls man an dieser Stelle einen "
   "vertrockneten alten Mann haben will. Trotz seiner Senilität scheint er "
   "aber klar genug im Kopf zu sein.\""
rebelliege_random_017 = de \
   "~kJonas sagt, \"Die Zustände in diesem Land sind erschreckend, seit die "
   "Regierung zweigeteilt ist zwischen dem rechtmäßigen Königshaus und einem "
   "armseligen Hund, der sich in teure Kaufmannsgewänder kleidet und sich "
   "selbst Herzog nennt. Ich habe nicht übel Lust, selbst nach der Krone zu "
   "greifen.\""
rebelliege_random_018 = de "~kJonas blickt versonnen in die Ferne."
rebelliege_random_019 = de "~kJonas sieht müde aus."
rebelliege_random_020 = de \
   "~kJonas hat noch immer die kerzengerade Haltung eines Berufssoldaten."
rebelliege_random_021 = de "~kJonas ist ein sehr stolzer Mann."
rebelliege_random_022 = de \
   "~kJonas blickt starr durch die Gegend, bedrohlich und streng."
rebelliege_random_023 = de \
   "~kJonas schaut Dir direkt in die Augen, unerschrocken und mit eiskalter "
   "Präzision."
rebelliege_random_024 = de "~kJonas lächelt in sich hinein."
rebelliege_random_025 = de \
   "~kJonas reibt gedankenverloren die lange Narbe, die längs durch seine "
   "rechte Gesichtshälfte verläuft."
rebelliege_random_026 = de \
   "~kJonas genießt den Ruf, ein brillanter Taktiker zu sein."
rebelliege_random_027 = de \
   "~kJonas sagt, \"Wenn Du ausziehst, den Lupoggkönig zu bekämpfen, dann "
   "halte Dich an diesen taktischen Rat, denn er ist vernünftig. Nimm eine "
   "große Schar Krieger mit, denn er ist dafür bekannt, fünf oder mehr mit "
   "Leichtigkeit zu zerfetzen. Außerdem sollte jeweils nur ein Krieger den "
   "Angriff anführen und sich zurückziehen, sobald er schwere Verletzungen "
   "davonträgt.\""
rebelliege_random_028 = de \
   "~kJonas sagt, \"Wenn der Kampf direkt bevorsteht, sollte Dein erstes "
   "Gebot sein, die Verbündeten zu verteidigen. Denn die Gegner werden es "
   "garantiert tun, egal ob Mensch oder Bestie.\""
rebelliege_random_029 = de \
   "~kJonas sagt, \"Die wirkungsvollste Art, wie ein Krieger die Extreme "
   "seines Karmas erreichen kann, ist, einen anderen vom entgegengesetzten "
   "Extrem zu töten.\""
rebelliege_random_030 = de \
   "~kJonas rückt demonstrativ und mit einigem Geschepper seine Rüstung "
   "zurecht."
rebelliege_random_031 = de \
   "~kJonas sagt, \"Ich habe die alten Konima-Legenden erforscht. Du kennst "
   "doch die Geschichten des großen Konima, oder?\""
rebelliege_random_032 = de \
   "~kJonas ist im Grunde nur ein müder alter Mann. Das sieht man jetzt."
rebelliege_random_033 = de "~kJonas grummelt vor sich hin."
rebelliege_random_034 = de "~kJonas sagt, \"Pah.\""
rebelliege_random_035 = de \
   "~kJonas sagt, \"Ich denke, es ist an der Zeit, den Leuten zu zeigen, wie "
   "wichtig ich sein kann.\""
rebelliege_random_036 = de \
   "~kJonas sagt, \"Euer ganzer Haufen sollte in die Unterwelt versinken.\""
rebelliege_random_037 = de "~kJonas sagt, \"Lachst Du über mich?\""
