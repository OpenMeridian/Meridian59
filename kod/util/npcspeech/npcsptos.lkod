// TosWatcher
toswatcher_speech_001 = de \
   "~kDer Meister der Arena sagt, \"General Zylill ist ein Mitglied des "
   "Rates und er ist mein Vater. Er lebt am Fluss Ille.\""
toswatcher_speech_002 = de \
   "~kDer Meister der Arena sagt, \"Gepriesen sei die Erinnerung an Kalior! "
   "Gepriesen sei Herzog Akardius!\""
toswatcher_speech_003 = de \
   "~kDer Meister der Arena sagt, \"Gesegnet sei %s!\""
toswatcher_speech_004 = de \
   "~kDer Meister der Arena sagt, \"Ich bin der Kampfrichter aller "
   "Begegnungen in dieser Arena. Lies meine Banner, um zu erfahren, wie man "
   "daran teilnimmt.\""
toswatcher_speech_005 = de \
   "~kDer Meister der Arena sagt, \"Gesegnet sei unser Herr und Gott, "
   "Kraanan der Faust! Kämpfe in seinem Namen und Du wirst wahre Stärke "
   "kennenlernen.\""
toswatcher_speech_006 = de \
   "~kDer Meister der Arena sagt, \"Gesegnet sei Prinzessin Kateriina!\""
toswatcher_speech_007 = de \
   "~kDer Meister der Arena sagt, \"Du sprichst von der Priesterin Qertina, "
   "meiner Mutter. Sie hat mich Disziplin und Mut gelehrt. Es wäre klug von "
   "Dir, sie im Tempel des Kraanan jenseits der zerklüfteten Berge "
   "aufzusuchen.\""
toswatcher_speech_008 = de \
   "~kDer Meister der Arena sagt, \"Gesegnet sei Tos, die älteste Stadt in "
   "ganz Meridian!\""
