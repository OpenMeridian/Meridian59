// Towns
towns_speech_001 = de \
   "~kEs wird still im Raum, als %s von einem verkümmerten Zwerg redet."
towns_trigger_stunted_dwarf = de "verkümmerten zwerg"
towns_trigger_stunted_dwarf_2 = de "verkümmerter zwerg"
towns_trigger_stunted_dwarf_3 = de "verkümmerte zwerg"
