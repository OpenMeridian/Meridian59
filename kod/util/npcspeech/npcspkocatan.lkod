kocatantrademaster_trigger_wings = de "flügel"

// KocatanVaultman
kocatanvaultman_random_001 = de \
   "~kItzal stiert die Mauer an und stößt mehrmals laut auf."
kocatanvaultman_random_002 = de "~kItzal kratzt sich am Hintern."
kocatanvaultman_random_003 = de \
   "~kItzal sagt, \"Du willst doch nicht etwa, dass ich ~Izurück~k in dieses "
   "Lager gehe, um Dir etwas zu holen, nicht wahr?!\""
kocatanvaultman_random_004 = de \
   "~kItzal sagt, \"He, Huital, kann ich eine Pause machen? Meine Beine sind "
   "müde.\""
kocatanvaultman_random_005 = de \
   "~kItzals Augen fallen flatternd zu und sein Mund bleibt offen stehen. "
   "Nach ein paar Sekunden fängt er an zu schnarchen."
kocatanvaultman_random_006 = de \
   "~kItzal sagt, \"Huital, ich brauche etwas zusätzliches Geld. Ich habe "
   "aus Versehen eine der Flaschen des Kunden zerbrochen.\""
kocatanvaultman_random_007 = de \
   "~kItzal taucht seine Hände ins Wasser und bespritzt sein Gesicht. Huital "
   "wirft ihm einen vernichtenden Blick zu."
kocatanvaultman_random_008 = de "~kItzal schlägt nach einer Fliege."
kocatanvaultman_random_009 = de \
   "~kPlötzlich steigt Dir ein sehr unangenehmer Geruch in die Nase. Itzal "
   "lächelt in sich hinein."
kocatanvaultman_random_010 = de \
   "~kItzal sagt, \"Entschuldigung. Ich hätte heute nicht im Bellenden "
   "Monstrum essen sollen.\""
kocatanvaultman_random_011 = de \
   "~kItzal sagt, \"Ich glaube, ich habe ein paar Teile von Ixlas Rüstung "
   "verloren. Ich hoffe, sie tut mir dafür nichts.\""
kocatanvaultman_random_012 = de \
   "~kItzal sagt, \"Danke, dass Ihr in unsere Gewölbe gekommen seid, %s.\", "
   "dann flüstert er Huital zu, \"War das in Ordnung?\""
kocatanvaultman_random_013 = de \
   "~kItzal sagt, \"Ich bin müde, Huit. Lass mich heute früh nach Hause "
   "gehen.\""
kocatanvaultman_random_014 = de \
   "~kItzal seufzt und sagt, \"Nicht Du schon wieder.\""

// KocatanWeaponsMaster
kocatanweaponsmaster_speech_001 = de \
   "~kKochtal sagt, \"Die Avar sind sehr genaue und starke Gegner. Schreite "
   "behutsam durch ihr Heimatland oder bring eine ganze Armee mit Dir.\""
kocatanweaponsmaster_speech_002 = de \
   "~kKochtal sagt, \"Ko'catan sorgt für all meine Bedürfnisse.\""
kocatanweaponsmaster_speech_003 = de \
   "~kKochtal sagt, \"Unsere Gesellschaft ist auf dem Respekt vor denen, die "
   "einen höheren Rang bekleiden, aufgebaut. Als ein Fremder stehst Du sogar "
   "noch unter einem Ix und musst deshalb alle in unserer Gesellschaft "
   "respektieren.\""
kocatanweaponsmaster_speech_004 = de \
   "~kKochtal ko'Tulca sagt, \"Hallo? Wer ist da?\""
kocatanweaponsmaster_speech_005 = de \
   "~kKochtal ko'Tulca sagt, \"Ich bin der beste Waffenmeister in Ko'catan. "
   "Diejenigen, die einem Krieger den gebührenden Respekt erweisen, "
   "unterrichte ich.\""
kocatanweaponsmaster_speech_006 = de \
   "~kKochtal sagt, \"Ko'catan ist eine große und geordnete Festung. Sie "
   "bietet ihren Bewohnern Schutz und einen Lebenszweck.\""
kocatanweaponsmaster_speech_007 = de \
   "~kKochtal sagt, \"Konima war der perfekte Krieger. Nicht nur eine "
   "Tötungsmaschine, sondern auch ein mitfühlender und selbstloser Stratege. "
   "Unsere Gesellschaft gründet sich auf seine kühnen Ideale.\""
kocatanweaponsmaster_speech_008 = de \
   "~kKochtal sagt, \"Jede Person wird nach ihrem Wert für unsere "
   "Kriegergesellschaft eingestuft. Die Menschen hier kennen die Grenzen "
   "ihrer Berufung.\""
kocatanweaponsmaster_speech_009 = de \
   "~kKochtal sagt, \"Ich könnte Dich vielleicht in der Kunst des "
   "Bogenschießens unterweisen.\""
kocatanweaponsmaster_speech_010 = de \
   "~kKochtal sagt, \"Ich kenne Dein Wort für die Halbmenschen nicht, die "
   "unser mächtiger Konima vor all den Jahrhunderten zurückgeschlagen hat.\""
kocatanweaponsmaster_random_001 = de \
   "~kKochtal sagt, \"In Ko'catan müssen unsere Leute sich ihren Namen "
   "verdienen. Man entscheidet sich nicht selbst, zu Cha oder Ko "
   "aufzusteigen. Andere werden das für einen entscheiden.\""
kocatanweaponsmaster_random_002 = de \
   "~kKochtal sagt, \"Unsere Kultur hat viele Sitten und Gebräuche "
   "hervorgebracht. Wir zögern nicht, jene auszustoßen, die sich nicht daran "
   "halten.\""
kocatanweaponsmaster_random_003 = de \
   "~kKochtal sagt, \"Jede Person erfüllt ihren Zweck und hat einen "
   "festgelegten Rang. Wir erlauben Dir, Dich innerhalb unserer Mauern "
   "aufzuhalten. Erdreiste Dich nicht, die Ordnung von Ko'catan zu stören.\""
kocatanweaponsmaster_random_004 = de \
   "~kKochtal sagt, \"Es gibt keine Kriegskunst. Krieg steht im krassen "
   "Widerspruch zur Kunst. Diejenigen, die im Krieg irgendeine Art von "
   "Schönheit zu entdecken meinen, haben nie eine Schlacht erlebt.\""
kocatanweaponsmaster_random_005 = de \
   "~kKochtal sagt, \"Über Waffenfertigkeit zu verfügen, macht einen fähigen "
   "Soldaten aus. Um wirklich furchteinflößend zu sein, braucht der Krieger "
   "aber auch Geduld, Voraussicht und Verbündete.\""
kocatanweaponsmaster_random_006 = de \
   "~kKochtal sagt, \"Du musst auch über Mitgefühl verfügen. Ein "
   "kaltherziger Krieger ist weniger erfolgreich als einer, der mitfühlt, "
   "denn der Kaltherzige hat nichts zu verlieren, das ihm etwas bedeutet.\""
kocatanweaponsmaster_random_007 = de \
   "~kKochtal sagt, \"Unsere Gesellschaft hat aufgrund eines Prinzips über "
   "200 Jahre überdauert - 'Ordnung'. Ohne Ordnung gibt es nur Chaos.\""
kocatanweaponsmaster_random_008 = de \
   "~kKochtal sagt, \"Vor vielen Jahren verlor ich meine Augen, als ich die "
   "äußeren Mauern verteidigte. Als Krieger bin ich jetzt kaum noch von "
   "Nutzen. Darum muss ich unterrichten.\""
kocatanweaponsmaster_random_009 = de \
   "~kKochtal schnuppert und sagt, \"Die Krieger sind von der Jagd "
   "zurückgekehrt.\""
kocatanweaponsmaster_random_010 = de \
   "~kKochtal streckt seinen Hals aus, als ob er intensiv lauschen würde. Du "
   "hörst nichts. Nach einem Moment lächelt er und sagt, \"Sie wird ihn "
   "nicht in der Kneipe finden.\""
kocatanweaponsmaster_random_011 = de \
   "~kKochtal beginnt mit einer langsamen Übung aus Strecken und Beugen."
kocatanweaponsmaster_random_012 = de \
   "~kKochtal tastet nach seinen Waffen. Nach einem Moment finden seine "
   "Hände ein altes, verrostetes Kurzschwert. Er flüstert, \"Da bist Du ja, "
   "alter Freund.\""
kocatanweaponsmaster_random_013 = de \
   "~kKochtal sagt, \"Diese Avaren können ziemlich gerissen sein. Es gibt "
   "einen, der sich mit dem Tod umgibt. Er weiß etwas über Riija.\""
kocatanweaponsmaster_random_014 = de \
   "~kKochtal sagt, \"Ich spüre, dass Du in Deinem Land respektiert wirst. "
   "Das ist gut, mein Freund.\""
kocatanweaponsmaster_random_015 = de \
   "~kKochtal sagt, \"Ich hörte einen anderen Reisenden Dich preisen. Sei "
   "stolz.\""
kocatanweaponsmaster_random_016 = de \
   "~kKochtal betastet Dein Gesicht und Deine Schultern. Lächelnd sagt er, "
   "\"Ich werde mich an Dich erinnern.\""
kocatanweaponsmaster_random_017 = de \
   "~kKochtal sagt, \"Du hast bereits bewiesen, dass Du stark bist, denn Du "
   "hast die Utomhöhlen durchquert.\""
kocatanweaponsmaster_random_018 = de \
   "~kKochtal sagt, \"Wie ich gehört habe, gibt es in Deinem Land wenig "
   "Ordnung. Das Königreich ist zerrissen und die Städte bekriegen sich. "
   "Ko'catan braucht solche Einflüsse nicht.\""
kocatanweaponsmaster_random_019 = de \
   "~kKochtal sagt, \"Du beleidigst unsere Gemeinschaft. Es wäre ein weiser "
   "Entschluss von Dir, uns zu verlassen.\""
kocatanweaponsmaster_random_020 = de \
   "~kKochtal sagt, \"Ko'catan wünscht nicht, dass Deine Leute hierher "
   "kommen.\""
kocatanweaponsmaster_random_021 = de \
   "~kKochtal sagt, \"Vor langer Zeit waren Dein Volk und unser Volk eins. "
   "Jetzt sind wir verschieden. Unsere Gesellschaften gehören nicht länger "
   "zueinander.\""
kocatanweaponsmaster_trigger_buy = de "kaufen"
kocatanweaponsmaster_trigger_sell = de "verkauf"
kocatanweaponsmaster_trigger_customs = de "bräuche"
kocatanweaponsmaster_trigger_society = de "bräuche"
kocatanweaponsmaster_trigger_hello = de "hallo"
kocatanweaponsmaster_trigger_help = de "hilfe"
kocatanweaponsmaster_trigger_mores = de "sitten"
kocatanweaponsmaster_trigger_mores_2 = de "wert"
kocatanweaponsmaster_trigger_teach = de "lernen"
kocatanweaponsmaster_trigger_learn = de "lehre"
kocatanweaponsmaster_trigger_learn_2 = de "beibringen"
