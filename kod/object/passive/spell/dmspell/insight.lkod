Insight_name_rsc = de "Durchschauen"
allinroom_Insight_msg1 = de "~b%s%s blickt tief in die Seele von %s%s."
allinroom_Insight_msg2 = de \
   "~bEin Kribbeln durchfährt Dich, als %s%s tief in %s%s blickt."
caster_Insight_msg = de "~bDu blickst %s%s tief in die Augen."
Insightd_Insight_msg = de "~b%s%s blickt Dir tief in die Augen."
Insight_desc_rsc = de \
   "Blickt einer Person tief in die Augen und schätzt ihre Chancen ein, sich in "
   "jedem Zauber und jeder Fähigkeit zu verbessern.  Der wahre Prozentwert "
   "steht hinter dem Namen.  Die erste Zahl danach ist die Intellekt-Prüfung, "
   "die zweite die Prüfung des benötigten Werts.  Diese geht von einem Ziel "
   "etwa auf der Stufe einer Pilzbestie oder Mutantenameise aus: Bei "
   "Angriffszaubern und Kampffähigkeiten steigen Deine Chancen gegen stärkere "
   "Monster."
Insight_Message = de "%s (%i):  %i gesamt, %i erste/%i zweite Chance."
