////////////////////////////////////////////////////////////////////////////////
ItemAttDyed is ItemAttribute

///////////////////////////////////////////////////////////////////////
//
//   This item has been coloured using a bottle of dye
//
//   Form is:
//
//      [IA_DYED, $, iColor, iOriginalColor]
//
//   iColor::the dye color; iOriginalColor::the original palette
//
///////////////////////////////////////////////////////////////////////

constants:

   include blakston.khd

resources:

   include iadyed.lkod

    ItemAtt_dyed_desc = "  This %s has been dyed with a vibrant color."

classvars:

   viItem_Att_Num = IA_DYED
   vrDesc = ItemAtt_dyed_desc

   // Item stays colored when it breaks - maybe someone wants that?
   vbRemoveOnItemBreak = FALSE

properties:

messages:

   AppendDesc(oItem=$,who=$,lData=$)
   {
      AddPacket(4,vrDesc,4,Send(oItem,@GetName));

      return;
   }

   SetPrimaryState(state1=$)
   {
      if state1 = $
      {
         Debug("SetPrimaryState called with nil state!");

         return FALSE;
      }

      return state1;
   }

   ReqAddToItem(oItem=$)
   {
      propagate;
   }

   UpdateItem(oItem=$, iState=$)
   {
      local oOwner;

      oOwner = Send(oItem,@GetOwner);

      Send(oItem,@SetPaletteTranslation,#translation=iState);
      if (oOwner <> $)
      {
         Send(oOwner,@SomethingChanged,#what=oItem);
         // Checks for item in overlays. SomethingChanged should probably
         // handle this, but other classes use ChangeWindowOverlay for
         // animations already.
         if (IsClass(oOwner,&User))
         {
            Send(oOwner,@ChangeWindowOverlay,#what=oItem);
         }
      }

      return;
   }

   AddToItem(oItem = $, state1 = $)
   {
      local lData;

      lData = Send(oItem,@GetAttributeData,#ItemAtt=viItem_Att_Num);
      if (lData <> $)
      {
         SetNth(lData,3,state1);
         Send(self,@UpdateItem,#oItem=oItem,#iState=state1);

         return;
      }

      propagate;
   }

   AddEffects(oItem=$,lData=$,state1=$)
   {
      local iOriginalColor;

      iOriginalColor = Send(oItem,@GetPaletteTranslation);
      if (Length(lData) > 3)
      {
         SetNth(lData,4,iOriginalColor);
      }
      else
      {
         lData = AppendListElem(iOriginalColor,lData);
      }

      Send(self,@UpdateItem,#oItem=oItem,#iState=state1);

      return;
   }

   RemoveFromItem(oItem=$, state1 = $)
   {
      local lData, iOriginalColor;

      lData = Send(oItem,@GetAttributeData,#ItemAtt=viItem_Att_Num);
      if (lData = $)
      {
         propagate;
      }

      iOriginalColor = 0;
      if (Length(lData) > 3 AND Nth(lData,4) <> $)
      {
         iOriginalColor = Nth(lData,4);
      }
      Send(self,@UpdateItem,#oItem=oItem,#iState=iOriginalColor);

      propagate;
   }

   CanBeSpoofed()
   {
      return FALSE;
   }

   GetNamePriority()
   {
      return -1;
   }

   InitiallyIdentified(random_gen=FALSE)
   {
      return TRUE;
   }

   AddToTreasureTable()
   {
      return FALSE;
   }

   SetItemsToAttribute()
   {
      plItems_to_Attribute = $;

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
