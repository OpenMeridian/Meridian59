FireGolemQuest_name_rsc = de "Die Geschichte eines Barden"

FireGolemQuest_desc_rsc = de \
   "Roderick Merk erzählt eine Geschichte, die viele Barden weitergeben.  "
   "Während der großen Spaltung soll Jala selbst Inferno, einen tobenden "
   "Feuergolem, herbeigerufen haben."
   
FireGolemQuest_kill_rsc = de \
   "Der Geist von %s, einem mächtigen Feuergolem, existiert noch immer in "
   "diesen Landen.  Finde und erschlage ihn."

FireGolemQuest_return_rsc = de \
   "Kehre zu %s zurück und lass %s wissen, dass die Aufgabe erledigt ist."

FireGolemQuest_completed = de \
   "Du hast Inferno, den Golem des Feuers, besiegt."

// Quest-Ressourcen.
FireGolemQuest_trigger = de "Feuergolem"
FireGolemQuest_assign_2 = de \
   "Unter Barden gibt es eine Geschichte über Jala.  Wohin Jala auch ging, "
   "stets beschützten sie die Elemente Feuer, Eis und Sturm.  Die Elementare "
   "schützten Jala auch noch lange nach der großen Isolation.  Dieser Schutz "
   "war jedoch kein Zufall.  Der Elementargott Faren verehrte Jala sehr und "
   "hatte ihr die Treue geschworen.  Eine große Spaltung trennte Jala vom Rest "
   "der Lande, und sie vermisste Faren sehr.  Aus ihrer Einsamkeit heraus "
   "erschuf sie Inferno, einen großen Feuergolem.  Viele glauben, dass Inferno "
   "noch heute in den Höhlen tobt."

FireGolemQuest_failure_2 = de \
   "Betreff: Die Geschichte eines Barden\nEs könnte auch nur ein Mythos sein.  "
   "Bei all den überlieferten Legenden ist es schwer zu sagen, was wahr ist."

FireGolemQuest_success_2 = de \
   "Du hast den mächtigen Inferno besiegt?  Die Legenden waren also doch wahr.  "
   "Ironisch, nicht wahr?  Was aus Jalas Einsamkeit entstand, ist nun selbst "
   "von der Welt abgeschnitten.  Sind wir besser als jene, die Jala im Stich "
   "ließen?  Vielleicht könnt ihr Westler das nicht verstehen.  Auch ich musste "
   "Jixa verlassen, und ich vermisse es noch immer sehr.  Ich vermisse meinen "
   "Freund."
