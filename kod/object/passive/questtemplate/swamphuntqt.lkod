   SwampHuntQuest_name_rsc = de "Schlammige Gewässer"
 
   SwampHuntQuest_desc_rsc = de \
      "Im Sumpf sind weitere feindliche Kreaturen aufgetaucht.  Michael d'Adue "
      "sorgt sich um den Zustand der Feuchtgebiete und die Folgen für die "
      "Umwelt.  Finde heraus, warum das geschieht."
 
   SwampHuntQuest_return_rsc = de \
      "Kehre zu %s zurück und lass %s wissen, dass die Aufgabe erledigt ist."
 
   SwampHuntQuest_completed = de \
      "Du bist im Sumpf auf die Jagd gegangen."
 
   // Quest-Ressourcen.
   SwampHuntQuest_trigger = de "Sumpf"
   SwampHuntQuest_assign_2 = de \
      "Warst du in letzter Zeit im Sumpf?  Die Ranunculus haben die Gewässer "
      "befallen und die Umwelt verseucht.  Im Sumpf, der Heimat des sanften "
      "Volks der Froschmenschen, kämpfen diese einen aussichtslosen Kampf gegen "
      "die Kranken.  Du glaubst mir nicht?  Dann nimm es mit einem Dutzend "
      "Ranunculus auf und komm zurück."
 
   SwampHuntQuest_node2_rsc = de \
      "Die %s haben die Sümpfe befallen, und es gibt keine echten Feinde, die "
      "ihren Bestand in Grenzen halten.  Michael d'Adue hat dich gebeten, %i zu "
      "töten.\n\nBisher hast du %i davon erschlagen.  Beende diese Aufgabe und "
      "erstatte Michael d'Adue Bericht."
   SwampHuntQuest_failure_2 = de \
      "Betreff: Schlammige Gewässer\nHallo, bist du tot?  Ihr Westler solltet "
      "euch von Berg fernhalten."
 
   SwampHuntQuest_node3_rsc = de \
      "Bitte ein Mitglied des königlichen Rats um Hilfe.  Esseldi ist als "
      "Forscher und Reisender bekannt, vielleicht kann er helfen."
   SwampHuntQuest_assign_3 = de \
      "Du bist zurück?  Die meisten aus dem Westen sind nicht so stark wie "
      "du...  Der Zustand des Moors macht mir wirklich Sorgen, denn das "
      "betrifft uns alle.  Ich würde unserem König zutrauen, sich darum zu "
      "kümmern, aber ihn scheint nur zu interessieren, wie er uns die "
      "Schillinge aus den Taschen zieht.  Gibt es im königlichen Rat jemanden, "
      "der uns helfen würde?"
   SwampHuntQuest_failure_3 = de \
      "Betreff: Schlammige Gewässer\nBist du weggelaufen?  Ihr Westler seid "
      "schlimmer als die Ranunculus."
 
   SwampHuntQuest_node4_rsc = de \
      "Der Rat kann bei den Problemen des Sumpfs nicht helfen.  Erstatte "
      "Michael d'Adue Bericht und lass es ihn wissen."
   SwampHuntQuest_assign_4 = de \
      "Der Rat ist nicht befugt, sich in die Politik des Ostens einzumischen.  "
      "Aber ich habe vielleicht Informationen, die dir nützen...  Spät in der "
      "Nacht ging ich durch den Sumpf, um seine Lebewesen zu studieren.  "
      "Plötzlich hörte ich dieses flatternde Geräusch.  Ich blickte auf und sah "
      "eine schattenhafte Gestalt vor dem Mond vorbeiziehen.  Es schien ein "
      "großer geflügelter Vogel zu sein, der auf gewaltigen Schwingen in der "
      "Luft schwebte und den ganzen Himmel überspannte.  Als ich die "
      "Feuchtgebiete verließ, fühlte ich mich die ganze Zeit beobachtet...  "
      "Barden singen von ihnen, den ~INachtpirschern~I, die verlorenen "
      "Reisenden folgen, bevor sie ihre Seelen verzehren.  Ich hatte Glück, "
      "dort herauszukommen.  Das ist gewiss das Werk von Qor."
   SwampHuntQuest_failure_4 = de \
      "Betreff: Schlammige Gewässer\nEs ist eine lange Reise nach Osten, und es "
      "ist schwierig, Hilfe dorthin zu schicken.  Entschuldige die Umstände!"
 
   SwampHuntQuest_node5_rsc = de \
      "Diener von Qor haben das Moor möglicherweise befallen.  Finde und töte "
      "%i 'Nachtpirscher'.\n\nBisher hast du %i davon erschlagen.  Beende diese "
      "Aufgabe und erstatte Michael d'Adue Bericht."
   SwampHuntQuest_assign_5 = de \
      "Nicht befugt?!  Ein riesiger Vogel?!  PAH!  Vielleicht auf einer fernen "
      "Insel, aber nicht hier...  Obwohl...  wenn die Sonne untergeht, spürt "
      "man tatsächlich eine böse Gegenwart.  Stell eine Gruppe zusammen und "
      "vertreibe diese sogenannten Nachtpirscher."
   SwampHuntQuest_failure_5 = de \
      "Betreff: Schlammige Gewässer\nNachtpirscher, dass ich nicht lache.  Nur "
      "noch ein Westler, der an unserem Land verdienen will."
 
   SwampHuntQuest_success = de \
      "Irgendwie schwindet das Leben aus dem Sumpf, und ich weiß nicht, warum."
