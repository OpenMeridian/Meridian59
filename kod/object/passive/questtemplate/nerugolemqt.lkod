   NeruGolemQuest_name_rsc = de "Golem-Erschaffung"
 
   NeruGolemQuest_desc_rsc = de \
      "Über die Golems ist wenig bekannt, außer dass sie von Menschen "
      "erschaffen wurden.  Sie dienten als Werkzeuge im großen Krieg und zum "
      "Schutz von Berg.  Wegen ihrer gewaltigen Kraft sind sie heute "
      "weggesperrt.  Bastiane d'Ile träumt von einem eigenen Golem, damit er "
      "nicht mehr arbeiten muss.  Hilf ihm, Informationen über die Erschaffung "
      "der Golems zu sammeln, und erschaffe selbst einen."
 
   NeruGolemQuest_return_rsc = de \
      "Kehre zu %s zurück und lass %s wissen, dass die Aufgabe erledigt ist."
 
   NeruGolemQuest_completed = de \
      "Du hast erfolgreich einen Golem beschworen, aber er war viel zu mächtig, "
      "um ihn zu kontrollieren."
 
   // Quest-Ressourcen.
   nerugolemquest_trigger = de "Golems"
   nerugolemquest_assign_2 = de \
      "Die Golems sind also von Menschenhand gemacht?  Man sollte meinen, wir "
      "würden sie als Werkzeuge benutzen, die uns dienen, statt sie in diesen "
      "Höhlen w-w-wegzusperren.  Wir sollten wie K-K-Könige leben und keinen "
      "einzigen Tag in unserem Leben arbeiten müssen.  Ich wette, wir können "
      "unseren eigenen Golem bauen... so schwer kann das nicht sein... "
      "vielleicht könntest du einen umhauen und herausfinden, wie sie gebaut "
      "sind?"
 
   NeruGolemQuest_node2_rsc = de \
      "Bastiane d'Ile möchte herausfinden, wie ein Golem gebaut ist.  "
      "Vielleicht erfährst du es, wenn du einen Golem erschlägst.  Beende diese "
      "Aufgabe und erstatte Bastiane d'Ile Bericht."
   nerugolemquest_failure_2 = de \
      "Betreff: Golem-Erschaffung\nIch habe nichts mehr von dir gehört.  Ich "
      "hoffe, du bist nicht tot, Kumpel."
 
   NeruGolemQuest_node3_rsc = de \
      "Der Vater von Rosaline Marinus war ein Meisterschmied.  Besuche sie, "
      "vielleicht weiß sie etwas über den Ursprung der Golems."
   nerugolemquest_assign_3 = de \
      "Großer Jala?!  Du hast es geschafft, einen zu erledigen?  Mein Traum!  "
      "Mein g-g-ganz eigener Golem!  Er könnte doch noch in greifbare Nähe "
      "rücken!  Ach, ich dachte, es hilft uns, einen zu töten, aber weißt du... "
      "ich bin kein E-E-Experte...  Vielleicht solltest du die Färberin in Jixa "
      "aufsuchen.  Ihr Vater war ein großer Schmied, vielleicht hat er ihr sein "
      "Wissen weitergegeben."
   nerugolemquest_failure_3 = de \
      "Betreff: Golem-Erschaffung\nTut mir leid, Kumpel, ich habe ein bisschen "
      "zu viel getrunken.  Vergiss mein Gerede vom Golembau."
 
   NeruGolemQuest_node4_rsc = de \
      "Die Erschaffung der Golems könnte auf die Xeochicatl zurückgehen.  "
      "Erschlage einen mächtigen ne'Xeochicatl und erstatte Rosaline Marinus "
      "Bericht."
   nerugolemquest_assign_4 = de \
      "Du hast einen Golem besiegt?  Du musst ein wahrer Krieger sein.  Mein "
      "Vater erzählte oft Geschichten über den Ursprung dieser Maschinen.  Er "
      "erwähnte, dass Herzsteine magische Eigenschaften besitzen und von einem "
      "einst mächtigen Alchemisten zur Erschaffung der Golems benutzt wurden.  "
      "Die genaue Methode ist allerdings noch immer ein Rätsel.  Jenseits von "
      "Berg, hinter dem Tal des Todes, leben Kreaturen, die sich von Mana "
      "ernähren.  Es gibt Legenden über einen riesigen Xeochicatl.  Vielleicht "
      "trägt diese Kreatur die Quelle ihrer Macht in sich.  Du hättest "
      "vielleicht mehr Glück, wenn du versuchst, eines dieser Wesen zu "
      "zerlegen."
   nerugolemquest_failure_4 = de \
      "Betreff: Golem-Erschaffung\nIch hätte dich auch vor der Stärke der "
      "Xeochicatl warnen sollen.  Ich hoffe, du lebst da draußen noch!"
 
   NeruGolemQuest_node5_rsc = de \
      "Nur ein verrückter Wissenschaftler könnte einen Golem erschaffen.  Finde "
      "jemanden, der zu einem Experiment bereit ist."
   nerugolemquest_assign_5 = de \
      "Wow, du hast einen mächtigen ne'Xeochicatl besiegt?  Vielleicht lässt "
      "sich die Kraft der Herzsteine zur Erschaffung eines Golems beherrschen.  "
      "Ich kenne nur ihre farbenfrohen Eigenschaften, dafür fehlt mir leider "
      "jede Ahnung.  Du wirst eine Art verrückten Wissenschaftler finden "
      "müssen.  Tut mir leid, dass ich dir hier nicht viel helfen kann."
   nerugolemquest_failure_5 = de \
      "Betreff: Golem-Erschaffung\nTut mir leid, dass ich dir nicht mehr helfen "
      "konnte.  Ich bin nicht sicher, ob es überhaupt jemanden gibt, der so "
      "etwas erschaffen kann."
 
   NeruGolemQuest_node6_rsc = de \
      "Bahal zax'Ot kann vielleicht einen Golem erschaffen.  Er verlangt einen "
      "Kangi-Stein?  Damit sind möglicherweise die Herzsteine gemeint.  Gib ihm "
      "einen dunkelgrünen."
   nerugolemquest_assign_6 = de \
      "Ein Golem, sagst du?  Mit der richtigen Magie könnte ich so etwas "
      "vielleicht erschaffen.  Bring mir den Kangi-Stein einer neruditischen "
      "Bestie, er ist dunkelgrün.  Das wird meine bisher mächtigste Schöpfung!"
   nerugolemquest_failure_6 = de \
      "Betreff: Golem-Erschaffung\nKomm zurück, wenn du einen Kangi-Stein hast.  "
      "Ohne ihn kann ich keinen Golem erschaffen."
 
   NeruGolemQuest_node7_rsc = de \
      "Der Golem wurde beschworen, ist aber viel zu mächtig, um ihn zu zähmen.  "
      "Vernichte den Kangi, bevor er außer Kontrolle gerät."
   nerugolemquest_assign_7 = de \
      "Oh nein!  Ich habe die Macht des Kangi unterschätzt.  Er ist außer "
      "Kontrolle!  Die Kreatur wütet direkt vor meinem Haus!  Schaff dieses "
      "Ding sofort weg, es wird uns alle ins Verderben stürzen!"
   nerugolemquest_failure_7 = de \
      "Betreff: Golem-Erschaffung\nHinfort, du Zauberer!  Halte mich von dieser "
      "verbotenen Magie fern.  Sie hätte uns fast alle vernichtet..."
 
