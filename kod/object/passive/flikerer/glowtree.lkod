GlowTree_name = de "Weide"
GlowTree_desc = de \
   "Ein leuchtender Saft hängt an den Zweigen dieses bizarren Baums.  Statt mit "
   "üppigem Laub Sonnenlicht einzufangen, lockt der Seelensaftbaum Insekten mit "
   "der süßen, leuchtenden Flüssigkeit an und nimmt dann direkt die Nährstoffe "
   "der hilflosen Käfer auf."
