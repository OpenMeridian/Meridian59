room_name_JasperAB3 = de "Altes Schulhaus"
JasperAB3_Necro_book_name = de "Das Tagebuch von Sergeant Doran"
JasperAB3_Necro_book_text = de \
   "\n\n\n\n\n\n\n\n\n\nDas Tagebuch von Sergeant Doran,\nAufklärungsspezialist "
   "der Armee von Tos\n\n\n\n\n\n\n\n\n\n\n¶Die Armee von Brax wächst "
   "tatsächlich für eine Offensive heran, wie wir befürchtet hatten.  Jede "
   "Woche rekrutiert ihre dunkle Königin Hunderte ernster Jugendlicher für ihre "
   "Horde von Nekromanten.  Jeder von ihnen muss sich einer Art dunkler "
   "Verwandlung unterziehen, die ich noch nicht mit eigenen Augen sehen konnte, "
   "weil ich noch nicht tief genug vorgedrungen bin.  Ich bin jedoch überzeugt, "
   "dass all ihre dunklen Rituale verblassen im Vergleich zu den Opfern, die "
   "Königin Venya'cyr selbst für ihre Macht gebracht hat; sie hält ihr Gesicht "
   "stets verhüllt, um zu verbergen, dass sie längst aufgehört hat, auch nur "
   "annähernd menschlich zu sein.\n\nDiese persönlichen Opfer müssen der "
   "Schlüssel zu ihrer Vernichtung sein, deshalb ist es entscheidend, dass wir "
   "mehr über ihre Wege erfahren.  Ich bin nicht der Erste, der versucht, in "
   "die inneren Kreise des Ordens der Nekromanten einzudringen, und ich "
   "bezweifle, dass ich lebend zurückkehren werde.  Meine einzige Hoffnung ist, "
   "dass nicht auch ich der Dunkelheit erliege und einer von ihnen "
   "werde.¶Leutnant Kyrg ist tot.  Man verdächtigte ihn, ein Spion zu sein, und "
   "so wurde er in der Arena öffentlich geopfert.  Ich musste mit den anderen "
   "Nekromanten zusehen, zusammengedrängt auf der riesigen Steinplattform in "
   "der Mitte der Arena.  Während die verhüllten Gestalten um mich herum zum "
   "Rand drängten, um die nackten, unten kauernden Opfer besser sehen zu "
   "können, zog ich mich in die Mitte der Plattform zurück.  Ich lehnte den "
   "Rücken an die kühle Steinsäule, blickte hinauf zu den dunklen, brodelnden "
   "Wolken und betete um Regen.  Die Böse Königin trat auf einen Felsvorsprung "
   "hoch über uns, und als die Menge zustimmend zu brüllen begann, kniff ich "
   "die Augen fest zu, um die aufsteigenden Gefühle zu ertragen.\nAls ich sie "
   "Augenblicke später öffnete, war ich bereits in Bewegung, heftig nach vorn "
   "geschleudert, und nahm nur dumpf wahr, wie der Blitz in die Säule und durch "
   "meinen Körper fuhr.  Weitere Einschläge um mich herum bemerkte ich kaum "
   "noch, einer, zwei, wie viele noch, kann ich nicht sagen; meine Ohren "
   "dröhnten von der Explosion und von den Schmerzensschreien überall um mich.  "
   "Dann begann sich die Plattform zu bewegen.¶Durch das Chaos aus knirschendem "
   "Stein, um sich schlagenden verkohlten Körpern und schreienden Stimmen drang "
   "ein klarer Gedanke:  Ich musste Kyrg retten.  Doch als ich meinen "
   "gebrochenen und blutenden Körper zum Rand der Plattform schleppte und durch "
   "die Rauchwolken tief nach unten blickte, begriff ich, dass ich nichts mehr "
   "für ihn tun konnte.  Die Plattform schwebte bereits hundert Fuß über dem "
   "Boden der Arena und stieg stetig weiter, und die wütenden Nekromanten "
   "beschworen eine Horde missgestalteter Skelettkrieger.  Entsetzt sah ich zu, "
   "wie die Untoten über ihre unbewaffneten, hilflosen Opfer herfielen und sie "
   "in Stücke rissen.\n\nIch schauderte und wandte mich von dem Schauspiel ab.  "
   "Während ich in die Bewusstlosigkeit glitt, betete ich zu meinem Herrn Faren "
   "um die Kraft, diese Abscheulichkeit vernichtet zu sehen.  In den letzten "
   "Augenblicken vor dem Schlaf sah ich Venya'cyrs strahlend schönes Gesicht "
   "über mir erscheinen.\n\"Du bist schwer verletzt, mein Liebling.  Für dich "
   "gibt es nun nur noch eines.\"\nSie lächelte, ihre Hände strichen sanft über "
   "mein Gesicht, und ich spürte eine kalte Stahlkette auf der Haut meines "
   "Halses."
