room_name_tossmith = de "Laden Freier Händler und Flicker"
TosSmithy_sign_name = de "Gegenstände reparieren"
TosSmithy_sign_desc = de \
   "Auch wenn Du gestärkt aus einem Kampf hervorgehen magst, gilt das für "
   "Deine Ausrüstung meist nicht.  Wenn Stahl auf Stahl trifft, fallen Waffen "
   "und Rüstungen langsam der Abnutzung im Kampf zum Opfer.  Solange Du "
   "vorausplanst und weißt, wie und wo Du Ersatz findest, sollte Dich das kaum "
   "beunruhigen.  Waffen und Rüstungen sind im Allgemeinen recht leicht zu "
   "bekommen, und im Laufe einer erfolgreichen Abenteurerlaufbahn wird ein "
   "mächtiger Krieger zahllose Klingen zerschlagen haben.\n\nHin und wieder "
   "findest Du aber vielleicht wertvollere Stücke: Waffen und Rüstungen mit "
   "nützlichen Verzauberungen oder solche, die schwerer zu bekommen sind und "
   "die Du nur ungern verlieren würdest.  In solchen Fällen solltest Du einen "
   "Magier suchen, der den Zauber 'Reparieren' beherrscht, und zwar am besten, "
   "bevor der Gegenstand zerbricht.  Zerbrochene Ausrüstung ist nicht mehr zu "
   "retten, behalte also die Haltbarkeit Deiner Ausrüstung im Auge und benutze "
   "wertvolle Gegenstände nicht mehr, bevor sie zerbrechen.\n\nUm einen "
   "geeigneten Magier zu finden, kannst Du eine Mitteilung an alle senden ('b "
   "Nachricht') oder, wenn Du es lieber unauffälliger magst, Leute höflich "
   "persönlich ansprechen.  Der Zauber 'Reparieren' benötigt einen Orkzahn und "
   "einen Saphir, deshalb wissen es Magier sehr zu schätzen, wenn Du diese "
   "Reagenzien für sie bereithältst.  Auch wenn die meisten Magier Dir umsonst "
   "helfen, freut sich jeder über ein Trinkgeld.\n\nEin Wort der Warnung: Das "
   "Reparieren stellt die Haltbarkeit eines Gegenstands auf ihr Maximum wieder "
   "her, doch dieses Maximum kann danach niedriger sein als zuvor, wenn kein "
   "wahrer Meister den Zauber gewirkt hat.\n\nUnd ein letzter Tipp: Wenn Du "
   "viele Waffen verbrauchst, kann es sich lohnen, den Zauber 'Waffe "
   "erschaffen' zu lernen, um Dir viele Wege zum örtlichen Schmied zu sparen.  "
   "Wenn Du den Zauber besser beherrschst, kannst Du Dich sogar auf eine "
   "bestimmte Waffenart konzentrieren und rohes Mana bündeln, um sie entstehen "
   "zu lassen!"
